(require 'gdev-taxonomy)
(require 'gdev-trace)
(require 'gdev-graph)
(require 'gdev-project-catalog)

(defconst gdev-project-manifest ".gdev-assurance/project.eld")
(defconst gdev-project-categories
  '(functional quality security data interface performance compatibility usability process release))
(defconst gdev-project-methods '(test analysis review model-check))
(defconst gdev-project-required-fields
  '((:purpose "Scopo" ANALYZED) (:scope "Perimetro" ANALYZED)
    (:owner "Responsabile" ANALYZED) (:context "Contesto operativo" ANALYZED)
    (:verification "Strategia di verifica" ANALYZED)
    (:validation "Strategia di validazione" REVIEWING)
    (:configuration "Gestione della configurazione" REVIEWING)
    (:release "Criteri di rilascio" REVIEWING)
    (:maintenance "Manutenzione" REVIEWING))
  "Campi obbligatori e prima fase che li richiede.")

(defun gdev-project--text-p (value)
  "Restituisci non nil per un testo VALUE compilato."
  (and (stringp value) (not (string-empty-p (string-trim value)))))

(defun gdev-project--id-p (value)
  "Restituisci non nil per un identificativo stabile VALUE."
  (and (stringp value) (let ((case-fold-search nil))
                        (string-match-p "\\`[A-Za-z0-9][A-Za-z0-9_.-]\\{0,127\\}\\'" value))))

(defun gdev-project--plist (data keys)
  "Verifica che DATA sia una plist senza duplicati con sole KEYS."
  (unless (and (proper-list-p data) (zerop (% (length data) 2)))
    (gdev-process-refuse "Oggetto di progetto non valido"))
  (let (seen)
    (cl-loop for (key _value) on data by #'cddr do
             (unless (and (memq key keys) (not (memq key seen)))
               (gdev-process-refuse "Campo sconosciuto o duplicato: %S" key))
             (push key seen))))

(defun gdev-project--strings (values &optional paths)
  "Verifica l'elenco VALUES; con PATHS richiedi percorsi relativi."
  (unless (and (proper-list-p values)
               (cl-every (if paths (if (functionp paths) paths #'gdev-trace-relative-p) #'gdev-project--text-p) values)
               (= (length values) (length (delete-dups (copy-sequence values)))))
    (gdev-process-refuse "Elenco di testi o percorsi non valido")))

(defun gdev-project-output-p (path)
  "Ammetti un sorgente relativo o un rapporto nell'area di stato dedicata."
  (or (gdev-trace-relative-p path)
      (and (stringp path) (string-prefix-p ".gdev/assurance/reports/" path)
           (gdev-trace-relative-p (substring path (length ".gdev/assurance/reports/"))))))

(defun gdev-project-file (root path)
  "Risolvi PATH nel progetto ROOT senza attraversare collegamenti esterni."
  (unless (gdev-project-output-p path) (gdev-process-refuse "Percorso di progetto non valido: %S" path))
  (let* ((root (file-name-as-directory (file-truename root))) (file (expand-file-name path root)))
    (unless (file-in-directory-p (file-truename file) root)
      (gdev-process-refuse "Il percorso esce dal progetto: %s" path))
    file))

(defun gdev-project-validate (data)
  "Valida la struttura di DATA, ammettendo campi incompleti nelle bozze."
  (gdev-project--plist data '(:version :id :name :purpose :scope :owner :stakeholders :profile
                             :criticality :context :constraints :risks :standards :requirements
                             :procedures :snippets :artifacts :verification :validation
                             :configuration :release :maintenance :source-roots :source-files :catalogs))
  (gdev-project-catalog-validate (plist-get data :catalogs))
  (unless (and (eq 1 (plist-get data :version)) (gdev-project--id-p (plist-get data :id))
               (gdev-project--text-p (plist-get data :name))
               (memq (plist-get data :profile) gdev-process-profiles)
               (memq (plist-get data :criticality) '(normal high critical)))
    (gdev-process-refuse "Versione, identificativo, nome o profilo del progetto non validi"))
  (dolist (field gdev-project-required-fields)
    (unless (or (null (plist-get data (car field))) (stringp (plist-get data (car field))))
      (gdev-process-refuse "Il campo %s deve essere testo" (car field))))
  (dolist (key '(:stakeholders :constraints)) (gdev-project--strings (plist-get data key)))
  (gdev-project--strings (plist-get data :source-roots) t)
  (gdev-project--strings (plist-get data :source-files) t)
  (dolist (key '(:risks :standards :requirements :procedures :snippets :artifacts))
    (unless (proper-list-p (plist-get data key)) (gdev-process-refuse "Elenco %s non valido" key))
    (let (ids)
      (dolist (row (plist-get data key))
        (unless (and (plistp row) (gdev-project--id-p (plist-get row :id))
                     (not (member (plist-get row :id) ids)))
          (gdev-process-refuse "Identificativo assente o duplicato in %s" key))
        (push (plist-get row :id) ids))))
  (dolist (row (plist-get data :risks))
    (gdev-project--plist row '(:id :description :mitigation :owner))
    (unless (cl-every (lambda (key) (gdev-project--text-p (plist-get row key)))
                      '(:description :mitigation :owner)) (gdev-process-refuse "Rischio incompleto")))
  (dolist (row (plist-get data :standards))
    (gdev-project--plist row '(:id :edition :applicability :decision :reason :scope))
    (unless (and (stringp (plist-get row :edition))
                 (memq (plist-get row :applicability) '(applicable not-applicable proposed))
                 (memq (plist-get row :decision) '(proposed accepted))
                 (memq (plist-get row :scope) '(indexed full bibliographic))
                 (gdev-project--text-p (plist-get row :reason)))
      (gdev-process-refuse "Applicabilità dello standard incompleta")))
  (dolist (row (plist-get data :requirements))
    (gdev-project--plist row '(:id :version :statement :origin :rationale :category :priority
                              :criticality :owner :status :applicability :reason :acceptance
                              :method :sources :tests :depends-on :procedure :references :conflicts :constraints :assumptions))
    (unless (and (integerp (plist-get row :version)) (> (plist-get row :version) 0)
                 (memq (plist-get row :category) gdev-project-categories)
                 (memq (plist-get row :priority) '(must should could))
                 (memq (plist-get row :criticality) '(normal high critical))
                 (memq (plist-get row :status) '(draft proposed accepted))
                 (memq (plist-get row :applicability) '(applicable not-applicable proposed))
                 (or (null (plist-get row :method)) (memq (plist-get row :method) gdev-project-methods)))
      (gdev-process-refuse "Tipo o stato del requisito %s non valido" (plist-get row :id)))
    (dolist (key '(:statement :origin :rationale :owner :acceptance :reason :procedure))
      (unless (or (null (plist-get row key)) (stringp (plist-get row key)))
        (gdev-process-refuse "Campo %s del requisito non testuale" key)))
    (gdev-project--strings (plist-get row :sources) t)
    (gdev-project--strings (plist-get row :tests))
    (gdev-project--strings (plist-get row :depends-on))
    (dolist (key '(:conflicts :constraints :assumptions)) (gdev-project--strings (plist-get row key)))
    (unless (proper-list-p (plist-get row :references)) (gdev-process-refuse "Riferimenti non validi"))
    (dolist (reference (plist-get row :references))
      (when-let* ((problem (gdev-standards-check-reference reference))) (gdev-process-refuse "%s" problem))))
  (dolist (row (plist-get data :procedures))
    (gdev-project--plist row '(:id :version :title :types :requirements :steps :outputs :snippets :mode
                              :purpose :preconditions :permissions :success :failure :interruption :recovery))
    (unless (and (memq (plist-get row :mode) '(nil implementation verification))
                 (integerp (plist-get row :version)) (> (plist-get row :version) 0)
                 (gdev-project--text-p (plist-get row :title))
                 (consp (plist-get row :steps)) (proper-list-p (plist-get row :steps)))
      (gdev-process-refuse "Procedura incompleta"))
    (dolist (key '(:types :requirements :snippets)) (gdev-project--strings (plist-get row key)))
    (dolist (key '(:purpose :preconditions :permissions :success :failure :interruption :recovery))
      (when (plist-member row key)
        (unless (gdev-project--text-p (plist-get row key)) (gdev-process-refuse "Contratto di procedura incompleto: %s" key))))
    (gdev-project--strings (plist-get row :outputs) #'gdev-project-output-p)
    (let (ids)
      (dolist (step (plist-get row :steps))
        (gdev-project--plist step '(:id :plan :timeout :replay :required :outputs :inputs))
        (unless (and (gdev-project--id-p (plist-get step :id)) (not (member (plist-get step :id) ids))
                     (gdev-trace-relative-p (plist-get step :plan))
                     (integerp (plist-get step :timeout)) (< 0 (plist-get step :timeout) 86401)
                     (memq (plist-get step :replay) '(safe manual))
                     (plist-member step :required) (memq (plist-get step :required) '(t nil))
                     (or (eq (plist-get step :replay) 'safe) (plist-get step :outputs)))
          (gdev-process-refuse "Passo di procedura non valido"))
        (gdev-project--strings (plist-get step :outputs) #'gdev-project-output-p)
        (gdev-project--strings (plist-get step :inputs) t)
        (push (plist-get step :id) ids))))
  (dolist (row (plist-get data :snippets))
    (gdev-project--plist row '(:id :version :description :language :template :parameters :scope :tags :prerequisites :example :checks))
    (unless (and (integerp (plist-get row :version)) (> (plist-get row :version) 0)
                 (gdev-trace-relative-p (plist-get row :template))
                 (gdev-project--text-p (plist-get row :description))
                 (gdev-project--text-p (plist-get row :language))
                 (proper-list-p (plist-get row :parameters))) (gdev-process-refuse "Snippet non valido"))
    (let (names)
      (dolist (parameter (plist-get row :parameters))
        (gdev-project--plist parameter '(:name :required :default :reason :type))
        (unless (and (gdev-project--id-p (plist-get parameter :name))
                     (not (member (plist-get parameter :name) names))
                     (memq (plist-get parameter :required) '(t nil))
                     (memq (plist-get parameter :type) '(nil text string symbol))
                     (or (null (plist-get parameter :default)) (stringp (plist-get parameter :default)))
                     (gdev-project--text-p (plist-get parameter :reason)))
          (gdev-process-refuse "Parametro di snippet non valido"))
        (push (plist-get parameter :name) names)))
    (dolist (key '(:tags :prerequisites :checks)) (gdev-project--strings (plist-get row key)))
    (dolist (key '(:scope :example))
      (when (plist-member row key)
        (unless (gdev-project--text-p (plist-get row key)) (gdev-process-refuse "Metadato del modello incompleto: %s" key)))))
  (dolist (row (plist-get data :artifacts))
    (gdev-project--plist row '(:id :type :path :sources :procedure :required))
    (unless (and (memq (plist-get row :type) '(document report source configuration))
                 (gdev-project-output-p (plist-get row :path))
                 (memq (plist-get row :required) '(t nil))) (gdev-process-refuse "Artefatto non valido"))
    (gdev-project--strings (plist-get row :sources) t))
  (let ((requirements (make-hash-table :test #'equal))
        (procedures (make-hash-table :test #'equal))
        (snippets (make-hash-table :test #'equal))
        (adjacency (make-hash-table :test #'equal)) nodes)
    (dolist (row (plist-get data :requirements))
      (puthash (plist-get row :id) t requirements)
      (puthash (plist-get row :id) (plist-get row :depends-on) adjacency)
      (push (plist-get row :id) nodes))
    (dolist (row (plist-get data :procedures)) (puthash (plist-get row :id) t procedures))
    (dolist (row (plist-get data :snippets)) (puthash (plist-get row :id) t snippets))
    (dolist (row (plist-get data :requirements))
      (dolist (id (plist-get row :depends-on))
        (unless (and (gethash id requirements) (not (equal id (plist-get row :id))))
          (gdev-process-refuse "Dipendenza di requisito non risolta: %s" id)))
      (dolist (id (plist-get row :conflicts))
        (unless (and (gethash id requirements) (not (equal id (plist-get row :id))))
          (gdev-process-refuse "Conflitto di requisito non risolto: %s" id)))
      (when (and (plist-get row :procedure) (not (gethash (plist-get row :procedure) procedures)))
        (gdev-process-refuse "Procedura del requisito non risolta")))
    (dolist (row (plist-get data :procedures))
      (dolist (id (plist-get row :requirements))
        (unless (gethash id requirements) (gdev-process-refuse "Requisito della procedura non risolto: %s" id)))
      (dolist (id (plist-get row :snippets))
        (unless (gethash id snippets)
          (gdev-process-refuse "Snippet della procedura non risolto: %s" id))))
    (when-let* ((cycle (gdev-graph-cycle (nreverse nodes) adjacency)))
      (gdev-process-refuse "Ciclo nelle dipendenze del requisito %s" (car cycle))))
  data)

(defun gdev-project-read (root)
  "Leggi il manifesto versionato del progetto ROOT come soli dati."
  (gdev-project-validate (gdev-standards-read (gdev-project-file root gdev-project-manifest))))

(defun gdev-project-default (id name &optional profile)
  "Prepara una bozza ID NAME con PROFILE e suggerimenti riconoscibili."
  (list :version 1 :id id :name name :profile (or profile 'quality) :criticality 'normal
        :standards nil :requirements nil :procedures nil :snippets nil :artifacts nil))

(defun gdev-project-suggest (standard)
  "Proponi requisiti da STANDARD senza accettarli né verificarli."
  (let* ((taxonomy (aref (alist-get 'taxonomies (gdev-taxonomy-data standard)) 0)) suggestions)
    (seq-doseq (node (alist-get 'nodes taxonomy))
      (when (equal "requirement" (alist-get 'kind node))
        (push `((id . ,(concat "REQ-" (replace-regexp-in-string "[^A-Za-z0-9_.-]" "-" (alist-get 'id node))))
                (statement . ,(alist-get 'text node)) (status . "proposed")
                (method . "test") (reason . "Suggerimento dalla fonte selezionata; richiede adattamento al progetto.")
                (source . ,standard) (edition . ,(alist-get 'edition taxonomy))
                (locator . ,(alist-get 'locator node)) (verified . :false)) suggestions)))
    (vconcat (nreverse suggestions))))

(defun gdev-project--due-p (due stage)
  "Restituisci non nil se il campo DUE è dovuto in STAGE."
  (or (eq stage 'BASELINED) (eq stage 'APPROVED) (eq stage 'REVIEWING)
      (and (eq due 'ANALYZED) (memq stage '(ANALYZED AUTHORIZED IMPLEMENTING VERIFYING)))))

(defun gdev-project-problems (root data &optional stage)
  "Controlla completezza e riferimenti di DATA in ROOT per STAGE."
  (gdev-project-validate data)
  (let ((stage (or stage 'REVIEWING)) problems)
    (cl-labels ((missing (format-string &rest args) (push (apply #'format format-string args) problems)))
      (dolist (field gdev-project-required-fields)
        (when (and (gdev-project--due-p (nth 2 field) stage)
                   (not (gdev-project--text-p (plist-get data (car field)))))
          (missing "Compila %s" (nth 1 field))))
      (unless (plist-get data :requirements) (missing "Definisci almeno un requisito verificabile"))
      (unless (plist-get data :standards) (missing "Dichiara gli standard e il loro perimetro"))
      (dolist (catalog (plist-get data :catalogs))
        (let ((view (gdev-project-catalog-data root catalog)))
          (unless (equal "CURRENT" (alist-get 'status view))
            (missing "%s: %s" (plist-get catalog :id) (alist-get 'problem view)))))
      (dolist (path (and (memq stage '(VERIFYING REVIEWING APPROVED BASELINED)) (plist-get data :source-files)))
        (unless (file-regular-p (gdev-project-file root path)) (missing "Sorgente dichiarata assente: %s" path)))
      (dolist (path (and (memq stage '(VERIFYING REVIEWING APPROVED BASELINED)) (plist-get data :source-roots)))
        (unless (file-directory-p (gdev-project-file root path)) (missing "Cartella sorgente assente: %s" path)))
      (dolist (standard (plist-get data :standards))
        (let ((entry (gdev-standards-get (plist-get standard :id))))
          (unless (and entry (equal (plist-get entry :edizione) (plist-get standard :edition)))
            (missing "%s: edizione non verificata nel registro" (plist-get standard :id)))
          (when (or (eq (plist-get standard :applicability) 'proposed) (eq (plist-get standard :decision) 'proposed))
            (missing "%s: applicabilità proposta da esaminare" (plist-get standard :id)))
          (when (and entry (eq (plist-get standard :applicability) 'applicable) (eq (plist-get standard :scope) 'full))
            (let ((taxonomy (aref (alist-get 'taxonomies (gdev-taxonomy-data (plist-get standard :id))) 0)))
              (unless (and (equal "COMPLETE_WITHIN_SCOPE" (alist-get 'index_status taxonomy))
                           (equal "EXTRACTED_WITHIN_SCOPE" (alist-get 'requirements_status taxonomy)))
                (missing "%s: tassonomia incompleta per il perimetro richiesto" (plist-get standard :id)))))))
      (dolist (row (plist-get data :requirements))
        (let ((id (plist-get row :id)))
          (if (eq (plist-get row :applicability) 'not-applicable)
              (unless (and (eq (plist-get row :status) 'accepted) (gdev-project--text-p (plist-get row :reason)))
                (missing "%s: non applicabilità da motivare e accettare" id))
            (dolist (key '(:statement :origin :rationale :owner :acceptance :method :procedure))
              (unless (plist-get row key) (missing "%s: compila %s" id key))
              (when (and (stringp (plist-get row key)) (not (gdev-project--text-p (plist-get row key))))
                (missing "%s: compila %s" id key)))
            (unless (and (eq (plist-get row :status) 'accepted) (eq (plist-get row :applicability) 'applicable))
              (missing "%s: requisito proposto da esaminare" id))
            (unless (plist-get row :sources) (missing "%s: collega l'implementazione" id))
            (unless (plist-get row :tests) (missing "%s: collega la verifica" id))
            (dolist (conflict (plist-get row :conflicts))
              (when (seq-find (lambda (other) (and (equal conflict (plist-get other :id))
                                                  (eq 'applicable (plist-get other :applicability))))
                              (plist-get data :requirements))
                (missing "%s: risolvi il conflitto con %s" id conflict)))
            (dolist (path (and (memq stage '(VERIFYING REVIEWING APPROVED BASELINED)) (plist-get row :sources)))
              (unless (file-regular-p (gdev-project-file root path)) (missing "%s: sorgente assente %s" id path))))))
      (dolist (procedure (plist-get data :procedures))
        (dolist (step (plist-get procedure :steps))
          (unless (file-regular-p (gdev-project-file root (plist-get step :plan)))
            (missing "%s: piano assente %s" (plist-get procedure :id) (plist-get step :plan)))))
      (dolist (snippet (plist-get data :snippets))
        (unless (file-regular-p (gdev-project-file root (plist-get snippet :template)))
          (missing "%s: modello assente" (plist-get snippet :id)))))
    (nreverse problems)))

(defun gdev-project-file-fingerprint (root path)
  "Fissa contenuto, tipo e oggetti Git del file PATH interno a ROOT."
  (let* ((root (file-name-as-directory (file-truename root)))
         (file (gdev-project-file root path)) (link (file-symlink-p file))
         (exists (file-regular-p file))
         (mode (and exists (cond (link "120000") ((/= 0 (logand #o100 (file-modes file))) "100755") (t "100644"))))
         content object)
    (when exists
      (setq content (with-temp-buffer (set-buffer-multibyte nil) (insert-file-contents-literally file) (buffer-string)))
      (let ((bytes (if link (encode-coding-string link (or file-name-coding-system 'utf-8-unix)) content)))
        (setq object (concat (encode-coding-string (format "blob %d\0" (length bytes)) 'us-ascii) bytes))))
    `((path . ,path) (sha256 . ,(if content (secure-hash 'sha256 content) :null))
      (mode . ,(or mode :null))
      (git_sha1 . ,(if object (secure-hash 'sha1 object) :null))
      (git_sha256 . ,(if object (secure-hash 'sha256 object) :null))
      (target . ,(if (and exists link)
                     (gdev-project-file-fingerprint root
                      (file-relative-name (expand-file-name link (file-name-directory file)) root)) :null)))))

(defun gdev-project-inputs (root data)
  "Fissa manifesto, sorgenti, piani e input espliciti di DATA in ROOT."
  (let ((chunks (list (cons gdev-project-manifest (plist-get data :source-files)))))
    (dolist (catalog (plist-get data :catalogs))
      (push (cons (plist-get catalog :path) (gdev-project-catalog-paths root catalog)) chunks))
    (dolist (row (plist-get data :requirements)) (push (plist-get row :sources) chunks))
    (dolist (row (plist-get data :procedures))
      (dolist (step (plist-get row :steps))
        (push (list (plist-get step :plan)) chunks)
        (push (plist-get step :inputs) chunks)))
    (dolist (row (plist-get data :snippets)) (push (list (plist-get row :template)) chunks))
    (dolist (row (plist-get data :artifacts)) (push (plist-get row :sources) chunks))
    (vconcat (mapcar (lambda (path) (gdev-project-file-fingerprint root path))
                    (sort (delete-dups (apply #'append (nconc chunks (list nil)))) #'string<)))))

(defun gdev-project-output-paths (data)
  "Elenca le uscite dichiarate da DATA, separate dalle sorgenti."
  (let ((chunks (list (mapcar (lambda (row) (plist-get row :path)) (plist-get data :artifacts)))))
    (dolist (procedure (plist-get data :procedures))
      (push (plist-get procedure :outputs) chunks)
      (dolist (step (plist-get procedure :steps)) (push (plist-get step :outputs) chunks)))
    (apply #'append (nconc (nreverse chunks) (list nil)))))

(defun gdev-project-source-selector (data)
  "Prepara una volta il predicato delle sorgenti dell'istantanea DATA.
Le uscite sono indicizzate con costo atteso O(K) e consultazione O(1).
Il predicato resta locale alla lettura: una nuova istantanea ne crea uno nuovo."
  (let ((roots (mapcar (lambda (root) (concat root "/")) (plist-get data :source-roots)))
        (outputs (make-hash-table :test #'equal)))
    (dolist (path (gdev-project-output-paths data)) (puthash path t outputs))
    (lambda (path)
      (and (seq-some (lambda (root) (string-prefix-p root path)) roots)
           (not (or (member (file-name-extension path) '("elc" "eln" "pyc"))
                    (member "__pycache__" (split-string path "/"))
                    (string-prefix-p ".gdev-assurance/receipts/" path)
                    (gethash path outputs)))))))

(defun gdev-project-source-path-p (path data)
  "Indica se PATH appartiene alle cartelle sorgenti di DATA."
  (funcall (gdev-project-source-selector data) path))

(defun gdev-project-source-inventory (root data)
  "Fissa i file sorgenti delle cartelle dichiarate da DATA in ROOT.
Bytecode, uscite e ricevute non entrano nel contesto delle sorgenti."
  (let ((root (file-name-as-directory (file-truename root))) chunks
        (source-p (gdev-project-source-selector data)))
    (dolist (path (plist-get data :source-roots))
      (let ((directory (gdev-project-file root path)))
        (when (file-directory-p directory)
          (push (directory-files-recursively directory ".") chunks))))
    (vconcat (mapcar (lambda (file) (gdev-project-file-fingerprint root (file-relative-name file root)))
                     (sort (seq-filter (lambda (file) (funcall source-p (file-relative-name file root)))
                                       (delete-dups (apply #'append chunks))) #'string<)))))

(defun gdev-project-json (data)
  "Converti i dati di progetto DATA in valori JSON senza valutazione."
  (cond ((null data) :null) ((eq data t) t) ((keywordp data) (symbol-name data))
        ((symbolp data) (symbol-name data))
        ((and (consp data) (keywordp (car data)))
         (cl-loop for (key value) on data by #'cddr
                  collect (cons (intern (replace-regexp-in-string "-" "_" (substring (symbol-name key) 1)))
                                (cond ((and (null value)
                                            (memq key '(:standards :requirements :procedures :snippets :artifacts :stakeholders
                                                        :constraints :risks :sources :tests :depends-on :references :conflicts
                                                        :assumptions :types :steps :outputs :inputs :parameters :tags
                                                        :prerequisites :checks :revisions :source-roots :source-files))) [])
                                      ((and (eq key :required) (null value)) :false)
                                      (t (gdev-project-json value))))))
        ((consp data) (vconcat (mapcar #'gdev-project-json data))) (t data)))

(defun gdev-project-data (root &optional stage)
  "Leggi il progetto ROOT e le mancanze dovute in STAGE."
  (if (not (file-exists-p (expand-file-name gdev-project-manifest root)))
      '((schema_version . 1) (project . :null) (status . "MISSING") (problems . ["Crea il manifesto del progetto."]))
    (gdev-standards-with-cache
     (lambda ()
       (let* ((data (gdev-project-read root)) (problems (gdev-project-problems root data stage)))
         `((schema_version . 1) (project . ,(gdev-project-json data))
           (status . ,(if problems "INCOMPLETE" "DEFINED")) (problems . ,(vconcat problems))
           (inputs . ,(gdev-project-inputs root data))
           (catalogs . ,(vconcat (mapcar (lambda (row) (gdev-project-catalog-data root row)) (plist-get data :catalogs))))
           (fields . ,(vconcat (mapcar (lambda (field)
                                        `((key . ,(substring (symbol-name (car field)) 1))
                                          (title . ,(nth 1 field)) (due_from . ,(symbol-name (nth 2 field)))
                                          (required . t) (value . ,(or (plist-get data (car field)) :null))))
                                      gdev-project-required-fields)))
           (human_approval . "NOT_VERIFIED") (certification . :false)))))))

(provide 'gdev-project)
;;; gdev-project.el ends here
