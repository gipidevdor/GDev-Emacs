(require 'ert)

(ert-deftest gdev-test-sidebar-applies-a-scan-that-finishes-during-creation ()
  "Una scansione terminata prima del ritorno di `make-process' aggiorna l'albero."
  (skip-unless (executable-find "perl"))
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-sidebar-fast-" t)))
         (default-directory root)
         (file (expand-file-name "prima" root))
         (new (expand-file-name "dopo" root))
         (make-process-function (symbol-function 'make-process))
         output errors child)
    (unwind-protect
        (with-temp-buffer
          (gdev-sidebar-mode)
          (setq gdev-sidebar--root root)
          (with-temp-file file)
          (should (equal (gdev-sidebar--children root) (list nil (list file))))
          (delete-file file)
          (with-temp-file new)
          (cl-letf (((symbol-function 'make-process)
                     (lambda (&rest arguments)
                       (setq output (plist-get arguments :buffer)
                             errors (plist-get arguments :stderr)
                             child (apply make-process-function arguments))
                       ;; Un'attesa sincrona lascia lo stdout nella pipe,
                       ;; anche quando il figlio risulta già terminato.
                       (let ((deadline (+ (float-time) 5)))
                         (while (and (process-live-p child) (< (float-time) deadline))
                           (call-process "/bin/sleep" nil nil nil "0.02")))
                       (should (eq (process-status child) 'exit))
                       (should (zerop (process-exit-status child)))
                       child)))
            (gdev-sidebar--refresh-directories))
          (should-not gdev-sidebar--directory-process)
          (should (equal (gdev-sidebar--children root) (list nil (list new))))
          (should-not (buffer-live-p output))
          (should-not (buffer-live-p errors)))
      (when (process-live-p child) (delete-process child))
      (when (buffer-live-p output) (kill-buffer output))
      (when (buffer-live-p errors) (kill-buffer errors))
      (delete-directory root t))))

(ert-deftest gdev-test-sidebar-find-selects-a-visible-row ()
  "La ricerca si limita alle righe mostrate e lascia il documento intatto."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (save-window-excursion
    (let ((editor (window-buffer))
          (sidebar (generate-new-buffer " *esplora-ricerca*")))
      (unwind-protect
          (let ((window (display-buffer-in-side-window sidebar '((side . left)))))
            (with-selected-window window
              (gdev-sidebar-mode)
              (setq gdev-sidebar--root "/prova/")
              (puthash "/prova/" '(("/prova/chiusa") ("/prova/leggi.txt" "/prova/nota.txt"))
                       gdev-sidebar--directory-cache)
              (puthash "/prova/chiusa" '(nil ("/prova/chiusa/privata.txt"))
                       gdev-sidebar--directory-cache)
              (gdev-sidebar--render "/prova/leggi.txt")
              (should (eq (key-binding (kbd "M-s-f")) #'gdev-sidebar-find-entry))
              (cl-letf (((symbol-function 'gdev-sidebar--directory-entries)
                         (lambda (_) (ert-fail "La ricerca ha letto il disco")))
                        ((symbol-function 'completing-read)
                         (lambda (_prompt choices &rest _)
                           (should (assoc "chiusa" choices))
                           (should-not (assoc "chiusa/privata.txt" choices))
                           "nota.txt")))
                (call-interactively (key-binding (kbd "/"))))
              (should (equal (gdev-sidebar--path-at-point) "/prova/nota.txt"))
              (should (eq (selected-window) window)))
            (should (eq (window-buffer) editor)))
        (kill-buffer sidebar)))))

(ert-deftest gdev-test-sidebar-find-preserves-selection-on-cancel-or-refresh ()
  "Annullare o scegliere una voce rimossa lascia la selezione corrente."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (with-temp-buffer
    (gdev-sidebar-mode)
    (setq gdev-sidebar--root "/prova/")
    (puthash "/prova/" '(nil ("/prova/resta" "/prova/scompare")) gdev-sidebar--directory-cache)
    (gdev-sidebar--render "/prova/resta")
    (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil))))
      (should (eq (condition-case nil (gdev-sidebar-find-entry) (quit 'annullato)) 'annullato)))
    (should (equal (gdev-sidebar--path-at-point) "/prova/resta"))
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _)
                 (puthash "/prova/" '(nil ("/prova/resta")) gdev-sidebar--directory-cache)
                 (gdev-sidebar--render)
                 "scompare")))
      (should-error (gdev-sidebar-find-entry) :type 'user-error))
    (should (equal (gdev-sidebar--path-at-point) "/prova/resta"))))

(ert-deftest gdev-test-sidebar-find-distinguishes-identical-names-in-different-roots ()
  "La ricerca distingue file omonimi e abbrevia la cartella personale locale."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (with-temp-buffer
    (gdev-sidebar-mode)
    (let* ((first (expand-file-name "~/primo/" "/"))
           (second "/secondo/")
           (file (concat first "note.txt")))
      (setq gdev-sidebar--root first
            gdev-sidebar--roots (list first second))
      (dolist (root gdev-sidebar--roots)
        (let ((directory (directory-file-name root)))
          (puthash directory t gdev-sidebar--expanded)
          (puthash directory (list nil (list (concat root "note.txt"))) gdev-sidebar--directory-cache)))
      (gdev-sidebar--render)
      (let ((default-directory "/ssh:remoto.invalid:/"))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt choices &rest _)
                     (should (equal (cdr (assoc "~/primo/note.txt" choices)) file))
                     (should (assoc "/secondo/note.txt" choices))
                     "~/primo/note.txt")))
          (gdev-sidebar-find-entry)))
      (should (equal (gdev-sidebar--path-at-point) file)))))

(ert-deftest gdev-test-sidebar-collapse-preserves-the-selected-branch ()
  "La prima compressione lascia aperte le radici, la seconda le chiude."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (with-temp-buffer
    (gdev-sidebar-mode)
    (setq gdev-sidebar--root "/prima/"
          gdev-sidebar--roots '("/prima/" "/seconda/"))
    (puthash "/prima" '(nil nil) gdev-sidebar--directory-cache)
    (puthash "/seconda" '(("/seconda/src") nil) gdev-sidebar--directory-cache)
    (puthash "/seconda/src" '(nil ("/seconda/src/main.c")) gdev-sidebar--directory-cache)
    (dolist (path '("/prima" "/seconda" "/seconda/src"))
      (puthash path t gdev-sidebar--expanded))
    (gdev-sidebar--render "/seconda/src/main.c")
    (gdev-sidebar-collapse-folders)
    (should (equal (gdev-sidebar--path-at-point) "/seconda/src"))
    (should (gethash "/prima" gdev-sidebar--expanded))
    (should (gethash "/seconda" gdev-sidebar--expanded))
    (should-not (gdev-sidebar--path-position "/seconda/src/main.c"))
    (gdev-sidebar-collapse-folders)
    (should (equal (gdev-sidebar--path-at-point) "/seconda"))
    (should (hash-table-empty-p gdev-sidebar--expanded))
    (gdev-sidebar-collapse-folders)
    (should (equal (gdev-sidebar--path-at-point) "/seconda"))))

(ert-deftest gdev-test-sidebar-copy-relative-path-follows-the-context-row ()
  "Il menu copia la voce cliccata, rispetto alla sua radice nello spazio."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (save-window-excursion
    (let ((sidebar (generate-new-buffer " *esplora-percorso*"))
          copied)
      (unwind-protect
          (let ((window (display-buffer-in-side-window sidebar '((side . left)))))
            (with-selected-window window
              (gdev-sidebar-mode)
              (setq gdev-sidebar--root "/lavoro/"
                    gdev-sidebar--roots '("/lavoro/" "/lavoro/secondo/"))
              (puthash "/lavoro" '(nil ("/lavoro/main.c")) gdev-sidebar--directory-cache)
              (puthash "/lavoro/secondo" '(nil ("/lavoro/secondo/nota è.txt")) gdev-sidebar--directory-cache)
              (dolist (root '("/lavoro" "/lavoro/secondo"))
                (puthash root t gdev-sidebar--expanded))
              (gdev-sidebar--render "/lavoro/main.c")
              (let* ((position (gdev-sidebar--path-position "/lavoro/secondo/nota è.txt"))
                     (event (list 'mouse-3 (list window position '(0 . 0) 0)))
                     (menu (gdev-context--map (lambda (&rest _) nil) event))
                     (action (lookup-key menu [gdev-sidebar-copy-relative-path])))
                (should (equal (gdev-sidebar--path-at-point) "/lavoro/main.c"))
                (should (commandp action))
                (cl-letf (((symbol-function 'kill-new) (lambda (text &rest _) (setq copied text))))
                  (call-interactively action))
                (should (equal copied "nota è.txt"))
                (should (equal (gdev-sidebar--path-at-point) "/lavoro/secondo/nota è.txt")))))
        (kill-buffer sidebar)))))

(ert-deftest gdev-test-sidebar-modified-click-selects-without-opening ()
  "Comando seleziona singole voci e Maiusc estende la scelta nell’albero."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (save-window-excursion
    (let ((sidebar (generate-new-buffer " *esplora-selezione*"))
          (files '("/prova/alfa" "/prova/beta" "/prova/gamma" "/prova/zeta"))
          opened)
      (unwind-protect
          (let ((window (display-buffer-in-side-window sidebar '((side . left)))))
            (with-selected-window window
              (gdev-sidebar-mode)
              (setq gdev-sidebar--root "/prova/")
              (puthash "/prova/" (list nil files) gdev-sidebar--directory-cache)
              (gdev-sidebar--render (car files))
              (cl-letf (((symbol-function 'gdev-sidebar--activate)
                         (lambda (button &optional preview)
                           (setq opened (cons (button-get button 'gdev-sidebar-path) preview)))))
                (dolist (event-kind '(s-mouse-1 S-mouse-1))
                  (should (eq (key-binding (vector event-kind)) #'gdev-sidebar-click)))
                (let ((gamma (gdev-sidebar--path-position (nth 2 files)))
                      (zeta (gdev-sidebar--path-position (nth 3 files))))
                  (gdev-sidebar-click (list 's-mouse-1 (list window gamma '(0 . 0) 0)))
                  (should (equal (gdev-sidebar--selection-at-point) (list (car files) (nth 2 files))))
                  (should (eq hl-line-face 'gdev-sidebar-focus-row))
                  (should-not opened)
                  (gdev-sidebar-click (list 'S-mouse-1 (list window zeta '(0 . 0) 0)))
                  (should (equal (gdev-sidebar--selection-at-point) (nthcdr 2 files)))
                  (should-not opened)
                  (gdev-sidebar-click (list 'mouse-1 (list window gamma '(0 . 0) 0)))
                  (should (equal opened (cons (nth 2 files) t)))
                  (should (hash-table-empty-p gdev-sidebar--selection))
                  (should (eq hl-line-face 'gdev-sidebar-selection))))))
        (kill-buffer sidebar)))))

(ert-deftest gdev-test-sidebar-keyboard-selection-survives-redraw ()
  "Tastiera e ridisegno conservano i percorsi ancora visibili, anche se si spostano."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (with-temp-buffer
    (gdev-sidebar-mode)
    (let* ((folder "/prova/ramo")
           (first (concat folder "/alpha"))
           (second (concat folder "/beta"))
           (third (concat folder "/gamma"))
           (remaining "/prova/zeta"))
      (setq gdev-sidebar--root "/prova/")
      (puthash "/prova/" (list (list folder) (list remaining)) gdev-sidebar--directory-cache)
      (puthash folder (list nil (list first second third)) gdev-sidebar--directory-cache)
      (puthash folder t gdev-sidebar--expanded)
      (gdev-sidebar--render first)
      (dotimes (_ 2) (call-interactively (key-binding (kbd "S-<down>"))))
      (should (equal (gdev-sidebar--selection-at-point) (list first second third)))
      (call-interactively (key-binding (kbd "S-<up>")))
      (should (equal (gdev-sidebar--selection-at-point) (list first second)))
      (let* ((overlay (gethash second gdev-sidebar--selection))
             (previous (overlay-start overlay)))
        (puthash folder (list nil (list second third)) gdev-sidebar--directory-cache)
        (gdev-sidebar--render)
        (should-not (gethash first gdev-sidebar--selection))
        (should (eq (gethash second gdev-sidebar--selection) overlay))
        (should (< (overlay-start overlay) previous))
        (should (= (overlay-end overlay) (1+ (line-end-position))))
        (should-not gdev-sidebar--selection-anchor))
      (call-interactively (key-binding (kbd "s-a")))
      (should (equal (gdev-sidebar--selection-at-point) (list folder second third remaining)))
      (gdev-sidebar-collapse-folders)
      (should (equal (gdev-sidebar--selection-at-point) (list folder remaining)))
      (call-interactively (key-binding (kbd "<escape>")))
      (should (equal (gdev-sidebar--selection-at-point) (list folder))))))

(ert-deftest gdev-test-sidebar-selection-opens-copies-and-compares ()
  "Le azioni di gruppo usano l’ordine visibile e convalidano i file prima di aprirli."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (with-temp-buffer
    (gdev-sidebar-mode)
    (let* ((first "/lavoro/alpha")
           (second "/lavoro/beta")
           (folder "/lavoro/cartella")
           opened copied compared)
      (setq gdev-sidebar--root "/lavoro/")
      (puthash "/lavoro/" (list (list folder) (list first second)) gdev-sidebar--directory-cache)
      (gdev-sidebar--render second)
      (call-interactively (key-binding (kbd "m")))
      (goto-char (gdev-sidebar--path-position first))
      (call-interactively (key-binding (kbd "m")))
      (cl-letf (((symbol-function 'kill-new) (lambda (text &rest _) (setq copied text)))
                ((symbol-function 'gdev-open-file) (lambda (file &optional _) (push file opened)))
                ((symbol-function 'gdev-compare-files) (lambda (&rest paths) (setq compared paths)))
                ((symbol-function 'file-regular-p) (lambda (path) (equal first path)))
                ((symbol-function 'file-readable-p) #'always))
        (call-interactively (key-binding (kbd "s-c")))
        (should (equal copied (concat first "\n" second)))
        (gdev-sidebar-copy-relative-path)
        (should (equal copied "alpha\nbeta"))
        (gdev-sidebar-compare-selection)
        (should (equal compared (list first second)))
        (should-error (gdev-sidebar-open) :type 'user-error)
        (should-not opened)
        (cl-letf (((symbol-function 'file-regular-p) #'always))
          (call-interactively (key-binding (kbd "RET"))))
        (should (equal (nreverse opened) (list first second)))
        (goto-char (gdev-sidebar--path-position folder))
        (should-not (gdev-sidebar-compare-selection-p))
        (gdev-sidebar-copy-paths)
        (should (equal copied folder))))))

(ert-deftest gdev-test-sidebar-closed-workspace-releases-its-explorer ()
  "Uno spazio chiuso rilascia Esplora file, salvo che un altro spazio lo mostri.
Riprendere la sessione o riaprire lo spazio non accumula copie del buffer."
  (require 'gdev-commands)
  (require 'gdev-workspaces)
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (gdev-test--with-layout
    (let* ((root (file-name-as-directory (file-truename (make-temp-file "gdev-esplora-" t))))
           (gdev-state-directory root)
           (gdev-workspaces--session-active nil)
           (alpha (expand-file-name "alfa/" root))
           (beta (expand-file-name "beta/" root))
           (tab-bar-closed-tabs nil)
           (tab-bar-tab-pre-close-functions '(gdev-sidebar--close-tab))
           (tab-bar-post-undo-close-tab-functions '(gdev-sidebar--reopen-tab))
           (explorer-p (lambda (buffer)
                         (with-current-buffer buffer (derived-mode-p 'gdev-sidebar-mode))))
           (before (seq-filter explorer-p (buffer-list)))
           (explorers (lambda () (seq-difference (seq-filter explorer-p (buffer-list)) before)))
           (shown (lambda () (window-buffer (window-with-parameter 'gdev-sidebar t))))
           (already-advised (advice-member-p #'gdev-workspaces--remember-layout 'tab-bar--tab))
           first second)
      (unwind-protect
          (progn
            (advice-add 'tab-bar--tab :around #'gdev-workspaces--remember-layout)
            (make-directory alpha t)
            (make-directory beta t)
            (tab-bar-rename-tab "Alfa")
            (gdev-sidebar-show alpha t)
            (setq first (funcall shown))
            (tab-bar-new-tab)
            (tab-bar-rename-tab "Beta")
            (gdev-sidebar-show beta t)
            (setq second (funcall shown))
            (should-not (eq first second))
            (gdev-workspaces-save)
            ;; Chiudere lo spazio libera il suo buffer, non quello degli altri.
            (tab-bar-close-tab)
            (should (buffer-live-p first))
            (should-not (buffer-live-p second))
            (should (equal (funcall explorers) (list first)))
            ;; Ogni ripresa della sessione lascia un Esplora file per spazio.
            (dotimes (_ 2)
              (gdev-workspaces-restore)
              (should (= (length (tab-bar-tabs)) 2))
              (should (= (length (funcall explorers)) 2))
              (tab-bar-close-tab 2)
              (should (equal (funcall explorers) (list first))))
            ;; Lo spazio riaperto ricostruisce Esplora file al posto del segnaposto.
            (tab-bar-undo-close-tab)
            (should (eq (gdev-workspace-state-get 'gdev-layout-explorer-buffer) (funcall shown)))
            (should (funcall explorer-p (funcall shown)))
            (should (equal (buffer-local-value 'gdev-sidebar--root (funcall shown)) beta))
            (should-not (seq-some (lambda (buffer) (string-prefix-p " *Old buffer " (buffer-name buffer)))
                                  (buffer-list)))
            (tab-bar-close-tab)
            ;; Una copia mostra lo stesso buffer: resta finché uno spazio lo usa.
            (tab-bar-duplicate-tab)
            (should (eq (funcall shown) first))
            (tab-bar-close-tab)
            (should (buffer-live-p first))
            (tab-bar-duplicate-tab)
            (tab-bar-select-tab 1)
            (tab-bar-close-tab)
            (should (buffer-live-p first))
            (should (eq (funcall shown) first))
            ;; Chiudere la finestra rilascia gli Esplora file dei suoi spazi.
            (gdev-sidebar--close-frame (selected-frame))
            (should-not (funcall explorers)))
        (unless already-advised
          (advice-remove 'tab-bar--tab #'gdev-workspaces--remember-layout))
        (dolist (buffer (funcall explorers)) (kill-buffer buffer))
        (delete-directory root t)))))

