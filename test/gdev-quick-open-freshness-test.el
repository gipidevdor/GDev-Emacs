(require 'ert)
(require 'gdev-commands)

(defun gdev-test--quick-open-wait (ready)
  "Attendi che READY diventi vero mentre Emacs gestisce processi e timer."
  (let ((deadline (+ (float-time) 15)))
    (while (and (not (funcall ready)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (funcall ready))))

(ert-deftest gdev-test-quick-open-scan-reuses-unchanged-file-list ()
  "Una scansione invariata restituisce solo l'impronta e riusa l'elenco aperto."
  (require 'ucs-normalize)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-quick-fingerprint-" t)))
         (project (cons 'transient root))
         (first "nome con \"virgolette\" e accento.à")
         (second "nome su\ndue righe.txt")
         (parse (symbol-function 'gdev-quick-open--scan-response))
         children bytes)
    (unwind-protect
        (cl-letf (((symbol-function 'gdev-quick-open--scan-response)
                   (lambda (output snapshot)
                     (setq bytes (with-current-buffer output (buffer-size)))
                     (funcall parse output snapshot))))
          (cl-labels ((scan (snapshot)
                        (let (response)
                          (push (gdev-quick-open--scan project (lambda (&rest arguments)
                                                               (setq response arguments))
                                                       nil snapshot)
                                children)
                          (gdev-test--quick-open-wait (lambda () response))
                          response)))
            (dolist (name (list first second))
              (with-temp-file (expand-file-name name root)))
            (pcase-let* ((`(,files t ,fingerprint) (scan (cons nil nil)))
                         (snapshot (cons fingerprint files))
                         (initial-bytes bytes)
                         (`(,unchanged t ,same-fingerprint) (scan snapshot)))
              (should (equal (sort (mapcar #'ucs-normalize-NFC-string files) #'string-lessp)
                             (list first second)))
              (should (stringp fingerprint))
              (should (eq unchanged files))
              (should (equal same-fingerprint fingerprint))
              (should (<= bytes (+ 3 (length fingerprint))))
              (should (< bytes initial-bytes))
              (delete-file (expand-file-name first root))
              (rename-file (expand-file-name second root) (expand-file-name "nuovo.txt" root))
              (pcase-let ((`(,changed t ,new-fingerprint) (scan snapshot)))
                (should (equal changed '("nuovo.txt")))
                (should (not (equal new-fingerprint fingerprint)))
                (delete-file (expand-file-name "nuovo.txt" root))
                (pcase-let ((`(,empty t ,empty-fingerprint) (scan (cons new-fingerprint changed))))
                  (should-not empty)
                  (should (stringp empty-fingerprint))
                  (should (not (equal empty-fingerprint new-fingerprint))))))))
      (dolist (process children)
        (when (process-live-p process) (delete-process process)))
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-index-budget-uses-path-bytes ()
  "La cache tiene gli indici più recenti entro il proprio budget stimato."
  (let ((gdev-quick-open--recent-project-files nil)
        (gdev-quick-open--cache-budget 750)
        (first '("un.el"))
        (second '("due.el")))
    (gdev-quick-open--remember-files 'uno "impronta 1" first)
    (gdev-quick-open--remember-files 'due "impronta 2" second)
    (let ((entry (cdr (assq 'uno gdev-quick-open--recent-project-files))))
      (should (eq (gdev-quick-open--index-files entry) first))
      (gdev-quick-open--remember-files 'uno "impronta 1" (copy-sequence first))
      (should (eq (cdar gdev-quick-open--recent-project-files) entry)))
    (gdev-quick-open--remember-files 'tre "impronta 3" '("sorgenti/è下.el"))
    (should (equal (mapcar #'car gdev-quick-open--recent-project-files) '(tre uno)))
    (gdev-quick-open--remember-files 'tre "impronta 4" (list (make-string 200 ?下)))
    (should (equal (mapcar #'car gdev-quick-open--recent-project-files) '(uno)))))

(ert-deftest gdev-test-quick-open-reopening-uses-file-list-and-fingerprint ()
  "La seconda apertura mostra subito i nomi e invia al processo l'impronta."
  (let* ((root (file-name-as-directory (make-temp-file "gdev-quick-reopen-" t)))
         (default-directory root)
         (editor (selected-window))
         (gdev-quick-open--recent-project-files nil)
         (real-scan (symbol-function 'gdev-quick-open--scan))
         (project (cons 'transient root))
         (file "sorgente.el")
         observed immediately)
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name file root))
          (cl-letf (((symbol-function 'gdev-layout-editor) (lambda (&rest _) editor))
                    ((symbol-function 'gdev-workspace-state-get) #'ignore)
                    ((symbol-function 'gdev-workspace-roots) #'ignore)
                    ((symbol-function 'gdev-workspace-directory) (lambda (&rest _) root))
                    ((symbol-function 'gdev-module-p) #'ignore)
                    ((symbol-function 'project-current) (lambda (&rest _) project))
                    ((symbol-function 'active-minibuffer-window) (lambda () editor))
                    ((symbol-function 'minibuffer-contents-no-properties) (lambda () ""))
                    ((symbol-function 'gdev-quick-open--scan)
                     (lambda (backend notify directory snapshot)
                       (push snapshot observed)
                       (funcall real-scan backend notify directory snapshot)))
                    ((symbol-function 'gdev-quick-open--read)
                     (lambda (_initial table &rest _)
                       (let ((noninteractive nil))
                         (push (test-completion file table) immediately)
                         (gdev-test--quick-open-wait
                          (lambda () (test-completion file table))))
                       "")))
            (gdev-quick-open)
            (gdev-quick-open))
          (should (equal immediately '(t nil)))
          (should-not (car (cadr observed)))
          (should (stringp (caar observed)))
          (should (equal (cdar observed) (list file))))
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-fuzzy-filename-matching ()
  "La ricerca per abbreviazione si applica soltanto ai file della tavolozza."
  (let* ((root (file-name-as-directory (make-temp-file "gdev-fuzzy-" t)))
         (default-directory root)
         (editor (selected-window))
         (completion-styles '(basic))
         (completion-category-overrides nil))
    (unwind-protect
        (progn
          (dolist (file '("text_parser.txt" "test_examples_parser.txt" "other.txt"))
            (with-temp-file file))
          (cl-letf (((symbol-function 'gdev-layout-editor) (lambda (&rest _) editor))
                    ((symbol-function 'gdev-workspace-state-get) #'ignore)
                    ((symbol-function 'gdev-workspace-roots) #'ignore)
                    ((symbol-function 'gdev-workspace-directory) #'ignore)
                    ((symbol-function 'gdev-module-p) #'ignore)
                    ((symbol-function 'project-current) (lambda (&rest _) (cons 'transient root)))
                    ((symbol-function 'gdev-quick-open--read)
                     (lambda (_initial table &rest _)
                       (should (eq (completion-metadata-get (completion-metadata "txp" table nil) 'category)
                                   'gdev-quick-open-file))
                       (should (eq (completion-metadata-get (completion-metadata ">find" table nil) 'category)
                                   'command))
                       (with-temp-buffer
                         (insert "txp")
                         (let* ((minibuffer-completion-table table)
                                (minibuffer-completion-predicate nil)
                                (matches (completion-all-sorted-completions (point-min) (point-max))))
                           (should (equal (car matches) "text_parser.txt"))
                           (should (equal (cadr matches) "test_examples_parser.txt"))
                           (should-not (consp (cddr matches)))))
                       "")))
            (gdev-quick-open)))
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-file-rows-preserve-matches-and-paths ()
  "I nomi precedono la cartella e conservano percorso e corrispondenze."
  (require 'gdev-ui)
  (cl-letf (((symbol-function 'gdev-ui-string-pixel-width) #'string-width))
    (let* ((filename (propertize "ricerca.org" 'face 'completions-common-part))
           (first (concat "distribuzione/guide/macos/" filename))
           (second (concat "progetto/pagine/macos/" filename))
           (a (car (gdev-quick-open--file-row first 29)))
           (b (car (gdev-quick-open--file-row second 29)))
           (label (get-text-property 0 'display a)))
      (should (equal (substring-no-properties a) (substring-no-properties first)))
      (should (equal label "ricerca.org  …/guide/macos"))
      (should (equal (get-text-property 0 'display b) "ricerca.org  …/pagine/macos"))
      (should (memq 'completions-common-part (get-text-property 0 'face label)))
      (should (equal (get-text-property 0 'help-echo label) (substring-no-properties first))))
    (let* ((path "sottocartella/nome-lungo-δ-con-accento.org")
           (label (get-text-property 0 'display (car (gdev-quick-open--file-row path 12)))))
      (should (<= (string-width label) 12))
      (should (string-search "…" label))
      (should (equal (get-text-property 0 'help-echo label) path)))))

(ert-deftest gdev-test-quick-open-visits-an-unsaved-file ()
  "Il percorso di una bozza aperta si può confermare con un suffisso di riga o testo."
  (let* ((root (file-name-as-directory (make-temp-file "gdev-quick-draft-" t)))
         (default-directory root)
         (editor (selected-window))
         (document (window-buffer editor))
         (draft (find-file-noselect "bozza:3")))
    (unwind-protect
        (save-window-excursion
          (with-current-buffer draft (insert "prima\nseconda\nterza"))
          (cl-letf (((symbol-function 'gdev-layout-editor) (lambda (&rest _) editor)))
            (gdev-quick-open--visit "bozza:3:2" editor document #'ignore #'ignore)
            (should (eq (window-buffer editor) draft))
            (should (= (line-number-at-pos) 2))
            (gdev-quick-open--visit "bozza:3#terza" editor document #'ignore #'ignore)
            (should (looking-at "terza"))))
      (with-current-buffer draft (set-buffer-modified-p nil))
      (kill-buffer draft)
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-confirms-a-preview-at-a-location ()
  "Un percorso con testo o simbolo fissa l'anteprima dopo aver trovato la destinazione."
  (require 'gdev-editor-tabs)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-quick-confirm-" t)))
         (default-directory root)
         (names '("testo.el" "simbolo.el" "successivo.el"))
         (files (mapcar (lambda (name) (expand-file-name name root)) names)))
    (unwind-protect
        (gdev-test--with-layout
          (dolist (file files)
            (with-temp-file file
              (insert ";; Cerca questa parola\n\n(defun gdev-quick-location () nil)\n")))
          (let ((editor (selected-window))
                choice)
            (cl-letf (((symbol-function 'gdev-workspace-directory) (lambda (&rest _) root))
                      ((symbol-function 'gdev-module-p) #'ignore)
                      ((symbol-function 'gdev-quick-open--read) (lambda (&rest _) choice)))
              (dolist (entry '(("testo.el" . "#questa parola")
                               ("simbolo.el" . "@gdev-quick-location")))
                (let* ((file (expand-file-name (car entry) root))
                       (preview (gdev-editor-open-preview file editor))
                       (point (window-point editor)))
                  (setq choice (concat (car entry) "#testo assente"))
                  (should-error (gdev-quick-open) :type 'user-error)
                  (should (gdev-editor-preview-p preview editor))
                  (should (= (window-point editor) point))
                  (setq choice (concat (car entry) (cdr entry)))
                  (gdev-quick-open)
                  (should (eq (selected-window) editor))
                  (should (eq (window-buffer editor) preview))
                  (should-not (gdev-editor-preview-buffer-p preview))
                  (if (string-prefix-p "#" (cdr entry))
                      (should (looking-at "questa parola"))
                    (should (= (line-number-at-pos) 3)))
                  (gdev-editor-open-preview (car (last files)) editor)
                  (should (buffer-live-p preview)))))))
      (dolist (file files)
        (when-let* ((buffer (find-buffer-visiting file))) (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-switches-preview-directly ()
  "Due anteprime consecutive cambiano documento una volta ciascuna."
  (let* ((root (make-temp-file "gdev-quick-preview-transition-" t))
         (default-directory (file-name-as-directory root))
         (first (expand-file-name "primo.txt" root))
         (second (expand-file-name "secondo.txt" root))
         (original (generate-new-buffer "Documento di partenza"))
         (show (symbol-function 'set-window-buffer-start-and-point))
         buffers transitions)
    (unwind-protect
        (gdev-test--with-layout
          (dolist (file (list first second))
            (with-temp-file file (insert "Prima riga\nSeconda riga\n"))
            (push (find-file-noselect file) buffers))
          (switch-to-buffer original)
          (insert "Testo di partenza")
          (goto-char 4)
          (set-window-hscroll nil 3)
          (let* ((editor (selected-window))
                 (history (window-prev-buffers editor))
                 (preview (gdev-quick-open--preview editor #'ignore #'ignore)))
            (cl-letf (((symbol-function 'set-window-buffer-start-and-point)
                       (lambda (window buffer &rest positions)
                         (push buffer transitions)
                         (apply show window buffer positions))))
              (funcall preview 'preview "primo.txt")
              (funcall preview 'preview "secondo.txt#Seconda")
              (should (looking-at "Seconda"))
              (should (eq (selected-window) editor))
              (funcall preview 'preview ">comando"))
            (should (equal (nreverse transitions)
                           (list (cadr buffers) (car buffers) original)))
            (should (= (point) 4))
            (should (= (window-hscroll editor) 3))
            (should (equal (window-prev-buffers editor) history))))
      (mapc #'kill-buffer (cons original buffers))
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-previews-open-files-without-a-timer ()
  "Consult attende soltanto i candidati che possono richiedere lettura."
  (require 'consult)
  (let* ((directory (make-temp-file "gdev-quick-preview-key-" t))
         (root (file-name-as-directory directory))
         (file (expand-file-name "aperto.txt" root))
         (buffer (find-file-noselect file))
         (key (list :keys 'any :predicate
                    (apply-partially #'gdev-quick-open--preview-key root))))
    (unwind-protect
        (progn
          ;; Il riconoscimento di un nome remoto può caricare TRAMP una volta.
          (file-remote-p "/ssh:prova:/doc.txt")
          (cl-letf (((symbol-function 'file-exists-p)
                     (lambda (&rest _) (ert-fail "La scelta del ritardo non deve interrogare il file"))))
            (should (= (consult--preview-key-debounce key "aperto.txt") 0))
            (should (= (consult--preview-key-debounce key ">comando") 0))
            (should (= (consult--preview-key-debounce key "da leggere.txt") 0.12))
            (should (= (consult--preview-key-debounce key "/ssh:prova:/doc.txt") 0.12))))
      (kill-buffer buffer)
      (delete-directory directory t))))

(ert-deftest gdev-test-quick-open-distinguishes-duplicates-in-narrow-rows ()
  "Una cartella condivisa lascia posto all'antenato che distingue i file."
  (require 'gdev-ui)
  (let* ((first "Acquisizione/Componenti/Controllo/CartellaCondivisaConNomeMoltoLungo/")
         (second "Esportazione/Componenti/Controllo/CartellaCondivisaConNomeMoltoLungo/")
         (name (concat (propertize "Calcolo" 'face 'completions-common-part)
                       "DiConfigurazioneDiUnServizioConUnNomeMoltoLungo"
                       (propertize ".swift" 'face 'completions-common-part)))
         (candidates (list (concat first name) (concat second name)))
         (width 50)
         (window (selected-window)))
    (cl-letf (((symbol-function 'gdev-ui-string-pixel-width) #'string-width)
              ((symbol-function 'active-minibuffer-window) (lambda () window))
              ((symbol-function 'window-body-width)
               (lambda (&rest _) (+ width (* 2 (frame-char-width (window-frame window)))))))
      (pcase-dolist (`(,candidate ,ancestor ,item)
                     (cl-mapcar #'list candidates '("Acquisizione" "Esportazione")
                                (gdev-quick-open--files-affixation candidates)))
        (let* ((text (car item))
               (label (get-text-property 0 'display text))
               (extension (string-search ".swift" label)))
          (should (<= (string-width label) width))
          (should (string-prefix-p "Calcolo" label))
          (should extension)
          (should (memq 'completions-common-part (get-text-property extension 'face label)))
          (should (string-suffix-p (concat ancestor "/…") label))
          (should (equal text (substring-no-properties candidate)))
          (should (equal (get-text-property 0 'help-echo label) candidate)))))))

(ert-deftest gdev-test-quick-open-long-paths-with-auto-save ()
  "I percorsi lunghi si aprono e conservano un salvataggio distinto."
  (require 'gdev-core)
  (let* ((root (make-temp-file "gdev-long-name-" t))
         (gdev-state-directory root)
         (directory (gdev-state-file "auto-save/"))
         (auto-save-file-name-transforms `((".*" ,directory t)))
         (auto-save-visited-file-name nil)
         (auto-save-default t)
         (auto-save-list-file-name nil)
         (create-lockfiles nil)
         (nested (expand-file-name (concat (make-string 108 ?a) "/" (make-string 108 ?b)) root))
         (paths (list (expand-file-name "prima/documento.txt" nested)
                      (expand-file-name (concat (make-string 75 ?測) "/documento.txt") root)))
         buffers saved)
    (unwind-protect
        (progn
          (make-directory directory t)
          (with-temp-buffer
            (setq buffer-file-name (expand-file-name "breve!.txt" root))
            (let ((original (let ((auto-save-file-name-transforms `((".*" ,directory 1))))
                              (make-auto-save-file-name))))
              (should (equal (make-auto-save-file-name) original)))
            (setq buffer-file-name (car paths))
            (let ((auto-save-file-name-transforms `((".*" ,directory sha1))))
              (should (equal (file-name-nondirectory (make-auto-save-file-name))
                             (concat "#" (secure-hash 'sha1 buffer-file-name) "#")))))
          (dolist (path paths)
            (make-directory (file-name-directory path) t)
            (with-temp-file path (insert "documento\n"))
            ;; Percorre lo stesso ramo di after-find-file della finestra grafica.
            (with-current-buffer (let ((noninteractive nil)) (find-file-noselect path))
              (push (current-buffer) buffers)
              (let ((name buffer-auto-save-file-name))
                (should (equal (file-name-directory name) directory))
                (should (equal (file-name-nondirectory name)
                               (concat "#" (secure-hash 'sha256 buffer-file-name) "#")))
                (should-not (member name saved))
                (push name saved)
                (goto-char (point-max))
                (insert "bozza\n")
                (do-auto-save t t)
                (should (file-exists-p name))
                (should (equal (with-temp-buffer (insert-file-contents name) (buffer-string))
                               "documento\nbozza\n"))))))
      (dolist (buffer buffers)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest gdev-test-quick-open-live-discovery-in-workspace ()
  "Una sola apertura rileva creazioni, rinomine e rimozioni nel proprio ambito."
  (defvar consult--completion-refresh-hook)
  (skip-unless (executable-find "git"))
  (let* ((repository (file-name-as-directory (file-truename (make-temp-file "gdev-live-index-" t))))
         (root (expand-file-name "workspace/" repository))
         (default-directory repository)
         (editor (selected-window))
         (gdev-quick-open--refresh-interval 0.06)
         (gdev-quick-open--recent-project-files nil)
         (refreshes 0)
         (consult--completion-refresh-hook (list (lambda () (setq refreshes (1+ refreshes)))))
         (query "")
         (scan (symbol-function 'gdev-quick-open--scan))
         (run-timer (symbol-function 'run-at-time))
         children refresh-timer unsaved)
    (unwind-protect
        (progn
          (should (zerop (call-process "git" nil nil nil "init" "-q")))
          (make-directory root)
          (with-temp-file (expand-file-name ".gitignore" repository)
            (insert "workspace/ignored.txt\n"))
          (dolist (file '("outside.txt" "workspace/renamed.txt" "workspace/deleted.txt" "workspace/ignored.txt"))
            (with-temp-file (expand-file-name file repository)))
          (should (zerop (call-process "git" nil nil nil "add" "outside.txt" "workspace/renamed.txt"
                                      "workspace/deleted.txt")))
          (let ((backend (project-current nil root))
                (emacs-major-version 30))
            (should (equal (sort (funcall gdev-quick-open--project-file-list backend root) #'string-lessp)
                           '("deleted.txt" "renamed.txt"))))
          (cl-letf (((symbol-function 'gdev-layout-editor) (lambda (&rest _) editor))
                    ((symbol-function 'gdev-workspace-state-get)
                     (lambda (property &rest _) (and (eq property 'gdev-layout-folder) root)))
                    ((symbol-function 'gdev-workspace-roots) (lambda (&rest _) (list root)))
                    ((symbol-function 'gdev-workspace-directory) (lambda (&rest _) root))
                    ((symbol-function 'gdev-module-p) #'ignore)
                    ((symbol-function 'active-minibuffer-window) (lambda () editor))
                    ((symbol-function 'minibuffer-contents-no-properties) (lambda () query))
                    ((symbol-function 'gdev-quick-open--scan)
                     (lambda (&rest args)
                       (should-not (seq-some #'process-live-p children))
                       (car (push (apply scan args) children))))
                    ((symbol-function 'run-at-time)
                     (lambda (delay repeat function &rest args)
                       (let ((timer (apply run-timer delay repeat function args)))
                         (when (equal repeat gdev-quick-open--refresh-interval)
                           (setq refresh-timer timer))
                         timer)))
                    ((symbol-function 'gdev-quick-open--read)
                     (lambda (_initial table &rest _)
                       (let ((noninteractive nil))
                         (gdev-test--quick-open-wait
                          (lambda () (member "deleted.txt" (all-completions "" table))))
                         (should (> refreshes 0))
                         (should-not (all-completions "outside" table))
                         (should-not (all-completions "ignored" table))
                         (let ((subdir (expand-file-name "a/b/" root)))
                           (make-directory subdir t)
                           (rename-file (expand-file-name "renamed.txt" root)
                                        (expand-file-name "a/b/nuovo.txt" root))
                           (with-temp-file (expand-file-name "a/b/creato.txt" root))
                           (delete-file (expand-file-name "deleted.txt" root))
                           (setq unsaved (find-file-noselect (expand-file-name "a/b/bozza.txt" root))))
                         (gdev-test--quick-open-wait
                          (lambda ()
                            (let ((names (all-completions "" table)))
                              (and (member "a/b/creato.txt" names)
                                   (member "a/b/nuovo.txt" names)
                                   (member "a/b/bozza.txt" names)
                                   (not (member "renamed.txt" names))
                                   (not (member "deleted.txt" names))))))
                         (kill-buffer unsaved)
                         (gdev-test--quick-open-wait (lambda () (not (all-completions "a/b/bozza" table))))
                         (setq query ">")
                         (gdev-test--quick-open-wait (lambda () (not (seq-some #'process-live-p children))))
                         (let ((count (length children)))
                           (sleep-for 0.3)
                           (should (= count (length children))))
                         (setq query "")
                         (gdev-test--quick-open-wait (lambda () (seq-some #'process-live-p children)))
                         (signal 'quit nil)))))
            (condition-case nil
                (progn (gdev-quick-open) (ert-fail "Annullamento atteso"))
              (quit nil)))
          (should-not (seq-some #'process-live-p children))
          (should (timerp refresh-timer))
          (should-not (memq refresh-timer timer-list)))
      (dolist (child children)
        (when (process-live-p child) (delete-process child)))
      (when (timerp refresh-timer) (cancel-timer refresh-timer))
      (when (buffer-live-p unsaved) (kill-buffer unsaved))
      (delete-directory repository t))))

;;; gdev-quick-open-freshness-test.el ends here
