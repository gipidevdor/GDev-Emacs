                gdev-sidebar--repo "/progetto/"
                gdev-sidebar--last-output "vecchio"
                gdev-sidebar--process old-process
                gdev-sidebar--status (make-hash-table :test #'equal)
                gdev-sidebar--removed (make-hash-table :test #'equal))
          (cl-letf (((symbol-function 'locate-dominating-file)
                     (lambda (&rest _) "/progetto/sotto/"))
                    ((symbol-function 'gdev-sidebar--refresh-directories) #'ignore)
                    ((symbol-function 'gdev-sidebar--read-git) #'ignore))
            (gdev-sidebar-refresh))
          (should (equal gdev-sidebar--repo "/progetto/sotto/"))
          (should-not (process-live-p old-process))
          (should-not gdev-sidebar--process)
          (should-not gdev-sidebar--status)
          (should-not gdev-sidebar--removed)
          (should-not gdev-sidebar--last-output))
      (when (process-live-p old-process) (delete-process old-process)))))

(ert-deftest gdev-test-sidebar-git-index ()
  "Gli stati Git risalgono alle cartelle e includono i percorsi eliminati."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (let* ((root (expand-file-name "progetto/" temporary-file-directory))
         (index (gdev-sidebar--git-index
                 (mapconcat #'identity '(" M src/file con spazi.c" "R  src/nuovo.c"
                                         "prima/vecchio.c" "?? src/non tracciato.c"
                                         "!! src/cache/" "UU src/conflitto.c") "\0")
                 root root))
         (status (car index)))
    (should (equal (gethash (concat root "src/cache") status) '(ignored)))
    (should (equal (gethash (concat root "src/file con spazi.c") status) '(modified)))
    (should (equal (gethash (concat root "src/conflitto.c") status) '(conflict)))
    (should (equal (gethash (concat root "src") status)
                   '(conflict untracked renamed staged modified)))
    (should (equal (gethash (concat root "prima") status) '(deleted)))
    (should (equal (gethash (concat root "prima") (cdr index))
                   (list (concat root "prima/vecchio.c"))))))

