(ert-deftest gdev-test-language-actions-respect-editor-and-cancellation ()
  "LSP e Xref usano il punto dell'editor attivo, ripristinando il pannello in caso di annullamento."
  (require 'gdev-commands)
  (require 'eglot)
  (load (gdev-module-file :tools 'lsp ".el") nil t t)
  (gdev-test--with-layout
    (let ((document (generate-new-buffer "gdev-test-file-lsp"))
          (tool (generate-new-buffer "*gdev-test-pannello-lsp*"))
          (available t)
          calls)
      (unwind-protect
          (progn
            (switch-to-buffer document)
            (insert "prima\nseconda\n")
            (gdev-layout-mark-document)
            (goto-char 8)
            (let ((editor (selected-window))
                  (panel (display-buffer tool)))
              (select-window panel)
              (cl-letf (((symbol-function 'eglot-managed-p)
                         (lambda () (eq (current-buffer) document)))
                        ((symbol-function 'eglot-server-capable)
                         (lambda (capability)
                           (and available (eq capability :renameProvider))))
                        ((symbol-function 'gdev-lsp-refactor-rename)
                         (lambda () (interactive)
                           (should (eq this-command 'gdev-lsp-refactor-rename))
                           (push (list 'rename (selected-window) (point)) calls)))
                        ((symbol-function 'xref-find-definitions)
                         (lambda () (interactive)
                           (should (eq this-command 'xref-find-definitions))
                           (push (list 'definition (selected-window) (point)) calls))))
                (should (gdev-lsp-capable-p :renameProvider document))
                (call-interactively #'gdev-lsp-rename)
                (select-window panel)
                (call-interactively #'gdev-find-definition)
                (should (equal (nreverse calls)
                               (list (list 'rename editor 8) (list 'definition editor 8))))
                (select-window panel)
                (setq available nil)
                (should-error (gdev-lsp-rename) :type 'user-error)
                (should (eq (selected-window) panel))
