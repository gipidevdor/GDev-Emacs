;;;; Comandi

(ert-deftest gdev-test-github-request-keeps-stdout-and-errors-separate ()
  "L'output di gh è disponibile dopo il ritorno del comando e senza avvisi."
  (load (gdev-module-file :tools 'github ".el") nil t t)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-gh-test-" t)))
         (tool (expand-file-name "gh" root))
         (exec-path (cons root exec-path))
         process result)
    (unwind-protect
        (progn
          (with-temp-file tool
            (insert "#!/bin/sh\necho avviso >&2\n"
                    "case \"$1\" in\n"
                    "  repo) test -f progetto && echo proprietario/progetto;;\n"
                    "  *) echo conclusione >&2; exit 1;;\nesac\n"))
          (with-temp-file (expand-file-name "progetto" root))
          (set-file-modes tool #o700)
          (dotimes (_ 8)
            (dolist (command '("repo" "pr"))
              (setq result nil
                    process (gdev-github--request root
                                                  (lambda (text failure) (setq result (cons text failure)))
                                                  command "list"))
              (let ((deadline (+ (float-time) 5)))
                (while (and (not result) (< (float-time) deadline))
                  (accept-process-output nil 0.01)))
              (should (equal result (if (equal command "repo")
                                        '("proprietario/progetto\n")
                                      '(nil . "HitHub · Operazione non riuscita\navviso\nconclusione")))))))
      (when (process-live-p process) (delete-process process))
      (delete-directory root t))))

(ert-deftest gdev-test-project-symbol-search-uses-the-editor ()
  "Da un pannello la ricerca usa il server del documento attivo."
  (require 'gdev-commands)
  (require 'eglot)
  (save-window-excursion
    (let* ((editor (selected-window))
           (tool (split-window-below))
           (document (window-buffer editor)))
      (set-window-parameter tool 'window-side 'bottom)
      (set-window-buffer tool (get-buffer-create " *gdev-test-tool*"))
      (select-window tool)
      (cl-letf (((symbol-function 'xref-find-backend)
                 (lambda () (and (eq (current-buffer) document) 'eglot)))
                ((symbol-function 'eglot-server-capable)
                 (lambda (capability) (eq capability :workspaceSymbolProvider)))
                ((symbol-function 'read-string)
                 (lambda (&rest _) "  processa  "))
                ((symbol-function 'xref-find-apropos)
                 (lambda (query)
                   (should (eq (selected-window) editor))
                   (should (equal query "processa"))
                   'trovato)))
        (should (eq (gdev-find-project-symbol) 'trovato))))))

(ert-deftest gdev-test-compare-quit-keeps-the-panel-opened-meanwhile ()
  "Uno strumento aperto durante il confronto resta nel pannello all'uscita."
  (require 'gdev-commands)
  (require 'ediff)
  (gdev-test--with-layout
    (let* ((first (make-temp-file "gdev-confronto-" nil ".txt" "uno\n"))
           (second (make-temp-file "gdev-confronto-" nil ".txt" "due\n"))
           (tool (generate-new-buffer "*gdev-test-strumento*"))
           control)
      (unwind-protect
          (progn
            (should-not (gdev-layout-panel-window))
            (setq control (gdev-compare-files first second))
            (should (gdev-layout-show-panel tool))
            (with-current-buffer control
              (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
                (gdev-comparison-close control)))
            (should-not (buffer-live-p control))
            (should (eq (window-buffer (gdev-layout-panel-window)) tool))
            (should-not (gdev-workspace-state-get 'gdev-layout-panel-hidden))
            ;; Il pannello chiuso durante il confronto resta chiuso.
            (setq control (gdev-compare-files first second))
            (should (gdev-layout-show-panel tool))
            (gdev-layout-hide-panel)
            (with-current-buffer control
              (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
                (gdev-comparison-close control)))
            (should-not (gdev-layout-panel-window))
            (should (gdev-workspace-state-get 'gdev-layout-panel-hidden)))
        (when (buffer-live-p control)
          (with-current-buffer control (ediff-really-quit nil)))
        (dolist (file (list first second))
          (when-let* ((buffer (find-buffer-visiting file))) (kill-buffer buffer))
          (delete-file file))
        (kill-buffer tool)))))

(ert-deftest gdev-test-compare-with-saved-uses-the-document ()
  "Il confronto preserva la bozza e ripristina il pannello di partenza."
  (require 'gdev-commands)
  (require 'ediff)
  (let* ((file (make-temp-file "gdev-compare-" nil ".txt" "salvato\n"))
         (document (find-file-noselect file))
         (tool (generate-new-buffer " *gdev-test-compare-tool*"))
         control snapshot)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer document)
          (should-error (gdev-compare-with-saved) :type 'user-error)
          (insert "bozza\n")
          (setq-local buffer-auto-save-file-name (concat file ".auto"))
          (let ((origin (gdev-layout--display-panel tool t)))
            (select-window origin)
            (setq control (gdev-compare-with-saved))
            (should (eq (current-buffer) control))
            (should (gdev-layout--temporary-p control))
            (setq snapshot ediff-buffer-A)
            (should (eq ediff-buffer-B document))
            (should (eq (gdev-layout--role snapshot) 'editor))
            (should (eq (gdev-layout--role control) 'panel))
            (when gdev-layout-mode (gdev-layout--reconcile))
            (should (eq (window-buffer ediff-window-A) snapshot))
            (should (equal (with-current-buffer snapshot (buffer-string)) "salvato\n"))
            (should (eq (buffer-local-value 'tab-line-close-tab-function control)
                        #'gdev-comparison-close))
            (should (eq (key-binding (kbd "X")) #'gdev-comparison-close))
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
              (call-interactively (key-binding (kbd "X"))))
            (should (buffer-live-p control))
            (let ((variant ediff-window-B))
              (select-window variant)
              (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
                (gdev-close-document))
              (should (eq (selected-window) variant))
              (should (eq (current-buffer) document))
              (should (eq (gdev-comparison-control-at-window) control)))
            (select-window (get-buffer-window control))
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (funcall tab-line-close-tab-function control))
            (should (eq (selected-window) origin))
            (should (eq (window-buffer origin) tool))
            (should-not (buffer-live-p control))
            (should-not (buffer-live-p snapshot))
            (should (buffer-modified-p document))
            (should (equal (buffer-local-value 'buffer-auto-save-file-name document)
                           (concat file ".auto")))))
      (when (buffer-live-p control)
        (with-current-buffer control (ediff-really-quit nil)))
      (when (buffer-live-p snapshot) (kill-buffer snapshot))
      (kill-buffer tool)
      (with-current-buffer document (set-buffer-modified-p nil))
      (kill-buffer document)
      (delete-file file))))

(ert-deftest gdev-test-compare-files-keeps-layout-on-cancel-and-close ()
  "Il comando di menu conserva i gruppi e le bozze anche dopo il confronto."
  (require 'gdev-commands)
  (require 'ediff)
  (let* ((a (make-temp-file "gdev-compare-a-" nil ".txt" "prima\n"))
         (b (make-temp-file "gdev-compare-b-" nil ".txt" "dopo\n"))
         (document (find-file-noselect a))
         control other)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer document)
          (insert "bozza\n")
          (let ((editor (selected-window))
                (neighbor (split-window-below))
                (answers (list a)))
            (cl-letf (((symbol-function 'read-file-name)
                       (lambda (&rest _) (or (pop answers) (signal 'quit nil)))))
              (should (eq (condition-case nil
                              (progn (gdev-compare-files) 'aperto)
                            (quit 'annullato))
                          'annullato)))
            (should (eq (selected-window) editor))
            (should (window-live-p neighbor))
            (setq answers (list a a))
            (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) (pop answers))))
              (should-error (gdev-compare-files) :type 'user-error))
            (should (eq (selected-window) editor))
            (setq answers (list a b))
            (cl-letf (((symbol-function 'read-file-name)
                       (lambda (_prompt _dir default &rest _)
                         (when (equal (car answers) a) (should (equal default a)))
                         (pop answers))))
              (setq control (gdev-compare-files)))
            (should (eq (current-buffer) control))
            (should (eq ediff-buffer-A document))
            (setq other ediff-buffer-B)
            (should (> ediff-number-of-differences 0))
            (select-window ediff-window-A)
            (let ((menu (gdev-test--context-menu (point))))
              (should (commandp (lookup-key menu [gdev-compare-files])))
              (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) nil)))
                (call-interactively (lookup-key menu [gdev-close-document])))
              (should (eq (current-buffer) document)))
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (gdev-layout-close-editor-tab document))
            (should-not (buffer-live-p control))
            (should (eq (selected-window) editor))
            (should (window-live-p neighbor))
            (should-not (assq document (gdev-layout--closed-documents)))
            (should (buffer-modified-p document))))
      (when (buffer-live-p control)
        (with-current-buffer control (ediff-really-quit nil)))
      (when (buffer-live-p other) (kill-buffer other))
      (with-current-buffer document (set-buffer-modified-p nil))
      (kill-buffer document)
      (delete-file a)
      (delete-file b))))

(defvar gdev-project-tasks)
(defvar gdev-project-task-history)
(defvar gdev-build-settings)

(ert-deftest gdev-test-project-task-uses-the-workspace-root ()
  "Attività omonime in progetti diversi hanno comandi e risultati distinti."
  (load (gdev-module-file :tools 'build ".el") nil t t)
  (let ((gdev-project-tasks '(("/prima/" ("Verifica" . "make test"))
                              ("/seconda" ("Verifica" . "make check"))))
        (gdev-project-task-history nil)
        (gdev-build-settings nil)
        (folder "/seconda/")
        outputs)
    (cl-letf (((symbol-function 'gdev-workspace-state-get)
               (lambda (key &optional _) (and (eq key 'gdev-layout-folder) folder)))
              ((symbol-function 'project-current) #'ignore)
              ((symbol-function 'completing-read)
               (lambda (_prompt candidates _predicate require-match &rest _)
                 (should require-match)
                 (should (equal candidates '(("Verifica" . "make check"))))
                 "Verifica"))
              ((symbol-function 'gdev-compile)
               (lambda (command name root &optional _)
                 (push name outputs)
                 (should (equal command "make check"))
                 (should (equal root "/seconda/")))))
      (gdev-run-project-task)
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (&rest _) (ert-fail "Ripeti non deve chiedere di nuovo il nome"))))
        (gdev-repeat-project-task)
        (setq folder "/prima/")
        (should-error (gdev-repeat-project-task) :type 'user-error)
        (setq folder "/seconda/"
              gdev-project-tasks '(("/seconda/" ("Altro" . "make docs"))))
        (should-error (gdev-repeat-project-task) :type 'user-error))
      (should (equal outputs '("Verifica · /seconda/" "Verifica · /seconda/"))))))

