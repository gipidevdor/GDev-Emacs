          (window-width-function (symbol-function 'window-total-width))
          (columns 80))
      (unwind-protect
          (cl-letf (((symbol-function 'window-total-width)
                     (lambda (&optional window round)
                       (if (eq window (frame-root-window)) columns
                         (funcall window-width-function window round)))))
            (gdev-workspace-state-set 'gdev-layout-explorer-width 30)
