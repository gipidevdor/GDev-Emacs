              (should (eq (window-parameter commands 'window-side) 'right))
              (should (= (window-parameter commands 'window-slot) 0))
              (should (eq (window-parameter lower 'window-side) 'right))
              (should (= (window-parameter lower 'window-slot) 1))
              (let ((upper-edges (window-edges commands))
                    (lower-edges (window-edges lower)))
                (should (= (nth 0 upper-edges) (nth 0 lower-edges)))
                (should (= (nth 2 upper-edges) (nth 2 lower-edges)))
                (should (= (nth 3 upper-edges) (nth 1 lower-edges))))
              (should (eq (selected-window) editor))
              (should (eq (window-buffer panel) tool))
              (with-selected-window commands (gdev-close-document))
              (should-not (gdev-layout-command-sidebar-window))
              (should (eq (gdev-layout-auxiliary-window) lower))
              (gdev-command-sidebar-toggle)
              (setq commands (gdev-layout-command-sidebar-window))
              (should (eq (window-buffer commands) commands-buffer))
              (should (= (nth 3 (window-edges commands)) (nth 1 (window-edges lower))))
              (with-selected-window lower (gdev-close-document))
              (should-not (gdev-layout-auxiliary-window))
              (should (buffer-live-p auxiliary))
              (should (eq (gdev-layout-command-sidebar-window) commands))
              (should (eq (window-buffer panel) tool))
              (should (eq (selected-window) editor))
              (should (eq (window-buffer editor) document))
              (should (= (window-point editor) 6))))
        (dolist (buffer (list document tool auxiliary commands-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest gdev-test-layout-auxiliary-uses-panel-in-a-narrow-frame ()
