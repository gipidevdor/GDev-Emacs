            (switch-to-buffer first)
            (goto-char 13)
            (should (eq (key-binding (kbd "C-x 2")) #'gdev-split-editor-below))
            (call-interactively (key-binding (kbd "C-x 2")))
            (should (eq (selected-window) source))
            (should (= (point) 13))
            (let* ((peer (gdev-layout-other-editor source))
                   (panel (display-buffer tool)))
              (set-window-buffer-start-and-point peer second 1 21)
              (set-window-prev-buffers peer (list (list history 1 6)))
              (set-window-parameter peer 'tab-line-buffers (list second history))
              (should (eq (gdev-layout-editor-direction source) 'below))
              (should-error (split-window peer nil 'below) :type 'user-error)
