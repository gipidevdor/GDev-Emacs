            (should (commandp (lookup-key local [azione-propria])))
            (should (equal (nth 2 (assq 'gdev-cut-dwim (cdr inside))) "Taglia"))
            (should (equal (nth 2 (assq 'gdev-cut-dwim (cdr outside))) "Taglia riga"))
            (setq buffer-read-only t)
            (let ((read-only-menu (gdev-test--context-menu 7)))
              (should (commandp (lookup-key read-only-menu [gdev-copy-dwim])))
              (should-not (lookup-key read-only-menu [gdev-cut-dwim]))
              (should-not (lookup-key read-only-menu [yank])))
            (call-interactively (lookup-key inside [gdev-copy-dwim]))
            (should (equal (car kill-ring) "ima\nsec"))
            (call-interactively (lookup-key outside [gdev-copy-dwim]))
            (should (equal (car kill-ring) "ultima\n"))))
      (kill-buffer buffer))))

