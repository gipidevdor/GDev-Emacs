(ert-deftest gdev-test-terminal-new-in-active-workspace ()
  "Il più del pannello e il comando creano sessioni indipendenti del progetto."
  (require 'package)
  (package-activate-all)
  (load (gdev-module-file :term 'eat ".el") nil t t)
  (require 'eat)
  (gdev-test--with-layout
    (let* ((directory (make-temp-file "gdev-terminal-test-" t))
           (root (file-name-as-directory (expand-file-name "progetto" directory)))
           (editor (selected-window))
           (document (generate-new-buffer "Documento del terminale"))
           (build (generate-new-buffer "*Compilazione del terminale*"))
           (project-current-directory-override nil)
           terminals)
      (unwind-protect
          (cl-letf (((symbol-function 'eat-other-window)
                     (lambda (_program new)
                       (should new)
                       (should (equal default-directory root))
                       (let ((buffer (generate-new-buffer eat-buffer-name)))
                         (push buffer terminals)
                         (with-current-buffer buffer (setq major-mode 'eat-mode))
                         (pop-to-buffer buffer)
                         buffer))))
            (make-directory root)
            (set-window-buffer editor document)
            (with-current-buffer document (setq default-directory root))
            (with-current-buffer build (setq default-directory directory))
            (gdev-workspace-set-roots (list root))
            (gdev-term-project)
            (let* ((first (car terminals))
                   (panel (display-buffer build))
                   (button (with-current-buffer build (car tab-line-format)))
                   (keymap (get-text-property 0 'keymap button)))
              (should (equal (get-text-property 0 'help-echo button) "Nuovo terminale del progetto"))
              (should (eq (keymap-lookup keymap "RET") 'gdev-term-new))
              (select-window editor)
              (funcall (keymap-lookup keymap "<tab-line> <mouse-1>")
                       (list 'mouse-1 (list panel 'tab-line '(0 . 0) 0)))
              (let ((second (car terminals)))
                (should-not (eq first second))
                (should (equal (gdev-layout--panel-label second) "Terminale · progetto (2)"))
                (should (eq (selected-window) panel))
                (should (eq (window-buffer panel) second))
                (should (eq (window-buffer editor) document))
                (gdev-layout-toggle-panel)
                (should (buffer-live-p first))
                (should (buffer-live-p second))
                (gdev-term-project)
                (should (eq (window-buffer) second))
                (should (= 2 (length terminals)))
                (tab-bar-new-tab)
                (gdev-workspace-set-roots (list root))
                (call-interactively #'gdev-term-new)
                (should (equal (gdev-layout--panel-buffers) (list (car terminals))))
                (tab-bar-select-tab 1)
                (gdev-term-project)
                (should (eq (window-buffer) second))
                (should (= 3 (length terminals))))))
        (mapc #'kill-buffer (append terminals (list document build)))
        (delete-directory directory t)))))

