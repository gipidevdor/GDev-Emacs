(ert-deftest gdev-test-quick-open-background-index-keeps-project-rules ()
  "La scansione locale restituisce gli stessi nomi del backend di progetto."
  (require 'gdev-commands)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-quick-index-" t)))
         (default-directory root)
         (project-vc-ignores '("saltami.txt"))
         (project-files-relative-names t)
         (deadline (+ (float-time) 10))
         result child)
    (unwind-protect
        (progn
          (should (zerop (call-process "git" nil nil nil "init" "-q")))
          (with-temp-file ".gitignore" (insert "escluso.txt\n"))
          (dolist (file '("saltami.txt" "escluso.txt" "spazio e accento è.txt" "due\nrighe.txt"))
            (with-temp-file file))
          (let* ((project (project-current))
                 (expected (project-files project)))
            (setq child (gdev-quick-open--scan
                         project (lambda (files ok) (setq result (cons ok files)))))
            (while (and (not result) (< (float-time) deadline))
              (accept-process-output child 0.1))
            (should (car result))
            (should (equal (sort (cdr result) #'string<) (sort expected #'string<)))
            (should (member "due\nrighe.txt" (cdr result)))
            (should-not (member "escluso.txt" (cdr result)))
            (should-not (member "saltami.txt" (cdr result)))
            (should-not (buffer-live-p (process-buffer child)))))
      (when (process-live-p child) (delete-process child))
      (delete-directory root t))))

(ert-deftest gdev-test-python-keeps-environment-and-tests-in-the-nearest-project ()
  "I comandi Python condividono cartella, interprete e file di test."
  (require 'python)
  (let* ((root (file-name-as-directory (file-truename (make-temp-file "gdev-python-" t))))
         (project (expand-file-name "Sottoprogetto Python/" root))
         (source-dir (expand-file-name "src/esempio/" project))
         (test-dir (expand-file-name "tests/esempio/" project))
         (source (expand-file-name "conti.py" source-dir))
         (test (expand-file-name "test_conti.py" test-dir))
         (bin (expand-file-name ".venv/bin/" project))
         (python (expand-file-name "python" bin))
         (gdev-trusted-projects (list project))
         (project-find-functions nil)
         (gdev-project-environment-functions nil)
         (gdev--handlers (make-hash-table :test #'eq))
         (gdev-popup-rules nil))
    (unwind-protect
        (progn
          (load (gdev-module-file :lang 'python ".el") nil t t)
          (dolist (directory (list source-dir test-dir bin)) (make-directory directory t))
          (dolist (file (list source test python (expand-file-name "pyproject.toml" project)
                             (expand-file-name ".venv/pyvenv.cfg" project)))
            (with-temp-file file))
          (set-file-modes python #o700)
          (with-temp-buffer
            (setq major-mode 'python-mode
                  default-directory source-dir
                  buffer-file-name source)
            (should (equal (gdev-python-root) project))
            (let ((gdev-trusted-projects nil))
              (should-not (gdev-python--venv-bin project)))
            (should (equal (gdev-python--interpreter project) python))
            (should (equal (getenv "VIRTUAL_ENV") (expand-file-name ".venv" project)))
            (should (equal (gdev-python--companion source project) test))
            (should (equal (gdev-python--companion test project) source))
            (should (string-search (gdev-shell-quote test)
                                   (gdev-python--test-command project test)))
            (should (eq (gdev-handler :test-project) #'gdev-python-test-project))))
      (delete-directory root t))))

(ert-deftest gdev-test-python-ruff-reports-source-and-syntax-errors ()
  "I risultati di Ruff puntano al testo Python con la gravità adatta."
  (require 'flymake)
  (let ((gdev--handlers (make-hash-table :test #'eq))
        (gdev-popup-rules nil))
    (load (gdev-module-file :lang 'python ".el") nil t t)
    (with-temp-buffer
      (insert "import sys\n")
      (let ((source (current-buffer)))
        (with-temp-buffer
          (insert (concat "[{\"code\":\"F401\",\"message\":\"Importazione inutilizzata\","
                          "\"location\":{\"row\":1,\"column\":8},"
                          "\"end_location\":{\"row\":1,\"column\":11}},"
                          "{\"code\":\"invalid-syntax\",\"message\":\"Sintassi non valida\","
                          "\"location\":{\"row\":1,\"column\":1}}]"))
          (pcase-let ((`(,unused ,syntax) (gdev-python--diagnostics source)))
            (should (= (flymake-diagnostic-beg unused) 8))
            (should (= (flymake-diagnostic-end unused) 11))
            (should (eq (flymake-diagnostic-type unused) :warning))
            (should (eq (flymake-diagnostic-type syntax) :error))))))))

(ert-deftest gdev-test-quick-open-keeps-editor-and-explorer ()
  "La ricerca rapida apre e naviga nello stesso riquadro, anche dall'albero."
  (require 'gdev-commands)
  (gdev-test--with-layout
    (let* ((root (file-name-as-directory (make-temp-file "gdev-quick-open-" t)))
           (default-directory root)
           (file (expand-file-name "src/target.el" root))
           (colon-file (expand-file-name "letterale:3" root))
           (editor (selected-window))
           (tree (generate-new-buffer "albero-test"))
           (gdev-sidebar-width 18)
           (completion-styles '(basic))
           (completion-category-overrides nil))
      (unwind-protect
          (progn
            (make-directory (file-name-directory file))
            (with-temp-file file
              (insert ";; Fixture\n\n(defun gdev-target () nil)\n"))
            (with-temp-file colon-file)
            (with-current-buffer tree (setq default-directory root))
            (let ((sidebar (gdev-layout-show-explorer tree)))
              (cl-letf (((symbol-function 'project-current)
                         (lambda (&rest _) (cons 'transient root)))
                        ((symbol-function 'completing-read)
                         (lambda (_prompt table &rest _)
                           (should (member "src/target.el" (all-completions "src/t" table)))
                           (should-not (find-buffer-visiting file))
                           "src/target.el:3")))
                (select-window sidebar)
                (gdev-quick-open))
              (should (eq (selected-window) editor))
              (should (equal buffer-file-name file))
              (should (= (line-number-at-pos) 3))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "src/target.el#gdev-target")))
                (gdev-quick-open))
              (should (looking-at "gdev-target"))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "src/target.el@gdev-target")))
                (gdev-quick-open))
              (should (= (line-number-at-pos) 3))
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) ":1")))
                (gdev-quick-open))
              (should (= (line-number-at-pos) 1))
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (_prompt table &rest _)
                           (should (equal (car (completion-all-completions "@gdev-t" table nil 7))
                                          "gdev-target"))
                           "@gdev-target")))
                (gdev-quick-open))
              (should (= (line-number-at-pos) 3))
              (select-window sidebar)
              (let ((extended-command-history nil)
                    (command-window nil)
                    (read-extended-command-predicate nil))
                (cl-letf (((symbol-function 'gdev-test-palette-command)
                           (lambda () (interactive) (setq command-window (selected-window))))
                          ((symbol-function 'completing-read)
                           (lambda (_prompt table _predicate _required initial &rest _)
                             (should (equal initial ">"))
                             (should (equal (car (completion-all-completions
                                                 ">gdev-test-palette-c" table nil 20))
                                            "gdev-test-palette-command"))
                             (should-not command-window)
                             ">gdev-test-palette-command")))
                  (gdev-command-palette))
                (should (eq command-window editor))
                (should (equal extended-command-history '("gdev-test-palette-command"))))
              (select-window sidebar)
              (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "")))
                (gdev-quick-open))
              (should (eq (selected-window) sidebar))
              (gdev-workspace-state-set 'gdev-layout-folder root)
              (cl-letf (((symbol-function 'project-current) #'ignore)
                        ((symbol-function 'completing-read)
                         (lambda (_prompt table &rest _)
                           (should (member "src/target.el" (all-completions "src/t" table)))
                           (should (member "letterale:3" (all-completions "lett" table)))
                           "letterale:3")))
                (gdev-quick-open))
              (should (equal buffer-file-name colon-file))
              (should (eq (selected-window) editor))
              (should (eq (window-buffer sidebar) tree))
              (should (= (length (window-list nil 'no-minibuffer)) 2))))
        (dolist (buffer (list tree (find-buffer-visiting file) (find-buffer-visiting colon-file)))
          (when buffer (kill-buffer buffer)))
        (delete-directory root t)))))

(ert-deftest gdev-test-quick-open-preview-restores-the-editor ()
  "L'anteprima di un altro file lascia intatti documento, posizione e cronologia."
  (require 'gdev-commands)
  (gdev-test--with-layout
    (let* ((root (make-temp-file "gdev-preview-" t))
           (default-directory (file-name-as-directory root))
           (file (expand-file-name "secondo.el" root))
