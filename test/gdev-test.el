(ert-deftest gdev-test-hit-status-uses-product-labels ()
  "Aprire lo stato di un repository mostra il fork localizzato."
  (skip-unless (executable-find "git"))
  (require 'package)
  (package-activate-all)
  (require 'magit)
  (let* ((directory (make-temp-file "gdev-hit-test-" t))
         (default-directory (file-name-as-directory directory))
         (magit-auto-revert-mode nil)
         buffer)
    (unwind-protect
        (save-window-excursion
          (should (zerop (call-process "git" nil nil nil "init" "-q")))
          (write-region "contenuto\n" nil (expand-file-name "prova.txt") nil 'silent)
          (magit-status-setup-buffer default-directory)
          (setq buffer (magit-get-mode-buffer 'magit-status-mode nil t))
          (should (buffer-live-p buffer))
          (with-current-buffer buffer
            (should (string-prefix-p "Hit · Stato" (gdev-ui-mode-label)))
            (should (string-match-p "\\`\\*?Hit · Stato" (buffer-name)))
            (should (string-search "File non tracciati" (buffer-string)))
            (magit-section-show (magit-get-section '((untracked) (status))))
            (should (string-search "prova.txt" (buffer-string)))
            (should-not (string-match-p "\\b[Mm]agit\\b" (buffer-string)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest gdev-test-hit-guide-is-localized-and-keeps-info-links ()
  "Il menu di Hit e i collegamenti storici aprono la guida italiana inclusa."
