(defmacro gdev-test--with-layout (&rest body)
  "Esegue BODY in uno spazio di lavoro isolato."
  (declare (indent 0))
  `(let ((frame (selected-frame))
         (tabs (frame-parameter nil 'tabs))
         (already-enabled gdev-layout-mode)
         (window-persistent-parameters (copy-tree window-persistent-parameters))
         (tab-bar-new-tab-choice "*scratch*"))
     (unwind-protect
         (save-window-excursion
           (let ((ignore-window-parameters t)) (delete-other-windows))
           (set-frame-parameter frame 'tabs nil)
           (gdev-layout-mode 1)
           ,@body)
       (set-frame-parameter frame 'tabs tabs)
       (unless already-enabled (gdev-layout-mode -1)))))

