        (should-not (overlay-buffer gdev-dashboard--selection-overlay))))))

(ert-deftest gdev-test-sidebar-refreshes-cached-directories-in-background ()
  "L'albero mantiene la lista precedente fino al termine della scansione."
  (skip-unless (executable-find "perl"))
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-sidebar-refresh-" t)))
         (default-directory root)
         (file (expand-file-name "prima" root))
         (new (expand-file-name "dopo\ncon accento è" root))
         (directory (expand-file-name "cartella" root))
         (link (expand-file-name "collegamento" root)))
    (unwind-protect
        (with-temp-buffer
          (gdev-sidebar-mode)
          (setq gdev-sidebar--root root)
          (with-temp-file file)
          (should (equal (gdev-sidebar--children root) (list nil (list file))))
          (delete-file file)
          (make-directory directory)
          (make-symbolic-link directory link)
          (with-temp-file new)
          (gdev-sidebar--refresh-directories)
          (should (equal (gdev-sidebar--children root) (list nil (list file))))
          (let ((process gdev-sidebar--directory-process)
                (deadline (+ (float-time) 5)))
            (should (processp process))
            (while (and gdev-sidebar--directory-process (< (float-time) deadline))
              ;; Si attende la callback finale, compreso il canale stderr.
              ;; Dopo la chiusura di stdout non basta attendere quel processo.
              (accept-process-output nil 0.1))
            (ert-info ((format "Scansione %S, stato %S, risposta %S"
                               process (process-status process)
                               (when (buffer-live-p (process-buffer process))
                                 (with-current-buffer (process-buffer process) (buffer-string)))))
              (should-not gdev-sidebar--directory-process)))
          (should (equal (gdev-sidebar--children root)
                         (list (list directory link) (list new)))))
      (delete-directory root t))))

(ert-deftest gdev-test-sidebar-discards-git-state-when-the-repository-changes ()
  "L'aggiornamento di un nuovo repository scarta lo stato e il processo precedenti."
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (let ((old-process (make-process :name "gdev-test-old-git" :command '("sleep" "2") :noquery t)))
