(ert-deftest gdev-test-configuration-loads ()
  "Caricare init.el carica ogni modulo attivo senza errori."
  (skip-unless (getenv "GDEV_TEST_SMOKE"))
  (require 'package)
  (package-activate-all)                ; -Q ha saltato l'attivazione
  (load (gdev-config-file "init.el") nil t)
  (should (> (length gdev-module-load-times) 40))
  (should-not gdev-failed-modules)
  ;; Salvare e ricaricare da C-c b sono gli stessi comandi del menu e di ⌘S.
  (should (eq (key-binding (kbd "C-c b s")) 'gdev-save-document))
  (should (eq (key-binding (kbd "C-c b r")) 'gdev-reload-document))
  ;; `occur' e la ricerca in rete non condividono più un tasto.
  (should (eq (key-binding (kbd "C-c s O")) 'occur))
  ;; Il vecchio gancio di Consult non c'è più e i tasti dell'ortografia seguono enchant.
  (should-not (memq 'consult-preview-at-point-mode (bound-and-true-p embark-collect-mode-hook)))
  (when (and (gdev-module-p :checkers 'spell) (not (gdev-find-executable "enchant-2")))
    (should-not (eq (key-binding (kbd "C-c ! s")) 'jinx-correct)))
  (when (gdev-module-p :lang 'org)
    (should (eq (key-binding (kbd "C-c n a")) 'gdev-org-calendar))
    (should (eq (key-binding (kbd "C-c n A")) 'org-agenda)))
  (cl-labels ((check-map
               (map)
               (map-keymap
                (lambda (event binding)
                  (let ((command (if (and (consp binding) (stringp (car binding)))
                                     (cdr binding)
                                   binding)))
                    (cond ((keymapp command) (check-map command))
                          ((and command (symbolp command))
                           (ert-info ((format "Tasto %S associato a %S" event command))
                             (should (commandp command)))))))
                map)))
    (check-map gdev-help-map)
    (dolist (group gdev-leader-groups)
      (check-map (symbol-value (cadr group)))))
  (with-temp-buffer
    (use-local-map (make-sparse-keymap))
    (keymap-local-set "s-y" #'compile)
    (should (eq (key-binding (kbd "s-y")) #'gdev-redo))
    (should (eq (key-binding (kbd "s-z")) #'gdev-undo)))
  (dolist (entry '(("s-F" [menu-bar gdev-search Cerca\ nei\ file…] gdev-search-query)
                   ("s-g" [menu-bar gdev-search Trova\ successivo] gdev-find-next)
                   ("s-G" [menu-bar gdev-search Trova\ precedente] gdev-find-previous)
                   ("s-p" [menu-bar gdev-navigate Vai\ a\ qualsiasi\ cosa…] gdev-quick-open)
                   ("C-c o w" [menu-bar gdev-tools Apri\ navigatore\ web…] gdev-web-browser)
                   ("C-c o W" [menu-bar gdev-tools Anteprima\ web\ affiancata] gdev-web-preview)
                   ("C-c p e" [menu-bar gdev-project Dipendenze\ del\ progetto] gdev-project-dependencies-show)
                   ("C-c p n" [menu-bar gdev-file Nuovo\ progetto…] gdev-new-project)
                   ("C-c g 3" [menu-bar gdev-file Unisci\ tre\ file…] gdev-merge-files)
                   ("C-c g !" [menu-bar gdev-file Risolvi\ i\ conflitti…] gdev-merge-conflict)))
    (pcase-let ((`(,key ,menu ,command) entry))
      (should (eq (key-binding (kbd key)) command))
      (should (eq (lookup-key global-map menu) command))))
  ;; Impostazioni… ed Esci nel menu dell'app di macOS usano i comandi di ⌘, e
  ;; ⌘Q: Impostazioni… apriva Customize invece delle Preferenze di GDev.
  (when gdev-macos-p
    (should (eq (lookup-key global-map [ns-show-prefs]) 'gdev-preferences-open))
    (should (eq (lookup-key global-map [ns-show-prefs]) (key-binding (kbd "s-,"))))
    (should (eq (lookup-key global-map [ns-power-off]) (key-binding (kbd "s-q"))))))

