(ert-deftest gdev-test-workspace-checkpoint-reuses-unchanged-drafts ()
  "Serializza solo le bozze cambiate e ritenta dopo un errore di scrittura."
  (require 'gdev-workspaces)
  (let* ((gdev-state-directory (make-temp-file "gdev-checkpoint-" t))
         (gdev-workspaces--session-active nil)
         (gdev-workspaces--checkpoint-signature nil)
         (gdev-workspaces--checkpoint-file nil)
         (gdev-workspaces--checkpoint-cache nil)
         (gdev-drafts-hot-exit t)
         (first (generate-new-buffer " *gdev prima bozza*" t))
         (second (generate-new-buffer " *gdev seconda bozza*" t))
         (first-key '(bozza "Prima"))
         (second-key '(bozza "Seconda"))
         (snapshot (symbol-function 'gdev-drafts--snapshot))
         saved)
    (unwind-protect
        (cl-letf (((symbol-function 'gdev-workspaces--drafts)
                   (lambda () (list (cons first first-key) (cons second second-key))))
                  ((symbol-function 'tab-bar-tabs) (lambda (&rest _) '((current-tab))))
                  ((symbol-function 'gdev-workspaces--record)
                   (lambda (&rest _) (list :name "Prova" :files (list first-key second-key))))
                  ((symbol-function 'gdev-drafts--snapshot)
                   (lambda (buffer) (push buffer saved) (funcall snapshot buffer))))
          (with-current-buffer first (insert "Uno"))
          (with-current-buffer second (insert "Due\n«Citazione»"))
          (gdev-workspaces-checkpoint)
          (should (= (length saved) 2))
          (let ((before (gdev-workspaces--read))
                (signature gdev-workspaces--checkpoint-signature))
            (with-current-buffer first (insert " bis"))
            (setq saved nil)
            (cl-letf (((symbol-function 'gdev-session-db--write-tab)
                       (lambda (&rest _) (signal 'file-error '("Disco non scrivibile")))))
              (gdev-workspaces-checkpoint))
            (should (eq gdev-workspaces--checkpoint-signature signature))
            (should (equal (gdev-workspaces--read) before))
            (setq saved nil)
            (gdev-workspaces-checkpoint)
            (should (equal saved (list first)))
            (let ((drafts (plist-get (gdev-workspaces--read) :drafts)))
              (should (equal (plist-get (alist-get first-key drafts nil nil #'equal) :text)
                             "Uno bis"))
              (should (equal (alist-get second-key drafts nil nil #'equal)
                             (alist-get second-key (plist-get before :drafts) nil nil #'equal))))))
      (kill-buffer first)
      (kill-buffer second)
      (delete-directory gdev-state-directory t))))

(ert-deftest gdev-test-project-tools-require-explicit-trust ()
  "Aprire un file concede precedenza agli strumenti solo dopo autorizzazione."
  (let* ((root (file-name-as-directory (make-temp-file "gdev-progetto-" t)))
         (bin (expand-file-name ".tools/bin" root))
         (venv (expand-file-name ".venv/bin" root))
         (gdev-trusted-projects nil)
         (gdev-project-environment-functions nil))
    (unwind-protect
        (with-temp-buffer
          (make-directory bin t)
          (setq default-directory root buffer-file-name (expand-file-name "testo.txt" root))
          (gdev-use-project-tools)
          (should-not (member bin exec-path))
          (should-not gdev--project-tools-applied)
          (setq gdev-trusted-projects (list (file-name-as-directory (file-truename root))))
          (gdev-use-project-tools)
          (should (equal (car exec-path) bin))
          (should (equal (car (parse-colon-path (getenv "PATH")))
                         (file-name-as-directory bin)))
          ;; Una cartella di strumenti creata dopo vale per i documenti aperti poi.
          (make-directory venv t)
          (with-temp-buffer
            (setq default-directory root buffer-file-name (expand-file-name "altro.txt" root))
            (gdev-use-project-tools)
            (should (equal (seq-take exec-path 2) (list bin venv)))))
      (delete-directory root t))))

(ert-deftest gdev-test-hot-exit-recovers-drafts-after-confirmation ()
  "Annullare rimanda l'uscita. Confermare conserva testo e cursor senza scrivere i file."
  (require 'gdev-commands)
  (require 'gdev-workspaces)
  (gdev-test--with-layout
    (let* ((gdev-state-directory (make-temp-file "gdev-drafts-" t))
           (gdev-workspaces--session-active nil)
           (file (gdev-state-file "originale.txt"))
           (kill-emacs-query-functions nil)
           (confirm-kill-processes nil)
           (confirm-kill-emacs (lambda (_prompt) nil))
           (save-some-buffers-functions nil)
           (killed nil)
           visiting draft recovered conflict)
      (unwind-protect
          (progn
            (with-temp-file file (insert "Dal disco\n"))
            (tab-bar-rename-tab "Bozze")
            (gdev-open-file file)
            (setq visiting (current-buffer))
            (insert "In corso\n")
            (gdev-new-buffer)
            (setq draft (current-buffer))
            (insert "Una priorità\nUna bozza senza nome\n")
            (goto-char 5)
            (cl-letf (((symbol-function 'kill-emacs) (lambda (&rest _) (setq killed t))))
              (gdev-workspaces-quit nil)
              (should-not killed)
              (should-not (gdev-session-db-exists-p))
              (should-not (gdev-state-db-entries "applicazione" "" "ripristino_richiesto"))
              (should (buffer-modified-p visiting))
              (should (buffer-modified-p draft))
              (let ((confirm-kill-emacs (lambda (_prompt) t)))
                (gdev-workspaces-quit nil))
              (should killed))
            (should (equal (with-temp-buffer (insert-file-contents file) (buffer-string)) "Dal disco\n"))
            (should (gdev-state-db-entries "applicazione" "" "ripristino_richiesto"))
            (switch-to-buffer "*scratch*")
            (dolist (buffer (list visiting draft))
              (with-current-buffer buffer (set-buffer-modified-p nil))
              (kill-buffer buffer))
            (set-frame-parameter nil 'tabs nil)
            (gdev-workspaces-restore)
            (setq recovered (current-buffer)
                  visiting (find-buffer-visiting file))
            (should gdev-layout-document-p)
            (should (buffer-modified-p recovered))
            (should (equal (buffer-string) "Una priorità\nUna bozza senza nome\n"))
            (should (= (point) 5))
            (should (eq (caar (window-prev-buffers)) visiting))
            (should (equal (with-current-buffer visiting (buffer-string)) "In corso\nDal disco\n"))
            (should (buffer-modified-p visiting))
            (let ((snapshot (gdev-drafts--snapshot visiting)))
              (with-temp-file file (insert "Modificato altrove\n"))
              (set-file-times file (seconds-to-time 1000000))
              (setq conflict (gdev-drafts--restore snapshot))
              (with-current-buffer conflict
                (should (and gdev-layout-document-p (buffer-modified-p)))
                (should-not buffer-file-name)
                (should (equal (buffer-string) "In corso\nDal disco\n")))))
        (dolist (buffer (list visiting draft recovered conflict))
          (when (buffer-live-p buffer)
            (with-current-buffer buffer (set-buffer-modified-p nil))
            (kill-buffer buffer)))
        (delete-directory gdev-state-directory t)))))

(ert-deftest gdev-test-beside-and-minimap-respect-the-layout ()
  "Le viste affiancate e la minimappa mantengono i ruoli dei riquadri."
  (require 'gdev-commands)
  (require 'gdev-minimap)
  (gdev-test--with-layout
    (let ((first (generate-new-buffer "documento-primo"))
          (second (generate-new-buffer "documento-secondo"))
          (tool (generate-new-buffer "*strumento-minimappa*"))
          mirror)
      (unwind-protect
          (progn
            (dolist (buffer (list first second))
              (with-current-buffer buffer
                (dotimes (line 100) (insert (format "%s %d\n" (buffer-name) line)))
                (gdev-layout-mark-document)))
            (switch-to-buffer first)
            (let* ((editor (selected-window))
                   (panel (display-buffer tool)))
              (gdev-workspace-state-set 'gdev-layout-minimap-visible t)
              (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) t)))
                (gdev-minimap--sync (selected-frame)))
              (let ((side (window-with-parameter 'gdev-minimap t)))
                (setq mirror (window-buffer side))
                (should (eq (window-parameter side 'window-side) 'right))
                (should (eq (gdev-layout--role mirror) 'minimap))
                (gdev-layout-toggle-document-beside second editor)
                (should (eq (selected-window) editor))
                (should (eq (window-buffer (gdev-layout-document-beside second editor)) second))
                (gdev-layout-toggle-document-beside second editor)
                (should-not (gdev-layout-document-beside second editor))
                (gdev-layout--reconcile)
                (should (and (window-live-p panel) (window-live-p side)))
                (should-not (memq mirror (gdev-layout--panel-buffers)))
                (delete-window side)
                (should-not (gdev-workspace-state-get 'gdev-layout-minimap-visible)))))
        (mapc #'kill-buffer (delq nil (list first second tool mirror)))))))

(ert-deftest gdev-test-editor-split-button-uses-the-clicked-group ()
  "Dividi conserva la selezione se si annulla e agisce sul gruppo del clic."
  (require 'gdev-commands)
  (unless (fboundp 'gdev-workspaces-split-menu)
    (require 'package)
    (package-activate-all)
    (load (gdev-module-file :ui 'workspaces ".el") nil t t))
  (gdev-test--with-layout
    (let ((first (generate-new-buffer "Documento principale"))
          (second (generate-new-buffer "Documento di confronto"))
          choice shown)
      (unwind-protect
          (progn
            (dolist (buffer (list first second))
              (with-current-buffer buffer (gdev-layout-mark-document)))
            (switch-to-buffer first)
            (cl-letf (((symbol-function 'tab-line-mode)
                       (lambda (&rest _) (ert-fail "La riga delle schede è già attiva"))))
              (gdev-workspaces--enable-document-tabs))
            (should (equal tab-line-format '(:eval (gdev-workspaces--document-tab-line))))
            (let* ((source (selected-window))
                   (click (lookup-key (get-text-property 0 'local-map gdev-workspaces--split-button)
                                      [tab-line mouse-1]))
                   (event (list 'mouse-1 (list source 'tab-line '(1 . 1) 0))))
              (cl-letf (((symbol-function 'popup-menu)
                         (lambda (menu _event &rest _)
                           (setq shown menu)
                           (when choice (call-interactively (lookup-key menu (vector choice)))))))
                (funcall click event)
                (should-not (gdev-layout-other-editor source))
                (should-not (lookup-key shown [close]))
                (setq choice 'below)
                (funcall click event)
                (let* ((peer (gdev-layout-other-editor source))
                       (peer-event (list 'mouse-1 (list peer 'tab-line '(1 . 1) 0))))
                  (set-window-buffer peer second)
                  (should (eq (selected-window) source))
                  (setq choice nil)
                  (funcall click peer-event)
                  (should-not (plist-get (nthcdr 4 (assq 'below shown)) :enable))
                  (should (plist-get (nthcdr 4 (assq 'right shown)) :enable))
                  (should (eq (selected-window) source))
                  (setq choice 'right)
                  (funcall click peer-event)
                  (should (eq (selected-window) peer))
                  (should (eq (current-buffer) second))
                  (should (eq (gdev-layout-editor-direction peer) 'right))
                  (should (= (length (gdev-layout--editors)) 3))
                  (setq choice 'grid)
                  (funcall click peer-event)
                  (should (eq (selected-window) peer))
                  (should (gdev-layout-editor-grid-p))
                  (setq choice 'close)
                  (funcall click peer-event)
                  (should (= (length (gdev-layout--editors)) 3))
                  (should (window-live-p source))
                  (should (buffer-live-p second))))))
        (mapc #'kill-buffer (list first second))))))

(ert-deftest gdev-test-editor-split-keeps-documents-focus-and-panel ()
  "I comandi nativi orientano due gruppi, conservando schede e posizioni."
