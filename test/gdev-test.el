(ert-deftest gdev-test-bundled-package-provenance ()
  "Registro, descrittori, autoload e sorgenti concordano per tutti i fork."
  (let* ((names (mapcar #'car gdev-bundled-packages))
         (root (gdev-config-file "vendor/elpa/"))
         (directories (seq-filter #'file-directory-p
                                  (directory-files root t directory-files-no-dot-files-regexp))))
    (should (= (length names) (length (delete-dups (copy-sequence names)))))
    (should (equal (sort (mapcar #'directory-file-name
                                 (mapcar #'gdev-bundled-package-directory names)) #'string<)
                   (sort directories #'string<)))
    (should-not (gdev-bundled-package-directory 'gdev-fork-inesistente))
    (pcase-dolist (`(,name ,version ,license ,origin ,revision) gdev-bundled-packages)
      (ert-info ((symbol-name name))
        (let* ((directory (gdev-bundled-package-directory name))
               (descriptor (expand-file-name (format "%s-pkg.el" name) directory))
               (form (with-temp-buffer
                       (insert-file-contents descriptor)
                       (read (current-buffer)))))
          (should (equal (take 3 form) (list 'define-package (symbol-name name) version)))
          (when-let* ((commit (plist-get (nthcdr 5 form) :commit)))
            (should (equal revision commit)))
          (should (file-readable-p (expand-file-name (format "%s-autoloads.el" name) directory)))
          (should (seq-some (lambda (file)
                              (not (string-match-p "-\\(?:pkg\\|autoloads\\)\\.el\\'" file)))
                            (directory-files-recursively directory "\\.el\\'")))
          (should (and (stringp version) (not (string-empty-p license))))
          (should (string-prefix-p "https://" origin))
          (should (string-match-p
                   "\\`\\(?:[[:xdigit:]]\\{40\\}\\|sha256:[[:xdigit:]]\\{64\\}\\)\\'" revision)))))))

