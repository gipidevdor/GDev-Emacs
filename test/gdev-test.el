(ert-deftest gdev-test-preferences-respects-shortcut-conflicts ()
  "La sostituzione di un tasto richiede conferma e resta ripristinabile."
  (let* ((custom-file (make-temp-file "gdev-test-custom-" nil ".el"))
         (gdev-preferences-keybindings nil)
         (gdev-preferences--base-bindings (make-hash-table :test #'equal))
         (key (kbd "<f19>"))
         (old (lookup-key (current-global-map) key)))
    (unwind-protect
        (with-temp-buffer
          (gdev-preferences-mode)
          (keymap-global-set "<f19>" '("Azione originale" . ignore))
          (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "next-line"))
                    ((symbol-function 'read-key-sequence-vector) (lambda (&rest _) key))
                    ((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
            (should-error (gdev-preferences-edit-shortcut) :type 'user-error)
            (should (eq (lookup-key (current-global-map) key) 'ignore))
            (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
              (gdev-preferences-edit-shortcut)))
          (should (eq (lookup-key (current-global-map) key) 'next-line))
          (should (equal gdev-preferences-keybindings '(("<f19>" . next-line))))
          (gdev-preferences-reset-shortcut "<f19>")
          (should (eq (lookup-key (current-global-map) key) 'ignore))
          (should (equal (gdev-preferences--global-entry "<f19>") '("Azione originale" . ignore)))
          (should-not gdev-preferences-keybindings))
      (keymap-global-set "<f19>" old)
      (delete-file custom-file))))

(ert-deftest gdev-test-preferences-lists-effective-shortcuts ()
  "I tasti visibili e il menu usano il binding effettivo del comando."
  (let* ((gdev-preferences-keybindings '(("<f19>" . next-line)))
         (gdev-preferences--base-bindings (make-hash-table :test #'equal))
         (key (kbd "<f19>"))
         (previous (gdev-preferences--global-entry "<f19>"))
         (document (generate-new-buffer "gdev-test-scorciatoie")))
    (unwind-protect
        (cl-letf (((symbol-function 'gdev-menu-command-items)
                   (lambda (&optional _) '(("Riga successiva · Vai a" . next-line)
                                            ("Apri file · File" . find-file)))))
          (gdev-preferences-apply-shortcuts)
          (with-temp-buffer
            (gdev-preferences-mode)
            (setq-local gdev-preferences--source document
                        gdev-preferences--scope 'keys
                        gdev-preferences--filter "riga f19")
            (gdev-preferences--render)
            (should (string-search "Riga successiva · Vai a" (buffer-string)))
            (should (string-search "Ripristina" (buffer-string)))
            (should-not (string-search "Apri file" (buffer-string)))
            (with-current-buffer document
              (should (equal (gdev-menu-command-key 'next-line) key))
              (let* ((entry (gdev-menu--entry ["Riga successiva" next-line]))
                     (properties (append (seq-drop entry 2) nil)))
                (should (or (equal (plist-get properties :key-sequence) key)
                            (equal (plist-get properties :keys) (gdev-menu-key-label key)))))
              (use-local-map (make-sparse-keymap))
              (keymap-local-set "<f19>" #'ignore)
              (should-not (gdev-menu-command-key 'next-line)))))
      (keymap-global-set "<f19>" previous)
      (kill-buffer document))))

