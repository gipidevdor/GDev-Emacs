(ert-deftest gdev-test-workspaces-restores-editor-state ()
  "Ripristina i gruppi, i percorsi omonimi e lo spazio attivo, anche dalla concentrazione."
  (require 'gdev-commands)
  (require 'gdev-workspaces)
  (unless (fboundp 'gdev-sidebar-show)
    (load (gdev-config-file "modules/ui/sidebar/config.el") nil t))
  (gdev-test--with-layout
    (let* ((root (file-name-as-directory (file-truename (make-temp-file "gdev-workspaces-" t))))
           (gdev-state-directory root)
           (gdev-workspaces--session-active nil)
           (alpha (expand-file-name "alfa/" root))
           (beta (expand-file-name "beta/" root))
           (left (expand-file-name "main.txt" alpha))
           (right (expand-file-name "note.txt" alpha))
           (bottom-left (expand-file-name "altro.txt" alpha))
           (bottom-right (expand-file-name "test.txt" alpha))
           (other (expand-file-name "main.txt" beta))
           (tool (generate-new-buffer "*strumento-sessione*"))
           (existing-warning (get-buffer "*Warnings*"))
           (warning (get-buffer-create "*Warnings*"))
           (gdev-sidebar-width 18)
           (already-advised (advice-member-p #'gdev-workspaces--remember-layout 'tab-bar--tab)))
      (unwind-protect
          (progn
            (advice-add 'tab-bar--tab :around #'gdev-workspaces--remember-layout)
            (dolist (file (list left right bottom-left bottom-right other))
              (make-directory (file-name-directory file) t)
              (with-temp-file file (insert "riga uno\nriga due\nriga tre\n")))
            (tab-bar-rename-tab "Alfa")
            (gdev-open-file left)
            (gdev-workspace-state-set 'gdev-command-sidebar-category 'project)
            (gdev-workspace-state-set 'gdev-launch-selections (list (cons alpha "Debug Alfa")))
            (gdev-sidebar-show alpha t)
            (select-window (gdev-split-editor-right))
            (gdev-open-file right)
            (gdev-split-editor-grid)
            (let ((active (selected-window))
                  (peer (window-in-direction 'left)))
              (set-window-buffer (window-in-direction 'below peer) (find-file-noselect bottom-left))
              (set-window-buffer (window-in-direction 'below active) (find-file-noselect bottom-right)))
            (display-buffer tool)
            (tab-bar-new-tab)
            (should-not (window-prev-buffers))
            (tab-bar-rename-tab "Beta")
            (gdev-open-file other)
            (gdev-workspace-state-set 'gdev-command-sidebar-category 'terminals)
            (gdev-workspace-state-set 'gdev-launch-selections (list (cons beta "Debug Beta")))
            (gdev-sidebar-show beta t)
            (gdev-sidebar-toggle)
            (tab-bar-select-tab 1)
            (gdev-layout-toggle-focus)
            (goto-char 12)
            (gdev-workspaces-save)
            (should (frame-parameter nil 'gdev-layout-focus))
            (should (equal (gdev-workspace-state-get 'name) "Alfa"))
            (should (= (point) 12))
            (gdev-layout-exit-focus)
            (let ((ignore-window-parameters t)) (delete-other-windows))
            (switch-to-buffer "*scratch*")
            (set-frame-parameter nil 'tabs nil)
            (dolist (file (list left right bottom-left bottom-right other))
              (kill-buffer (find-buffer-visiting file)))
            (setq gdev-workspaces--session-active nil)
            (display-buffer warning)
            (gdev-workspaces-save t)
            (gdev-workspaces-restore)
            (should (= (length (tab-bar-tabs)) 2))
            (should (equal (gdev-workspace-state-get 'name) "Alfa"))
            (should (eq (gdev-workspace-state-get 'gdev-command-sidebar-category) 'project))
            (should (equal (gdev-workspace-state-get 'gdev-launch-selections) (list (cons alpha "Debug Alfa"))))
            (should (equal buffer-file-name right))
            (should (= (point) 12))
            (should (gdev-layout-editor-grid-p))
            (should (equal (window-buffer (window-in-direction 'below)) (find-buffer-visiting bottom-right)))
            (should (equal (sort (mapcar (lambda (w) (buffer-file-name (window-buffer w)))
                                         (gdev-layout--editors)) #'string<)
                           (list bottom-left left right bottom-right)))
            (should (= (window-total-width (window-with-parameter 'gdev-sidebar t)) 18))
            (should-not (gdev-layout--panel))
            (gdev-workspaces-restore)
            (should (= (length (tab-bar-tabs)) 2))
            (tab-bar-select-tab 2)
            (should (equal buffer-file-name other))
            (should (eq (gdev-workspace-state-get 'gdev-command-sidebar-category) 'terminals))
            (should (equal (gdev-workspace-state-get 'gdev-launch-selections) (list (cons beta "Debug Beta"))))
            (should-not (assq (find-buffer-visiting right) (window-prev-buffers)))
            (should (equal (gdev-workspace-state-get 'gdev-layout-explorer-root) beta))
            (should (gdev-workspace-state-get 'gdev-layout-explorer-hidden))
            (should-not (window-with-parameter 'gdev-sidebar t)))
        (unless already-advised (advice-remove 'tab-bar--tab #'gdev-workspaces--remember-layout))
        (gdev-layout-exit-focus)
        (unless existing-warning (kill-buffer warning))
        (mapc #'kill-buffer
              (delq nil (cons tool (mapcar #'find-buffer-visiting
                                           (list left right bottom-left bottom-right other)))))
        (dolist (buffer (buffer-list))
          (when (with-current-buffer buffer
                  (and (derived-mode-p 'gdev-sidebar-mode) (string-prefix-p root default-directory)))
            (kill-buffer buffer)))
        (delete-directory root t)))))

(ert-deftest gdev-test-save-document-keeps-panel-focus ()
  "I comandi sul file usano il documento mentre è attivo uno strumento."
  (require 'gdev-commands)
  (gdev-test--with-layout
    (let* ((directory (make-temp-file "gdev-save-document-" t))
           (file (expand-file-name "originale.txt" directory))
           (copy (expand-file-name "copia.txt" directory))
           (tool (generate-new-buffer "*strumento-salvataggio*")))
      (unwind-protect
          (progn
            (write-region "" nil file nil 'silent)
            (gdev-open-file file)
            (insert "Documento modificato")
            (let ((editor (selected-window))
                  (panel (display-buffer tool)))
              (select-window panel)
              (gdev-save-document)
              (should (eq (selected-window) panel))
              (should (eq (current-buffer) tool))
              (should-not (buffer-modified-p (window-buffer editor)))
              (should (equal (with-temp-buffer (insert-file-contents file) (string-trim (buffer-string)))
                             "Documento modificato"))
              (with-temp-file file (insert "Documento ricaricato"))
              (gdev-reload-document)
              (should (eq (selected-window) panel))
              (should (equal (with-current-buffer (window-buffer editor) (buffer-string))
                             "Documento ricaricato"))
              (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) copy)))
                (gdev-save-document-as))
              (should (eq (selected-window) panel))
              (should (equal (buffer-file-name (window-buffer editor)) copy))
              (should (equal (with-temp-buffer (insert-file-contents copy) (string-trim (buffer-string)))
                             "Documento ricaricato"))))
        (kill-buffer tool)
        (dolist (path (list file copy))
          (when-let* ((buffer (find-buffer-visiting path)))
            (with-current-buffer buffer (set-buffer-modified-p nil))
            (kill-buffer buffer)))
        (delete-directory directory t)))))

(ert-deftest gdev-test-restart-saves-only-on-confirmed-exit ()
