(ert-deftest gdev-test-sposta-testo-bounds-and-selection ()
  "Il modulo locale mantiene i ritorni a capo, il registro e la selezione."
  (require 'package)
  (package-activate-all)
  (require 'gdev-sposta-testo)
  (should (file-in-directory-p (symbol-file 'gdev-sposta-testo-giu 'defun)
                               (gdev-bundled-package-directory 'gdev-sposta-testo)))
  (let ((kill-ring '("conservato")))
    (with-temp-buffer
      (insert "uno\ndue\ntre")
      (goto-char 6)
      (gdev-sposta-testo-giu 1)
      (should (equal (buffer-string) "uno\ntre\ndue"))
      (should (= (current-column) 1))
      (gdev-sposta-testo-giu 3)
      (should (equal (buffer-string) "uno\ntre\ndue"))
      (gdev-sposta-testo-giu -4)
      (should (equal (buffer-string) "due\nuno\ntre")))
    (with-temp-buffer
      (insert "ultima\n")
      (gdev-sposta-testo-su 1)
      (should (equal (buffer-string) "ultima\n")))
    (with-temp-buffer
      (let ((transient-mark-mode t))
        (insert "abc\ndef\nghi\n")
        (goto-char 6)
        (set-mark 8)
        (gdev-sposta-testo-su 1)
        (should (equal (buffer-string) "efabc\nd\nghi\n"))
        (should (= (point) (region-beginning)))
        (should (use-region-p))
        (should (equal (buffer-substring (region-beginning) (region-end)) "ef"))))
    (should (equal kill-ring '("conservato")))))

