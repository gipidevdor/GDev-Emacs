(ert-deftest gdev-test-dashboard-selection-stays-within-its-row ()
  "Il risalto segue una voce, esclude il margine e sopravvive al ridisegno."
  (load (gdev-module-file :ui 'dashboard ".el") nil t t)
  (require 'project)
  (let* ((root "/prova/una-cartella-dal-nome-molto-lungo/Asteria/")
         (other "/prova/Meridiana/")
         (project--list (list (list root) (list other)))
         (gdev-dashboard-menu '(("f" "file" "Apri file…" "C-x C-f")))
         (width 40))
    (with-temp-buffer
      (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width)))
        (gdev-dashboard-mode)
        (gdev-dashboard--render)
        (goto-char (point-min))
        (goto-char (prop-match-beginning (text-property-search-forward 'gdev-dashboard-id root t)))
        (gdev-dashboard--update-selection)
        (let ((button (button-at (point)))
              (selection gdev-dashboard--selection-overlay))
          (should (= (overlay-start selection) (button-start button) (1+ (line-beginning-position))))
          (should (= (overlay-end selection) (button-end button) (line-end-position)))
          (should (equal (button-get button 'help-echo) (concat "Apri " root)))
          (should (string-match-p "…" (buffer-substring (button-start button) (button-end button)))))
