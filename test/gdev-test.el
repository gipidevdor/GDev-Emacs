                       (lambda (_) (cons width 0))))
              (display-buffer tool)
              (dolist (method '(command tab))
                (setq width 40)
                (let ((window (display-buffer auxiliary)))
                  (select-window window)
                  (pcase method
                    ('command (call-interactively #'gdev-close-document))
                    ('tab (tab-line-close-tab
                           (list 'mouse-1
                                 (list window 'tab-line '(1 . 1) 0
                                       (cons (propertize " × " 'tab auxiliary) 1)))))))
                (should (buffer-live-p auxiliary))
