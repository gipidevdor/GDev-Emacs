(ert-deftest gdev-test-editor-preview-follows-explorer-activation ()
  "I clic riusano la scheda temporanea e la conferma o la modifica la conserva."
  (require 'gdev-editor-tabs)
  (require 'gdev-workspaces)
  (require 'tab-line)
  (load (gdev-module-file :ui 'sidebar ".el") nil t t)
  (let* ((root (make-temp-file "gdev-preview-" t))
         (files (mapcar (lambda (name) (expand-file-name name root))
                        '("prima.txt" "seconda.txt" "terza.txt" "quarta.txt")))
         (sidebar (generate-new-buffer " *gdev-preview-test*"))
         (installed (advice-member-p #'gdev-editor--pin-opened-file 'gdev-open-file))
         (closing (advice-member-p #'gdev-editor--close-tab 'gdev-layout-close-editor-tab))
         (gdev-layout-mode t)
         (gdev-layout--displaying t))
    (unwind-protect
        (save-window-excursion
          (mapc (lambda (file) (write-region "testo\n" nil file)) files)
          (let* ((editor (selected-window))
                 (explorer (display-buffer-in-side-window sidebar '((side . left))))
                 (click
                  (lambda (file &optional double)
                    (let ((point (with-current-buffer sidebar (gdev-sidebar--path-position file))))
                      (gdev-sidebar-click
                       (list (if double 'double-mouse-1 'mouse-1)
                             (list explorer point '(0 . 0) 0)))))))
            (with-current-buffer sidebar
              (gdev-sidebar-mode)
              (let ((inhibit-read-only t))
                (dolist (file files)
                  (insert-text-button (file-name-nondirectory file) :type 'gdev-sidebar-entry
                                      'gdev-sidebar-path file 'action #'gdev-sidebar--activate)
                  (insert "\n"))))
            (gdev-editor-tabs-install)
            (funcall click (nth 0 files))
            (let ((first (window-buffer editor)))
              (should (eq (selected-window) explorer))
              (should (gdev-editor-preview-p first editor))
              (goto-char (gdev-sidebar--path-position (nth 1 files)))
              (call-interactively (key-binding (kbd "SPC")))
              (should (gdev-editor-preview-p (window-buffer editor) editor))
              (should-not (memq first (with-selected-window editor (tab-line-tabs-window-buffers))))
              (should-not (member (nth 1 files)
                                  (plist-get (gdev-workspaces--record '(current-tab (name . "Test")))
                                             :files))))
            (funcall click (nth 1 files) t)
            (let ((second (window-buffer editor)))
              (should (eq (selected-window) editor))
              (should-not (gdev-editor-preview-buffer-p second))
              (funcall click (nth 2 files))
              (let ((third (window-buffer editor)))
                (with-current-buffer third (insert "modifica"))
                (should-not (gdev-editor-preview-buffer-p third))
                (funcall click (nth 3 files))
                (with-selected-window editor
                  (should (memq second (tab-line-tabs-window-buffers)))
                  (should (memq third (tab-line-tabs-window-buffers)))
                  (let ((closed (gdev-layout--closed-documents)))
                    (gdev-layout-close-editor-tab (window-buffer editor))
                    (should (eq (window-buffer editor) third))
                    (should (equal closed (gdev-layout--closed-documents)))))))))
      (unless installed
        (advice-remove 'gdev-open-file #'gdev-editor--pin-opened-file))
      (unless closing
        (advice-remove 'gdev-layout-close-editor-tab #'gdev-editor--close-tab))
      (kill-buffer sidebar)
      (dolist (file files)
        (when-let* ((buffer (find-buffer-visiting file)))
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-editor-move-to-group-preserves-view ()
  "Lo spostamento trasferisce la vista e lascia intatte le altre schede."
  (require 'gdev-editor-tabs)
  (let ((document (generate-new-buffer "documento da spostare"))
        (previous (generate-new-buffer "altro nel gruppo di origine"))
        (existing (generate-new-buffer "altro nel gruppo di arrivo")))
    (unwind-protect
        (save-window-excursion
          (delete-other-windows)
          (let* ((source (selected-window))
                 (target (split-window-right)))
            (with-current-buffer document
              (dotimes (i 40) (insert (make-string 100 ?x) "\n"))
              (setq-local gdev-layout-document-p t))
            (set-window-buffer target existing)
            (set-window-buffer source previous)
            (set-window-buffer-start-and-point source document 405 707)
            (set-window-hscroll source 12)
            (should-error (gdev-editor-move-to-group source) :type 'user-error)
            (should (eq (window-buffer source) document))
            (gdev-editor-move-to-group target)
            (should (eq (selected-window) target))
            (should (eq (window-buffer target) document))
            (should (= (window-start target) 405))
            (should (= (window-point target) 707))
            (should (= (window-hscroll target) 12))
            (should (eq (window-buffer source) previous))
            (should (assq existing (window-prev-buffers target)))
            (should-not (assq document (window-prev-buffers source)))))
      (mapc #'kill-buffer (list document previous existing)))))

