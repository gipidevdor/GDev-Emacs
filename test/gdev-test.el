  '(("chiave API Anthropic" . "sk-ant-[A-Za-z0-9_-]\\{20,\\}")
    ("token GitHub" . "\\(gh[pousr]_[A-Za-z0-9]\\{30,\\}\\|github_pat_[A-Za-z0-9_]\\{20,\\}\\)")
    ("chiave AWS" . "AKIA[0-9A-Z]\\{16\\}")
    ("chiave API Google" . "AIza[0-9A-Za-z_-]\\{35\\}")
    ("token Slack" . "xox[abposr]-[0-9A-Za-z-]\\{10,\\}")
    ("chiave privata" . "-----BEGIN [A-Z ]*PRIVATE KEY-----")
    ("percorso personale" . "/\\(Users\\|home\\)/[a-z][a-z0-9_-]+/"))
  "Ciò che non deve mai comparire in un file del repository.")

(defconst gdev-test--allowed-mail-domains
  '("example.com" "example.org" "users.noreply.github.com")
  "Domini ammessi per un indirizzo email nel repository.")

(defun gdev-test--upstream-example-path-p (file path)
  "Verifica se PATH è un percorso d'esempio noto del sorgente FILE."
  (let ((relative (file-relative-name file gdev-config-directory)))
    (or (and (equal relative "test/gdev-test.el")
             (member path '("/Users/foo/" "/home/foo/" "/home/www/" "/home/user/"
                            "/home/akib/" "/users/tarsius/" "/home/me/" "/Users/alanr/")))
        (and (equal relative "test/behavior/upstream/emacs/test/lisp/progmodes/python-tests.el")
             (equal path "/home/user/"))
        (and (string-prefix-p "vendor/elpa/" relative)
             (equal path "/home/user/"))
        (and (string-prefix-p "vendor/elpa/f-20241003.1131/" relative)
             (member path '("/Users/foo/" "/home/foo/" "/home/www/")))
        (and (string-prefix-p "vendor/elpa/eat-0.9.4/integration/" relative)
             (equal path "/home/akib/"))
        (and (string-prefix-p "vendor/elpa/org-9.8.10/" relative)
             (cl-some (lambda (account) (equal path (concat "/home/" account "/")))
                      (cdr (assoc (substring relative (length "vendor/elpa/org-9.8.10/"))
                                  '(("doc/org-guide.org" "dominik")
                                    ("doc/org-manual.org" "dand" "dominik")
                                    ("doc/org.texi" "dand" "dominik")
                                    ("doc/orgguide.texi" "dominik")
                                    ("org.info" "dand" "dominik")
                                    ("orgguide.info" "dominik")
                                    ("etc/ORG-NEWS" "jack" "me"))))))
        (and (member relative '("vendor/elpa/ghub-20261110.1618/ghub.texi"
                                "vendor/elpa/ghub-20261110.1618/ghub.info"))
             (equal path "/users/tarsius/"))
        (and (member relative '("vendor/elpa/sly-1.0.43/doc/sly.texi"
                                "vendor/elpa/sly-1.0.43/sly.info"))
             (equal path "/home/me/"))
        (and (equal relative "vendor/elpa/sly-1.0.43/slynk/backend/abcl.lisp")
             (equal path "/Users/alanr/")))))

(ert-deftest gdev-test-no-secrets ()
  "Nessuna credenziale, percorso o indirizzo email personale nel repository."
  (let (findings)
    (dolist (file (gdev-test--repository-files))
      (when (and (file-regular-p file) (< (file-attribute-size (file-attributes file)) 2000000))
        (with-temp-buffer
          (insert-file-contents-literally file)
          (pcase-dolist (`(,label . ,pattern) gdev-test--secret-patterns)
            (goto-char (point-min))
            (while (re-search-forward pattern nil t)
              (unless (and (equal label "percorso personale")
                           (gdev-test--upstream-example-path-p file (match-string 0)))
                (push (format "%s: %s alla riga %d" (file-relative-name file gdev-config-directory)
                              label (line-number-at-pos))
                      findings))))
          (goto-char (point-min))
          ;; Nei sorgenti importati restano gli indirizzi pubblici degli autori.
          ;; I controlli delle credenziali e dei percorsi sopra valgono anche lì.
          ;; Gli autori pubblici restano nelle copie originali del corpus;
          ;; la prova di provenienza ne verifica tutte le impronte esatte.
          (while (and (not (file-in-directory-p file (gdev-config-file "vendor/elpa/")))
                      (not (file-in-directory-p file (gdev-config-file "test/behavior/upstream/")))
                      (re-search-forward "[A-Za-z0-9._%+-]+@\\([A-Za-z0-9-]+\\.\\)+[A-Za-z]\\{2,\\}" nil t))
            (unless (cl-some (lambda (domain) (string-suffix-p domain (match-string 0)))
                             gdev-test--allowed-mail-domains)
              (push (format "%s: indirizzo email alla riga %d"
                            (file-relative-name file gdev-config-directory) (line-number-at-pos))
                    findings))))))
    (should-not findings)))

(ert-deftest gdev-test-checkout-not-native-compiled ()
  "La compilazione nativa asincrona non tocca la copia di lavoro.
I suoi processi non leggono early-init.el: compilando un modulo
installerebbero pacchetti dentro il repository."
  (skip-unless (and (fboundp 'native-comp-available-p) (native-comp-available-p)))
  (let ((module (gdev-module-file :ui 'workbench ".el")))
    (should (cl-some (lambda (regexp) (string-match-p regexp module))
                     native-comp-jit-compilation-deny-list))))

(ert-deftest gdev-test-environment-cache-has-no-secrets ()
  "L'ambiente in cache non include mai variabili con credenziali."
  (require 'gdev-env)
  (dolist (name gdev-env-variables)
    (unless (equal name "SSH_AUTH_SOCK")  ; percorso di socket, non un segreto
      (should-not (string-match-p "KEY\\|TOKEN\\|SECRET\\|PASS\\|AUTH\\|CREDENTIAL" name)))))

(ert-deftest gdev-test-command-line-quotes-only-shell-syntax ()
  "Le righe di comando restano leggibili e la shell riceve gli argomenti intatti."
  (should (equal (gdev-command-line "c++" "-std=c++23" "-O2" nil
                                    '("-o" "build/edf-test") "kernel/edf.cpp")
                 "c++ -std=c++23 -O2 -o build/edf-test kernel/edf.cpp"))
  (let ((arguments '("a b" "" "=ls" "$HOME" "~/x" "it's" "x;rm" "*.c" "é" "%1" "u@h:/p")))
    (should (equal (gdev-shell-quote "=ls") "\\=ls"))
    (should (equal (gdev-shell-quote "") "''"))
    (when (executable-find "sh")
      (with-temp-buffer
        (should (zerop (let ((coding-system-for-read 'utf-8)
                             (coding-system-for-write 'utf-8))
                         (call-process
                          "sh" nil t nil "-c"
                          (gdev-command-line "printf" "%s\\n" arguments)))))
        (should (equal (split-string (buffer-string) "\n" t)
                       (remove "" arguments)))
        (should (= (count-lines (point-min) (point-max)) (length arguments)))))))

(ert-deftest gdev-test-remote-hosts-terminates-with-recursive-includes ()
  "Ogni file SSH si legge una volta, anche quando un Include torna alla radice."
  (require 'package)
  (package-activate-all)
  (load (gdev-module-file :tools 'remote ".el") nil t t)
  (let ((directory (make-temp-file "gdev-ssh-config-" t))
        (case-fold-search nil))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "config" directory)
            (insert "Host alfa * !escluso\nInclude extra.cfg extra.cfg\n"))
          (with-temp-file (expand-file-name "extra.cfg" directory)
            (insert "include config\nhost beta alfa\n"))
          (should (equal (gdev-remote-hosts directory) '("alfa" "beta"))))
      (delete-directory directory t))))

;;;; Moduli

(ert-deftest gdev-test-environment-cache-is-complete-and-written-before-application ()
  "Le impostazioni della stampa e un errore su disco lasciano una cache leggibile."
  (require 'gdev-env)
  (let* ((gdev-state-directory (make-temp-file "gdev-ambiente-" t))
         (pairs '(("PATH" . "/percorso con spazi") ("MANPATH" . "/uno\n/due")))
         (path (getenv "PATH"))
         (process-environment (copy-sequence process-environment))
         (exec-path exec-path))
    (unwind-protect
        (progn
          (let ((print-length 1) (print-level 0))
            (gdev-env--write pairs))
          (let ((before (gdev-state-db-entries "ambiente" "")))
            (should (equal before (reverse pairs)))
            (cl-letf (((symbol-function 'gdev-env--from-login-shell)
                       (lambda () '(("PATH" . "/sostituzione"))))
                      ((symbol-function 'gdev-state-db--put)
                       (lambda (&rest _) (signal 'file-error '("Disco non scrivibile")))))
              (should-error (gdev-env-refresh) :type 'file-error))
            (should (equal (getenv "PATH") path))
            (should (equal (gdev-state-db-entries "ambiente" "") before))
            (should (equal (directory-files gdev-state-directory nil "\\`[^.]")
                           '("copie-stato" "stato.sqlite")))))
      (delete-directory gdev-state-directory t))))

(ert-deftest gdev-test-declaring-modules ()
  "`gdev!' registra moduli e opzioni (flag) in ordine e salta quelli ignoti."
  (let ((gdev-modules nil)
        (warning-minimum-log-level :emergency)
        (inhibit-message t))
    (gdev! :editor (format +onsave +onsave) fold :lang cc no-such-module
           :editor (format +seconda-opzione))
    (should (equal gdev-modules '((:editor format +onsave +seconda-opzione) (:editor fold) (:lang cc))))
    (should (gdev-module-p :editor 'format))
    (should (gdev-module-p :editor 'format '+onsave))
    (should-not (gdev-module-p :editor 'fold '+onsave))
    (should-not (gdev-module-p :lang 'perl))))

(ert-deftest gdev-test-workbench-replaces-popup-and-compiles-its-libraries ()
  "L'init privato precedente attiva lo stesso modulo e il compilatore trova ogni libreria."
  (let ((gdev-modules nil))
    (gdev! :ui dashboard popup workbench workspaces)
    (should (equal gdev-modules '((:ui dashboard) (:ui workbench) (:ui workspaces))))
    (should (gdev-module-p :ui 'popup))
    (should (equal (gdev-module-file :ui 'popup) (gdev-module-file :ui 'workbench)))
    (let* ((directory (gdev-module-directory :ui 'workbench))
           (sources (gdev-module-source-files :ui 'workbench)))
      (should (member (expand-file-name "gdev-context.el" directory) sources))
      (should (equal (butlast sources) (directory-files directory t "\\`gdev-.*\\.el\\'")))
      (should (equal (car (last sources)) (gdev-module-file :ui 'workbench ".el")))
      (should (file-equal-p (file-name-directory (locate-library "gdev-ui"))
                            (gdev-module-directory :ui 'workbench))))))

(ert-deftest gdev-test-hithub-keeps-the-existing-module-and-keys ()
  "HitHub si carica una volta con entrambi i nomi e riusa i comandi esistenti."
  (defvar gdev-github-map)
  (let ((gdev-modules nil)
        (gdev-git-map (make-sparse-keymap))
        (gdev-github-map (make-sparse-keymap)))
    (should-not (gdev-menu--section-enabled-p 'gdev-hithub))
    (gdev! :tools (github +precedente) (hithub +corrente))
    (should (equal gdev-modules '((:tools hithub +precedente +corrente))))
    (should (gdev-module-p :tools 'github '+corrente))
    (should (equal (gdev-module-file :tools 'github) (gdev-module-file :tools 'hithub)))
    (should (member '(:tools . hithub) (gdev-modules-available)))
    (should-not (member '(:tools . github) (gdev-modules-available)))
    (load (gdev-module-file :tools 'hithub ".el") nil t t)
    (should (gdev-menu--section-enabled-p 'gdev-hithub))
    (should-not (gdev-menu--section-enabled-p 'gdev-hit))
    (should (eq (keymap-lookup gdev-git-map "h l") #'gdev-github-pull-requests))
    (let ((entries (gdev-menu--entries (cddr (assq 'gdev-hithub gdev-menu--sections)))))
      (should (seq-some (lambda (entry)
                          (and (vectorp entry) (eq (aref entry 1) 'gdev-github-pull-requests)))
                        entries))
      (should (seq-some (lambda (entry)
                          (and (vectorp entry) (eq (aref entry 1) 'hithub-guida)))
                        entries)))))

(ert-deftest gdev-test-template-matches-disk ()
  "templates/init.el attiva tutti e soli i moduli su disco, config per ultimo."
  (let ((gdev-modules nil))
    (load (gdev-config-file "templates/init.el") nil t t)
    (let ((enabled (mapcar (lambda (entry) (cons (car entry) (cadr entry))) gdev-modules)))
      (should (equal (car (last enabled)) '(:config . default)))
      (should (equal (sort (mapcar #'prin1-to-string enabled) #'string<)
                     (sort (mapcar #'prin1-to-string (gdev-modules-available)) #'string<))))))

(ert-deftest gdev-test-private-modules-appear-and-load-from-config ()
  "Un modulo personale appare nell'aiuto e usa la cartella del profilo."
  (let* ((root (make-temp-file "gdev-personal-modules-" t))
         (gdev-user-directory root)
         (load-path (copy-sequence load-path))
         (gdev-modules nil)
         (gdev-module-load-times nil)
         (gdev-failed-modules nil)
         (init-file-debug t)
         (file (expand-file-name "modules/tools/fixture/config.el" root)))
    (unwind-protect
        (progn
          (make-directory (file-name-directory file) t)
          (with-temp-file file
            (insert ";; -*- lexical-binding: t -*-\n"
                    "(when gdev--bundled-packages-only (error \"Modulo personale trattato come distribuito\"))\n"))
          (gdev! :tools fixture)
          (should (gdev-module-p :tools 'fixture))
          (should (member '(:tools . fixture) (gdev-modules-available)))
          (should (equal (gdev-module-file :tools 'fixture ".el") file))
          (should (member (file-name-directory file) load-path))
          (gdev-modules--load :tools 'fixture)
          (should (assoc '(:tools fixture) gdev-module-load-times))
          (should-not gdev-failed-modules))
      (delete-directory root t))))

(defvar gdev-test--module-registration-effect nil)
(defvar gdev-test--module-keys nil)

(ert-deftest gdev-test-module-activation-publishes-capabilities-only-on-success ()
  "Un modulo fallito non sostituisce i gestori e può essere attivato di nuovo."
  (let* ((root (make-temp-file "gdev-module-state-" t))
         (gdev-user-directory root)
         (load-path (copy-sequence load-path))
         (gdev-modules nil)
         (gdev-module-load-times nil)
         (gdev-failed-modules nil)
         (gdev--handlers (make-hash-table :test #'eq))
         (gdev-project-languages nil)
         (gdev-tool-action-groups nil)
         (gdev-doctor-checks nil)
         (gdev-test--module-registration-effect nil)
         (gdev-test--module-keys (make-sparse-keymap))
         (gdev-tool-actions-change-hook nil)
         action-status
         (init-file-debug nil)
         (file (expand-file-name "modules/tools/fixture/config.el" root))
         (registration
          (concat "(unless (and (eq (gdev-module-status :tools 'fixture) 'loading)"
                  " (gdev-module-p :tools 'fixture '+attivo))"
                  " (error \"Attivazione non visibile\"))\n"
                  "(gdev-set-runner 'text-mode :run #'identity)\n"
                  "(gdev-set-tool-actions 'fixture \"Prova\" \"code\" [\"Azione\" ignore])\n"
                  "(gdev-doctor-check \"prova\" #'ignore \"istruzione\")\n"
                  "(gdev-register-after-module (lambda ()"
                  " (setq gdev-test--module-registration-effect"
                  " (list (gdev-module-status :tools 'fixture) (gdev-handler :run 'text-mode)))))\n")))
    (unwind-protect
        (progn
          (add-hook 'gdev-tool-actions-change-hook
                    (lambda () (setq action-status (gdev-module-status :tools 'fixture))))
          (make-directory (file-name-directory file) t)
          (with-temp-file file
            (insert ";;; -*- lexical-binding: t; -*-\n" registration
                    "(gdev-localleader simple gdev-test--module-keys \"a\" nil #'ignore)\n"
                    "(gdev-localleader simple gdev-test--module-keys \"C-\" nil #'ignore)\n"))
          (gdev-set-runner 'text-mode :run #'ignore)
          (gdev! :tools (fixture +attivo))
          (should (eq (gdev-module-status :tools 'fixture) 'declared))
          (cl-letf (((symbol-function 'display-warning) #'ignore))
            (gdev-modules--load :tools 'fixture))
          (should (eq (gdev-module-status :tools 'fixture) 'failed))
          (should-not (gdev-module-p :tools 'fixture '+attivo))
          (should (eq (gdev-handler :run 'text-mode) #'ignore))
          (should-not gdev-tool-action-groups)
          (should-not gdev-doctor-checks)
          (should-not (commandp (keymap-lookup gdev-test--module-keys "C-c l a")))
          (should-not gdev-test--module-registration-effect)
          (should-not action-status)
          (let ((failure (car gdev-failed-modules)))
            (with-temp-file file
              (insert ";;; -*- lexical-binding: t; -*-\n" registration "(signal 'quit nil)\n"))
            (should (condition-case nil (gdev-modules--load :tools 'fixture) (quit t)))
            (should (eq (car gdev-failed-modules) failure))
            (should (eq (gdev-module-status :tools 'fixture) 'failed))
            (should (eq (gdev-handler :run 'text-mode) #'ignore))
            (should-not gdev-test--module-registration-effect)
            (should-not action-status))
          (with-temp-file file
            (insert ";;; -*- lexical-binding: t; -*-\n" registration))
          (gdev-modules--load :tools 'fixture)
          (should (eq (gdev-module-status :tools 'fixture) 'active))
          (should (gdev-module-p :tools 'fixture '+attivo))
          (should (eq (gdev-handler :run 'text-mode) #'identity))
          (should (assq 'fixture gdev-tool-action-groups))
          (should (assoc "prova" gdev-doctor-checks))
          (should (equal gdev-test--module-registration-effect '(active identity)))
          (should (eq action-status 'active))
          (should-not gdev-failed-modules))
      (delete-directory root t))))

(ert-deftest gdev-test-module-activation-notifies-after-publication ()
  "Gli effetti vedono i nuovi gestori e un loro errore non impedisce gli altri."
  (let ((gdev--handlers (make-hash-table :test #'eq))
        (gdev-tool-action-groups nil)
        (gdev-tool-actions-change-hook nil)
        (inhibit-message t)
        observations)
    (add-hook 'gdev-tool-actions-change-hook
              (lambda () (push (list 'comandi (mapcar #'car gdev-tool-action-groups)) observations)))
    (gdev-load-module-registrations
     (lambda ()
       (gdev-set-runner 'text-mode :run #'identity)
       (gdev-set-tool-actions 'uno "Uno" "code" ["Apri" ignore])
       (gdev-set-tool-actions 'due "Due" "code" ["Chiudi" ignore])
       (gdev-register-after-module (lambda () (error "Errore di prova nell'effetto")))
       (gdev-register-after-module
        (lambda () (push (gdev-handler :run 'text-mode) observations)))
       (should-not observations)))
    (should (eq (gdev-handler :run 'text-mode) #'identity))
    (should (equal observations '((comandi (due uno)) identity)))))

(ert-deftest gdev-test-module-activation-isolates-registry-replacements ()
  "Una sostituzione fallita lascia le voci precedenti nello stesso ordine."
  (let ((gdev--handlers (make-hash-table :test #'eq))
        gdev-project-languages gdev-doctor-checks gdev-tool-action-groups
        gdev-tool-actions-change-hook
        (replace-entries
         (lambda ()
           (gdev-set-project-language 'primo '(text-mode prog-mode) "nuovo" #'ignore)
           (gdev-doctor-check (copy-sequence "primo") #'ignore "Nuovo")
           (gdev-set-tool-actions 'primo "Nuovo" "code")
           (should (eq (gdev-handler :project-language 'text-mode) 'primo))
           (should (equal (cadr (assq 'primo gdev-project-languages)) "nuovo")))))
    (gdev-set-project-language 'primo 'text-mode "prima" #'ignore)
    (gdev-set-project-language 'secondo 'prog-mode "altro" #'ignore)
    (gdev-doctor-check "primo" #'ignore "Prima")
    (gdev-doctor-check "secondo" #'ignore "Altro")
    (gdev-set-tool-actions 'primo "Prima" "code")
    (gdev-set-tool-actions 'secondo "Altro" "code")
    (should-error
     (gdev-load-module-registrations
      (lambda ()
        (funcall replace-entries)
        (error "Errore di prova"))))
    (should (eq (gdev-handler :project-language 'prog-mode) 'secondo))
    (should (equal (cadr (assq 'primo gdev-project-languages)) "prima"))
    (should (equal (nth 2 (assoc "primo" gdev-doctor-checks)) "Prima"))
    (should (equal (cadr (assq 'primo gdev-tool-action-groups)) "Prima"))
    (gdev-load-module-registrations replace-entries)
    (should (eq (gdev-handler :project-language 'prog-mode) 'primo))
    (should (equal (mapcar #'car gdev-project-languages) '(secondo primo)))
    (should (equal (mapcar #'car gdev-doctor-checks) '("secondo" "primo")))
    (should (equal (mapcar #'car gdev-tool-action-groups) '(secondo primo)))
    (should (equal (nth 2 (assoc "primo" gdev-doctor-checks)) "Nuovo"))
    (should (equal (cadr (assq 'primo gdev-tool-action-groups)) "Nuovo"))))

(ert-deftest gdev-test-test-panel-catalogs-preserve-ids-and-results ()
  "Il provider, gli identificatori e i percorsi coincidono con i risultati."
  (let* ((root (make-temp-file "gdev-test-catalog-" t))
         (file (expand-file-name "test with space.py" root))
         (ok "test with space.py::test_ok[a b]")
         (bad "test with space.py::test_bad"))
    (unwind-protect
        (progn
          (should (eq (gdev-test-catalog-provider 'c-mode root root) 'ctest))
          (should (eq (gdev-test-catalog-provider 'js-mode root nil) 'deno))
          (write-region "" nil file)
          (should (equal (mapcar (lambda (entry) (alist-get 'name entry))
                                 (gdev-test-catalog-pytest
                                  (concat ok "\n" bad "\n2 tests collected\n") root))
                         (list ok bad)))
          (with-temp-buffer
            (insert ok " PASSED [50%]\n" bad " FAILED [100%]\n")
            (let ((results (gdev-test-catalog-pytest-results)))
              (should (equal (gethash ok results) "Passato"))
              (should (equal (gethash bad results) "Fallito"))))
          (should (equal (mapcar (lambda (entry) (alist-get 'name entry))
                                 (gdev-test-catalog-files "z_test.ts\0a.test.ts\0" root))
                         '("a.test.ts" "z_test.ts")))
          (with-temp-buffer
            (insert "diagnosi\n<testsuites>\n"
                    "<testsuite name=\"./z_test.ts\" tests=\"2\" failures=\"1\" errors=\"0\" disabled=\"0\" />"
                    "<testsuite name=\"./a.test.ts\" tests=\"1\" failures=\"0\" errors=\"0\" disabled=\"1\" />"
                    "</testsuites>\nfine")
            (let ((results (gdev-test-catalog-deno-results)))
              (should (equal (gethash "z_test.ts" results) "Fallito"))
              (should (equal (gethash "a.test.ts" results) "Saltato"))))
          (with-temp-buffer
            (insert "<testsuites>\n"
                    "<testcase name=\"primo\" file=\"a.test.js\"><failure /></testcase>"
                    "<testcase name=\"secondo\" file=\"a.test.js\" />"
                    "<testcase name=\"terzo\" file=\"b.test.js\"><skipped /></testcase>"
                    "</testsuites>\n")
            (let ((results (gdev-test-catalog-node-results root)))
              (should (equal (gethash "a.test.js" results) "Fallito"))
              (should (equal (gethash "b.test.js" results) "Saltato")))))
      (delete-directory root t))))

(ert-deftest gdev-test-test-panel-follows-nested-packages ()
  "La vista segue il pacchetto attivo, senza eseguire righe di quello precedente."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-test-packages-" t)))
         (alpha (expand-file-name "alpha/" root))
         (beta (expand-file-name "beta/" root))
         (editor (generate-new-buffer " *test editor pacchetti*"))
         (view (generate-new-buffer " *test vista pacchetti*"))
         (window (selected-window)))
    (unwind-protect
        (save-window-excursion
          (dolist (package (list alpha beta))
            (make-directory (expand-file-name "src" package) t)
            (with-temp-file (expand-file-name "package.json" package) (insert "{}"))
            (with-temp-file (expand-file-name
                             (concat (file-name-nondirectory (directory-file-name package)) ".test.js")
                             package)))
          (with-current-buffer editor
            (setq major-mode 'js-mode
                  default-directory (expand-file-name "src/" alpha)))
          (set-window-buffer window editor)
          (with-current-buffer view
            (gdev-project-view-mode)
            (setq gdev-activity-kind 'test))
          (cl-letf (((symbol-function 'gdev-layout-editor) (lambda (&optional _) window))
                    ((symbol-function 'gdev-workspace-directory) (lambda (&rest _) root))
                    ((symbol-function 'gdev-project-view--ctest-context) #'ignore)
                    ((symbol-function 'gdev-compile)
                     (lambda (&rest _) (ert-fail "Esecuzione di un test del vecchio pacchetto"))))
            (with-current-buffer view
              (gdev-project-view-sync view)
              (gdev-project-view-refresh)
              (let ((deadline (+ (float-time) 5)))
                (while (and gdev-project-view--process (< (float-time) deadline))
                  (accept-process-output gdev-project-view--process 0.05)))
              (should (eq gdev-project-view--test-provider 'node))
              (should (equal gdev-project-view--test-dir alpha))
              (should (equal (mapcar (lambda (test) (alist-get 'name test)) gdev-project-view--lines)
                             '("alpha.test.js")))
              (with-current-buffer editor (setq default-directory alpha))
              (should-not (gdev-project-view-sync view))
              (should (equal gdev-project-view--test-dir alpha))
              (with-current-buffer editor (setq major-mode 'text-mode))
              (should-not (gdev-project-view-sync view))
              (should (equal gdev-project-view--test-dir alpha))
              (with-current-buffer editor (setq default-directory beta major-mode 'js-mode))
              ;; Il clic arriva prima che il riquadro abbia ricevuto l'aggiornamento.
              (should-error (gdev-project-view--test "alpha.test.js") :type 'user-error)
              (should-not gdev-project-view--lines)
              (should (equal gdev-project-view--root beta))
              (gdev-project-view-refresh)
              (let ((deadline (+ (float-time) 5)))
                (while (and gdev-project-view--process (< (float-time) deadline))
                  (accept-process-output gdev-project-view--process 0.05)))
              (should (equal (mapcar (lambda (test) (alist-get 'name test)) gdev-project-view--lines)
                             '("beta.test.js")))
              (should-error (gdev-project-view--test "alpha.test.js") :type 'user-error))))
      (kill-buffer view)
      (kill-buffer editor)
      (delete-directory root t))))

