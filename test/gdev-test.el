              (should (equal (gdev-workspace-roots) (list alpha beta)))
              (should (eq (gdev-workspace-state-get 'gdev-activity-view) 'search))
              (should (equal (gdev-workspace-directory) beta))))
        (when gdev-sidebar--timer (cancel-timer gdev-sidebar--timer))
        (when-let* ((buffer (find-buffer-visiting second))) (kill-buffer buffer))
        (delete-directory root t)))))

