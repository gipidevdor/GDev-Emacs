(ert-deftest gdev-test-editor-grid-completes-in-place-and-rolls-back ()
  "La griglia completa una T e ripristina il layout se lo spazio è insufficiente."
  (require 'gdev-commands)
  (gdev-test--with-layout
    (let ((source (selected-window))
          (documents (mapcar #'generate-new-buffer '("Sorgente" "Regole" "Test" "Fixture"))))
      (unwind-protect
          (progn
            (dolist (buffer documents)
              (with-current-buffer buffer (insert "Un documento aperto") (gdev-layout-mark-document)))
            (switch-to-buffer (car documents))
            (goto-char 7)
            (let ((window-min-height (window-total-height source)))
              (should-error (gdev-split-editor-grid) :type 'user-error))
            (should (equal (gdev-layout--editors) (list source)))
            (should (eq (selected-window) source))
            (should (= (point) 7))
            (let* ((top-right (gdev-split-editor-right))
                   (bottom-left (gdev-split-editor-below source)))
              (set-window-buffer top-right (nth 1 documents))
              (set-window-buffer bottom-left (nth 2 documents))
              (set-window-point bottom-left 11)
              (should-error (gdev-split-editor-right source) :type 'user-error)
              (gdev-split-editor-grid top-right)
              (let ((bottom-right (window-in-direction 'below top-right)))
                (set-window-buffer bottom-right (nth 3 documents))
                (should (gdev-layout-editor-grid-p))
                (should-not (gdev-layout--commands-width '(82 . 0) 36 (selected-frame)))
                (should (= (gdev-layout--commands-width '(114 . 0) 36 (selected-frame)) 36))
                (should (eq (selected-window) top-right))
                (should (eq (window-buffer bottom-left) (nth 2 documents)))
                (should (= (window-point bottom-left) 11))
                (should (= (nth 1 (window-pixel-edges bottom-left))
                           (nth 1 (window-pixel-edges bottom-right))))
                (let ((windows (gdev-layout--editors)))
                  (gdev-split-editor-grid)
                  (should (equal (gdev-layout--editors) windows))
                  (should-error (split-window bottom-right nil 'below) :type 'user-error))
                (dotimes (_ 4) (gdev-focus-other-editor))
                (should (eq (selected-window) top-right)))))
        (mapc #'kill-buffer documents)))))

(ert-deftest gdev-test-document-symbol-picker-targets-the-clicked-group ()
  "Simboli cerca classi e funzioni nel documento indicato dal clic."
  (require 'gdev-commands)
  (unless (fboundp 'gdev-breadcrumb-symbols)
    (require 'package)
    (package-activate-all)
    (load (gdev-module-file :ui 'breadcrumb ".el") nil t t))
  (gdev-test--with-layout
    (let* ((source (selected-window))
           (peer (gdev-split-editor-right))
           (code (generate-new-buffer "Documento indicizzato"))
           (click (lookup-key (get-text-property 0 'local-map gdev-breadcrumb--symbol-button)
                              [header-line mouse-1]))
           (event (list 'mouse-1 (list peer 'header-line '(1 . 1) 0))))
      (unwind-protect
          (progn
            (with-current-buffer code
              (insert "Registro\nnormalizza\n")
              (setq-local imenu-create-index-function
                          (lambda () '(("Classi" ("Registro" . 1))
                                       ("Funzioni" ("normalizza" . 10)))))
              (gdev-layout-mark-document))
            (set-window-buffer peer code)
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt table &rest _)
                         (should (eq (current-buffer) code))
                         (should (eq (selected-window) peer))
                         (let ((names (all-completions "" table)))
                           (should (seq-some (lambda (name) (string-match-p "Registro" name)) names))
                           (seq-find (lambda (name) (string-match-p "normalizza" name)) names)))))
              (funcall click event))
            (should (eq (selected-window) peer))
            (should (= (point) 10))
            (select-window source)
            (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil))))
              (condition-case nil (funcall click event) (quit nil)))
            (should (eq (selected-window) source))
            (should (= (window-point peer) 10)))
        (kill-buffer code)))))

(ert-deftest gdev-test-private-bytecode-follows-source ()
  "Il bytecode privato si carica se aggiornato e sopravvive a una compilazione fallita."
  (let ((package-quickstart package-quickstart))
    (require 'gdev-cli))
  (let* ((gdev-user-directory (make-temp-file "gdev-private-compile-" t))
         (source (gdev-user-file "config.el"))
         (bytecode (concat source "c"))
         (init-file-debug t)
         (load-history nil)
         (byte-compile-log-warning-function #'ignore))
    (unwind-protect
        (progn
          (with-temp-file source (insert ";; -*- lexical-binding: t -*-\n(ignore)\n"))
          (should (eq t (gdev-cli--compile-private-file source)))
          (gdev-modules--load-private "config")
          (should (assoc bytecode load-history))
          (let ((compile-file (symbol-function 'byte-compile-file)))
            (cl-letf (((symbol-function 'byte-compile-file)
                       (lambda (file)
                         (prog1 (funcall compile-file file)
                           (with-temp-file source
                             (insert ";; -*- lexical-binding: t -*-\n(ignore 'modificato)\n"))
                           (set-file-times source (time-add nil 2))))))
              (should-not (gdev-cli--compile-private-file source))))
          (should (file-newer-than-file-p source bytecode))
          (with-temp-file source (insert ";; -*- lexical-binding: t -*-\n(progn\n"))
          (set-file-times source (time-add nil 2))
          (should-not (gdev-cli--compile-private-file source))
          (should (load bytecode nil t t))
          (should-error (gdev-modules--load-private "config") :type 'end-of-file)
          (with-temp-file source (insert ";; -*- lexical-binding: t; no-byte-compile: t -*-\n"))
          (set-file-times source (time-add nil 2))
          (gdev-modules--load-private "config")
          (should (assoc source load-history))
          (should (eq 'no-byte-compile (gdev-cli--compile-private-file source)))
          (should (equal (directory-files gdev-user-directory nil "^[^.]") '("config.el"))))
      (delete-directory gdev-user-directory t))))

(ert-deftest gdev-test-run-view-keeps-default-and-explicit-debug-adapters ()
  "I vecchi profili usano LLDB e i nuovi conservano l'adattatore scelto."
  (require 'package)
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (let ((directory (make-temp-file "gdev-debug-profiles-" t)))
    (unwind-protect
        (let ((root (file-name-as-directory directory)))
          (with-temp-file (expand-file-name "fixture.dll" root) (insert "fixture"))
          (gdev-test--with-layout
            (with-temp-buffer
              (let ((gdev-launch-profiles
                     (list (list root '("Vecchio" "fixture.dll" ("one") ("NAME=value"))
                                 '("Net" "fixture.dll" ("one") ("NAME=some=value") netcoredbg))))
                    (gdev-activity-kind 'run)
                    (gdev-project-view--root root)
                    (default-directory root)
                    (choice "Net")
                    config)
                (set-window-buffer (gdev-layout-editor) (current-buffer))
                (cl-letf (((symbol-function 'dape) (lambda (value &rest _) (setq config value)))
                          ((symbol-function 'gdev-project-view--run-command)
                           (lambda (command) (call-interactively command)))
                          ((symbol-function 'completing-read) (lambda (&rest _) choice))
                          ((symbol-function 'gdev-debug-lldb-dap) (lambda () "lldb-dap")))
                  (gdev-project-view-select-profile)
                  (gdev-project-view-launch t)
                  (should (equal (plist-get config 'command) "netcoredbg"))
                  (should (equal (plist-get config :args) ["one"]))
                  (should (equal (gethash "NAME" (plist-get config :env)) "some=value"))
                  (should (equal (plist-get config :cwd) root))
                  (set-file-modes (expand-file-name "fixture.dll" root) #o700)
                  (setq choice "Vecchio")
                  (gdev-project-view-select-profile)
                  (gdev-project-view-launch t)
                  (should (equal (plist-get config 'command) "lldb-dap"))
                  (should (equal (plist-get config :env) ["NAME=value"])))))))
      (delete-directory directory t))))

(ert-deftest gdev-test-debug-workbench-keeps-actions-in-the-owning-space ()
  "La connessione scelta altrove non riceve le azioni del riquadro."
  (require 'package)
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (let* ((owner (make-symbol "workspace-one"))
         (other-owner (make-symbol "workspace-two"))
         (gdev-debug--local-targets (make-hash-table :test #'eq))
         (dape--connection-selected 'other)
         action)
    (cl-letf (((symbol-function 'dape--live-connections) (lambda () '(other child main)))
              ((symbol-function 'dape--root-of) (lambda (conn) (if (eq conn 'child) 'main conn)))
              ((symbol-function 'dape--config)
               (lambda (conn) (list 'gdev-workspace (if (eq conn 'other) other-owner owner)
                                    'command-cwd (if (eq conn 'other) "/ssh:example:/project/" "/tmp/"))))
              ((symbol-function 'dape--state) (lambda (_) 'stopped))
              ((symbol-function 'dape-continue) (lambda (conn) (setq action conn))))
      (with-temp-buffer
        (setq-local gdev-debug-workbench--owner owner)
        (should (equal (gdev-debug-workspace-connections owner) '(child main)))
        (should (eq (gdev-debug-workbench--connection) 'child))
        (gdev-debug-workbench--controls #'dape-continue)
        (should (eq action 'child))
        (gdev-debug--remember-target 'child '(:systemProcessId 234 :isLocalProcess t))
        (gdev-debug--remember-target 'main '(:systemProcessId 345 :isLocalProcess :json-false))
        (gdev-debug--remember-target 'other '(:systemProcessId 456 :isLocalProcess t))
        (should (equal (gdev-debug-workbench--target 'child) '(234 . child)))
        (should-not (gdev-debug-workspace-target 'main))
        (should-not (gdev-debug-workspace-target 'other))))))

(ert-deftest gdev-test-debug-workbench-launch-stays-in-the-current-space ()
  "L'avvio automatico continua la sessione dello spazio o ne avvia una nuova."
  (require 'package)
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (require 'dape)
  (let ((gdev-layout-mode t)
        (dape-active-mode t)
        (owner (make-symbol "spazio"))
        (config '(:program "prova"))
        connection actions)
    (cl-letf (((symbol-function 'gdev-workspace-state-id)
               (lambda (&optional _frame) owner))
              ((symbol-function 'gdev-project-view--run-command)
               (lambda (command) (call-interactively command)))
              ((symbol-function 'gdev-layout-editor) #'ignore)
              ((symbol-function 'gdev-debug-workspace-connection)
               (lambda (space)
                 (should (eq space owner))
                 connection))
              ((symbol-function 'dape--state) (lambda (_) 'stopped))
              ((symbol-function 'dape-continue)
               (lambda (session)
                 (interactive (list 'altro-spazio))
                 (push session actions)))
              ((symbol-function 'gdev-launch-dispatch) #'ignore)
              ((symbol-function 'gdev-handler) #'ignore)
              ((symbol-function 'dape--read-config) (lambda () config))
              ((symbol-function 'dape) (lambda (launch) (push launch actions))))
      (with-temp-buffer
        (setq-local gdev-activity-kind 'run)
        (gdev-project-view-launch t)
        (setq connection 'sessione-locale)
        (gdev-project-view-launch t)
        (should (equal actions (list 'sessione-locale config)))))))

(ert-deftest gdev-test-debug-workbench-process-history-rejects-reused-pids ()
  "Un PID riutilizzato non eredita le misure del processo precedente."
  (with-temp-buffer
    (let ((sample (gdev-debug-workbench--parse-process " 12.5  1024 Wed Feb 12 00:24:38 2025 \n")))
      (should (equal sample '(12.5 1048576 "Wed Feb 12 00:24:38 2025")))
      (gdev-debug-workbench--accept-sample sample)
      (gdev-debug-workbench--accept-sample '(0 2048 "Wed Feb 12 00:24:38 2025"))
      (should (equal gdev-debug-workbench--cpu-history '(0 12.5)))
      (gdev-debug-workbench--accept-sample '(99 4096 "Thu Feb 13 00:24:38 2025"))
      (should (eq gdev-debug-workbench--sample 'unavailable))
      (should (equal gdev-debug-workbench--cpu-history '(0 12.5))))))

(ert-deftest gdev-test-debug-workbench-page-and-action-survive-redraw ()
