              (let ((window-min-width (window-total-width (window-main-window))))
                (should-error (gdev-split-editor-right)))
              (should (eq (gdev-layout-other-editor source) peer))
              (should (eq (gdev-layout--panel) panel))
              (gdev-rotate-editor-pair)
              (setq peer (gdev-layout-other-editor source))
              (should (eq (selected-window) source))
              (should (eq (gdev-layout-editor-direction source) 'right))
              (should (= (length (gdev-layout--editors)) 2))
              (should (eq (window-buffer peer) second))
              (should (= (window-point peer) 21))
              (should (assq history (window-prev-buffers peer)))
              (should (equal (window-parameter peer 'tab-line-buffers) (list second history)))
              (should (eq (gdev-layout--panel) panel))
              (gdev-focus-other-editor)
              (should (eq (selected-window) peer))
              (gdev-rotate-editor-pair)
              (should (eq (selected-window) peer))
              (should (eq (current-buffer) second))
              (should (eq (window-buffer (window-top-child (window-main-window))) first))))
        (mapc #'kill-buffer (list first second history tool))))))

(ert-deftest gdev-test-editor-split-opens-a-tab-in-the-target-group ()
