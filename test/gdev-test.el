;;;; Funzioni di supporto

(defun gdev-test--repository-files ()
  "Restituisce i file della copia di lavoro che Git traccerebbe."
  (let ((default-directory gdev-config-directory))
    ;; Anche prima della prima registrazione (commit): ls-files conosce già
    ;; .gitignore.
    (if (and (file-exists-p ".git")
             (zerop (call-process "git" nil nil nil "rev-parse" "--git-dir")))
        (mapcar #'expand-file-name
                (process-lines "git" "ls-files" "--cached" "--others" "--exclude-standard"))
      (cl-remove-if (lambda (file) (string-match-p "/\\.git/\\|\\.elc\\'" file))
                    (directory-files-recursively gdev-config-directory "" nil)))))

(defun gdev-test--elisp-sources ()
  "Restituisce i sorgenti Emacs Lisp della copia di lavoro, tranne templates/."
  (append (directory-files (gdev-config-file "lisp/") t "\\.el\\'")
          (directory-files-recursively (gdev-config-file "modules/") "\\.el\\'")
          (list (gdev-config-file "early-init.el") (gdev-config-file "init.el")
                (gdev-config-file "test/gdev-test.el"))))

;;;; Igiene del repository

(ert-deftest gdev-test-module-guides-show-documentation-and-source-link ()
  "Ogni modulo ha una guida. L'aiuto presenta il testo e collega il sorgente."
  (require 'lisp-mnt)
  (dolist (entry (gdev-modules-available))
    (let ((file (gdev-module-file (car entry) (cdr entry) ".el")))
      (ert-info ((format "Guida di %s %s" (car entry) (cdr entry)))
        (should (lm-summary file))
        (should-not (string-empty-p (or (lm-commentary file) ""))))))
  (let ((name "*Guida del modulo :ui workbench*")
        opened)
    (unwind-protect
        (save-window-excursion
          (gdev-describe-module :ui 'workbench)
          (with-current-buffer name
            (should (derived-mode-p 'help-mode))
            (should buffer-read-only)
            (goto-char (point-min))
            (should (looking-at "interfaccia e disposizione di GDev"))
            (should-not (string-search ";;; Code:" (buffer-string)))
            (search-forward "Apri il sorgente del modulo")
            (let ((button (button-at (1- (point)))))
              (should button)
              (cl-letf (((symbol-function 'view-file)
                         (lambda (file &rest _) (setq opened file))))
                (button-activate button))))
          (should (equal opened (gdev-module-file :ui 'workbench ".el"))))
      (when-let* ((buffer (get-buffer name)))
        (kill-buffer buffer)))))

(ert-deftest gdev-test-file-headers ()
  "Ogni sorgente ha lexical-binding, licenza, Commentary e riga finale."
  (dolist (file (gdev-test--elisp-sources))
    (let ((name (file-name-nondirectory file))
          (text (gdev-read-file-contents file)))
      (should (string-match-p "\\`;;; .* -\\*- lexical-binding: t;" text))
      (should (string-match-p "SPDX-License-Identifier: GPL-3.0-or-later" text))
      (should (string-match-p "^;;; Commentary:" text))
      (should (string-match-p (format "^;;; %s ends here\n?\\'" (regexp-quote name)) text)))))

