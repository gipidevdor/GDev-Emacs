(ert-deftest gdev-test-context-menu-keeps-focus-and-uses-unmarked-row ()
  "Il clic in un altro riquadro mantiene il fuoco fino alla scelta."
  (require 'dired-aux)
  (let* ((root (make-temp-file "gdev-menu-dired-" t))
         (marked (expand-file-name "a.txt" root))
         (clicked (expand-file-name "b.txt" root))
         (kill-ring nil)
         buffer files)
    (unwind-protect
        (save-window-excursion
          (with-temp-file marked)
          (with-temp-file clicked)
          (setq buffer (dired-noselect root))
          (let* ((editor (selected-window))
                 (directory-window (split-window-right))
                 position)
            (set-window-buffer directory-window buffer)
            (with-selected-window directory-window
              (dired-goto-file marked)
              (dired-mark 1)
              (dired-goto-file clicked)
              (setq position (point))
              (dired-goto-file marked))
            (let ((menu (gdev-test--context-menu position directory-window)))
              (should (eq (selected-window) editor))
              (with-selected-window directory-window
                (should (equal (dired-get-filename) marked)))
              (cl-letf (((symbol-function 'dired-do-create-files)
                         (lambda (_operation _creator _description prefix &rest _)
                           (setq files (dired-get-marked-files nil prefix)))))
                (call-interactively (lookup-key menu [dired-do-rename])))
              (should (equal files (list clicked)))
              (should (eq (selected-window) directory-window))
              (call-interactively (lookup-key menu [gdev-context-copy-path]))
              (should (equal (car kill-ring) clicked)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest gdev-test-context-menu-retargets-native-submenus ()
  "I filtri e le azioni native vedono il riquadro e l'evento originali."
  (let ((buffer (generate-new-buffer "gdev-menu-nativo"))
        event position called)
    (unwind-protect
        (save-window-excursion
          (let* ((editor (selected-window))
                 (tool (split-window-right))
                 (context-menu-functions
                  (list
                   (lambda (menu _click)
                     (define-key-after
                      menu [submenu]
                      `(menu-item "Strumento" ,(make-sparse-keymap)
                                  :filter
                                  ,(lambda (_)
                                     (let ((submenu (make-sparse-keymap)))
                                       (when (and (eq (selected-window) tool) (= (point) position))
                                         (define-key-after
                                          submenu [azione]
                                          `(menu-item "Apri"
                                                      ,(lambda (click)
                                                         (interactive "e")
                                                         (setq called (list click (point) (selected-window)))))))
                                       submenu))))
                     menu))))
            (set-window-buffer tool buffer)
            (with-selected-window tool
              (insert "prima\nseconda\n")
              (goto-char (point-min))
              (setq position (+ 2 (line-end-position))))
            (setq event (list 'down-mouse-3 (list tool position '(0 . 0) 0)))
            (let* ((menu (gdev-test--context-menu position tool))
                   (action (lookup-key menu [gdev-other submenu azione])))
              (should (eq editor (selected-window)))
              (should (commandp action))
              (call-interactively action)
              (should (equal called (list event position tool))))))
      (kill-buffer buffer))))

(ert-deftest gdev-test-context-menu-follows-workspace-identity ()
  "Rinomina e chiusura seguono lo spazio cliccato anche se cambia ordine."
  (let* ((first (list 'current-tab '(name . "Primo")))
         (second (list 'tab '(name . "Secondo")))
         (tabs (list first second))
         (event (list 'down-mouse-3 (list (selected-window) 'tab-bar '(0 . 0) 0)))
         renamed)
    (cl-letf (((symbol-function 'tab-bar--event-to-item) (lambda (_) '(tab-2)))
              ((symbol-function 'tab-bar--key-to-number) (lambda (_) 2))
              ((symbol-function 'tab-bar-tabs) (lambda (&optional _) tabs))
              ((symbol-function 'read-string)
               (lambda (_prompt name &rest _)
                 (should (equal name "Secondo"))
                 (setq tabs (list second first))
                 "Progetto"))
              ((symbol-function 'tab-bar-rename-tab)
               (lambda (name index) (setq renamed (cons name index))))
              ((symbol-function 'popup-menu)
               (lambda (menu _position &rest _)
                 (call-interactively (lookup-key menu [rename]))
                 (should (equal renamed '("Progetto" . 1)))
                 (setq tabs (list first (list 'tab '(name . "Terzo"))))
                 (should-error (call-interactively (lookup-key menu [close])) :type 'user-error))))
      (gdev-context-workspace event))))

(ert-deftest gdev-test-context-menu-diff-compilation-and-tabs ()
