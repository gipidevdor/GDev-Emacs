    (cl-labels ((walk (spec)
                  (cond ((and (vectorp spec) (> (length spec) 1) (stringp (aref spec 0)))
                         (when-let* ((keys (plist-get (append (substring spec 2) nil) :key-sequence)))
                           (cl-pushnew (aref spec 0) (gethash (cons (aref spec 1) keys) names)
