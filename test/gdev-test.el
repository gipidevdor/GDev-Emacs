(ert-deftest gdev-test-flymake-indicators-have-contextual-help ()
  "Bordo e margine distinguono la gravità e mostrano un estratto breve."
  (require 'flymake)
  (load (gdev-module-file :checkers 'syntax ".el") nil t t)
  (with-temp-buffer
    (insert "errore\navviso\nnota\n")
    (let* ((flymake-start-on-flymake-mode nil)
           (flymake-show-diagnostics-at-end-of-line nil)
           (flymake-autoresize-margins nil)
           (flymake-fringe-indicator-position 'right-fringe)
           (flymake-margin-indicator-position 'left-margin)
           (source (current-buffer))
           (diagnostics
            (list (flymake-make-diagnostic source 1 6 :error "Espressione incompleta\nDettagli")
                  (flymake-make-diagnostic source 8 13 :warning "Variabile inutilizzata")
                  (flymake-make-diagnostic source 15 18 :note (make-string 100 ?n)))))
      (setq-local trusted-content :all)
      (setq-local flymake-diagnostic-functions
                  (list (lambda (report &rest _) (funcall report diagnostics))))
      (flymake-mode 1)
      (let ((flymake-indicator-type 'fringes))
        (flymake-start)
        (pcase-let ((`(,error ,warning ,note) (mapcar #'flymake--diag-overlay diagnostics)))
          (should (equal (overlay-get error 'right-fringe-help) "Errore · Espressione incompleta"))
          (should (equal (overlay-get warning 'right-fringe-help) "Avviso · Variabile inutilizzata"))
          (should-not (overlay-get warning 'left-fringe-help))
          (let ((help (overlay-get note 'right-fringe-help)))
            (should (string-prefix-p "Nota · " help))
            (should (string-suffix-p "…" help))
            (should (<= (string-width help) 75)))))
      (let ((flymake-indicator-type 'margins))
        (flymake-start)
        (let* ((overlay (flymake--diag-overlay (car diagnostics)))
               (display (get-text-property 0 'display (overlay-get overlay 'before-string)))
               (glyph (cadr display)))
          (should (equal (car display) '(margin left-margin)))
          (should (string-prefix-p "Errore · Espressione incompleta"
                                   (get-text-property 0 'help-echo glyph)))))
      (when (fboundp 'flymake--bs-display)
        (let ((flymake-indicator-type 'auto))
          (flymake-start)
          (let* ((overlay (flymake--diag-overlay (car diagnostics)))
                 (display (get-text-property 0 'display (overlay-get overlay 'before-string)))
                 (margin (cddr (cadr display)))
                 (glyph (cadr margin)))
            (should (string-prefix-p "Errore · Espressione incompleta"
                                     (get-text-property 0 'help-echo glyph)))
            (should (eq (lookup-key (get-text-property 0 'keymap glyph) [left-margin mouse-1])
                        'flymake-show-buffer-diagnostics))))))))

(ert-deftest gdev-test-modeline-distinguishes-diagnostic-counts ()
