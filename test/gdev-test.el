           (buffer (generate-new-buffer "contenuto-anteprima")))
      (unwind-protect
          (progn
            (with-temp-file file (insert ";; Esempio\n\n(defun prova () nil)\n"))
            (with-current-buffer buffer
              (insert-file-contents file)
              (emacs-lisp-mode))
            (switch-to-buffer original)
            (insert "Bozza da lasciare intatta")
