            (should (equal (gdev-workspace-roots) (list alpha beta)))
            (with-current-buffer (window-buffer (window-with-parameter 'gdev-sidebar t))
              (dolist (path (list (directory-file-name alpha) (directory-file-name beta) first second))
                (should (gdev-sidebar--path-position path))))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt table &rest _)
                         (let ((names (all-completions "" table)))
                           (should (member "documento.txt" names))
                           (should (member "../beta/documento.txt" names)))
                         "../beta/documento.txt")))
              (gdev-quick-open))
            (should (eq (selected-window) editor))
            (should (equal buffer-file-name second))
            (should (equal (gdev-workspace-directory) beta))
