(require 'gdev-timeline)
(require 'gdev-commands)

(ert-deftest gdev-test-timeline-copies-bytes-bounds-and-excludes ()
  (let* ((directory (make-temp-file "gdev-cronologia-test-" t))
         (gdev-state-directory (expand-file-name "stato" directory))
         (gdev-timeline-local-size-limit 8)
         (gdev-timeline-local-entry-limit 2)
         (file (expand-file-name "doc.txt" directory))
         (secret (expand-file-name ".env" directory)))
    (unwind-protect
        (progn
          (with-temp-buffer
            (dolist (text '("v1" "v2" "v3\r\n"))
              (let ((coding-system-for-write 'no-conversion))
                (write-region text nil file nil 'silent))
              (setq buffer-file-name file)
              (gdev-timeline-record))
            (write-region "123456789" nil file nil 'silent)
            (gdev-timeline-record)
            (write-region "privato" nil secret nil 'silent)
            (setq buffer-file-name secret)
            (gdev-timeline-record))
          (should-not (file-exists-p (gdev-timeline--directory secret)))
          (let* ((copies (gdev-timeline--directory file))
                 (snapshots (gdev-timeline--snapshots copies)))
            (should (= (length snapshots) 2))
            (let ((latest (expand-file-name (car snapshots) copies)))
              (should (= (logand (file-modes latest) #o077) 0))
              (with-temp-buffer
                (insert-file-contents-literally latest)
                (should (equal (buffer-string) "v3\r\n"))))))
      (delete-directory directory t))))

(ert-deftest gdev-test-timeline-excludes-aliased-files ()
  (let* ((directory (make-temp-file "gdev-cronologia-alias-" t))
         (gdev-state-directory (expand-file-name "stato" directory))
         (find-file-visit-truename nil)
         (secret (expand-file-name ".env" directory))
         (alias (expand-file-name "documento.txt" directory))
         document)
    (unwind-protect
        (progn
          (write-region "valore di prova" nil secret nil 'silent)
          (make-symbolic-link secret alias)
          (setq document (find-file-noselect alias))
          (with-current-buffer document
            (should (equal buffer-file-name alias))
            (should (file-equal-p buffer-file-truename (file-truename secret)))
            (gdev-timeline-record))
          (should-not (file-exists-p (gdev-timeline--directory alias))))
      (when (buffer-live-p document) (kill-buffer document))
      (delete-directory directory t))))

(ert-deftest gdev-test-timeline-real-git-follows-rename ()
  (skip-unless (executable-find "git"))
  (let* ((directory (make-temp-file "gdev-cronologia-git-" t))
         (gdev-state-directory (expand-file-name "stato" directory))
         (default-directory (file-name-as-directory directory))
         (original (expand-file-name "prima.txt" directory))
         (file (expand-file-name "dopo con spazio.txt" directory))
         view document)
    (unwind-protect
        (gdev-test--with-layout
          (cl-flet ((git (&rest args)
                      (with-temp-buffer
                        (unless (zerop (apply #'process-file "git" nil t nil
                                             "-c" "user.email=prova@example.org"
                                             "-c" "user.name=GDev"
                                             "-c" "commit.gpgsign=false" args))
                          (ert-fail (buffer-string))))))
            (git "init" "-q")
            (write-region "prima\n" nil original nil 'silent)
            (git "add" "--" original)
            (git "commit" "-qm" "Versione iniziale")
            (git "mv" "--" original file)
            (git "commit" "-qm" "File rinominato")
            (setq document (find-file-noselect file))
            (switch-to-buffer document)
            (call-interactively #'gdev-timeline-open)
            (setq view (current-buffer))
            (should (derived-mode-p 'gdev-timeline-mode))
            (should (window-parameter (selected-window) 'window-side))
            (let ((timeout (+ (float-time) 4)))
              (while (and gdev-timeline--log-job (< (float-time) timeout))
                (accept-process-output nil 0.05)))
            (should-not gdev-timeline--git-status)
            (should (equal (mapcar #'gdev-timeline--entry-path gdev-timeline--git-entries)
                           '("dopo con spazio.txt" "prima.txt")))
            (should (equal (gdev-timeline--entry-at-point) (car gdev-timeline--git-entries)))
            (gdev-timeline-move 1)
            (should (equal (gdev-timeline--entry-at-point) (cadr gdev-timeline--git-entries)))
            (let (contents)
              (gdev-timeline--with-version
               (gdev-timeline--entry)
               (lambda (snapshot)
                 (setq contents (with-temp-buffer (insert-file-contents snapshot) (buffer-string)))))
              (let ((timeout (+ (float-time) 4)))
                (while (and gdev-timeline--action-job (< (float-time) timeout))
                  (accept-process-output nil 0.05)))
              (should (equal contents "prima\n")))
            (gdev-timeline-move -1)
            (should (equal (gdev-timeline--entry-at-point) (car gdev-timeline--git-entries)))))
      (dolist (buffer (list view document))
        (when (buffer-live-p buffer) (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest gdev-test-timeline-restore-revalidates-after-confirmation ()
  (let* ((directory (make-temp-file "gdev-cronologia-conferma-" t))
         (gdev-state-directory (expand-file-name "stato" directory))
         (file (expand-file-name "testo.txt" directory))
         view document)
    (unwind-protect
        (gdev-test--with-layout
          (write-region "versione archiviata\n" nil file nil 'silent)
          (setq document (find-file-noselect file))
          (with-current-buffer document
            (gdev-timeline-record)
            (erase-buffer)
            (insert "bozza"))
          (set-window-buffer (gdev-layout-editor) document)
          (gdev-timeline-open file)
          (setq view (current-buffer))
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (&rest _)
                       (with-current-buffer document (insert " aggiornata"))
                       t)))
            (should-error (gdev-timeline-restore) :type 'user-error))
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (&rest _)
                       (write-region "sostituzione su disco\n" nil file nil 'silent)
                       t)))
            (should-error (gdev-timeline-restore) :type 'user-error))
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (&rest _) (tab-bar-new-tab) t)))
            (should-error (gdev-timeline-restore) :type 'user-error))
          (should-not (eq document (window-buffer (gdev-layout-editor))))
          (with-current-buffer document
            (should (equal (buffer-string) "bozza aggiornata")))
          (with-temp-buffer
            (insert-file-contents file)
            (should (equal (buffer-string) "sostituzione su disco\n"))))
      (dolist (buffer (list view document))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest gdev-test-timeline-restore-keeps-disk-and-can-undo ()
  (let* ((directory (make-temp-file "gdev-cronologia-ripristino-" t))
         (gdev-state-directory (expand-file-name "stato" directory))
         (file (expand-file-name "testo.txt" directory))
         view document)
    (unwind-protect
        (gdev-test--with-layout
          (write-region "versione prima\n" nil file nil 'silent)
          (setq document (find-file-noselect file))
          (with-current-buffer document
            (gdev-timeline-record)
            (erase-buffer)
            (insert "cambiamento non salvato\n"))
          (write-region "versione su disco\n" nil file nil 'silent)
          (with-current-buffer document (set-visited-file-modtime))
          (gdev-timeline-open file)
          (setq view (current-buffer))
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) nil)))
            (gdev-timeline-restore))
          (with-current-buffer document
            (should (equal (buffer-string) "cambiamento non salvato\n")))
          (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t)))
            (gdev-timeline-restore))
          (should (eq document (current-buffer)))
          (should (buffer-modified-p))
          (should (equal (buffer-string) "versione prima\n"))
          (with-temp-buffer
            (insert-file-contents file)
            (should (equal (buffer-string) "versione su disco\n")))
          (let ((last-command nil)) (undo-only))
          (should (equal (buffer-string) "cambiamento non salvato\n")))
      (dolist (buffer (list view document))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest gdev-test-timeline-confronta-salvataggio-e-commit-in-sola-lettura ()
  (skip-unless (executable-find "git"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-confronto-versioni-" t)))
         (gdev-state-directory (expand-file-name "stato" root))
         (default-directory root)
         (file (expand-file-name "versioni.txt" root))
         view control left right)
    (unwind-protect
        (gdev-test--with-layout
          (cl-flet ((git (&rest args)
                      (with-temp-buffer
                        (unless (zerop (apply #'process-file "git" nil t nil
                                             "-c" "user.email=prova@example.org" "-c" "user.name=GDev"
                                             "-c" "commit.gpgsign=false" args))
                          (ert-fail (buffer-string))))))
            (git "init" "-q")
            (write-region "Versione Git\n" nil file nil 'silent)
            (git "add" "--" file)
            (git "commit" "-qm" "Versione Git")
            (write-region "Salvataggio locale\n" nil file nil 'silent)
            (with-temp-buffer
              (setq buffer-file-name file)
              (gdev-timeline-record))
            (write-region "Testo sul disco\n" nil file nil 'silent)
            (gdev-timeline-open file)
            (setq view (current-buffer))
            (let ((deadline (+ (float-time) 5)))
              (while (and gdev-timeline--log-job (< (float-time) deadline))
                (accept-process-output nil 0.05)))
            (should (eq (gdev-timeline--entry-source (gdev-timeline--entry)) 'local))
            (let ((position (point)))
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (&rest _) (signal 'quit nil))))
                (should (eq 'annullato
                            (condition-case nil (call-interactively (key-binding (kbd "c")))
                              (quit 'annullato)))))
              (should (eq (current-buffer) view))
              (should (= position (point)))
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (_prompt choices &rest _)
                           (goto-char (point-max))
                           (caar choices))))
                (should-error (call-interactively (key-binding (kbd "c"))) :type 'user-error))
              (should-not gdev-timeline--action-job)
              (goto-char position))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt choices &rest _)
                         (should (= (length choices) 1))
                         (caar choices))))
              (call-interactively (key-binding (kbd "c"))))
            (let ((deadline (+ (float-time) 5)))
              (while (and (buffer-local-value 'gdev-timeline--action-job view)
                          (< (float-time) deadline))
                (accept-process-output nil 0.05)))
            (setq control (gdev-workspace-state-get 'gdev-comparison-control))
            (should (buffer-live-p control))
            (setq left (buffer-local-value 'ediff-buffer-A control)
                  right (buffer-local-value 'ediff-buffer-B control))
            (dolist (pair (list (cons left "Salvataggio locale\n") (cons right "Versione Git\n")))
              (with-current-buffer (car pair)
                (should buffer-read-only)
                (should-not buffer-file-name)
                (should (equal (buffer-string) (cdr pair)))))
            (cl-letf (((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
              (gdev-comparison-close control))
            (should-not (buffer-live-p left))
            (should-not (buffer-live-p right))
            (should (eq (window-buffer (selected-window)) view))
            (with-temp-buffer
              (insert-file-contents file)
              (should (equal (buffer-string) "Testo sul disco\n")))))
      (dolist (buffer (list control left right view))
        (when (buffer-live-p buffer) (kill-buffer buffer)))
      (delete-directory root t))))

(provide 'gdev-timeline-test)
