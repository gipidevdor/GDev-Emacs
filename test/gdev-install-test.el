;;; gdev-install-test.el --- Primo ingresso esplicito e riscontro -*- lexical-binding: t; -*-
;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Commentary:
;; Il lanciatore sceglie il checkout; soltanto l'istanza avviata può confermarne
;; il caricamento. Queste prove includono profili estranei ed esiti negativi.
;;; Code:
(require 'ert)
(require 'gdev-install)
(load (gdev-config-file "bin/gdev-startup-check.el") nil t t)

;; Il riscontro legge questi stati anche quando la prova carica soltanto
;; l'installatore, senza inizializzare Workbench e gli altri proprietari.
(defvar gdev-layout-mode)
(defvar gdev-state-startup-issue)
(defvar gdev-modules-private-errors)
(defvar gdev-failed-modules)

(ert-deftest gdev-test-install-launcher-keeps-checkout-profile-and-arguments ()
  (let* ((directory (make-temp-file "gdev-ingresso-" t))
         (gdev-config-directory (expand-file-name "checkout con spazi è '" directory))
         (process-environment (copy-sequence process-environment))
         app)
    (unwind-protect
        (progn
          (make-directory (expand-file-name "bin" gdev-config-directory) t)
          (with-temp-file (expand-file-name "bin/gdev" gdev-config-directory)
            (insert "#!/bin/sh\nprintf '%s\\n' \"$GDEV_USER_DIR\" \"${GDEV_STATE_DIR:-assente}\" \"$GDEV_STARTUP_REQUIRE_WORKBENCH\" \"$GDEV_STARTUP_REQUIRE_GRAPHICAL\" \"$@\"\n"))
          (set-file-modes (expand-file-name "bin/gdev" gdev-config-directory) #o700)
          (setenv "GDEV_USER_DIR" "profilo con spazi è ' $nessuna_espansione")
          (setenv "GDEV_STATE_DIR" nil)
          (setq app (gdev-install-macos-application directory))
          (should (equal app (gdev-install-macos-application directory)))
          ;; Un ambiente ereditato da un'altra sessione non cambia il profilo.
          (setenv "GDEV_USER_DIR" "altro profilo")
          (setenv "GDEV_STATE_DIR" "altro stato")
          (with-temp-buffer
            (should (zerop (call-process (expand-file-name "Contents/MacOS/gdev" app)
                                         nil t nil "documento con spazi è.txt")))
            (should (equal (buffer-string)
                           "profilo con spazi è ' $nessuna_espansione\nassente\n1\n1\nemacs\ndocumento con spazi è.txt\n"))))
      (delete-directory directory t))))

(ert-deftest gdev-test-install-launcher-preserves-unrelated-apps-and-links ()
  (let* ((directory (make-temp-file "gdev-ingresso-" t))
         (app (expand-file-name "GDev-Emacs.app" directory))
         (personal (expand-file-name "personale" app)))
    (unwind-protect
        (progn
          (make-directory app)
          (with-temp-file personal (insert "da conservare"))
          (should-error (gdev-install-macos-application directory) :type 'user-error)
          (should (equal "da conservare" (gdev-read-file-contents personal)))
          (delete-directory app t)
          (make-symbolic-link "destinazione-assente" app)
          (should-error (gdev-install-macos-application directory) :type 'user-error)
          (should (file-symlink-p app))
          (delete-file app)
          (gdev-install-macos-application directory)
          (delete-directory (expand-file-name "Contents/MacOS" app) t)
          (make-symbolic-link "destinazione-assente" (expand-file-name "Contents/MacOS" app))
          (should-error (gdev-install-macos-application directory) :type 'user-error)
          (should (file-symlink-p (expand-file-name "Contents/MacOS" app))))
      (delete-directory directory t))))

(ert-deftest gdev-test-install-startup-receipt-rejects-errors-and-missing-interface ()
  (let ((feature-query (symbol-function 'featurep))
        (init-file-had-error nil)
        (gdev-state-startup-issue nil)
        (gdev-modules-private-errors nil)
        (gdev-failed-modules nil)
        (gdev-layout-mode t)
        (process-environment (copy-sequence process-environment))
        (directory (make-temp-file "gdev-riscontro-" t)))
    (unwind-protect
        (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) t))
                  ((symbol-function 'featurep)
                   (lambda (feature &optional subfeature)
                     (or (eq feature 'gdev-core) (funcall feature-query feature subfeature)))))
          (setenv "GDEV_STARTUP_REQUIRE_WORKBENCH" "1")
          (setenv "GDEV_STARTUP_REQUIRE_GRAPHICAL" "1")
          (setenv "GDEV_STARTUP_CHECK_DIR" directory)
          (should (eq t (alist-get 'ok (gdev-startup-check-run))))
          (should (equal "ready\n" (gdev-read-file-contents (expand-file-name "status" directory))))
          (let ((gdev-layout-mode nil))
            (should (eq :false (alist-get 'ok (gdev-startup-check-run))))
            (should (equal "failed\n" (gdev-read-file-contents (expand-file-name "status" directory)))))
          (let ((gdev-config-directory directory))
            (should (eq :false (alist-get 'ok (gdev-startup-check-inspect t t)))))
          (let ((init-file-had-error t))
            (should (eq :false (alist-get 'ok (gdev-startup-check-inspect t t)))))
          (let ((gdev-state-startup-issue 'invalid))
            (should (eq :false (alist-get 'ok (gdev-startup-check-inspect t t)))))
          (let ((gdev-modules-private-errors '(config)))
            (should (eq :false (alist-get 'ok (gdev-startup-check-inspect t t)))))
          (let ((gdev-failed-modules '(workbench)))
            (should (eq :false (alist-get 'ok (gdev-startup-check-inspect t t)))))
          (cl-letf (((symbol-function 'display-graphic-p) (lambda (&optional _) nil)))
            (should (eq :false (alist-get 'ok (gdev-startup-check-inspect t t))))))
      (delete-directory directory t))))

(ert-deftest gdev-test-install-standard-entry-preserves-originals-and-is-idempotent ()
  (let* ((directory (make-temp-file "gdev-icona-emacs-" t))
         (home-directory (expand-file-name "utente con spazi è" directory))
         (gdev-config-directory (file-name-as-directory (expand-file-name "checkout ' è" directory)))
         (process-environment (copy-sequence process-environment))
         (names '(".emacs" ".emacs.el" ".emacs.elc" ".emacs.d/init.el"))
         first)
    (unwind-protect
        (progn
          (make-directory (expand-file-name ".emacs.d" home-directory) t)
          (dolist (name names)
            (with-temp-file (expand-file-name name home-directory) (insert "originale " name)))
          (setenv "GDEV_USER_DIR" (expand-file-name "configurazione privata è" directory))
          (setq first (gdev-install-standard-entry home-directory))
          (should (equal (plist-get first :entry) (expand-file-name ".emacs.d" home-directory)))
          (dolist (name names)
            (should (equal (gdev-read-file-contents (expand-file-name name (plist-get first :backup)))
                           (concat "originale " name))))
          (let* ((backup (plist-get first :backup))
                 (manifest (read (gdev-read-file-contents (expand-file-name "ripristino.eld" backup)))))
            (should (= (length (plist-get manifest :moves)) 4))
            (should (= #o700 (logand #o777 (file-modes backup)))))
          (let* ((file (expand-file-name ".emacs.d/early-init.el" home-directory))
                 (before (file-attribute-inode-number (file-attributes file)))
                 (text (gdev-read-file-contents file)))
            (should (string-search (prin1-to-string (getenv "GDEV_USER_DIR")) text))
            (should (string-search (prin1-to-string (gdev-config-file "early-init.el")) text))
            (should-not (plist-get (gdev-install-standard-entry home-directory) :backup))
            (should (equal before (file-attribute-inode-number (file-attributes file))))))
      (delete-directory directory t))))

(ert-deftest gdev-test-install-standard-entry-preserves-directory-and-broken-links ()
  (let* ((directory (make-temp-file "gdev-icona-link-" t))
         (home-directory (expand-file-name "utente" directory))
         (entry (expand-file-name ".emacs.d" home-directory))
         (foreign (expand-file-name "configurazione originale" directory)))
    (unwind-protect
        (progn
          (make-directory foreign)
          (with-temp-file (expand-file-name "init.el" foreign) (insert ";; personale\n"))
          (make-directory home-directory)
          (make-symbolic-link foreign entry)
          (make-symbolic-link (expand-file-name "assente" directory) (expand-file-name ".emacs" home-directory))
          (let ((backup (plist-get (gdev-install-standard-entry home-directory) :backup)))
            (should (equal (file-symlink-p (expand-file-name ".emacs.d" backup)) foreign))
            (should (equal (file-symlink-p (expand-file-name ".emacs" backup))
                           (expand-file-name "assente" directory)))
            (should (equal (gdev-read-file-contents (expand-file-name "init.el" foreign)) ";; personale\n"))
            (should-not (file-symlink-p entry))
            (should (file-regular-p (expand-file-name "early-init.el" entry)))))
      (delete-directory directory t))))

(ert-deftest gdev-test-install-standard-entry-rolls-back-before-publication ()
  (let* ((directory (make-temp-file "gdev-icona-ripristino-" t))
         (entry (expand-file-name ".emacs.d" directory))
         (rename (symbol-function 'rename-file)))
    (unwind-protect
        (progn
          (make-directory entry)
          (with-temp-file (expand-file-name "init.el" entry) (insert ";; originale\n"))
          (with-temp-file (expand-file-name ".emacs" directory) (insert ";; prevalenza originale\n"))
          (cl-letf (((symbol-function 'rename-file)
                     (lambda (source destination &optional overwrite)
                       (if (and (equal destination entry)
                                (string-prefix-p ".gdev-emacs-entry-" (file-name-nondirectory source)))
                           (signal 'file-error '("Pubblicazione interrotta"))
                         (funcall rename source destination overwrite)))))
            (should-error (gdev-install-standard-entry directory) :type 'file-error))
          (should (equal (gdev-read-file-contents (expand-file-name "init.el" entry)) ";; originale\n"))
          (should (equal (gdev-read-file-contents (expand-file-name ".emacs" directory)) ";; prevalenza originale\n"))
          (should-not (directory-files directory nil "\\`.gdev-emacs-entry-")))
      (delete-directory directory t))))

(ert-deftest gdev-test-install-standard-entry-backs-up-shadowing-bytecode ()
  (let* ((directory (make-temp-file "gdev-icona-bytecode-" t))
         (home-directory (expand-file-name "utente" directory))
         (entry (expand-file-name ".emacs.d" home-directory))
         (source (expand-file-name "originale.el" directory)))
    (unwind-protect
        (progn
          (make-directory home-directory)
          (with-temp-file source
            (insert ";;; -*- lexical-binding: t; -*-\n(error \"Configurazione compilata oscurante\")\n"))
          (should (byte-compile-file source))
          (gdev-install-standard-entry home-directory)
          (dolist (name '("init.elc" "early-init.elc"))
            (copy-file (concat source "c") (expand-file-name name entry))
            (let ((backup (plist-get (gdev-install-standard-entry home-directory) :backup)))
              (should backup)
              (should (file-regular-p (expand-file-name (concat ".emacs.d/" name) backup)))
              (should-not (file-exists-p (expand-file-name name entry)))))
          (make-symbolic-link (expand-file-name "assente" directory) (expand-file-name "init.elc" entry))
          (let ((backup (plist-get (gdev-install-standard-entry home-directory) :backup)))
            (should (file-symlink-p (expand-file-name ".emacs.d/init.elc" backup)))
            (should-not (file-symlink-p (expand-file-name "init.elc" entry)))))
      (delete-directory directory t))))

(provide 'gdev-install-test)
