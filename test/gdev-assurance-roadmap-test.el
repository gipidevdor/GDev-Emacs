(ert-deftest gdev-test-assurance-request-confirms-once-and-preserves-agent-identity ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((id (gdev-test-assurance--open db))
           (ref (gdev-assurance-request-submit db id "advance" ["CLASSIFIED"]))
           (digest (alist-get 'digest (gdev-record-get db ref))))
      (should (eq 'PROPOSED (alist-get 'state (gdev-process-get db id))))
      (gdev-assurance-request-confirm db root ref digest :actor "persona" :actor-kind 'human)
      (should (eq 'CLASSIFIED (alist-get 'state (gdev-process-get db id))))
      (should (eq 'agent (alist-get 'actor_kind (car (last (seq-filter
                                                       (lambda (event) (eq (alist-get 'kind event) 'transition))
                                                       (gdev-process-events db id)))))))
      (should-error (gdev-assurance-request-confirm db root ref digest :actor "persona" :actor-kind 'human))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-assurance-request-rejects-agent-approval-stale-and-wrong-digest ()
  (gdev-test-assurance--with-archive (root db)
    (let ((id (gdev-test-assurance--open db)))
      (should-error (gdev-assurance-request-submit db id "advance" ["AUTHORIZED"]))
      (should (eq 'refusal (alist-get 'kind (car (last (gdev-process-events db id))))))
      (dolist (scenario '(agent digest stale reject gate))
        (let* ((ref (gdev-assurance-request-submit db id "advance" ["IMPLEMENTING"]))
               (digest (alist-get 'digest (gdev-record-get db ref))))
          (pcase scenario
            ('agent (let ((gdev-process-origin 'agent))
                      (should-error (gdev-assurance-request-confirm db root ref digest :actor "a" :actor-kind 'human))))
            ('digest (should-error (gdev-assurance-request-confirm db root ref "diverso" :actor "p" :actor-kind 'human)))
            ('stale (gdev-test-assurance--prove db id)
                    (should-error (gdev-assurance-request-confirm db root ref digest :actor "p" :actor-kind 'human)))
            ('reject (gdev-assurance-request-confirm db root ref digest :actor "p" :actor-kind 'human :accept nil))
            ('gate (should-error (gdev-assurance-request-confirm db root ref digest :actor "p" :actor-kind 'human))
                   (should (equal "rejected" (alist-get 'status (gdev-record-data (car (last (gdev-record-list db nil 'request)))))))))
          (should (eq 'PROPOSED (alist-get 'state (gdev-process-get db id))))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-assurance-request-evidence-assessment-artifact-and-link-use-the-kernel ()
  (gdev-test-assurance--with-archive (root db)
    (let ((id (gdev-test-assurance--open db)) refs)
      (write-region "sorgente" nil (expand-file-name "a.el" root) nil 'silent)
      (write-region "prova" nil (expand-file-name "b.el" root) nil 'silent)
      (dolist (proposal `(("evidence" ["Prova" "dati"])
                          ("assess" [])
                          ("artifact" ["a.el" "source" ,(gdev-evidence-file-sha256 (expand-file-name "a.el" root))])
                          ("artifact" ["b.el" "test" ,(gdev-evidence-file-sha256 (expand-file-name "b.el" root))])))
        (let* ((ref (gdev-assurance-request-submit db id (car proposal) (cadr proposal)))
               (digest (alist-get 'digest (gdev-record-get db ref))))
          (gdev-assurance-request-confirm db root ref digest :actor "persona" :actor-kind 'human)))
      (setq refs (mapcar (lambda (row) (alist-get 'ref row)) (gdev-trace-artifacts db)))
      (let* ((ref (gdev-assurance-request-submit db id "link" (vector (car refs) (cadr refs) "verifies" "Copertura")))
             (digest (alist-get 'digest (gdev-record-get db ref))))
        (gdev-assurance-request-confirm db root ref digest :actor "persona" :actor-kind 'human))
      (should (= 1 (length (gdev-trace-links db))))
      (should-not (gdev-assurance-verify db))
      (let* ((ref (gdev-assurance-request-submit db id "artifact" (vector "a.el" "source" (gdev-evidence-file-sha256 (expand-file-name "a.el" root)))))
             (digest (alist-get 'digest (gdev-record-get db ref))))
        (write-region "cambiato" nil (expand-file-name "a.el" root) nil 'silent)
        (should-error (gdev-assurance-request-confirm db root ref digest :actor "persona" :actor-kind 'human)))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-assurance-request-live-tool-only-queues-a-proposal ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((id (gdev-test-assurance--open db))
           (proposal "{\"operation\":\"advance\",\"arguments\":[\"CLASSIFIED\"]}")
           (fields (gdev-agent-interface--dispatch "assurance-request" (list id proposal root)))
           (ref (alist-get 'request fields)))
      (should (equal "pending" (alist-get 'status fields)))
      (should (eq 'PROPOSED (alist-get 'state (gdev-process-get db id))))
      (should (equal proposal (gdev-mcp--operand 'assurance-proposal proposal)))
      (should-error (gdev-mcp--operand 'assurance-proposal "{\"operation\":\"advance\",\"arguments\":[\"AUTHORIZED\"]}"))
      (should-error (gdev-mcp--operand 'assurance-proposal "malformato"))
      (should-error (gdev-mcp--operand 'assurance-proposal (concat proposal " {}")))
      (should-error (gdev-mcp--operand 'assurance-proposal "{\"operation\":\"evidence\",\"operation\":\"assess\",\"arguments\":[]}"))
      (should-error (gdev-mcp--operand 'assurance-proposal (make-string 32769 ?x)))
      (should (= 0 (car (gdev-test-assurance--cli root "requests" ref))))
      (should (= 0 (car (gdev-test-assurance--cli root "confirm" ref (alist-get 'digest fields)))))
      (should (eq 'CLASSIFIED (alist-get 'state (gdev-process-get db id)))))))

(ert-deftest gdev-test-assurance-git-signs-the-authorized-index-and-external-checker-verifies ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-adoption--git root)
    (gdev-test-assurance--with-root secrets
      (let* ((key (expand-file-name "test-key" secrets))
             (signers (expand-file-name "allowed-signers" secrets))
             (id (gdev-test-assurance--open db)))
        (should (zerop (process-file "ssh-keygen" nil nil nil "-q" "-t" "ed25519" "-N" "" "-f" key)))
        (with-temp-buffer
          (insert "persona ") (insert-file-contents (concat key ".pub")) (write-region (point-min) (point-max) signers nil 'silent))
        (should-error (gdev-assurance-git-sign db id root "test/progetto" "persona" key :actor "a" :actor-kind 'agent))
        (should-error (gdev-assurance-git-sign db id root "test/progetto" "persona" key :actor "p" :actor-kind 'human))
        (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED)
        (should (= 1 (car (gdev-test-assurance--cli root "hooks" (concat signers "-assente") "test/progetto"))))
        (should (= 0 (car (gdev-test-assurance--cli root "hooks" signers "test/progetto"))))
        (should-error (gdev-assurance-git-sign db id root "test/progetto" "persona" (concat key "-assente")
                                              :actor "p" :actor-kind 'human))
        (let ((insert (symbol-function 'gdev-record-add)))
          (cl-letf (((symbol-function 'gdev-record-add)
                     (lambda (db tx kind data &rest properties)
                       (if (eq kind 'commit) (error "Guasto simulato dopo la firma")
                         (apply insert db tx kind data properties)))))
            (should-error (gdev-assurance-git-sign db id root "test/progetto" "persona" key :actor "p" :actor-kind 'human))))
        (should-not (directory-files (expand-file-name ".gdev-assurance/receipts" root) nil "^[^.].*"))
        (let* ((signed (gdev-test-assurance--cli root "sign" id "test/progetto" "persona" key))
               (receipt (progn (should (= 0 (car signed)))
                               (json-parse-string (cdr signed) :object-type 'alist)))
               (message (expand-file-name "message" secrets))
               (base (string-trim (gdev-adoption-git root "rev-parse" "HEAD"))))
          (write-region (concat "Modifica\n\n" (alist-get 'trailers receipt) "\n") nil message nil 'silent)
          (gdev-adoption-git root "add" ".gdev-assurance/receipts")
          (should (zerop (process-file gdev-assurance-git-checker nil nil nil "--root" root "--signers" signers
                                       "--repository" "test/progetto" "staged" message)))
          (gdev-adoption-git root "commit" "-qF" message)
          (should (= 0 (car (gdev-test-assurance--cli root "sign-amend" id "test/progetto" "persona" key))))
          (should (zerop (process-file gdev-assurance-git-checker nil nil nil "--root" root "--signers" signers
                                       "--repository" "test/progetto" "range" base "HEAD")))
          (write-region "cambiato" nil (expand-file-name "sorgente.el" root) nil 'silent)
          (gdev-adoption-git root "add" "sorgente.el")
          (should-not (zerop (process-file gdev-assurance-git-checker nil nil nil "--root" root "--signers" signers
                                           "--repository" "test/progetto" "staged" message)))
          (should-not (gdev-assurance-verify db)))))))

