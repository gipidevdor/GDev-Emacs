(ert-deftest gdev-test-assurance-recovery-rolls-back-if-the-new-archive-fails ()
  (gdev-test-assurance--with-root root
    (let ((file (gdev-assurance-db-file root)))
      (make-directory (file-name-directory file) t)
      (write-region "originale danneggiato" nil file nil 'silent)
      (let ((before (gdev-evidence-file-sha256 file)))
        (cl-letf (((symbol-function 'gdev-process-open) (lambda (&rest _) (error "Guasto simulato"))))
          (should-error (gdev-adoption-recover root 'core "Guasto" :actor "persona" :actor-kind 'human)))
        (should (equal before (gdev-evidence-file-sha256 file)))
        (should (= 1 (length (directory-files (expand-file-name ".gdev" root) nil "assurance"))))))))

(ert-deftest gdev-test-assurance-documents-cli-and-lavorazione-report-stale-data ()
  (gdev-test-assurance--with-root root
    (make-directory (expand-file-name ".gdev-assurance" root))
    (write-region "(:version 1 :documents ((:id plan :sources (\"piano.org\"))))"
                  nil (expand-file-name gdev-documents-manifest root) nil 'silent)
    (write-region "* Piano\n" nil (expand-file-name "piano.org" root) nil 'silent)
    (should (= 1 (car (gdev-test-assurance--cli root "documents" "check"))))
    (should (= 1 (car (gdev-test-assurance--cli root "documents" "sconosciuto"))))
    (should (= 0 (car (gdev-test-assurance--cli root "documents"))))
    (should (= 0 (car (gdev-test-assurance--cli root "documents" "check"))))
    (let ((plan (gdev-test-lavorazione--piano "{\"versione\":1,\"passi\":[{\"azione\":\"assicurazione-documenti\",\"argomenti\":{}}]}")))
      (should (= 1 (gdev-lavorazione--esegui plan root)))
      (write-region "* Cambiato\n" nil (expand-file-name "piano.org" root) nil 'silent)
      (should-error (gdev-lavorazione--esegui plan root)))))

(ert-deftest gdev-test-assurance-cli-adoption-and-recovery-keep-original-provenance ()
  (gdev-test-assurance--with-root root
    (gdev-test-adoption--git root)
    (should (= 0 (car (gdev-test-assurance--cli root "adopt" "core"))))
    (should (= 0 (car (gdev-test-assurance--cli root "recover" "core" "Guasto simulato"))))
    (gdev-assurance-db-with-open (db root)
      (should (= 1 (length (gdev-record-list db nil 'recovery))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-assurance-generated-markdown-links-still-point-at-the-source-targets ()
  (let* ((input "[Guida](docs/a.md#punto) [Web](https://example.invalid) [Qui](#qui)\n[x]: <README.md>\n```md\n[Codice](unchanged.md)\n```\n")
         (output (gdev-documents--markdown input "/repo/README.md" "/repo/docs/assicurazione/generati/plan.md")))
    (should (string-search "[Guida](../../a.md#punto)" output))
    (should (string-search "[Web](https://example.invalid)" output))
    (should (string-search "[Qui](#qui)" output))
    (should (string-search "[x]: <../../../README.md>" output))
    (should (string-search "[Codice](unchanged.md)" output))))

(ert-deftest gdev-test-assurance-new-cli-entrances-and-read-arity-are-consistent ()
  (gdev-test-assurance--with-root root
    (gdev-test-adoption--git root)
    (should (= 0 (car (gdev-test-assurance--cli root "open" "Lavoro" "core"))))
    (dolist (state '("CLASSIFIED" "ANALYZED" "AUTHORIZED" "IMPLEMENTING"))
      (should (= 0 (car (gdev-test-assurance--cli root "advance" "GT-0001" state)))))
    (should (= 0 (car (gdev-test-assurance--cli root "evidence" "GT-0001" "File di prova" "sorgente.el"))))
    (should (= 0 (car (gdev-test-assurance--cli root "assess-record" "GT-0001"))))
    (dotimes (_ 2)
      (should (= 0 (car (gdev-test-assurance--cli root "artifact" "GT-0001" "sorgente.el" "source")))))
    (should (= 0 (car (gdev-test-assurance--cli root "link" "GT-0001" "RC-0001" "RC-0002" "verifies" "Prova"))))
    (should (= 0 (car (gdev-test-assurance--cli root "trace"))))
    (should (= 0 (car (gdev-test-assurance--cli root "impact" "sorgente.el"))))
    (should (= 1 (car (gdev-test-assurance--cli root "requests" "RC-0001"))))
    (should (= 1 (car (gdev-test-assurance--cli root "requests" "RC-9999"))))
    (should (= 2 (car (gdev-test-assurance--cli root "open"))))
    (should-error (gdev-assurance-data "status" root "extra"))
    (let ((gdev-assurance-read-contracts (append gdev-assurance-read-contracts '(("experimental" 0 0)))))
      (should-error (gdev-assurance-data "experimental" root)))))

(ert-deftest gdev-test-assurance-confirmation-refuses-tampered-pending-data ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((id (gdev-test-assurance--open db))
           (ref (gdev-assurance-request-submit db id "advance" ["CLASSIFIED"]))
           (digest (alist-get 'digest (gdev-record-get db ref))))
      (gdev-test-assurance--edit-restoring-guard
       db "assurance_record_no_update" "update assurance_record set payload = replace(payload, 'CLASSIFIED', 'ANALYZED')")
      (should-error (gdev-assurance-request-confirm db root ref digest :actor "persona" :actor-kind 'human))
      (should (eq 'PROPOSED (alist-get 'state (gdev-process-get db id)))))))

(ert-deftest gdev-test-assurance-signing-refuses-unmet-due-controls-before-touching-key ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-adoption--git root)
    (let ((id (gdev-test-assurance--open db 'secure)))
      (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED)
      (let ((error (should-error (gdev-assurance-git-sign db id root "test/project" "persona" "/chiave-inesistente"
                                                        :actor "persona" :actor-kind 'human))))
        (should (string-search "Controllo dovuto" (error-message-string error))))
      (should-not (file-exists-p (expand-file-name ".gdev-assurance/receipts" root))))))

(ert-deftest gdev-test-assessment-rework-cannot-reuse-verification-evidence ()
  (gdev-test-assurance--with-archive (root db)
    (let ((id (gdev-test-assurance--open db 'quality)))
      (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED 'IMPLEMENTING 'VERIFYING)
      (gdev-test-assurance--prove db id)
      (gdev-test-assurance--walk db id 'REVIEWING 'IMPLEMENTING 'VERIFYING)
      (let* ((data (gdev-assessment-run db id))
             (quality (seq-find (lambda (row) (equal "GES-Q01" (alist-get 'control row))) (alist-get 'results data))))
        (should (equal "NOT_SATISFIED" (alist-get 'status quality)))
        (should (eq t (alist-get 'due quality))))
      (gdev-test-assurance--prove db id)
      (let* ((data (gdev-assessment-run db id))
             (quality (seq-find (lambda (row) (equal "GES-Q01" (alist-get 'control row))) (alist-get 'results data))))
        (should (equal "SATISFIED" (alist-get 'status quality)))))))

(ert-deftest gdev-test-assurance-lavorazione-uses-the-kernel-without-approving ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((id (gdev-test-assurance--open db))
           (source (format "{\"versione\":1,\"passi\":[{\"azione\":\"assicurazione-verifica\",\"argomenti\":{}},{\"azione\":\"assicurazione-proponi\",\"argomenti\":{\"transazione\":%S,\"operazione\":\"advance\",\"argomenti\":\"[\\\"CLASSIFIED\\\"]\"}}]}" id))
           (before (gdev-test-assurance--snapshot root))
           (plan (gdev-test-lavorazione--piano source)))
      (should (equal before (gdev-test-assurance--snapshot root)))
      (should (= 2 (gdev-lavorazione--esegui plan root)))
      (should (eq 'PROPOSED (alist-get 'state (gdev-process-get db id))))
      (should (= 1 (length (gdev-record-list db nil 'request))))
      (should-error (gdev-test-lavorazione--piano "{\"versione\":1,\"passi\":[{\"azione\":\"assicurazione-approva\",\"argomenti\":{}}]}")))))

(ert-deftest gdev-test-standards-new-data-rejects-trailing-forms-and-typed-profile-errors ()
  (gdev-test-assurance--with-root root
    (let ((file (expand-file-name "data.eld" root)))
      (dolist (text '("(:dato t)\n(:altro t)" "(:dato t) ("))
        (write-region text nil file nil 'silent)
        (should-error (gdev-standards-read file) :type 'gdev-standards-error)))
    (should (gdev-standards-problems '(x . y)))
    (should (gdev-standards-check-reference '(errato)))
    (should (gdev-controls-problems nil '((:id 7 :eredita bad :controlli 4))))
    (should (gdev-controls-problems '((:id 7 :titolo 8)) '(bad)))
    (should (member "Build L3" (gdev-standards-clauses "slsa")))
    (should-not (gdev-standards-check-reference '(:standard "slsa" :edizione "1.2" :clausola "Source L4")))))

(ert-deftest gdev-test-assurance-documents-are-deterministic-and-never-evaluate-org ()
  (gdev-test-assurance--with-root root
    (make-directory (expand-file-name ".gdev-assurance" root))
    (write-region "(:version 1 :documents ((:id plan :sources (\"piano.org\")) (:id requirements :sources (\"requisiti.md\"))))"
                  nil (expand-file-name gdev-documents-manifest root) nil 'silent)
    (write-region "* Piano\n#+INCLUDE: /etc/passwd\n#+BEGIN_SRC emacs-lisp\n(error \"eseguito\")\n#+END_SRC\n````\n"
                  nil (expand-file-name "piano.org" root) nil 'silent)
    (write-region "# Requisiti\n\nUn requisito.\n" nil (expand-file-name "requisiti.md" root) nil 'silent)
    (let ((before (gdev-test-assurance--snapshot root)) (rendered (gdev-documents-render root)))
      (should (= 16 (length rendered)))
      (should (equal before (gdev-test-assurance--snapshot root)))
      (should (string-search "`````org" (cdar rendered)))
      (should (= 16 (length (gdev-documents-generate root t))))
      (should (= 16 (length (gdev-documents-generate root))))
      (should-not (gdev-documents-generate root t))
      (should (equal rendered (gdev-documents-render root)))
      (write-region "* Cambiato\n" nil (expand-file-name "piano.org" root) nil 'silent)
      (should (equal '("docs/assicurazione/generati/plan.md") (gdev-documents-generate root t)))
      (gdev-documents-generate root)
      (write-region "Dati miei" nil (expand-file-name "docs/assicurazione/generati/plan.md" root) nil 'silent)
      (should-error (gdev-documents-generate root)))))

