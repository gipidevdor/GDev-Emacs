(require 'button)
(require 'cl-lib)
(require 'ert)
(require 'gdev-modules)
(require 'gdev-context)

(defvar gdev-context-items)
(defvar gdev-ui-view-profile)
(defvar gdev-writing--project-markers)

(defun gdev-article-test--load ()
  "Carica il modulo Articolo del checkout se serve."
  (unless (fboundp 'gdev-article-new-project)
    (require 'package)
    (package-activate-all)
    (load (gdev-module-file :lang 'article ".el") nil t t)))

(ert-deftest gdev-test-article-opens-a-structured-project ()
  "Il comando apre il manoscritto e riattiva il flusso anche alla riapertura."
  (gdev-article-test--load)
  (let* ((directory (make-temp-file "gdev-test-article-" t))
         (root (file-name-as-directory (expand-file-name "Articolo di prova" directory)))
         commands buffer)
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'gdev-open-folder)
                     (lambda (folder) (push (cons 'cartella folder) commands)))
                    ((symbol-function 'gdev-open-file)
                     (lambda (file) (push (cons 'documento file) commands)))
                    ((symbol-function 'gdev-writing-open)
                     (lambda () (push '(strumenti) commands))))
            (gdev-article-new-project root "Una storia\nsulla città"))
          (should (equal (reverse commands)
                         `((cartella . ,root)
                           (documento . ,(expand-file-name "articolo.org" root))
                           (strumenti))))
          (should (file-regular-p (expand-file-name "bozze/prima-stesura.org" root)))
          (should (file-regular-p (expand-file-name "ricerche/indice.org" root)))
          (let ((project (project-current nil (expand-file-name "ricerche/" root))))
            (should (eq (car project) 'gdev-article))
            (should (equal (project-root project) root)))
          (setq buffer (find-file-noselect (expand-file-name "articolo.org" root)))
          (with-current-buffer buffer
            (should (derived-mode-p 'org-mode))
            (should (eq major-mode 'gdev-article-mode))
            (should (eq gdev-ui-view-profile 'native))
            (should (string-search "#+TITLE: Una storia sulla città" (buffer-string)))
            (should (string-search "file:ricerche/indice.org" (buffer-string)))
            (should (seq-some (lambda (item) (eq (aref item 1) 'gdev-article-new-research))
                              gdev-context-items))
            (let ((actions (gdev-context-view-items)))
              (should (cl-find 'imenu actions :key #'gdev-context-item-command))
              (should (commandp 'org-export-dispatch))
              (should (= (cl-count 'org-export-dispatch actions
                                   :key #'gdev-context-item-command) 1))
              (should (= (cl-count "Esporta…" actions :test #'equal
                                   :key (lambda (item) (aref item 0))) 1)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest gdev-test-article-preserves-files-and-cleans-up-incomplete-setup ()
  "Una collisione conserva il documento, un errore lascia la cartella riutilizzabile."
  (gdev-article-test--load)
  (let* ((directory (make-temp-file "gdev-test-article-" t))
         (root (file-name-as-directory directory))
         (default-directory root)
         (original (symbol-function 'gdev-article--write-file)))
    (unwind-protect
        (progn
          (cl-letf (((symbol-function 'gdev-article--write-file)
                     (lambda (file content)
                       (if (string-suffix-p "indice.org" file)
                           (signal 'file-error '("Scrittura non riuscita"))
                         (funcall original file content)))))
            (should-error (gdev-article--initialize root "Titolo") :type 'file-error))
          (should (directory-empty-p root))
          (gdev-article--initialize root "Titolo")
          (let ((new (expand-file-name "ricerche/qualità-dell-aria.org" root)))
            (cl-letf (((symbol-function 'gdev-open-file) #'identity))
              (should (equal (gdev-article-new-research "Qualità dell'aria") new))
              (should-error (gdev-article-new-research "Qualità dell'aria") :type 'user-error))
            (with-temp-buffer
              (insert-file-contents new)
              (should (string-search "* Verifiche" (buffer-string)))
              (should (string-search "file:../articolo.org" (buffer-string)))))
          (should-error (gdev-article--initialize root "Altro titolo") :type 'user-error))
      (delete-directory directory t))))

(ert-deftest gdev-test-article-and-latex-use-the-nearest-project ()
  "La radice più vicina prevale in entrambi gli ordini di annidamento."
  (gdev-article-test--load)
  (let* ((directory (make-temp-file "gdev-test-writing-project-" t))
         (article (file-name-as-directory (expand-file-name "articolo" directory)))
         (latex (file-name-as-directory (expand-file-name "latex" directory)))
         (nested-article (file-name-as-directory (expand-file-name "articolo" latex)))
         (nested-latex (file-name-as-directory (expand-file-name "latex" article)))
         (gdev-writing--project-markers (copy-tree gdev-writing--project-markers)))
    (unwind-protect
        (progn
          (gdev-writing-register-project 'gdev-latex ".gdev-latex")
          (gdev-article--initialize article "Articolo esterno")
          (make-directory latex)
          (gdev-article--write-file (expand-file-name ".gdev-latex" latex) "latex\n")
          (gdev-article--initialize nested-article "Articolo interno")
          (make-directory nested-latex)
          (gdev-article--write-file (expand-file-name ".gdev-latex" nested-latex) "latex\n")
          (should (equal (project-current nil nested-latex) (cons 'gdev-latex nested-latex)))
          (should (equal (project-current nil nested-article) (cons 'gdev-article nested-article)))
          (should-not (gdev-writing-project-root 'gdev-article nested-latex))
          (should (equal (gdev-writing-project-root 'gdev-article nested-article) nested-article)))
      (delete-directory directory t))))

(ert-deftest gdev-test-article-project-reopens-the-unsaved-draft-after-refresh ()
  "Il progetto conserva la bozza selezionata e torna al documento aperto."
  (gdev-article-test--load)
  (require 'gdev-commands)
  (let* ((directory (make-temp-file "gdev-test-article-" t))
         (root (file-name-as-directory directory))
         (file (expand-file-name "bozze/prima-stesura.org" root))
         (new-file (expand-file-name "bozze/00-nuova.org" root))
         (gdev-layout-mode nil)
         draft draft-point overview)
    (unwind-protect
        (save-window-excursion
          (gdev-article--initialize root "Una storia sulla città")
          (setq draft (find-file-noselect file))
          (switch-to-buffer draft)
          (goto-char (point-max))
          (insert "\nUna frase di lavoro ancora da rivedere.\n")
          (search-backward "lavoro")
          (setq draft-point (point))
          (should (eq (key-binding (kbd "C-c j")) #'gdev-article-open-project))
          (execute-kbd-macro (kbd "C-c j"))
          (setq overview (current-buffer))
          (should (eq major-mode 'gdev-article-project-mode))
          (should (eq gdev-ui-view-profile 'document))
          (should buffer-read-only)
          (goto-char (point-min))
          (let ((selected (text-property-search-forward 'gdev-article-file file #'equal)))
            (should selected)
            (goto-char (prop-match-beginning selected)))
          (with-temp-file new-file
            (insert "#+TITLE: Nuova bozza\n"))
          (call-interactively (key-binding (kbd "g")))
          (save-excursion
            (goto-char (point-min))
            (should (text-property-search-forward 'gdev-article-file new-file #'equal)))
          (let ((button (button-at (point))))
            (should button)
            (should (equal (button-get button 'gdev-article-file) file))
            (should (eq (keymap-lookup (button-get button 'keymap) "<mouse-1>") #'push-button))
            (should (eq (key-binding (kbd "RET")) #'push-button))
            (let ((position (point)))
              (execute-kbd-macro (kbd "RET"))
              (should (eq (window-buffer (selected-window)) draft))
              (switch-to-buffer overview)
              (push-button (list 'mouse-1 (list (selected-window) position '(0 . 0) 0)))))
          (should (eq (window-buffer (selected-window)) draft))
          (with-current-buffer draft
            (should (= (point) draft-point))
            (should (buffer-modified-p))
            (should (string-search "Una frase di lavoro ancora da rivedere." (buffer-string)))))
      (when (buffer-live-p overview) (kill-buffer overview))
      (when (buffer-live-p draft)
        (with-current-buffer draft (set-buffer-modified-p nil))
        (kill-buffer draft))
      (delete-directory directory t))))

(ert-deftest gdev-test-article-draft-picker-uses-the-current-org-title ()
  "Il selettore propone il titolo corrente e una bozza ricrea la cartella."
  (gdev-article-test--load)
  (let* ((directory (make-temp-file "gdev-test-article-" t))
         (root (file-name-as-directory directory))
         (file (expand-file-name "bozze/titolo-iniziale.org" root))
         buffer)
    (unwind-protect
        (progn
          (gdev-article--initialize root "Articolo")
          (delete-directory (expand-file-name "bozze" root) t)
          (let ((default-directory root))
            (should-error (gdev-article-open-drafts) :type 'user-error)
            (cl-letf (((symbol-function 'gdev-open-file) #'identity))
              (should (equal (gdev-article-new-draft "Titolo iniziale") file))))
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (goto-char (point-min))
            (search-forward "Titolo iniziale")
            (replace-match "Titolo rivisto"))
          (let ((default-directory root))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt choices &rest _)
                         (should (equal choices (list (cons "Titolo rivisto" file))))
                         "Titolo rivisto"))
                      ((symbol-function 'gdev-open-file) #'identity))
              (should (equal (gdev-article-open-drafts) file)))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-directory directory t))))

(ert-deftest gdev-test-article-exports-the-manuscript-without-the-work-plan ()
  "L'esportazione HTML include il testo pubblico ed esclude il piano di lavoro."
  (gdev-article-test--load)
  (require 'ox-html)
  (let ((directory (make-temp-file "gdev-test-article-" t))
        buffer)
    (unwind-protect
        (let ((root (gdev-article--initialize directory "Una storia sulla città")))
          (setq buffer (find-file-noselect (expand-file-name "articolo.org" root)))
          (with-current-buffer buffer
            (let ((html (org-export-as 'html)))
              (should (string-search "Una storia sulla città" html))
              (should (string-search "Apertura" html))
              (should-not (string-search "Piano di lavoro" html))
              (should-not (string-search "ricerche/indice.org" html)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory directory t))))

(defun gdev-article-test--file-text (file)
  "Leggi il testo di FILE senza alterare i buffer dei documenti."
  (with-temp-buffer
    (insert-file-contents file)
    (buffer-string)))

(ert-deftest gdev-test-article-outline-finds-an-unsaved-heading-from-the-project ()
  "La scaletta cerca nel manoscritto corrente e conserva la vista se annullata."
  (gdev-article-test--load)
  (let* ((root (gdev-article--initialize (make-temp-file "gdev-test-article-" t) "Città"))
         (gdev-layout-mode nil)
         manuscript draft overview)
    (unwind-protect
        (save-window-excursion
          (setq manuscript (find-file-noselect (expand-file-name "articolo.org" root))
                draft (find-file-noselect (expand-file-name "bozze/prima-stesura.org" root)))
          (with-current-buffer manuscript
            (goto-char (point-max))
            (insert "\n* Nuova osservazione sul quartiere\n"))
          (switch-to-buffer draft)
          (gdev-article-open-project)
          (setq overview (current-buffer))
          (goto-char (point-min))
          (let ((action (text-property-search-forward 'gdev-article-item 'gdev-article-outline #'eq)))
            (should action)
            (goto-char (prop-match-beginning action))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (&rest _) (signal 'quit nil))))
              (should (condition-case nil
                          (progn (call-interactively #'push-button) nil)
                        (quit t))))
            (should (eq (current-buffer) overview))
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt table &optional predicate &rest _)
                         (let ((choice (car (all-completions "Nuova osservazione" table predicate))))
                           (should choice)
                           choice))))
              (call-interactively #'push-button)))
          (should (eq (current-buffer) manuscript))
          (should (looking-at-p "\\* Nuova osservazione sul quartiere"))
          (should (buffer-modified-p)))
      (dolist (buffer (list overview draft manuscript))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-article-capture-preserves-an-open-research-plan ()
  "Raccogli la fonte dal testo selezionato e conserva gli appunti non salvati."
  (gdev-article-test--load)
  (let* ((root (gdev-article--initialize (make-temp-file "gdev-test-article-" t) "Città"))
         (file (expand-file-name "ricerche/indice.org" root))
         (url "https://example.org/archivio?a=1&b=due")
         (disk (gdev-article-test--file-text file))
         (gdev-layout-mode nil)
         source research)
    (unwind-protect
        (save-window-excursion
          (setq source (find-file-noselect (expand-file-name "articolo.org" root))
                research (find-file-noselect file))
          (with-current-buffer research
            (goto-char (point-max))
            (insert "\nAppunto di ricerca ancora da salvare.\n")
            (narrow-to-region (line-beginning-position 0) (point))
            (goto-char (point-min)))
          (switch-to-buffer source)
          (goto-char (point-max))
          (let ((transient-mark-mode t)
                (start (point))
                (answers (list url "Archivio cittadino" "Consultare il secondo volume.")))
            (insert "\nBrano selezionato\n* Profilo di prova")
            (set-mark (1+ start))
            (activate-mark)
            (let ((position (point))
                  (window (selected-window)))
              (cl-letf (((symbol-function 'read-string)
                         (lambda (&rest _) (pop answers))))
                (call-interactively #'gdev-article-capture-source))
              (should-not answers)
              (should (eq (selected-window) window))
              (should (eq (current-buffer) source))
              (should (= (point) position))))
          (should (equal disk (gdev-article-test--file-text file)))
          (with-current-buffer research
            (should (buffer-modified-p))
            (should (buffer-narrowed-p))
            (should (= (point) (point-min)))
            (save-restriction
              (widen)
              (goto-char (point-min))
              (re-search-forward "^\\*\\* Archivio cittadino$")
              (should (equal (org-get-outline-path) '("Fonti da consultare")))
              (let ((entry-end (save-excursion (org-end-of-subtree t))))
                (should (search-forward url entry-end t))
                (should (equal (org-element-property :raw-link (org-element-context)) url))
                (should (search-forward ",* Profilo di prova" entry-end t))
                (should (search-forward "Consultare il secondo volume." entry-end t)))
              (goto-char (point-max))
              (should (search-backward "Appunto di ricerca ancora da salvare." nil t)))))
      (dolist (buffer (list source research))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-article-review-jumps-to-an-open-issue-in-the-manuscript ()
  "La revisione mostra i problemi aperti del testo pubblico e apre la riga giusta."
  (gdev-article-test--load)
  (let* ((root (gdev-article--initialize (make-temp-file "gdev-test-article-" t) "Città"))
         (gdev-layout-mode nil)
         manuscript review)
    (unwind-protect
        (save-window-excursion
          (setq manuscript (find-file-noselect (expand-file-name "articolo.org" root)))
          (switch-to-buffer manuscript)
          (erase-buffer)
          (insert (gdev-article--document
                   "Città"
                   (concat "* Piano escluso :noexport:\n** TODO Appunto riservato\n"
                           "- [ ] Solo per la redazione\n"
                           "* Senza corpo\n"
                           "* Sezione madre\n** Sottosezione\nTesto già scritto.\n"
                           "* TODO Verificare la data\nNotizia da completare.\n"
                           "- [X] Controllo concluso\n- [ ] Controllare il riferimento\n")))
          (gdev-article-review)
          (setq review (current-buffer))
          (should (derived-mode-p 'gdev-article-review-mode))
          (should (eq gdev-ui-view-profile 'document))
          (should buffer-read-only)
          (dolist (kind '(empty todo checkbox))
            (goto-char (point-min))
            (should (text-property-search-forward 'gdev-article-review-kind kind #'eq)))
          (dolist (hidden '("Appunto riservato" "Solo per la redazione" "Controllo concluso"
                            "Sezione madre"))
            (should-not (string-search hidden (buffer-string))))
          (goto-char (point-min))
          (let ((issue (text-property-search-forward 'gdev-article-review-kind 'checkbox #'eq)))
            (should issue)
            (goto-char (prop-match-beginning issue))
            (execute-kbd-macro (kbd "RET")))
          (should (eq (current-buffer) manuscript))
          (should (buffer-modified-p))
          (should (string-search "Controllare il riferimento" (thing-at-point 'line t))))
      (when (buffer-live-p review) (kill-buffer review))
      (when (buffer-live-p manuscript)
        (with-current-buffer manuscript (set-buffer-modified-p nil))
        (kill-buffer manuscript))
      (delete-directory root t))))

(ert-deftest gdev-test-article-saves-immutable-versions-of-the-complete-manuscript ()
  "Salva il manoscritto corrente da una bozza, conservando stesure e file originale."
  (gdev-article-test--load)
  (let* ((root (gdev-article--initialize (make-temp-file "gdev-test-article-" t) "Città"))
         (file (expand-file-name "articolo.org" root))
         (disk (gdev-article-test--file-text file))
         (gdev-layout-mode nil)
         manuscript draft first-text second-text)
    (unwind-protect
        (save-window-excursion
          (setq manuscript (find-file-noselect file)
                draft (find-file-noselect (expand-file-name "bozze/prima-stesura.org" root)))
          (with-current-buffer manuscript
            (goto-char (point-max))
            (insert "\nTesto della prima revisione.\n")
            (setq first-text (buffer-string))
            (narrow-to-region (1+ (point-min)) (1- (point-max))))
          (switch-to-buffer draft)
          (let ((first (gdev-article-save-version "Prima revisione")))
            (should (file-in-directory-p first (expand-file-name ".gdev-article-versions/" root)))
            (should (eq (current-buffer) draft))
            (with-current-buffer manuscript
              (should (buffer-narrowed-p))
              (should (buffer-modified-p))
              (save-restriction
                (widen)
                (goto-char (point-max))
                (insert "Aggiunta per la seconda revisione.\n")
                (setq second-text (buffer-string))))
            (let ((second (gdev-article-save-version "Seconda revisione")))
              (should-not (equal first second))
              (should (equal first-text (gdev-article-test--file-text first)))
              (should (equal second-text (gdev-article-test--file-text second)))
              (let (comparison)
                (cl-letf (((symbol-function 'completing-read)
                           (lambda (_prompt choices &rest _)
                             (let ((choice (rassoc first choices)))
                               (should choice)
                               (car choice))))
                          ((symbol-function 'gdev-compare-buffer-with-file)
                           (lambda (buffer snapshot &optional label whole)
                             (setq comparison (list buffer snapshot label whole)))))
                  (gdev-article-compare-version))
                (should (equal comparison (list manuscript first "Versione conservata" t))))
              (should (equal disk (gdev-article-test--file-text file))))))
      (when (buffer-live-p draft) (kill-buffer draft))
      (when (buffer-live-p manuscript)
        (with-current-buffer manuscript (set-buffer-modified-p nil))
        (kill-buffer manuscript))
      (delete-directory root t))))

