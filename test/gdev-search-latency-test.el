(require 'ert)
(require 'gdev-search)

(defun gdev-search-latency-test--process ()
  "Crea un processo fittizio per consegnare blocchi ripgrep alla vista corrente."
  (let* ((output (generate-new-buffer " *gdev-search-latency-json*"))
         (errors (generate-new-buffer " *gdev-search-latency-errors*"))
         (process (make-pipe-process :name "gdev-search-latency" :buffer output
                                     :noquery t :sentinel #'ignore)))
    (buffer-disable-undo output)
    (process-put process 'errors errors)
    (process-put process 'started (float-time))
    (setq gdev-search--process process)))

(defun gdev-search-latency-test--record (number)
  "Restituisci una corrispondenza ripgrep alla riga NUMBER."
  (format (concat "{\"type\":\"match\",\"data\":{\"path\":{\"text\":\"righe.txt\"},"
                  "\"lines\":{\"text\":\"noè\\n\"},\"line_number\":%d,\"submatches\":[]}}\n")
          number))

(ert-deftest gdev-search-test-deferred-records-finish-in-order ()
  "Il filtro accoda, i lotti ricompongono i record e l'esito attende l'ultimo lotto."
  (with-temp-buffer
    (gdev-search-mode)
    (let* ((process (gdev-search-latency-test--process))
           (output (process-buffer process))
           (gdev-search-max-results 2000)
           (root temporary-file-directory)
           (buffer (current-buffer))
           (first (gdev-search-latency-test--record 350))
           (remaining (mapconcat #'gdev-search-latency-test--record (number-sequence 349 1 -1)))
           (deadline (+ (float-time) 5)))
      (unwind-protect
          (progn
            (gdev-search--filter process (make-string 70000 ?a) buffer nil root)
            (cancel-timer (process-get process 'drain-timer))
            (gdev-search--drain process buffer nil root)
            (should (process-get process 'skip-tail))
            (should (= 0 (buffer-size output)))
            (gdev-search--filter process (concat "fine da scartare\n" (substring first 0 37)) buffer nil root)
            (let ((timer (process-get process 'drain-timer)))
              (gdev-search--filter process (concat (substring first 37) remaining) buffer nil root)
              (should (eq timer (process-get process 'drain-timer)))
              (cancel-timer timer))
            (should-not (process-get process 'hits))
            (process-put process 'finished t)
            (gdev-search--drain process buffer nil root)
            (should (eq gdev-search--process process))
            (should (< 0 (process-get process 'count) 350))
            (should-not gdev-search--results)
            (while (and gdev-search--process (< (float-time) deadline))
              (accept-process-output nil 0.02))
            (should-not gdev-search--process)
            (should-not (buffer-live-p output))
            (should (equal (mapcar #'gdev-search-hit-line gdev-search--results)
                           (number-sequence 1 350)))
            (should (string-match-p "lunghe" gdev-search--status)))
        (when (process-live-p process) (delete-process process))
        (gdev-search--release-process process)))))

(ert-deftest gdev-search-test-cancel-discards-deferred-output ()
  "Un risultato in attesa della vecchia ricerca non invade il nuovo processo."
  (with-temp-buffer
    (gdev-search-mode)
    (let* ((old (gdev-search-latency-test--process))
           (old-output (process-buffer old))
           (old-errors (process-get old 'errors))
           (buffer (current-buffer))
           (root temporary-file-directory))
      (gdev-search--filter old (gdev-search-latency-test--record 2) buffer nil root)
      (should (process-get old 'drain-timer))
      (gdev-search--stop-process)
      (should-not (process-get old 'drain-timer))
      (should-not (buffer-live-p old-output))
      (should-not (buffer-live-p old-errors))
      (let ((new (gdev-search-latency-test--process)))
        (gdev-search--filter old (gdev-search-latency-test--record 3) buffer nil root)
        (gdev-search--drain old buffer nil root)
        (should-not (process-get old 'hits))
        (should-not (process-get new 'hits))
        (should (eq gdev-search--process new))
        (should-not gdev-search--results)))))

(ert-deftest gdev-search-test-render-groups-preserve-order ()
  "Il passaggio lineare mantiene l'ordine dei gruppi e l'identità delle righe."
  (let* ((first (make-gdev-search-hit :file "a" :line 5))
         (middle (make-gdev-search-hit :file "b" :line 30 :marked t))
         (last (make-gdev-search-hit :file "a" :line 12))
         (hits (list first middle last)))
    (pcase-let ((`(,groups ,total ,marked ,last-line) (gdev-search--group-results hits)))
      (should (equal groups (seq-group-by #'gdev-search-hit-file hits)))
      (should (equal (mapcar #'car groups) '("b" "a")))
      (should (eq (cadr (assoc "a" groups)) first))
      (should (eq (caddr (assoc "a" groups)) last))
      (should (= total 3))
      (should (= marked 1))
      (should (= last-line 30)))))

(ert-deftest gdev-search-test-repeated-directory-keeps-file-tooltip ()
  "Riusa l'etichetta di cartella conservando il percorso completo di ogni file."
  (let* ((root (file-name-as-directory temporary-file-directory))
         (files (mapcar (lambda (name) (expand-file-name name root))
                        '("cartella-condivisa/primo.txt" "cartella-condivisa/secondo.txt")))
         (measures 0))
    (with-temp-buffer
      (gdev-search-mode)
      (setq default-directory root
            gdev-search--roots (list root)
            gdev-search--results (mapcar (lambda (file)
                                           (make-gdev-search-hit :file file :line 1 :source "testo"))
                                         files))
      (cl-letf (((symbol-function 'gdev-search--measure)
                 (lambda (text)
                   (when (equal text "cartella-condivisa") (cl-incf measures))
                   (string-width text))))
        (gdev-search--render))
      (should (= measures 1))
      (goto-char (point-min))
      (dolist (file files)
        (should (search-forward "cartella-condivisa" nil t))
        (should (equal (get-text-property (match-beginning 0) 'help-echo) file))))))

(ert-deftest gdev-search-test-converts-ascii-utf8-and-raw-byte-offsets ()
  "Lettura ASCII e UTF-8 conservano gli intervalli e rifiutano offset non validi."
  (cl-labels ((match-entry (start end)
                `((match . ((text . "x"))) (start . ,start) (end . ,end)))
              (read-raw (start end)
                (let* ((base64 (base64-encode-string (unibyte-string ?A #x80 ?B) t))
                       (data `((path . ((text . "file.txt"))) (line_number . 1)
                               (lines . ((bytes . ,base64)))
                               (submatches . [,(match-entry start end)]))))
                  (gdev-search--parse (json-serialize `((type . "match") (data . ,data)))
                                      nil "/prova/"))))
    (should (equal (gdev-search--character-ranges "needle due needle"
                                                  (list (match-entry 0 6) (match-entry 11 17)))
                   '((0 . 6) (11 . 17))))
    (should (equal (gdev-search--character-ranges "é a Ωz"
                                                  (list (match-entry 3 4) (match-entry 5 8)))
                   '((2 . 3) (4 . 6))))
    (should-not (gdev-search--character-ranges "ASCII" (list (match-entry 1 2) (match-entry 2 6))))
    (should-not (gdev-search--character-ranges "é a Ωz" (list (match-entry 5 6))))
    (let ((valid (read-raw 2 3))
          (invalid (read-raw 1 2)))
      (should (multibyte-string-p (gdev-search-hit-source valid)))
      (should (equal (gdev-search-hit-ranges valid) '((2 . 3))))
      (should-not (gdev-search-hit-ranges invalid)))))

(defun gdev-search-latency-test--hits (count)
  "Prepara COUNT risultati identificabili in cartelle e righe diverse."
  (cl-loop for number from 1 to count collect
           (make-gdev-search-hit :file (format "/fixture/modulo-%03d/un-documento-lungo.swift" (/ number 10))
                                :line number :ranges '((3 . 7)) :source "Un caso è visibile nel contesto")))

(ert-deftest gdev-test-search-selection-updates-only-its-control-and-summary ()
  "Una selezione fra 2000 risultati coincide con il ridisegno completo."
  (with-temp-buffer
    (gdev-search-mode)
    (setq default-directory "/fixture/" gdev-search--roots '("/fixture/"))
    (gdev-search--set-results (gdev-search-latency-test--hits 2000))
    (gdev-search--render)
    (dolist (index '(0 999 1999))
      (let ((hit (nth index gdev-search--results)))
        (dotimes (_ 2)
          (goto-char (text-property-any (point-min) (point-max) 'gdev-search-hit hit))
          (cl-letf (((symbol-function 'gdev-search--row)
                     (lambda (&rest _) (ert-fail "Ridisegno dei risultati durante la selezione"))))
            (gdev-search-toggle-hit))
          (should (eq hit (gdev-search--hit-at-point)))
          (should (eq (button-get (button-at (point)) 'action) #'gdev-search--toggle))
          (should (equal (button-label (button-at (point)))
                         (if (gdev-search-hit-marked hit) "  ✓ " "  ○ ")))
          (let ((incremental (buffer-substring-no-properties (point-min) (point-max))))
            (gdev-search--render)
            (should (equal incremental (buffer-substring-no-properties (point-min) (point-max))))))))
    (gdev-search-toggle-all)
    (should (string-search "Deseleziona tutte" (buffer-string)))
    (cl-letf (((symbol-function 'gdev-search--row)
               (lambda (&rest _) (ert-fail "Ridisegno durante la deselezione"))))
      (gdev-search--toggle (car gdev-search--results)))
    (should (string-search "Seleziona tutte" (buffer-string)))
    (should (= 1999 (cl-count-if #'gdev-search-hit-marked gdev-search--results)))))

(ert-deftest gdev-test-search-selection-keeps-both-viewports-and-invalidates-preview ()
  "Selezione e scorrimento di due finestre restano stabili; l'anteprima scade."
  (save-window-excursion
    (with-temp-buffer
      (gdev-search-mode)
      (let* ((gdev-search-refresh-interval 0)
             (preview (generate-new-buffer " *gdev-search-preview-latency*"))
             (first (selected-window))
             (second (split-window-below)))
        (unwind-protect
            (progn
              (setq default-directory "/fixture/" gdev-search--roots '("/fixture/")
                    gdev-search--preview preview gdev-search--plan '(fixture))
              (gdev-search--set-results (gdev-search-latency-test--hits 240))
              (set-window-buffer first (current-buffer))
              (set-window-buffer second (current-buffer))
              (gdev-search--render)
              (cl-labels ((position (index)
                            (text-property-any (point-min) (point-max) 'gdev-search-hit
                                               (nth index gdev-search--results))))
                (goto-char (button-start (next-button (position 110))))
                (set-window-point second (position 180))
                (set-window-start first (position 100) t)
                (set-window-start second (position 170) t)
                (gdev-search-toggle-hit)
                (should (eq (button-get (button-at (point)) 'action) #'gdev-search--open-hit))
                (dolist (pair `((,first 110 100) (,second 180 170)))
                  (should (eq (get-text-property (window-point (car pair)) 'gdev-search-hit)
                              (nth (nth 1 pair) gdev-search--results)))
                  (should (eq (get-text-property (window-start (car pair)) 'gdev-search-hit)
                              (nth (nth 2 pair) gdev-search--results)))))
              (should-not gdev-search--plan)
              (should-not (text-property-any (point-min) (point-max) 'gdev-search-action #'gdev-search-apply))
              (with-current-buffer preview (should (string-search "Ricrea l'anteprima" (buffer-string)))))
          (kill-buffer preview))))))

(ert-deftest gdev-test-search-selection-rebuilds-after-geometry-or-component-change ()
  "Geometria o componenti superati richiedono un nuovo disegno completo."
  (with-temp-buffer
    (gdev-search-mode)
    (setq default-directory "/fixture/" gdev-search--roots '("/fixture/"))
    (gdev-search--set-results (gdev-search-latency-test--hits 3))
    (let ((width 19) (rows 0) (row (symbol-function 'gdev-search--row)))
      (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width))
                ((symbol-function 'gdev-search--row)
                 (lambda (&rest arguments) (cl-incf rows) (apply row arguments))))
        (gdev-search--render)
        (setq width 35 rows 0)
        (gdev-search--toggle (car gdev-search--results))
        (should (= rows 3))
        (setq rows 0)
        (gdev-search--toggle (car gdev-search--results))
        (should (zerop rows))
        (let ((inhibit-read-only t))
          (remove-text-properties (point-min) (point-max) '(gdev-search-selection-summary nil)))
        (gdev-search--toggle (car gdev-search--results))
        (should (= rows 3))
        (let ((old (car gdev-search--results)))
          (gdev-search--set-results (gdev-search-latency-test--hits 1))
          (gdev-search--render)
          (gdev-search--toggle old)
          (should-not (gdev-search-hit-marked (car gdev-search--results))))))))

(ert-deftest gdev-test-search-arrows-open-and-selection-share-visible-target ()
  "Le frecce scelgono risultati; Invio apre e Spazio cambia solo la selezione."
  (save-window-excursion
    (with-temp-buffer
      (gdev-search-mode)
      (setq default-directory "/fixture/" gdev-search--roots '("/fixture/"))
      (gdev-search--set-results (gdev-search-latency-test--hits 3))
      (gdev-search--render)
      (set-window-buffer (selected-window) (current-buffer))
      (goto-char (point-min))
      (let (opened)
        (cl-letf (((symbol-function 'gdev-search--open-hit) (lambda (hit) (setq opened hit))))
          (dolist (key '("<down>" "<down>" "<up>"))
            (call-interactively (key-binding (kbd key))))
          (should (eq (gdev-search--hit-at-point) (car gdev-search--results)))
          (let ((before (point)))
            (call-interactively (key-binding (kbd "<up>")))
            (should (= before (point))))
          (call-interactively (key-binding (kbd "SPC")))
          (should (gdev-search-hit-marked (car gdev-search--results)))
          (should-not opened)
          (call-interactively (key-binding (kbd "RET")))
          (should (eq opened (car gdev-search--results)))
          (should (= 1 (cl-count-if #'gdev-search-hit-marked gdev-search--results)))
          (goto-char (point-max))
          (call-interactively (key-binding (kbd "<up>")))
          (should (eq (gdev-search--hit-at-point) (car (last gdev-search--results))))
          (let ((before (point)))
            (call-interactively (key-binding (kbd "<down>")))
            (should (= before (point))))
          (gdev-search--set-results nil)
          (gdev-search--render)
          (let ((before (point)))
            (call-interactively (key-binding (kbd "<down>")))
            (should (= before (point)))))))))

(ert-deftest gdev-test-search-selection-keeps-button-role-with-font-padding ()
  "Il riempimento dei simboli non scambia selezione e apertura al ridisegno."
  (with-temp-buffer
    (gdev-search-mode)
    (setq default-directory "/fixture/" gdev-search--roots '("/fixture/"))
    (gdev-search--set-results (gdev-search-latency-test--hits 2))
    ;; Le facce grafiche possono richiedere un carattere di riempimento.
    (cl-letf (((symbol-function 'gdev-search--marks) (lambda () '(5 "  ✓ " "  ○  "))))
      (gdev-search--render)
      (goto-char (text-property-any (point-min) (point-max) 'gdev-search-hit (car gdev-search--results)))
      (goto-char (1- (button-end (button-at (point)))))
      (gdev-search-toggle-hit)
      (should (eq (button-get (button-at (point)) 'action) #'gdev-search--toggle))
      (goto-char (button-start (next-button (line-beginning-position))))
      (gdev-search-toggle-hit)
      (should (eq (button-get (button-at (point)) 'action) #'gdev-search--open-hit)))))

