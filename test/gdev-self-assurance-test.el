(require 'ert)
(require 'gdev-standard-assessment)
(require 'gdev-project)

(defun gdev-test-self-assurance--contract ()
  "Leggi il contratto distribuito come dati, senza valutarlo."
  (gdev-standards-read (gdev-config-file ".gdev-assurance/self-check.eld")))

(ert-deftest gdev-test-self-assurance-contract-has-current-references-and-executable-traces ()
  (let ((contract (gdev-test-self-assurance--contract)) ids)
    (should (equal 1 (plist-get contract :version)))
    (should (eq 'quality (plist-get contract :profile)))
    (dolist (reference (plist-get contract :references))
      (let ((target (car (gdev-standard-catalog-resolve (plist-get reference :target)))))
        (should (equal (plist-get reference :edition) (plist-get target :edition)))))
    (let ((project (gdev-project-read gdev-config-directory)))
     (dolist (id (plist-get contract :requirements))
      (let ((requirement (seq-find (lambda (row) (equal id (plist-get row :id))) (plist-get project :requirements))))
      (should requirement)
      (let ((procedure (seq-find (lambda (row) (equal (plist-get requirement :procedure) (plist-get row :id)))
                                 (plist-get project :procedures))))
        (should procedure)
        (should (member id (plist-get procedure :requirements))))
      (should-not (member (plist-get requirement :id) ids))
      (push (plist-get requirement :id) ids)
      (should (plist-get requirement :sources))
      (dolist (source (plist-get requirement :sources))
        (should (gdev-trace-relative-p source))
        (should (file-regular-p (gdev-config-file source))))
      (should (plist-get requirement :tests))
      (dolist (test (plist-get requirement :tests))
        (cond ((string-prefix-p "gdev-test-" test) (should (ert-test-boundp (intern test))))
              ((string-prefix-p "test/" test) (should (file-regular-p (gdev-config-file test))))
              (t (should (member test '("project" "model" "project-report" "documents")))))))))))

(ert-deftest gdev-test-self-assurance-applies-its-engine-to-distributed-sources ()
  (gdev-test-assurance--with-root root
    (let* ((contract (gdev-test-self-assurance--contract))
           (specs (mapcar (lambda (row) (plist-get row :target)) (plist-get contract :references)))
           (paths '(("docs/assicurazione/autoverifica.md" . requirement)
                    ("docs/architettura.md" . design) ("README.md" . document)
                    (".github/workflows/ci.yml" . configuration)
                    ("lisp/gdev-assurance-db.el" . source) ("lisp/gdev-workspace-state.el" . source)
                    ("vendor/elpa/multiple-cursors-1.5.0/multiple-cursors-core.el" . source)
                    ("test/gdev-reliability-test.py" . test) ("test/gdev-forks-test.el" . test)))
           refs)
      (dolist (entry paths)
        (let ((target (expand-file-name (car entry) root)))
          (make-directory (file-name-directory target) t)
          (copy-file (gdev-config-file (car entry)) target)))
      (gdev-assurance-db-with-open (db root 'write)
        (let* ((gdev-process-origin nil)
               (id (gdev-process-open db :title "Fixture: autoverifica di GDev" :profile 'quality
                                      :actor "fixture:proponente" :actor-kind 'human)))
          (gdev-standard-select db id specs "Fixture del contratto distribuito, senza attestazione reale"
                                :actor "fixture:responsabile" :actor-kind 'human)
          (dolist (entry paths)
            (push (cons (car entry) (gdev-trace-artifact db id root (car entry) (cdr entry)
                                                       :actor "fixture:ci" :actor-kind 'ci)) refs))
          (dolist (source '("lisp/gdev-assurance-db.el" "lisp/gdev-workspace-state.el" "vendor/elpa/multiple-cursors-1.5.0/multiple-cursors-core.el"))
            (gdev-trace-link db id (cdr (assoc "docs/assicurazione/autoverifica.md" refs)) (cdr (assoc source refs))
                             'implements "Requisito di affidabilità" :actor "fixture:ci" :actor-kind 'ci)
            (gdev-trace-link db id (cdr (assoc source refs)) (cdr (assoc (if (string-prefix-p "vendor/" source) "test/gdev-forks-test.el" "test/gdev-reliability-test.py") refs))
                             'verifies "Campagna di affidabilità" :actor "fixture:ci" :actor-kind 'ci))
          (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED)
          (let ((gdev-process-origin 'ci))
            (should-error (gdev-process-advance db id 'AUTHORIZED :actor "fixture:ci" :actor-kind 'ci)
                          :type 'gdev-process-refused))
          (gdev-test-assurance--walk db id 'AUTHORIZED 'IMPLEMENTING 'VERIFYING)
          (dolist (target specs)
            (let ((evidence (gdev-evidence-add db id :kind 'fact
                                               :description (concat "Fixture di prova per " target)
                                               :content "Esito simulato per verificare il motore, non la distribuzione"
                                               :actor "fixture:ci" :actor-kind 'ci)))
              (gdev-standard-proof db id target evidence "pass" :actor "fixture:ci" :actor-kind 'ci)))
          (gdev-test-assurance--step db id 'REVIEWING 'ci)
          (should-not (gdev-assurance-verify db))
          (should (cl-every (lambda (row) (equal "SATISFIED" (alist-get 'status row)))
                            (alist-get 'results (gdev-standard-assessment db id))))
          (write-region "\n;; modifica dopo la prova\n" nil (expand-file-name "lisp/gdev-assurance-db.el" root) t 'silent)
          (should (cl-every (lambda (row) (equal "NOT_VERIFIED" (alist-get 'status row)))
                            (alist-get 'results (gdev-standard-assessment db id)))))))))

(ert-deftest gdev-test-self-assurance-requires-fresh-complete-reliability-evidence ()
  (let ((file (getenv "GDEV_SELF_ASSURANCE_REPORT")))
    (skip-unless file)
    (let* ((contract (gdev-test-self-assurance--contract))
           (report (with-temp-buffer
                     (let ((coding-system-for-read 'utf-8-unix)) (insert-file-contents file))
                     (json-parse-buffer :object-type 'alist :array-type 'list :null-object nil :false-object :false)))
           (counts (alist-get 'counts report)))
      (should (eq t (alist-get 'ok report)))
      (should (equal 1 (alist-get 'schema_version report)))
      (should (equal (sort (copy-sequence (plist-get contract :reliability-cases)) #'string<)
                     (sort (copy-sequence (alist-get 'cases report)) #'string<)))
      (should (>= (alist-get 'model_operations counts) (plist-get contract :minimum-model-operations)))
      (should (>= (alist-get 'sql_faults counts) (plist-get contract :minimum-sql-faults)))
      (should (>= (alist-get 'crash_points counts) (plist-get contract :minimum-crash-points)))
      (should (>= (length (alist-get 'mutations report)) (plist-get contract :minimum-mutations)))
      (should (cl-every (lambda (row) (equal "killed" (alist-get 'status row))) (alist-get 'mutations report)))
      (should (equal "NOT_VERIFIED" (alist-get 'human_approval report)))
      (should (eq :false (alist-get 'sources_changed report)))
      (should (alist-get 'sources report))
      (dolist (source (alist-get 'sources report))
        (let ((path (alist-get 'path source)))
          (should (gdev-trace-relative-p path))
          (should (equal (alist-get 'sha256 source) (gdev-trace-file-sha256 (gdev-config-file path)))))))))

(provide 'gdev-self-assurance-test)
