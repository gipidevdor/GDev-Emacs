(ert-deftest gdev-search-test-workspace-undo-redo-and-conflict ()
  "Undo e redo attraversano due documenti e si fermano prima di un conflitto."
  (let ((first (generate-new-buffer " *gdev-operation-first*"))
        (second (generate-new-buffer " *gdev-operation-second*")))
    (unwind-protect
        (gdev-test--with-layout
          (dolist (buffer (list first second))
            (with-current-buffer buffer
              (buffer-enable-undo)
              (insert "lungo\nz")))
          (gdev-operation-record-replacement
           (list (list first '(2 3 4 "b" "z") '(1 1 2 "a" "lungo"))
                 (list second '(2 3 4 "b" "z") '(1 1 2 "a" "lungo"))))
          (gdev-operation-undo)
          (dolist (buffer (list first second))
            (should (equal (with-current-buffer buffer (buffer-string)) "a\nb")))
          (gdev-operation-redo)
          (dolist (buffer (list first second))
            (should (equal (with-current-buffer buffer (buffer-string)) "lungo\nz")))
          (with-current-buffer second (insert "!"))
          (should-error (gdev-operation-undo) :type 'user-error)
          (should (equal (with-current-buffer first (buffer-string)) "lungo\nz"))
          (should (gdev-operation-undo-label)))
      (kill-buffer first)
      (kill-buffer second))))

(ert-deftest gdev-search-test-workspace-replays-consecutive-replacements ()
  "Il ripristino controllato ricollega le revisioni, un intervento esterno le separa."
  (let ((file (make-temp-file "gdev-revisioni-" nil ".txt" "a\n"))
        buffer)
    (unwind-protect
        (gdev-test--with-layout
          (setq buffer (find-file-noselect file))
          (cl-labels ((replace-line
                       (before after)
                       (gdev-search--change
                        (list (make-gdev-search-plan
                               :file file :paths (list file)
                               :tick (cons buffer (with-current-buffer buffer
                                                    (buffer-chars-modified-tick)))
                               :attributes (gdev-search--file-version file)
                               :lines (list (list 1 1 (1+ (length before)) before after))))))
                      (text () (with-current-buffer buffer (buffer-string))))
            (replace-line "a" "breve")
            (replace-line "breve" "lungo")
            (gdev-operation-undo)
            (should (equal (text) "breve\n"))
            (gdev-operation-undo)
            (should (equal (text) "a\n"))
            (gdev-operation-redo)
            (should (equal (text) "breve\n"))
            (gdev-operation-redo)
            (should (equal (text) "lungo\n"))
            (with-current-buffer buffer
              (goto-char (point-max))
              (insert "ritocco")
              (delete-region (- (point) (length "ritocco")) (point)))
            (replace-line "lungo" "nuovo")
            (gdev-operation-undo)
            (should (equal (text) "lungo\n"))
            (should-error (gdev-operation-undo) :type 'user-error)
            (should (equal (text) "lungo\n"))))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (delete-file file))))

(ert-deftest gdev-search-test-workspace-redo-rejects-external-changes ()
  "Ripeti verifica tutti i documenti prima di modificare quelli ancora validi."
  (dolist (cause '(edit disk closed))
    (ert-info ((format "Conflitto: %s" cause))
      (let ((file (make-temp-file "gdev-conflitto-" nil ".txt" "a"))
            (first (generate-new-buffer " *Cambio ancora valido*"))
            second)
        (unwind-protect
            (gdev-test--with-layout
              (setq second (find-file-noselect file))
              (dolist (buffer (list first second))
                (with-current-buffer buffer
                  (buffer-enable-undo)
                  (erase-buffer)
                  (insert "b")))
              (gdev-operation-record-replacement
               (mapcar (lambda (buffer) (list buffer '(1 1 2 "a" "b"))) (list first second)))
              (gdev-operation-undo)
              (let ((label (gdev-operation-redo-label)))
                (pcase cause
                  ('edit (with-current-buffer second (insert "!")))
                  ('disk
                   (with-temp-file file (insert "Modifica sul disco"))
                   (set-file-times file (seconds-to-time 1000000)))
                  ('closed
                   (with-current-buffer second (set-buffer-modified-p nil))
                   (kill-buffer second)))
                (should-error (gdev-operation-redo) :type 'user-error)
                (should (equal (gdev-operation-redo-label) label))
                (should (equal (with-current-buffer first (buffer-string)) "a"))))
          (dolist (buffer (list first second))
            (when (buffer-live-p buffer)
              (with-current-buffer buffer (set-buffer-modified-p nil))
              (kill-buffer buffer)))
          (delete-file file))))))

(ert-deftest gdev-search-test-workspace-undo-retries-after-a-failed-edit ()
  "Un errore dopo la prima modifica ripristina tutti i testi e lascia riprovare."
  (let ((first (generate-new-buffer " *Documento da verificare*"))
        (second (generate-new-buffer " *Documento da ripristinare*"))
        interrupted)
    (unwind-protect
        (gdev-test--with-layout
          (dolist (buffer (list first second))
            (with-current-buffer buffer
              (buffer-enable-undo)
              (insert "b")))
          (gdev-operation-record-replacement
           (mapcar (lambda (buffer) (list buffer '(1 1 2 "a" "b"))) (list first second)))
          (let ((fail (lambda (&rest _)
                        (unless interrupted
                          (setq interrupted t)
                          (error "Modifica interrotta")))))
            (with-current-buffer first (add-hook 'after-change-functions fail nil t))
            (unwind-protect
                (should-error (gdev-operation-undo))
              (with-current-buffer first (remove-hook 'after-change-functions fail t))))
          (should interrupted)
          (dolist (buffer (list first second))
            (should (equal (with-current-buffer buffer (buffer-string)) "b")))
          (should (gdev-operation-undo-label))
          (should-not (gdev-operation-redo-label))
          (gdev-operation-undo)
          (dolist (buffer (list first second))
            (should (equal (with-current-buffer buffer (buffer-string)) "a")))
          (gdev-operation-redo)
          (dolist (buffer (list first second))
            (should (equal (with-current-buffer buffer (buffer-string)) "b"))))
      (mapc #'kill-buffer (list first second)))))

(ert-deftest gdev-test-operation-history-installs-and-observes-commands ()
  "L'installazione osserva il comando e conserva il comportamento senza Workbench."
  (require 'gdev-commands)
  (gdev-test--with-layout
    (let ((pre-command-hook nil)
          (gdev-operation-commands (make-ring 4))
          (add-advice (symbol-function 'advice-add))
          registered)
      (unwind-protect
          (progn
            (cl-letf (((symbol-function 'advice-add)
                       (lambda (symbol where function &optional properties)
                         (push symbol registered)
                         (funcall add-advice symbol where function properties))))
              (gdev-operation-install))
            (should (advice-member-p #'gdev-operation--capture-layout 'gdev-split-editor-right))
            (dolist (command (list 'gdev-split-editor-right (lambda () (interactive)) nil))
              (let ((this-command command)) (run-hooks 'pre-command-hook)))
            (should (equal (ring-elements gdev-operation-commands)
                           '(comando-anonimo gdev-split-editor-right)))
            (let ((gdev-layout-mode nil))
              (call-interactively #'gdev-split-editor-right))
            (should (= (length (gdev-layout--editors)) 2))
            (should-not (gdev-operation-undo-label)))
        (dolist (symbol registered)
          (advice-remove symbol #'gdev-operation--capture-layout))))))

(defun gdev-search-test--wait ()
  "Attende la pubblicazione dei risultati con un limite di tempo."
  (let ((deadline (+ (float-time) 5)))
    (while (and gdev-search--process (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should-not gdev-search--process)))

(defun gdev-search-test--eventually (predicate)
  "Attende che PREDICATE confermi un aggiornamento automatico."
  (let ((deadline (+ (float-time) 5)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.05))
    (should (funcall predicate))))

(ert-deftest gdev-search-test-requires-project-or-workspace-folder ()
  "La ricerca senza cartelle attive non usa la cartella predefinita."
  (with-temp-buffer
    (cl-letf (((symbol-function 'gdev-workspace-roots) #'ignore)
              ((symbol-function 'gdev-search--root) #'ignore))
      (gdev-search-mode)
      (should-not gdev-search--roots)
      (should-error (gdev-search--start "codice") :type 'user-error)
      (should-not gdev-search--process))))

(ert-deftest gdev-search-test-empty-scope-offers-folder-action ()
  "Senza cartelle, il pulsante e Invio chiamano la stessa apertura."
  (let ((calls 0) shown)
    (cl-letf (((symbol-function 'gdev-search--scope) #'ignore)
              ((symbol-function 'gdev-open-folder)
               (lambda () (interactive) (cl-incf calls)))
              ((symbol-function 'gdev-search-show)
               (lambda (&optional query) (should-not query) (setq shown t)))
              ((symbol-function 'read-string)
               (lambda (&rest _) (ert-fail "Richiesta di testo senza cartelle"))))
      (with-temp-buffer
        (call-interactively #'gdev-search-query)
        (should shown)
        (gdev-search-mode)
        (let ((open (text-property-any (point-min) (point-max)
                                       'gdev-search-action #'gdev-open-folder)))
          (should open)
          (should-not (text-property-any (point-min) (point-max)
                                         'gdev-search-action #'gdev-search-query))
          (button-activate (button-at open))
          (goto-char (point-min))
          (gdev-search-visit)
          (should (= calls 2))
          (should-not gdev-search--roots))))))

(ert-deftest gdev-search-test-visible-filters-restore-results ()
  "I filtri visibili spiegano lo stato vuoto e possono essere azzerati."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-filter-view-" t)))
         (file (expand-file-name "testo.txt" root))
         (include "*.formato-non-presente")
         (exclude "*.backup"))
    (unwind-protect
        (progn
          (with-temp-file file (insert "documento\n"))
          (cl-letf (((symbol-function 'gdev-search--scope) (lambda () (list root)))
                    ((symbol-function 'window-body-width) (lambda (&rest _) 19)))
            (with-temp-buffer
              (gdev-search-mode)
              (gdev-search-query "documento")
              (gdev-search-test--wait)
              (dolist (activate (list (lambda () (button-activate (button-at (point))))
                                      #'gdev-search-visit))
                (gdev-search-filters include exclude)
                (gdev-search-test--wait)
                (should (gdev-search-path-filters-p))
                (should-not gdev-search--results)
                (should (equal gdev-search--status "Nessun risultato"))
                (dolist (label (list (concat "Includi " include) (concat "Escludi " exclude)))
                  (save-excursion
                    (goto-char (point-min))
                    (should (text-property-search-forward 'help-echo label t))))
                (goto-char (text-property-any (point-min) (point-max)
                                              'gdev-search-action #'gdev-search-clear-filters))
                (funcall activate)
                (gdev-search-test--wait)
                (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list file)))
                (should (equal gdev-search--query "documento"))
                (should (equal gdev-search--roots (list root)))
                (should-not (gdev-search-path-filters-p))
                (should-not (text-property-any (point-min) (point-max)
                                               'gdev-search-action #'gdev-search-clear-filters))
                (should (eq (get-text-property (point) 'gdev-search-action)
                            #'gdev-search-filters))))))
      (delete-directory root t))))

(ert-deftest gdev-search-test-word-globs-ignored-and-captures ()
  "I filtri combinano più file e l'anteprima usa i gruppi di ripgrep."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-filters-" t)))
         (swift (expand-file-name "a.swift" root))
         (header (expand-file-name "a.h" root)))
    (unwind-protect
        (with-temp-buffer
          (with-temp-file swift
            (insert "precodice 01\ncodice 42\ncodice 00 " (make-string 70000 ?x) "\n"))
          (with-temp-file header (insert "codice 13\n"))
          (with-temp-file (expand-file-name ".ignore" root) (insert "*.h\n"))
          (with-temp-file (expand-file-name "a.txt" root) (insert "codice 09\n"))
          (gdev-search-mode)
          (let ((gdev-search-refresh-interval 0))
            (cl-letf (((symbol-function 'gdev-search--scope) (lambda () (list root))))
              (setq gdev-search--include "*.swift, *.h"
                    gdev-search--whole-word t
                    gdev-search--regexp t)
              (gdev-search--start "(codice) ([0-9]+)")
              (gdev-search-test--wait)
              (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list header swift)))
              (should (string-match-p "lunghe" gdev-search--status))
              (setq gdev-search--include "" gdev-search--exclude "*.txt")
              (gdev-search-repeat)
              (gdev-search-test--wait)
              (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list swift)))
              (gdev-search-toggle-ignored)
              (gdev-search-test--wait)
              (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list header swift)))
              (let ((expanded (gdev-search--regexp-replacements gdev-search--results "$2 $1")))
                (should (equal (mapcar (lambda (hit) (gethash hit expanded))
                                       gdev-search--results)
                               '("13 codice" "42 codice")))))))
      (delete-directory root t))))

(ert-deftest gdev-search-test-preview-and-apply ()
  "Cerca in due radici, filtra e applica le righe scelte dopo conferma."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-test-" t)))
         (first (expand-file-name "primo/" root))
         (second (expand-file-name "secondo/" root))
         (file (expand-file-name "testo.txt" first))
         (another (expand-file-name "altro.txt" second))
         (excluded (expand-file-name "ignorato.txt" second))
         (roots (list first second))
         (search (generate-new-buffer " *gdev-search-test*")))
    (unwind-protect
        (save-window-excursion
          (make-directory first)
          (make-directory second)

          (write-region "à Noe noe\nseconda noe\n" nil file)
          (write-region "noe dal secondo\n" nil another)
          (write-region "noe ignorato\n" nil excluded)
          (write-region "noe dal Markdown\n" nil (expand-file-name "testo.md" first))
          (cl-letf (((symbol-function 'gdev-workspace-roots) (lambda (&optional _) roots)))
            (with-current-buffer search
              (gdev-search-mode)
              (gdev-search-filters "*.txt" "ignorato.txt")
              (gdev-search-query "noe")
              (gdev-search-test--wait)
              (should (= (length gdev-search--results) 3))
              (should (= (length (seq-group-by #'gdev-search-hit-file gdev-search--results)) 2))
              (goto-char (point-min))
              (gdev-search-next-hit)
              (should (gdev-search--hit-at-point))
              (gdev-search-next-hit)
              (should (gdev-search--hit-at-point))
              (gdev-search-previous-hit)
              (gdev-search-toggle-all)
              (let ((row (seq-find (lambda (hit) (equal (gdev-search-hit-source hit) "seconda noe"))
                                   gdev-search--results)))
                (gdev-search--toggle row))
              (gdev-search-preview "sì")
              (should-not (find-buffer-visiting file))
              (should-not (find-buffer-visiting another))
              (with-current-buffer gdev-search--preview
                (should (derived-mode-p 'diff-mode))
                (should (string-match-p (regexp-quote "+à sì sì") (buffer-string)))
                (should-not (string-match-p "seconda" (buffer-string))))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) nil)))
                (gdev-search-apply))
              (should-not (find-buffer-visiting file))
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t)))
                (gdev-search-apply))
              (with-current-buffer (find-buffer-visiting file)
                (should (equal (buffer-string) "à sì sì\nseconda noe\n"))
                (should (buffer-modified-p)))
              (with-current-buffer (find-buffer-visiting another)
                (should (equal (buffer-string) "sì dal secondo\n")))
              (with-temp-buffer
                (insert-file-contents file)
                (should (equal (buffer-string) "à Noe noe\nseconda noe\n")))
              (with-current-buffer (find-buffer-visiting file)
                (let ((last-command nil)) (undo-only))
                (should (equal (buffer-string) "à Noe noe\nseconda noe\n"))))))
      (kill-buffer search)
      (dolist (path (list file another))
        (when-let* ((buffer (find-buffer-visiting path)))
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-search-test-reject-stale-preview ()
  "Rifiuta l'intera sostituzione se un documento è cambiato dopo il diff."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-test-" t)))
         (file (expand-file-name "primo.txt" root))
         (another (expand-file-name "secondo.txt" root))
         (search (generate-new-buffer " *gdev-search-test*")))
    (unwind-protect
        (save-window-excursion
          (write-region "noe\n" nil file)
          (write-region "noe\n" nil another)
          (cl-letf (((symbol-function 'gdev-workspace-roots) (lambda (&optional _) (list root))))
            (with-current-buffer search
              (gdev-search-mode)
              (gdev-search-query "noe")
              (gdev-search-test--wait)
              (gdev-search-toggle-all)
              (gdev-search-preview "sì")
              (write-region "nuovo contenuto\n" nil another)
              (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t)))
