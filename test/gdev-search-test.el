      (kill-buffer search)
      (dolist (path (list file another))
        (when-let* ((buffer (find-buffer-visiting path)))
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-search-test-replacement-keeps-the-owning-workspace ()
  "Due spazi con le stesse cartelle non condividono anteprima e cronologia."
  (skip-unless (executable-find "rg"))
  (dolist (change '(before-confirmation during-confirmation during-file-open during-edit))
    (ert-info ((symbol-name change))
      (let* ((root (file-name-as-directory (make-temp-file "gdev-search-owner-" t)))
             (file (expand-file-name "documento.txt" root))
             (gdev-search-refresh-interval 0)
             search preview plan (confirmations 0))
        (unwind-protect
            (gdev-test--with-layout
              (with-temp-file file (insert "ago\n"))
              (gdev-workspace-set-roots (list root))
              (setq search (gdev-search-buffer))
              (with-current-buffer search
                (gdev-search-query "ago")
                (gdev-search-test--wait)
                (gdev-search-toggle-all)
                (gdev-search-preview "filo")
                (setq preview gdev-search--preview plan gdev-search--plan))
              (cl-labels ((other-workspace ()
                            (tab-bar-new-tab)
                            (gdev-workspace-set-roots (list root)))
                          (apply-from-preview ()
                            (with-current-buffer preview
                              (goto-char (point-min))
                              (forward-button 1)
                              (push-button)))
                          (file-opened ()
                            (when (and buffer-file-name (file-equal-p buffer-file-name file))
                              (pcase change
                                ('during-file-open (save-current-buffer (other-workspace)))
                                ('during-edit
                                 (add-hook 'after-change-functions #'file-edited nil t)))))
                          (file-edited (&rest _)
                            (remove-hook 'after-change-functions #'file-edited t)
                            (save-current-buffer (other-workspace))))
                (when (eq change 'before-confirmation) (other-workspace))
                (let ((find-file-hook (cons #'file-opened find-file-hook)))
                  (cl-letf (((symbol-function 'yes-or-no-p)
                             (lambda (&rest _)
                               (cl-incf confirmations)
                               (when (eq change 'during-confirmation) (other-workspace))
                               t)))
                    (let ((err (should-error (apply-from-preview) :type 'user-error)))
                      (should (string-match-p "spazio di origine" (error-message-string err))))))
                (should (= confirmations (if (eq change 'before-confirmation) 0 1)))
                (should (equal (gdev-workspace-roots) (list root)))
                (should-not (gdev-operation-undo-label))
                (when-let* ((buffer (find-buffer-visiting file)))
                  (with-current-buffer buffer
                    (should-not (buffer-modified-p))
                    (should (equal (buffer-string) "ago\n"))))
                (tab-bar-select-tab 1)
                (should (eq (buffer-local-value 'gdev-search--plan search) plan))
                (cl-letf (((symbol-function 'yes-or-no-p) #'always))
                  (apply-from-preview))
                (with-current-buffer (find-buffer-visiting file)
                  (should (equal (buffer-string) "filo\n")))
                (should (gdev-operation-undo-label))))
          (when-let* ((buffer (find-buffer-visiting file)) ((buffer-live-p buffer)))
            (with-current-buffer buffer (set-buffer-modified-p nil))
            (kill-buffer buffer))
          (when (buffer-live-p search) (kill-buffer search))
          (delete-directory root t))))))

(ert-deftest gdev-search-test-regexp-and-case-crlf ()
  "Rispetta maiuscole e termini di riga dei file CRLF in modo regexp."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-test-" t)))
         (file (expand-file-name "testo.txt" root)))
    (unwind-protect
        (save-window-excursion
          (let ((coding-system-for-write 'utf-8-dos))
            (write-region "Un noe\nUn Noe\n" nil file))
          (cl-letf (((symbol-function 'gdev-workspace-roots) (lambda (&optional _) (list root))))
            (with-temp-buffer
              (gdev-search-mode)
              (gdev-search-toggle-regexp)
              (gdev-search-toggle-case)
              (gdev-search-query "no[e]$")
              (gdev-search-test--wait)
              (should (= (length gdev-search--results) 1))
              (should (equal "Un noe" (gdev-search-hit-source (car gdev-search--results))))
              (gdev-search-toggle-all)
              (gdev-search-preview "sì")
              (should gdev-search--plan)
              (gdev-search-toggle-all)
              (should-not gdev-search--plan)
              (should-error (gdev-search-apply) :type 'user-error)
              (should-not (find-buffer-visiting file)))))
      (delete-directory root t))))

(ert-deftest gdev-search-test-refresh-visible-on-disk ()
  "Scopre cartelle nuove nel progetto e conserva fuoco, selezione e filtri."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-live-" t)))
         (old (expand-file-name "z.txt" root))
         (nested (expand-file-name "a/nuovo.txt" root))
         (search (generate-new-buffer " *gdev-search-live*"))
         (gdev-search-refresh-interval 1))
    (unwind-protect
        (save-window-excursion
          (let* ((editor-window (selected-window))
                 (editor-buffer (window-buffer editor-window))
                 (search-window (split-window-below)))
            (set-window-buffer search-window search)
            (write-region "ago stabile\n" nil old)
            (write-region "ignorati/\n" nil (expand-file-name ".ignore" root))
            (cl-letf (((symbol-function 'gdev-workspace-roots) (lambda (&optional _) (list root)))
                      ((symbol-function 'display-buffer) #'ignore))
              (with-current-buffer search
                (gdev-search-mode)
                (gdev-search-filters "*.txt" "escluso.txt")
                (gdev-search-query "ago")
                (gdev-search-test--wait)
                (goto-char (point-min))
                (gdev-search-next-hit)
                (gdev-search-toggle-hit)
                (gdev-search-preview "filo")
                (let ((hit (gdev-search--hit-at-point))
                      (plan gdev-search--plan))
                  (set-window-point search-window (point))
                  (make-directory (file-name-directory nested))
                  (make-directory (expand-file-name "ignorati" root))
                  (write-region "ago annidato\n" nil nested)
                  (write-region "ago ignorato\n" nil (expand-file-name "ignorati/nascosto.txt" root))
                  (write-region "ago escluso\n" nil (expand-file-name "a/escluso.txt" root))
                  (write-region "ago in altro formato\n" nil (expand-file-name "a/non-testo.md" root))
                  (gdev-search-test--eventually (lambda () (= (length gdev-search--results) 2)))
                  (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list nested old)))
                  (should (eq hit (cadr gdev-search--results)))
                  (should (gdev-search-hit-marked hit))
                  (should-not (gdev-search-hit-marked (car gdev-search--results)))
                  (should (eq plan gdev-search--plan))
                  (should (eq editor-window (selected-window)))
                  (should (eq hit (get-text-property (window-point search-window) 'gdev-search-hit)))
                  (cl-letf (((symbol-function 'yes-or-no-p)
                             (lambda (_)
                               (delete-file old)
                               (gdev-search-test--eventually (lambda () (null gdev-search--plan)))
                               t)))
                    (should-error (gdev-search-apply) :type 'user-error))
                  (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list nested))))
                (set-window-buffer search-window editor-buffer)
                (gdev-search--window-changed search-window)
                (should-not gdev-search--refresh-timer)
                (rename-file nested old)
                (should (equal nested (gdev-search-hit-file (car gdev-search--results))))
                (set-window-buffer search-window search)
                (gdev-search--window-changed search-window)
                (gdev-search-test--eventually
                 (lambda () (equal old (gdev-search-hit-file (car gdev-search--results)))))
                (should (eq editor-window (selected-window)))
                (gdev-search-toggle-all)
                (gdev-search-preview "filo")
                (cl-letf (((symbol-function 'yes-or-no-p) (lambda (_) t)))
                  (gdev-search-apply))
                (write-region "ago esterno mentre le sostituzioni sono da salvare\n" nil nested)
                (gdev-search-test--eventually (lambda () (gdev-search-hit-p (car gdev-search--results))))
                (should (equal (mapcar #'gdev-search-hit-file gdev-search--results) (list nested)))
                (with-current-buffer (find-buffer-visiting old)
                  (should (buffer-modified-p))
                  (save-buffer))
                (gdev-search-test--eventually (lambda () (null gdev-search--awaiting-save)))))))
      (kill-buffer search)
      (when-let* ((document (find-buffer-visiting old)))
        (with-current-buffer document (set-buffer-modified-p nil))
        (kill-buffer document))
      (delete-directory root t))))

(ert-deftest gdev-search-test-refresh-order-at-limit ()
  "Mostra sempre il medesimo risultato quando il limite tronca la ricerca."
  (skip-unless (executable-find "rg"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-search-limit-" t)))
         (first (expand-file-name "a.txt" root))
         (gdev-search-max-results 1))
    (unwind-protect
        (cl-letf (((symbol-function 'gdev-workspace-roots) (lambda (&optional _) (list root))))
          (write-region "ago\n" nil (expand-file-name "z.txt" root))
          (write-region "ago\n" nil first)
          (with-temp-buffer
            (gdev-search-mode)
            (gdev-search-query "ago")
            (gdev-search-test--wait)
            (let ((hit (car gdev-search--results)))
              (should (equal first (gdev-search-hit-file hit)))
              (gdev-search--launch t)
              (gdev-search-test--wait)
              (should (eq hit (car gdev-search--results))))))
      (delete-directory root t))))

(ert-deftest gdev-search-test-query-seed-and-cancel ()
  "Propone il testo letterale selezionato prima di mostrare la vista."
  (let ((search (generate-new-buffer " *gdev-search-seed*")))
    (unwind-protect
        (cl-letf (((symbol-function 'gdev-search--scope) (lambda () (list default-directory)))
                  ((symbol-function 'gdev-workspace-state-get)
                   (lambda (key &optional _) (when (eq key 'gdev-activity-buffers) (list (cons 'search search)))))
                  ((symbol-function 'gdev-search-show) (lambda (&rest _) (ert-fail "È stata aperta la vista"))))
          (with-current-buffer search
            (setq-local gdev-search--query "ultima" gdev-search--regexp t))
          (with-temp-buffer
            (let ((transient-mark-mode t))
              (should (equal "ultima" (gdev-search--query-seed)))
              (insert "a(b)|c")
              (push-mark (point-min) t t)
              (cl-letf (((symbol-function 'read-string) (lambda (_prompt seed &rest _) (throw 'annulla seed))))
                (should (equal "a\\(b\\)\\|c" (catch 'annulla (call-interactively #'gdev-search-query)))))
              (insert "\nseconda")
              (should (equal "ultima" (gdev-search--query-seed))))))
      (kill-buffer search))))

(ert-deftest gdev-search-test-narrow-view-keeps-occurrence-and-actions ()
  "Nel riquadro stretto l'occorrenza resta leggibile e le azioni restano distinte."
  (let* ((width 19)
         (root (file-name-as-directory temporary-file-directory))
         (name "ConfigurazioneSistemaConUnNomeMoltoLungo.swift")
         (first (expand-file-name (concat "moduli/primo/" name) root))
         (second (expand-file-name (concat "moduli/secondo/" name) root))
         (source (concat (make-string 120 ?α) "documento  e altro"))
         (ascii (concat (make-string 120 ?a) "documento  e altro"))
         (hit (make-gdev-search-hit :file first :line 37 :ranges '((120 . 129)) :source source))
         (other (make-gdev-search-hit :file second :line 2 :ranges '((120 . 129)) :source ascii))
         opened)
    (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) width))
              ((symbol-function 'gdev-search--open-hit) (lambda (result) (setq opened result))))
      (with-temp-buffer
        (gdev-search-mode)
        (setq default-directory root
              gdev-search--roots (list root) gdev-search--query "documento"
              gdev-search--results (list hit other))
        (gdev-search--render)
        (goto-char (point-min))
        (while (not (eobp))
          (should (<= (string-width (buffer-substring (line-beginning-position) (line-end-position)))
                      width))
          (forward-line 1))
        (dolist (file (list first second))
          (save-excursion
            (let ((heading (text-property-any (point-min) (point-max) 'help-echo file)))
              (should heading)
              (goto-char heading)
              (should (string-suffix-p ".swift"
                                       (buffer-substring-no-properties (point) (line-end-position)))))))
        (goto-char (point-min))
        (gdev-search-next-hit)
        (should (eq (gdev-search--hit-at-point) hit))
        (should (equal (button-get (button-at (point)) 'help-echo) source))
        (should (search-forward "documento" (line-end-position) t))
        (should (equal (get-text-property (- (point) 2) 'face) '(gdev-ui-action fixed-pitch)))
        (button-activate (button-at (line-beginning-position)))
        (should (gdev-search-hit-marked hit))
        (should-not (gdev-search-hit-marked other))
        (should-not opened)
        (gdev-search-next-hit)
        (should (eq (gdev-search--hit-at-point) other))
        (should (search-forward "documento" (line-end-position) t))
        (gdev-search-previous-hit)
        (setq width 35)
        (gdev-search--resize (selected-window))
        (should (eq (gdev-search--hit-at-point) hit))
        (goto-char (button-start (next-button (line-beginning-position))))
        (gdev-search-visit)
        (should (eq opened hit))
        (goto-char (text-property-any (point-min) (point-max)
                                      'gdev-search-action #'gdev-search-toggle-ignored))
        (setq width 19)
        (gdev-search--resize (selected-window))
        (should (eq (get-text-property (point) 'gdev-search-action) #'gdev-search-toggle-ignored))))))

(provide 'gdev-search-test)
(ert-deftest gdev-search-test-consult-grep-preserves-limits-and-properties ()
  "Consult applica il limite in caratteri senza perdere il contesto delle righe."
  (require 'package)
  (package-activate-all)
  (require 'consult)
  (let* ((line (concat "note.org" (string 0) "12-" (propertize "è🌲àxyz" 'help-echo "Contesto")))
         (format-results (funcall (consult--grep-format (lambda (_) nil)) #'identity)))
    (funcall format-results "ricerca")
    (dolist (example '((0 . "") (3 . "è🌲à") (6 . "è🌲àxyz") (nil . "è🌲àxyz")))
      (let* ((consult-grep-max-columns (car example))
             (candidate (car (funcall format-results (list line))))
             (prefix "note.org-12-"))
        (should (equal (substring-no-properties candidate) (concat prefix (cdr example))))
        (should (equal (get-text-property 0 'consult--group candidate) "note.org"))
        (unless (equal (car example) 0)
          (should (equal (get-text-property (length prefix) 'help-echo candidate) "Contesto")))))))

