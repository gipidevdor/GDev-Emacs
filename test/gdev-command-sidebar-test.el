(require 'gdev-command-sidebar)
(require 'gdev-workspaces)

(defun gdev-test-command-sidebar--action (command groups)
  "Cerca COMMAND in GROUPS."
  (cl-loop for (_ _ _ actions) in groups
           thereis (seq-find (lambda (action)
                               (eq command (gdev-command-sidebar--action-command action)))
                             actions)))

(ert-deftest gdev-test-command-sidebar-discovers-module-and-view-actions ()
  "I gruppi nuovi entrano nel pannello e nel menu solo nel contesto adatto."
  (let ((gdev-tool-action-groups nil)
        (gdev-tool-actions-change-hook nil)
        (gdev--localleader-maps (make-hash-table :test #'eq)))
    (cl-letf (((symbol-function 'gdev-test-command-sidebar-module-action)
               (lambda () (interactive)))
              ((symbol-function 'gdev-test-command-sidebar-local-action)
               (lambda () (interactive))))
      (gdev-set-tool-actions 'future "Modulo futuro" "tool"
        ["Lavora sul testo" gdev-test-command-sidebar-module-action
         :visible (derived-mode-p 'text-mode)])
      (with-temp-buffer
        (fundamental-mode)
        (should-not (assq 'future (gdev-command-sidebar--collect)))
        (text-mode)
        (use-local-map (make-composed-keymap nil (current-local-map)))
        (gdev-bind (gdev-localleader-map (current-local-map)) "z" "azione del linguaggio"
                   #'gdev-test-command-sidebar-local-action)
        (let ((groups (gdev-command-sidebar--collect)))
          (should (assq 'future groups))
          (should (gdev-test-command-sidebar--action 'gdev-test-command-sidebar-local-action
                                                    (list (assq 'language groups))))
          (should (rassq 'gdev-test-command-sidebar-module-action (gdev-menu-command-items))))
        (setq-local gdev-context-items '(["Copia la riga" kill-ring-save (use-region-p) (:prefix 1)]))
        (should-not (gdev-test-command-sidebar--action 'kill-ring-save
                                                      (list (assq 'view (gdev-command-sidebar--collect)))))
        (let ((transient-mark-mode t))
          (insert "selezione")
          (push-mark (point-min) t t)
          (let ((action (gdev-test-command-sidebar--action
                         'kill-ring-save (list (assq 'view (gdev-command-sidebar--collect))))))
            (should (eq 1 (gdev-command-sidebar--action-prefix action)))))))))

;; Comandi e il menu Codice offrivano le azioni del server di linguaggio
;; anche senza server: il clic finiva in un errore.
(ert-deftest gdev-test-command-sidebar-hides-unavailable-module-commands ()
  "Un comando con una condizione dichiarata compare solo quando la condizione vale."
  (let ((available nil)
        (map (make-sparse-keymap)))
    (cl-letf (((symbol-function 'gdev-test-command-sidebar-server-action)
               (lambda () (interactive))))
      (unwind-protect
          (progn
            (put 'gdev-test-command-sidebar-server-action 'gdev-menu-available (lambda () available))
            (define-key map "a" '("azione del server" . gdev-test-command-sidebar-server-action))
            (let ((item (car (gdev-menu--items map "C-c c")))
                  (written (gdev-menu--entry ["Azione" gdev-test-command-sidebar-server-action])))
              (should-not (gdev-menu--available-item-p item))
              (should-not (gdev-menu--available-item-p written))
              ;; Il catalogo delle scorciatoie elenca anche i comandi in attesa.
              (should (gdev-menu--available-item-p item t))
              (setq available t)
              (should (gdev-menu--available-item-p item))
              (should (gdev-menu--available-item-p written))))
        (put 'gdev-test-command-sidebar-server-action 'gdev-menu-available nil))))
  (load (gdev-module-file :tools 'lsp ".el") nil t t)
  (with-temp-buffer
    (emacs-lisp-mode)
    (dolist (command '(gdev-lsp-rename gdev-lsp-code-actions gdev-lsp-call-hierarchy
                       gdev-organize-imports eglot-shutdown eglot-reconnect))
      (ert-info ((symbol-name command))
        (should (get command 'gdev-menu-available))
        (should-not (gdev-menu-command-available-p command))))))

(ert-deftest gdev-test-command-sidebar-resolves-conditional-submenus ()
  "Strumenti conserva la condizione del sottomenu fino alla risoluzione."
  (with-temp-buffer
    (let* ((gdev-menu--defer-context t)
           (groups
            (gdev-command-sidebar--tool-groups
             '(gdev-tools "Strumenti" (:when buffer-read-only ("Esempio" ["Elenca buffer" list-buffers])))))
           (resolve (nth 3 (cadr groups))))
      (should-not (gdev-command-sidebar--available-p (car (funcall resolve))))
      (setq buffer-read-only t)
      (let ((action (car (funcall resolve))))
        (should (gdev-command-sidebar--available-p action))
        (should (eq (gdev-command-sidebar--action-command action) 'list-buffers))))))

(ert-deftest gdev-test-command-sidebar-layout-is-fixed-and-restorable ()
  "I riquadri condividono le regole di layout e la chiusura appartiene allo spazio."
  (gdev-test--with-layout
    (let ((gdev-sidebar-width 16)
          (frame-width-before (frame-width))
          (frame-height-before (frame-height))
          (gdev-command-sidebar-width 24)
          (editor (selected-window))
          (document (generate-new-buffer "Documento Comandi"))
          (activity (generate-new-buffer "Attività Comandi"))
          (tool (generate-new-buffer "*Strumento Comandi*"))
          side-buffer)
      (unwind-protect
          (progn
            (set-frame-size (selected-frame) 120 frame-height-before)
            (set-window-buffer editor document)
            (with-current-buffer document (text-mode))
            (with-current-buffer activity (setq-local gdev-activity-kind 'test))
            (let* ((left (gdev-layout-show-left activity 'gdev-activity))
                   (side (gdev-command-sidebar-sync)))
              (should (window-live-p side))
              (setq side-buffer (window-buffer side))
              (should (eq (selected-window) editor))
              (should (eq (gdev-layout-left-window) left))
              (should (eq (window-parameter side 'window-side) 'right))
              (should (window-dedicated-p side))
              (should-error (split-window side) :type 'user-error)
              (should (eq (window-buffer (display-buffer tool)) tool))
              (should (eq (window-buffer side) side-buffer))
              (select-window side)
              (window-resize side 2 t side)
              (gdev-command-sidebar-sync)
              (should (= (window-total-width side)
                         (gdev-workspace-state-get 'gdev-layout-commands-width)))
              (set-frame-size (selected-frame) 72 frame-height-before)
              (should-not (gdev-command-sidebar-sync))
              (should-not (gdev-layout-command-sidebar-window))
              (should (eq (selected-window) editor))
              (should-not (gdev-workspace-state-get 'gdev-layout-commands-visibility))
              (set-frame-size (selected-frame) 120 frame-height-before)
              (setq side (gdev-command-sidebar-sync))
              (should (eq (window-buffer side) side-buffer))
              (select-window side)
              (call-interactively #'gdev-command-sidebar-toggle)
              (should (eq (selected-window) editor))
              (should-not (gdev-command-sidebar-sync))
              (let ((record (gdev-workspaces--record (gdev-workspace-state-current))))
                (should (eq (plist-get record :commands-visibility) 'hidden))
                (should (natnump (plist-get record :commands-width))))
              (should (window-live-p left))))
        (set-frame-size (selected-frame) frame-width-before frame-height-before)
        (dolist (buffer (list document activity tool side-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest gdev-test-command-sidebar-switches-categories-with-pointer-and-keys ()
  "Icone e frecce cambiano categoria, conservando contesto e selezione."
  (gdev-test--with-layout
    (let ((editor (gdev-layout-editor))
          (document (generate-new-buffer "Documento delle categorie"))
          side-buffer)
      (unwind-protect
          (cl-letf (((symbol-function 'gdev-layout--commands-space) (lambda (_) '(125 . 0))))
            (set-window-buffer editor document)
            (with-current-buffer document (text-mode))
            (let* ((side (gdev-command-sidebar--show))
                   (line (with-selected-window side (gdev-command-sidebar--tab-line)))
                   (project (nth 2 line))
                   (event (list 'mouse-1 (list side 'tab-line '(1 . 1) 0))))
              (setq side-buffer (window-buffer side))
              (should (= (length (cdr line)) 5))
              (should (equal (get-text-property 0 'help-echo project) "Progetto"))
              (funcall (lookup-key (get-text-property 0 'keymap project) [tab-line mouse-1]) event)
              (should (eq (selected-window) side))
              (should (eq gdev-command-sidebar--source editor))
              (should (eq (window-buffer editor) document))
              (should (eq (car (gdev-command-sidebar--category)) 'project))
              (should-not (gethash 'remote gdev-command-sidebar--positions))
              (goto-char (gethash 'gdev-project gdev-command-sidebar--positions))
              (call-interactively (key-binding (kbd "<right>")))
              (should (eq (car (gdev-command-sidebar--category)) 'search))
              (should (gethash 'gdev-search gdev-command-sidebar--positions))
              (call-interactively (key-binding (kbd "<left>")))
              (should (eq (get-text-property (point) 'gdev-command-sidebar-id) 'gdev-project))
              (let ((record (gdev-workspaces--record (gdev-workspace-state-current))))
                (should (eq (plist-get record :commands-category) 'project)))))
        (dolist (buffer (list document side-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest gdev-test-command-sidebar-executes-from-the-visible-context ()
  "Invocazione, conferma e annullamento usano il documento o lo strumento indicato."
  (gdev-test--with-layout
    (let* ((gdev-tool-action-groups nil)
           (gdev-tool-actions-change-hook nil)
           (editor (selected-window))
           (document (generate-new-buffer "Documento del contesto"))
           (tool (generate-new-buffer "*Terminale del contesto*"))
           side-buffer calls)
      (unwind-protect
          (cl-letf (((symbol-function 'gdev-test-command-sidebar-call)
                     (lambda ()
                       (interactive)
                       (read-string "Valore: ")
                       (push (list (current-buffer) (selected-window) default-directory) calls)))
                    ((symbol-function 'gdev-layout--commands-space) (lambda (_) '(125 . 0))))
            (gdev-set-tool-actions 'test "Contesto" "code"
              ["Richiama contesto…" gdev-test-command-sidebar-call])
            (set-window-buffer editor document)
            (with-current-buffer document (text-mode))
            (let* ((side (gdev-command-sidebar-sync))
                   (tool-window (gdev-layout--display-panel tool)))
              (setq side-buffer (window-buffer side))
              (select-window editor)
              (gdev-command-sidebar-focus)
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (_ table &rest _)
                           (seq-find (lambda (entry) (string-prefix-p "Richiama contesto…" entry))
                                     table)))
                        ((symbol-function 'read-string) (lambda (&rest _) "confermato")))
                (gdev-command-sidebar-find))
              (should (equal (car calls)
                             (list document editor (buffer-local-value 'default-directory document))))
              (should (eq (selected-window) editor))
              (gdev-command-sidebar-focus)
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (_ table &rest _)
                           (with-current-buffer document
                             (setq-local default-directory temporary-file-directory))
                           (seq-find (lambda (entry) (string-prefix-p "Richiama contesto…" entry))
                                     table))))
                (should-error (gdev-command-sidebar-find) :type 'user-error))
              (should (eq (selected-window) side))
              (should (= (length calls) 1))
              (select-window tool-window)
              (gdev-command-sidebar-sync)
              (gdev-command-sidebar-select 'tools)
              (goto-char (gethash 'test gdev-command-sidebar--positions))
              (call-interactively (key-binding (kbd "RET")))
              (goto-char (gethash '(test gdev-test-command-sidebar-call)
                                  gdev-command-sidebar--positions))
              (let ((row (get-text-property (point) 'gdev-command-sidebar-id))
                    (event (list 'mouse-1 (list side (point) '(1 . 1) 0))))
                (gdev-command-sidebar-refresh)
                (should (equal row (get-text-property (point) 'gdev-command-sidebar-id)))
                (cl-letf (((symbol-function 'read-string) (lambda (&rest _) (signal 'quit nil))))
                  (should (eq (condition-case nil
                                  (gdev-command-sidebar-click event)
                                (quit 'annullato))
                              'annullato))
                  (should (eq (selected-window) side))
                  (should (= (length calls) 1)))
                (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "confermato")))
                  (gdev-command-sidebar-click event))
                (should (equal (car calls)
                               (list tool tool-window (buffer-local-value 'default-directory tool))))
                (should (eq (selected-window) tool-window)))))
        (dolist (buffer (list document tool side-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest gdev-test-command-sidebar-rejects-stale-selection-and-roots ()
  "Una scelta aperta su una selezione o una radice superata non esegue l'azione."
  (gdev-test--with-layout
    (let ((editor (gdev-layout-editor))
          (document (generate-new-buffer "Documento con una selezione"))
          (gdev-tool-action-groups nil)
          (gdev-tool-actions-change-hook nil)
          (roots (list default-directory))
          (transient-mark-mode t)
          calls)
      (unwind-protect
          (cl-letf (((symbol-function 'gdev-test-command-sidebar-apply)
                     (lambda () (interactive)
                       (push (buffer-substring-no-properties (region-beginning) (region-end)) calls)))
                    ((symbol-function 'gdev-workspace-roots) (lambda (&optional _) roots))
                    ((symbol-function 'gdev-command-sidebar-refresh) #'ignore))
            (set-window-buffer editor document)
            (with-selected-window editor
              (insert "Prima parte e seconda parte")
              (goto-char (point-min))
              (push-mark (+ (point-min) 5) t t)
              (setq-local gdev-context-items
                          '(["Usa la selezione" gdev-test-command-sidebar-apply (use-region-p)]))
              (let* ((action (gdev-test-command-sidebar--action
                              'gdev-test-command-sidebar-apply (gdev-command-sidebar--collect)))
                     (identity (gdev-command-sidebar--identity action))
                     (target (gdev-command-sidebar--target editor t)))
                (should action)
                (set-mark (+ (point-min) 11))
                (should-error (gdev-command-sidebar--run identity target 'view) :type 'user-error)
                (setq target (gdev-command-sidebar--target editor t)
                      roots (list (file-name-directory (directory-file-name (car roots)))))
                (should-error (gdev-command-sidebar--run identity target 'view) :type 'user-error)
                (should-not calls)
                (gdev-command-sidebar--run identity (gdev-command-sidebar--target editor t) 'view)
                (should (equal calls '("Prima parte"))))
              (deactivate-mark)
              (cl-letf (((symbol-function 'get-buffer-process) (lambda (&optional _) t)))
                (let ((target (gdev-command-sidebar--target editor t)))
                  (goto-char (point-max))
                  (insert "\nNuovo output")
                  (should (equal target (gdev-command-sidebar--target editor t)))))))
        (kill-buffer document)))))

(ert-deftest gdev-test-command-sidebar-selection-extent-keeps-the-view ()
  "Estendere la selezione non ridisegna Comandi; attivarla o toglierla sì."
  (gdev-test--with-layout
    (let ((editor (gdev-layout-editor))
          (document (generate-new-buffer "Documento da selezionare"))
          (transient-mark-mode t))
      (unwind-protect
          (progn
            (set-window-buffer editor document)
            (with-selected-window editor
              (insert "uno\ndue\ntre\n")
              (goto-char (point-min))
              (let ((none (gdev-command-sidebar--context-stamp editor))
                    (row (gdev-command-sidebar--target editor)))
                (push-mark (point) t t)
                (forward-line 1)
                (let ((short (gdev-command-sidebar--context-stamp editor))
                      (short-row (gdev-command-sidebar--target editor)))
                  (should-not (equal none short))
                  (should-not (equal row short-row))
                  (forward-line 1)
                  (should (equal short (gdev-command-sidebar--context-stamp editor)))
                  (should (equal short-row (gdev-command-sidebar--target editor))))
                (deactivate-mark)
                (should (equal none (gdev-command-sidebar--context-stamp editor)))
                (should (equal row (gdev-command-sidebar--target editor))))))
        (kill-buffer document)))))

(ert-deftest gdev-test-command-sidebar-cloned-workspace-owns-its-pane ()
  "Uno spazio duplicato gestisce Comandi in modo indipendente."
  (gdev-test--with-layout
    (let ((document (generate-new-buffer "Documento condiviso"))
          (tab-bar-tab-pre-close-functions '(gdev-command-sidebar--close-tab))
          (tab-bar-closed-tabs nil)
          original duplicate reopened)
      (unwind-protect
          (cl-letf (((symbol-function 'gdev-layout--commands-space) (lambda (_) '(120 . 0))))
            (set-window-buffer (gdev-layout-editor) document)
            (setq original (window-buffer (gdev-command-sidebar--show)))
            (gdev-command-sidebar-select 'search)
            (tab-bar-duplicate-tab)
            (setq duplicate (window-buffer (gdev-command-sidebar-sync)))
            (should-not (eq original duplicate))
            (should (eq (window-buffer (gdev-layout-editor)) document))
            (gdev-command-sidebar--show)
            (gdev-command-sidebar-select 'tools)
            (tab-bar-close-tab)
            (should-not (buffer-live-p duplicate))
            (should (eq (window-buffer (gdev-command-sidebar-sync)) original))
            (should (eq (car (gdev-command-sidebar--category)) 'search))
            (tab-bar-undo-close-tab)
            (setq reopened (window-buffer (gdev-command-sidebar-sync)))
            (should (eq (gdev-workspace-state-get 'gdev-layout-commands-visibility) 'shown))
            (should (eq (car (gdev-command-sidebar--category)) 'tools))
            (should (eq (window-buffer (selected-window)) document))
            (should-not (memq reopened (list original duplicate))))
        (dolist (buffer (list document reopened duplicate original))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest gdev-test-command-sidebar-resolves-groups-on-demand ()
  "Espansione e ricerca valutano un gruppo chiuso quando serve."
  (gdev-test--with-layout
    (let* ((gdev-tool-action-groups nil)
           (gdev-tool-actions-change-hook '(gdev-command-sidebar-refresh))
           (editor (gdev-layout-editor))
           (document (generate-new-buffer "Documento Comandi a richiesta"))
           (other (generate-new-buffer "Altro documento Comandi"))
           (checks 0)
           (runs 0)
           (condition t)
           side-buffer)
      (unwind-protect
          (cl-letf (((symbol-function 'gdev-layout--commands-space) (lambda (_) '(125 . 0)))
                    ((symbol-function 'gdev-test-command-sidebar-check)
                     (lambda () (cl-incf checks) condition))
                    ((symbol-function 'gdev-test-command-sidebar-lazy-action)
                     (lambda () (interactive) (cl-incf runs))))
            (gdev-set-tool-actions 'lazy-fixture "Azioni differite" "code"
              ["Azione differita" gdev-test-command-sidebar-lazy-action
               :visible (gdev-test-command-sidebar-check)])
            (set-window-buffer editor document)
            (let ((side (gdev-command-sidebar-sync)))
              (setq side-buffer (window-buffer side))
              (with-selected-window side
                (should-not (gethash 'lazy-fixture gdev-command-sidebar--positions))
                (gdev-command-sidebar-select 'tools)
                (should (gethash 'lazy-fixture gdev-command-sidebar--positions))
                (should (zerop checks))
                (let ((groups gdev-command-sidebar--groups-by-category))
                  (set-window-buffer editor other)
                  (gdev-command-sidebar--update side editor)
                  (should (eq groups gdev-command-sidebar--groups-by-category))
                  (should (zerop checks)))
                (cl-letf (((symbol-function 'completing-read)
                           (lambda (_ candidates &rest _)
                             (should (member "Azione differita · Azioni differite" candidates))
                             nil)))
                  (gdev-command-sidebar-find))
                (should (= checks 1))
                (goto-char (gethash 'lazy-fixture gdev-command-sidebar--positions))
                (gdev-command-sidebar-activate)
                (should (= checks 2))
                (let ((row '(lazy-fixture gdev-test-command-sidebar-lazy-action)))
                  (goto-char (gethash row gdev-command-sidebar--positions))
                  (gdev-command-sidebar--render side)
                  (should (= checks 2))
                  (should (equal row (get-text-property (point) 'gdev-command-sidebar-id)))
                  (setq condition nil)
                  (should-error (gdev-command-sidebar-activate) :type 'user-error)
                  (should (zerop runs))
                  (should-not (gethash row gdev-command-sidebar--positions))
                  (gdev-set-tool-actions 'lazy-fixture "Azioni aggiornate" "code"
                    ["Azione aggiornata" gdev-test-command-sidebar-lazy-action])
                  (goto-char (gethash row gdev-command-sidebar--positions))
                  (should (string-match-p "Azioni aggiornate" (buffer-string)))
                  (gdev-command-sidebar-activate)
                  (should (= runs 1))))))
        (dolist (buffer (list document other side-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest gdev-test-command-sidebar-compact-groups-defer-later-conditions ()
  "L'anteprima compatta valuta solo le voci che può mostrare."
  (let ((checks 0)
        (conditions (lambda () '(["Prima" beginning-of-line]
                                 (:when (gdev-test-command-sidebar-late-check)
                                  ("Altre azioni" ["Seconda" end-of-line]
                                   ["Terza" forward-char]))))))
    (cl-letf (((symbol-function 'gdev-test-command-sidebar-late-check)
               (lambda () (cl-incf checks) t)))
      (let ((group (list 'demo "Dimostrazione" "code"
                         (lambda ()
                           (gdev-command-sidebar--menu-actions
                            (gdev-menu--entries (funcall conditions)))))))
        (should (= (length (gdev-command-sidebar--resolve group nil 1)) 1))
        (should (zerop checks))
        (should (= (length (gdev-command-sidebar--resolve group)) 3))
        (should (= checks 1))
        (should (consp (assoc "Altre azioni" (gdev-menu--entries (funcall conditions)))))
        (should (= checks 2))))))

(ert-deftest gdev-test-command-sidebar-reuses-equivalent-dired-rows ()
  "Conserva le righe di Comandi finché disponibilità e scorciatoie coincidono."
  (require 'dired)
  (gdev-test--with-layout
    (let* ((directory (make-temp-file "gdev-command-sidebar-" t))
           (files (mapcar (lambda (name) (expand-file-name name directory))
                          '("a.txt" "b.txt" "c.txt" "d.log")))
           (editor (gdev-layout-editor))
           (gdev-preferences-keybindings '(("C-c z" . gdev-test-command-sidebar-open-row)))
           (row '(view gdev-test-command-sidebar-open-row))
           dired side-buffer calls)
      (unwind-protect
          (cl-letf (((symbol-function 'gdev-layout--commands-space) (lambda (_) '(125 . 0)))
                    ((symbol-function 'gdev-test-command-sidebar-open-row)
                     (lambda () (interactive) (push (dired-get-filename nil t) calls))))
            (dolist (file files) (write-region "" nil file))
            (setq dired (dired-noselect directory))
            (set-window-buffer editor dired)
            (with-selected-window editor
              (use-local-map (copy-keymap dired-mode-map))
              (keymap-local-set "C-c z" #'gdev-test-command-sidebar-open-row)
              (setq-local gdev-context-items
                          '(["Apri documento di testo" gdev-test-command-sidebar-open-row
                             (equal (file-name-extension (or (dired-get-filename nil t) "")) "txt")]))
              (dired-goto-file (nth 0 files)))
            (let ((side (gdev-command-sidebar--show)))
              (setq side-buffer (window-buffer side))
              (with-selected-window side
                (goto-char (gethash row gdev-command-sidebar--positions))
                (let ((tick (buffer-chars-modified-tick))
                      (start (window-start side)))
                  (with-selected-window editor (dired-goto-file (nth 1 files)))
                  (cl-letf (((symbol-function 'gdev-command-sidebar--group-category)
                             (lambda (_) (ert-fail "Le sezioni non cambiano spostando il cursore"))))
                    (gdev-command-sidebar--update side editor))
                  (should (= (buffer-chars-modified-tick) tick))
                  (should (= (window-start side) start))
                  (should (equal (get-text-property (point) 'gdev-command-sidebar-id) row))
                  (gdev-command-sidebar-activate)
                  (should (eq (selected-window) editor))
                  (should (equal calls (list (nth 1 files))))
                  (select-window side)
                  (with-selected-window editor
                    (dired-goto-file (nth 2 files))
                    (let ((overlay (make-overlay (line-beginning-position) (line-end-position)))
                          (map (make-sparse-keymap)))
                      (keymap-set map "C-c z" #'forward-char)
                      (overlay-put overlay 'keymap map)))
                  (gdev-command-sidebar--update side editor)
                  (should (/= (buffer-chars-modified-tick) tick))
                  (should (equal (get-text-property (point) 'gdev-command-sidebar-id) row))
                  (should (equal (button-get (button-at (point)) 'help-echo)
                                 "Apri documento di testo"))
                  (with-selected-window editor (dired-goto-file (nth 3 files)))
                  (gdev-command-sidebar--update side editor)
                  (should-not (gethash row gdev-command-sidebar--positions))))))
        (dolist (buffer (list dired side-buffer))
          (when (buffer-live-p buffer) (kill-buffer buffer)))
        (delete-directory directory t)))))

