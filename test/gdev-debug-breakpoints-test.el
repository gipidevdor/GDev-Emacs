(require 'cl-lib)
(require 'ert)

(defvar dape--breakpoints)
(defvar dape-update-ui-hook)

(defun gdev-test-debug-breakpoints--load ()
  "Carica la vista con il fork di Dape, anche quando la prova gira da sola."
  (package-activate-all)
  (require 'gdev-debug-breakpoints))

(ert-deftest gdev-test-debug-breakpoints-show-status-of-workspace-session ()
  "Le verifiche di un'altra sessione non cambiano i punti del proprio spazio."
  (gdev-test-debug-breakpoints--load)
  (let* ((a (make-dape--source-breakpoint :location '("/uno/a.c" . 3)
                                         :type 'expression :value "i == 2"
                                         :verified '(local nil foreign t)))
         (b (make-dape--source-breakpoint :location '("/uno/b.c" . 5) :type 'log
                                         :value "i = {i}" :verified '(local t)))
         (c (make-dape--source-breakpoint :location '("/altro/c.c" . 7) :verified '(foreign t)))
         (dape--breakpoints (list a b c (make-dape--function-breakpoint :name "main"))))
    (cl-letf (((symbol-function 'gdev-workspace-roots) (lambda (&optional _) '("/uno/")))
              ((symbol-function 'dape--capable-p) (lambda (&rest _) t))
              ((symbol-function 'gdev-debug-workspace-connection)
               (lambda (owner) (should (eq owner 'owner)) 'local)))
      (with-temp-buffer
        (gdev-debug-breakpoints-mode)
        (setq gdev-debug-breakpoints--owner 'owner)
        (gdev-debug-breakpoints--render t)
        (should (eq gdev-ui-view-profile 'document))
        (should gdev-layout-auxiliary-p)
        (should (eq (gdev-debug-breakpoints--entry) a))
        (should (string-search "Condizione · ! Non verificato" (buffer-string)))
        (should (string-search "Messaggio · ✓ Verificato" (buffer-string)))
        (should-not (string-search "c.c" (buffer-string)))
        (gdev-debug-breakpoints--next)
        (should (eq (gdev-debug-breakpoints--entry) b))
        (dape-source-breakpoint-edit a 'expression "i == 3")
        (gdev-debug-breakpoints--render nil)
        (should (string-search "In attesa di verifica" (buffer-string)))
        (should (eq (gdev-debug-breakpoints--entry) b))
        (gdev-debug-breakpoints--previous)
        (should (eq (gdev-debug-breakpoints--entry) a))))))

(ert-deftest gdev-test-debug-breakpoints-buttons-and-keys-use-canonical-objects ()
  "Clic e tastiera modificano lo stesso oggetto Dape mantenendo la selezione."
  (gdev-test-debug-breakpoints--load)
  (let* ((a (make-dape--source-breakpoint :location '("/uno/a.c" . 3)))
         (b (make-dape--source-breakpoint :location '("/uno/b.c" . 5)))
         (dape--breakpoints (list a b)))
    (with-temp-buffer
      (gdev-debug-breakpoints-mode)
      (let ((dape-update-ui-hook (list (lambda () (gdev-debug-breakpoints--render nil))))
            (case-fold-search nil))
        (gdev-debug-breakpoints--render t)
        (call-interactively (key-binding (kbd "SPC")))
        (should (dape--breakpoint-disabled a))
        (should (eq (gdev-debug-breakpoints--entry) a))
        (search-forward "Attiva")
        (button-activate (button-at (1- (point))))
        (should-not (dape--breakpoint-disabled a))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Messaggio"))
                  ((symbol-function 'read-string) (lambda (&rest _) "origine = {origine}")))
          (call-interactively (key-binding (kbd "e"))))
        (should (eq (dape--source-breakpoint-type a) 'log))
        (should (equal (dape--source-breakpoint-value a) "origine = {origine}"))
        (should (eq (gdev-debug-breakpoints--entry) a))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil))))
          (should (eq (condition-case nil (gdev-debug-breakpoints--edit) (quit 'quit)) 'quit)))
        (should (equal (dape--source-breakpoint-value a) "origine = {origine}"))
        (call-interactively (key-binding (kbd "d")))
        (should (equal dape--breakpoints (list b)))
        (should (eq (gdev-debug-breakpoints--entry) b))))))

(ert-deftest gdev-test-debug-breakpoints-fork-preserves-identity-in-source-editor ()
  "Una modifica nel sorgente conserva disattivazione, posizione e geometria."
  (gdev-test-debug-breakpoints--load)
  (let ((dape--breakpoints nil)
        (dape-update-ui-hook nil))
    (with-temp-buffer
      (insert "prima riga\nseconda riga\nterza riga\n")
      (goto-char (point-min))
      (forward-line 1)
      (let* ((position (point))
             (breakpoint (dape--breakpoint-place 'expression "x > 0"))
             (overlay (dape--source-breakpoint-location breakpoint))
             (indicator (overlay-get overlay 'before-string)))
        (should (equal (get-text-property 0 'help-echo indicator) "Condizione"))
        (dape-source-breakpoint-set-enabled breakpoint nil)
        (narrow-to-region position (point-max))
        (dape-breakpoint-log "x = {x}")
        (setq overlay (dape--source-breakpoint-location breakpoint))
        (should (equal dape--breakpoints (list breakpoint)))
        (should (dape--breakpoint-disabled breakpoint))
        (should (= (dape--breakpoint-line breakpoint) 2))
        (should (= (overlay-start overlay) position))
        (should (equal (get-text-property 0 'help-echo (overlay-get overlay 'before-string))
                       "Messaggio · Disattivato"))
        (widen)
        (dape--breakpoint-remove breakpoint)
        (should-not dape--original-margin)
        (should (zerop left-margin-width))))))

(ert-deftest gdev-test-debug-breakpoints-fork-discards-obsolete-set-responses ()
  "La risposta al tipo precedente non sposta o convalida un punto modificato."
  (gdev-test-debug-breakpoints--load)
  (let* ((file "/src/a.c")
         (breakpoint (make-dape--source-breakpoint :location (cons file 3)))
         (dape--breakpoints (list breakpoint))
         (dape-update-ui-hook nil)
         requests)
    (cl-letf (((symbol-function 'dape--live-connections) #'ignore)
              ((symbol-function 'dape--file-name-remote) (lambda (_ path) path))
              ((symbol-function 'dape--capable-p) (lambda (&rest _) t))
              ((symbol-function 'dape-request)
               (lambda (connection command args callback)
                 (should (eq connection 'local))
                 (should (eq command :setBreakpoints))
                 (push (cons args callback) requests))))
      (dape--set-breakpoints-in-source 'local file)
      (dape-source-breakpoint-edit breakpoint 'log "x = {x}")
      (dape--set-breakpoints-in-source 'local file)
      (should (equal (plist-get (caar requests) :breakpoints) [(:line 3 :logMessage "x = {x}")]))
      (funcall (cdar (cdr requests)) '(:breakpoints [(:line 7 :id 1 :verified t)]) nil)
      (should (= (dape--breakpoint-line breakpoint) 3))
      (should-not (dape--breakpoint-verified breakpoint))
      (funcall (cdar requests) '(:breakpoints [(:line 4 :id 2 :verified t)]) nil)
      (should (= (dape--breakpoint-line breakpoint) 4))
      (should (equal (dape--breakpoint-verified breakpoint) '(local t))))))

(ert-deftest gdev-test-debug-breakpoints-fork-resubmits-only-supported-kinds ()
  "Una nuova capacità aggiorna i sorgenti pertinenti senza inviare sostituti semplici."
  (gdev-test-debug-breakpoints--load)
  (let* ((file "/src/a.c")
         (plain (make-dape--source-breakpoint :location (cons file 1)))
         (log (make-dape--source-breakpoint :location (cons file 4) :type 'log :value "{x}"))
         (condition (make-dape--source-breakpoint :location (cons file 8)
                                                 :type 'expression :value "x != 0"))
         (dape--breakpoints (list plain log condition))
         (dape-update-ui-hook nil)
         (adapter (make-pipe-process :name "gdev-breakpoints-stub" :noquery t))
         (conn (make-instance 'dape-connection :name "gdev-breakpoints-stub"
                              :process adapter :config nil))
         requests)
    (unwind-protect
        (cl-letf (((symbol-function 'dape--initialized-p) (lambda (_) t))
                  ((symbol-function 'dape--file-name-remote) (lambda (_ path) path))
                  ((symbol-function 'dape-request)
                   (lambda (connection command args _callback)
                     (should (eq connection conn))
                     (should (eq command :setBreakpoints))
                     (push (plist-get args :breakpoints) requests))))
          (dape--set-breakpoints-in-source conn file)
          (should (equal (car requests) [(:line 1)]))
          (should (equal (car (gdev-debug-breakpoints--state log conn)) "! Tipo non supportato"))
          (dape-handle-event conn 'capabilities '(:capabilities (:supportsLogPoints t)))
          (should (equal (car requests) [(:line 1) (:line 4 :logMessage "{x}")]))
          (should (equal (car (gdev-debug-breakpoints--state log conn)) "◌ In attesa di verifica"))
          (dape-handle-event conn 'capabilities '(:capabilities (:supportsReadMemoryRequest t)))
          (should (= (length requests) 2))
          (dape-handle-event conn 'capabilities '(:capabilities (:supportsLogPoints :json-false)))
          (should (= (length requests) 3))
          (should (equal (car requests) [(:line 1)])))
      (when (process-live-p adapter) (delete-process adapter)))))

(ert-deftest gdev-test-debug-breakpoints-rejected-source-does-not-block-setup ()
  "Un adattatore che rifiuta un sorgente riceve comunque il resto della configurazione."
  (gdev-test-debug-breakpoints--load)
  (let ((dape--breakpoints (list (make-dape--source-breakpoint :location '("/src/a.c" . 3))))
        finished)
    (cl-letf (((symbol-function 'dape--file-name-remote) (lambda (_ path) path))
              ((symbol-function 'dape--warn) #'ignore)
              ((symbol-function 'dape-request)
               (lambda (_connection command _arguments callback)
                 (should (eq command :setBreakpoints))
                 (funcall callback nil "Sorgente rifiutato"))))
      (dape--set-breakpoints 'local (lambda (&rest _) (setq finished t)))
      (should finished))))

(provide 'gdev-debug-breakpoints-test)
