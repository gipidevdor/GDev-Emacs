(ert-deftest gdev-test-debug-f5-keeps-the-active-session ()
  "F5 riprende la sessione sospesa e conserva quella già in esecuzione."
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (let ((gdev-layout-mode t)
        (state 'starting)
        continued started)
    (cl-letf (((symbol-function 'gdev-debug-workspace-connection) (lambda (_) 'session))
              ((symbol-function 'dape--state) (lambda (_) state))
              ((symbol-function 'dape-continue) (lambda (connection) (push connection continued)))
              ((symbol-function 'gdev-launch-dispatch) #'ignore)
              ((symbol-function 'gdev-debug-start-editor) (lambda (&optional _) (setq started t))))
      (gdev-debug-dwim)
      (setq state 'running)
      (gdev-debug-dwim)
      (should-not started)
      (should-not continued)
      (setq state 'stopped)
      (gdev-debug-dwim)
      (should (equal continued '(session))))))

(ert-deftest gdev-test-debug-lldb-explains-the-macos-authorization ()
  "Senza modalità sviluppatore, l'avvio locale spiega perché il programma attende."
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (require 'dape)
  (let ((gdev-debug--developer-mode nil)
        (system-type 'darwin)
        (default-directory temporary-file-directory)
        (status "Developer mode is currently disabled.\n")
        messages)
    (cl-letf (((symbol-function 'executable-find)
               (lambda (program &rest _) (and (equal program "DevToolsSecurity") program)))
              ((symbol-function 'call-process) (lambda (&rest _) (insert status) 0))
              ((symbol-function 'message)
               (lambda (format &rest args) (push (apply #'format format args) messages))))
      (gdev-debug--lldb-ensure '(command "lldb-dap" :request "launch"))
      (should (string-search "DevToolsSecurity -enable" (car messages)))
      (should-not gdev-debug--developer-mode)
      (setq messages nil)
      (gdev-debug--lldb-ensure '(command "lldb-dap" :request "launch" :coreFile "core"))
      (should-not messages)
      (setq status "Developer mode is currently enabled.\n")
      (gdev-debug--lldb-ensure '(command "lldb-dap" :request "attach"))
      (should-not messages)
      (should gdev-debug--developer-mode)
      (should-error (gdev-debug--lldb-ensure '(command nil :request "launch")) :type 'user-error))))

(ert-deftest gdev-test-debug-controls-use-the-workspace-session ()
  "Passi e controlli di sessione ignorano la selezione di un altro spazio."
  (package-activate-all)
  (require 'dape)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (let ((gdev-layout-mode t)
        (dape--connection-selected 'elsewhere)
        (gdev-debug--workspace-selection (make-hash-table :test #'eq))
        (owner (make-symbol "spazio"))
        calls)
    (cl-letf (((symbol-function 'gdev-workspace-state-id) (lambda () owner))
              ((symbol-function 'gdev-debug-workspace-connections)
               (lambda (space) (and space '(parent child))))
              ((symbol-function 'dape--config) (lambda (conn) (list :program (symbol-name conn))))
              ((symbol-function 'completing-read)
               (lambda (_prompt choices &rest _) (car (nth 1 choices))))
              ((symbol-function 'dape-select-session)
               (lambda (conn exact)
                 (should exact)
                 (setq dape--connection-selected conn)))
              ((symbol-function 'gdev-debug--refresh-workbench) #'ignore)
              ((symbol-function 'dape--root-of) (lambda (_) 'parent))
              ((symbol-function 'dape-next) (lambda (conn) (push (cons 'next conn) calls)))
              ((symbol-function 'dape-restart) (lambda (conn &rest _) (push (cons 'restart conn) calls)))
              ((symbol-function 'dape-kill) (lambda (conn) (push (cons 'kill conn) calls)))
              ((symbol-function 'dape-quit) (lambda () (interactive) (push 'all calls))))
      (gdev-debug-select-workspace-session owner)
      (should (eq dape--connection-selected 'child))
      (setq dape--connection-selected 'elsewhere)
      (should (eq (gdev-debug-workspace-connection owner '(parent)) 'parent))
      (gdev-debug-next)
      (gdev-debug-restart)
      (gdev-debug-terminate)
      (with-temp-buffer
        (setq-local gdev-debug-workbench--owner owner)
        (gdev-debug-workbench--controls #'dape-next))
      ;; Il clic destro nelle viste di Dape usa gli stessi comandi della tastiera
      ;; e termina soltanto la sessione dello spazio.
      (with-temp-buffer
        (dape-repl-mode)
        (let ((commands (mapcar #'gdev-context-item-command (gdev-context-view-items))))
          (should (equal commands '(gdev-debug-continue gdev-debug-next gdev-debug-step-in
                                    gdev-debug-step-out gdev-debug-restart gdev-debug-terminate)))
          (call-interactively (car (last commands)))))
      (setq owner nil)
      (should-error (gdev-debug-terminate) :type 'user-error)
      (let ((gdev-layout-mode nil))
        (gdev-debug-terminate))
      (should (equal (nreverse calls)
                     '((next . child) (restart . parent) (kill . parent) (next . child)
                       (kill . parent) all))))))

(ert-deftest gdev-test-debug-session-is-an-operation-of-its-space ()
  "La sessione compare fra le operazioni del suo spazio e si ferma da lì."
  (package-activate-all)
  (require 'dape)
  (require 'gdev-workbench-operations)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (gdev-test--with-layout
    (let ((owner (gdev-workspace-state-ensure-id))
          (gdev-debug--operations (make-hash-table :test #'eq))
          (states '((uno . starting) (due . starting)))
          calls)
      (cl-letf (((symbol-function 'dape--root-of) #'identity)
                ((symbol-function 'dape--config)
                 (lambda (conn) (list 'gdev-workspace owner :program (format "/tmp/%s" conn))))
                ((symbol-function 'dape--state) (lambda (conn) (alist-get conn states)))
                ((symbol-function 'gdev-debug-session-command)
                 (lambda (command conn) (push (cons command conn) calls)))
                ((symbol-function 'yes-or-no-p) (lambda (_) t)))
        (gdev-debug--track-operation 'uno)
        (setf (alist-get 'uno states) 'running)
        (gdev-debug--track-operation 'uno)
        (let ((records (gdev-workspace-state-get 'gdev-workbench-operations)))
          (should (equal (mapcar #'gdev-workbench-operation-label records) '("Debug · uno")))
          (should (funcall (gdev-workbench-operation-interruptible (car records)) (car records))))
        (should (equal calls '((dape-kill . uno))))
        ;; L'uscita con un codice diverso da zero è un esito non riuscito.
        (gdev-debug--finish-operation 'uno 3)
        (setf (alist-get 'uno states) 'terminated)
        (gdev-debug--track-operation 'uno)
        (let ((saved (car (gdev-workspace-state-get 'gdev-workbench-operations))))
          (should (eq (gdev-workbench-operation-state saved) 'failed))
          (should (equal (gdev-workbench-operation-detail saved) "Codice 3")))
        ;; Senza codice di uscita la fine della sessione la completa.
        (gdev-debug--track-operation 'due)
        (setf (alist-get 'due states) 'terminated)
        (gdev-debug--track-operation 'due)
        (should (eq (gdev-workbench-operation-state
                     (car (gdev-workspace-state-get 'gdev-workbench-operations)))
                    'completed))
        (should (zerop (hash-table-count gdev-debug--operations)))))))

(ert-deftest gdev-test-debug-until-from-output-uses-the-current-editor ()
  "Fino al cursore prende posizione e sessione dallo spazio dell'editor."
  (gdev-test-launch--load-tools)
  (gdev-test--with-layout
    (let ((source (generate-new-buffer "sorgente debug"))
          (output (generate-new-buffer "*Output debug*"))
          (editor (gdev-layout-editor)))
      (unwind-protect
          (progn
            (set-window-buffer editor source)
            (with-current-buffer source (insert "prima\nseconda\n"))
            (set-window-point editor 7)
            (with-current-buffer output (compilation-mode))
            (select-window (display-buffer output))
            (cl-letf (((symbol-function 'gdev-debug--context-connection) (lambda () 'sessione))
                      ((symbol-function 'dape-until)
                       (lambda (conn)
                         (should (eq conn 'sessione))
                         (should (eq (current-buffer) source))
                         (should (= (point) 7)))))
              (gdev-debug-until)
              (should (eq (selected-window) editor))))
        (kill-buffer output)
        (kill-buffer source)))))

(ert-deftest gdev-test-debug-custom-adapter-separates-local-command-and-target-path ()
  "I percorsi DAP possono essere del target e il comando dell'adattatore è verificato in locale."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-custom-dap-" t)))
         (tool (expand-file-name "adattatore locale" root))
         (target (expand-file-name "programma remoto" root))
         (debug '(:adapter custom :adapter-command ("./adattatore locale" "--stdio" "")
                   :adapter-env ("TOKEN_A=prova=con spazi") :program "programma remoto"
                   :args ("con spazi" "") :exception-filters nil
                   :options (:type "fittizio" :request "launch")))
         (gdev-launch-profiles (list (list root (list "Personalizzato" :debug debug))))
         (gdev-launch--standalone-selections (list (cons root "Personalizzato")))
         (gdev-layout-mode nil)
         (dape-active-mode nil)
         config)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root)
          (with-temp-file tool (insert "#!/bin/sh\n"))
          (set-file-modes tool #o600)
          (cl-letf (((symbol-function 'dape) (lambda (value) (setq config value))))
            (should-error (gdev-debug-dwim) :type 'user-error)
            (should-not config)
            (set-file-modes tool #o700)
            (gdev-debug-dwim)
            (should-not (file-exists-p target))
            (should (equal (plist-get config :program) target))
            (should (equal (plist-get config 'command) tool))
            (should (equal (plist-get config 'command-args) '("--stdio" "")))
            (should (equal (plist-get config 'command-env) '("TOKEN_A" "prova=con spazi")))
            (should (equal (plist-get config :args) ["con spazi" ""]))
            (should (plist-member config 'exception-filters))
            (should-not (plist-get config 'exception-filters))))
      (delete-directory root t))))

(ert-deftest gdev-test-debug-f5-uses-the-hidden-workspace-profile ()
  "F5 dal pannello di un altro progetto usa il gruppo editor attivo."
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (gdev-test--with-layout
    (let* ((root (file-name-as-directory (make-temp-file "gdev-editor-debug-" t)))
           (other (expand-file-name "altro/" root))
           (debug '(:adapter custom :port 4100 :options (:type "probe" :request "attach")))
           (gdev-launch-profiles (list (list root (list "Editor" :debug debug))
                                       (list other '("Output" :debug (:adapter custom :port 4200
                                                          :options (:type "probe" :request "attach"))))))
           (output (generate-new-buffer "*Compilazione · Altro progetto*"))
           launch)
      (unwind-protect
          (with-temp-buffer
            (make-directory other)
            (setq default-directory root)
            (set-window-buffer (gdev-layout-editor) (current-buffer))
            (gdev-workspace-state-set 'gdev-launch-selections
                                       (list (cons root "Editor") (cons other "Output")))
            (with-current-buffer output
              (compilation-mode)
              (setq default-directory other))
            (let ((panel (display-buffer output)))
              (select-window panel)
              (cl-letf (((symbol-function 'gdev-debug-workspace-connection) #'ignore)
                        ((symbol-function 'gdev-debug-launch-profile)
                         (lambda (&rest _) (user-error "Avvio annullato"))))
                (should-error (gdev-debug-dwim) :type 'user-error)
                (should (eq panel (selected-window))))
              (cl-letf (((symbol-function 'gdev-debug-workspace-connection) #'ignore)
                        ((symbol-function 'gdev-debug-launch-profile)
                         (lambda (&rest options) (setq launch options))))
                (gdev-debug-dwim)
                (should (equal launch (list debug root root nil)))
                (should (eq (gdev-layout-editor) (selected-window))))))
        (kill-buffer output)
        (delete-directory root t)))))

(ert-deftest gdev-test-debug-workbench-renders-exit-after-disconnect ()
  "Alla chiusura del debugger lo spazio conserva il programma e il codice di uscita."
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (let ((owner (make-symbol "prova"))
        (gdev-debug--workspace-results (make-hash-table :test #'eq)))
    (cl-letf (((symbol-function 'dape--root-of) #'identity)
              ((symbol-function 'dape--config)
               (lambda (_) (list 'gdev-workspace owner :program "/tmp/probe")))
              ((symbol-function 'gdev-debug-workbench--connection) #'ignore))
      (gdev-debug--record-exit 'conn '(:exitCode 3))
      (should (equal (gdev-debug-workspace-result owner) '("/tmp/probe" . 3)))
      (should-not (gdev-debug-workspace-result (make-symbol "altro")))
      (with-temp-buffer
        (setq-local gdev-debug-workbench--owner owner)
        (gdev-debug-workbench--session nil)
        (goto-char (point-min))
        (should (search-forward "Uscita 3" nil t))
        (should (equal (get-text-property (1- (point)) 'help-echo) "Uscita con codice 3"))
        (should (string-match-p "probe" (buffer-string)))))))

(ert-deftest gdev-test-debug-duplicate-copies-profiles-and-keeps-separate-views ()
  "Duplica aggiorna il contesto del profilo e assegna un riquadro allo spazio nuovo."
  (gdev-test--with-layout
    (let* ((root (file-name-as-directory temporary-file-directory))
           (nested (expand-file-name "prova/src/" root))
           (profile '("Nuovo" :run ("true")))
           (gdev-modules '((:ui workbench)))
           (gdev-launch-profiles nil)
           (tab-bar-closed-tabs nil)
           (tab-bar-tab-pre-close-functions
            (cons #'gdev-activity-close-tab tab-bar-tab-pre-close-functions))
           original duplicate resumed)
      (unwind-protect
          (with-temp-buffer
            (setq default-directory nested)
            (set-window-buffer (gdev-layout-editor) (current-buffer))
            (gdev-workspace-set-roots (list root))
            (gdev-project-view-run)
            (setq original (current-buffer))
            (should (equal gdev-project-view--root root))
            (setq gdev-launch-profiles (list (list nested profile)))
            (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Nuovo")))
              (gdev-project-view-select-profile))
            (should (equal gdev-project-view--root nested))
            (let ((owner (gdev-workspace-state-ensure-id))
                  (frame (selected-frame)))
              (tab-bar-duplicate-tab)
              (setq duplicate (window-buffer (gdev-layout-left-window)))
              (should-not (eq original duplicate))
              (should (equal (gdev-workspace-roots) (list root)))
              (should (equal (gdev-launch-selected nested) profile))
              (let ((duplicate-id (gdev-workspace-state-id)))
                (should duplicate-id)
                (should-not (eq owner duplicate-id))
                (should (eq duplicate-id
                            (buffer-local-value 'gdev-debug-workbench--owner duplicate))))
              (gdev-launch--in-workspace frame owner
                                        (lambda () (setq resumed (gdev-workspace-state-id))))
              (should-not resumed)
              (tab-bar-close-tab)
              (should (eq owner resumed))
              (should (buffer-live-p original))
              (should-not (buffer-live-p duplicate))))
        (dolist (view (list original duplicate))
          (when (buffer-live-p view) (kill-buffer view)))))))

(ert-deftest gdev-test-debug-workbench-reflects-capabilities-without-a-state-change ()
  "Le azioni seguono i messaggi DAP e le sessioni disponibili durante una pausa."
  (package-activate-all)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (require 'dape)
  (gdev-test--with-layout
    (let* ((owner (gdev-workspace-state-ensure-id))
           (config (list 'gdev-workspace owner :program "prova"))
           (process (make-pipe-process :name "gdev-debug-test" :noquery t))
           (other-process (make-pipe-process :name "gdev-debug-test-other" :noquery t))
           (conn (make-instance 'dape-connection :name "gdev-test" :process process
                                :parent nil :config config))
           (other (make-instance 'dape-connection :name "gdev-test-other"
                                 :process other-process :parent conn :config config))
           (dape--connections (list conn))
           (dape--connection-selected conn)
           (dape-update-ui-hook '(gdev-debug--refresh-workbench))
           view)
      (cl-labels ((position (id)
                    (save-excursion
                      (goto-char (point-min))
                      (when-let* ((match (text-property-search-forward 'gdev-project-view-id id t)))
                        (prop-match-beginning match)))))
        (unwind-protect
            (progn
              (setf (dape--initialized-p conn) t
                    (dape--state conn) 'stopped
                    (dape--thread-id conn) 1)
              (gdev-project-view-run)
              (setq view (current-buffer))
              (should-not (position 'dape-memory))
              (should-not (position 'select-session))
              (goto-char (position 'primary))
              (setf (dape--children conn) (list other))
              (dape-handle-event conn 'capabilities '(:capabilities (:supportsReadMemoryRequest t)))
              (should (position 'dape-memory))
              (should (position 'select-session))
              (should (eq 'primary (button-get (button-at (point)) 'gdev-project-view-id)))
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (_prompt choices &rest _) (caar (last choices))))
                        ((symbol-function 'dape--update) #'ignore)
                        ((symbol-function 'dape--shell-buffer) #'ignore)
                        ((symbol-function 'dape--mode-line-format) #'ignore))
                (gdev-debug-select-workspace-session owner)
                (should (eq dape--connection-selected other)))
              (setf (dape--children conn) nil)
              (dape-handle-event conn 'capabilities '(:capabilities (:supportsReadMemoryRequest :json-false)))
              (should-not (position 'dape-memory))
              (should-not (position 'select-session))
              (should (eq 'stopped (dape--state conn)))
              (should-not gdev-debug-workbench--timer))
          (when (buffer-live-p view) (kill-buffer view))
          (delete-process process)
          (delete-process other-process))))))

(ert-deftest gdev-test-debug-cmake-maps-aliases-of-the-source-root ()
  "LLDB usa il percorso aperto per i breakpoint di un sorgente compilato tramite alias."
  (package-activate-all)
  (load (gdev-module-file :tools 'build ".el") nil t t)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (let* ((directory (make-temp-file "gdev-source-map-" t))
         (root (expand-file-name "src" directory))
         (alias (expand-file-name "alias" directory))
         (build (expand-file-name "build" root))
         (program (expand-file-name "probe" build))
         (cache (expand-file-name "CMakeCache.txt" build)))
    (unwind-protect
        (progn
          (make-directory build t)
          (make-symbolic-link root alias)
          (write-region "" nil (expand-file-name "CMakeLists.txt" root) nil 'silent)
          (write-region "" nil program nil 'silent)
          (with-temp-file cache (insert "CMAKE_HOME_DIRECTORY:INTERNAL=" alias "\n"))
          (should (equal (gdev-debug--cmake-source-map program root)
                         (vector (vector alias root))))
          (with-temp-file cache (insert "CMAKE_HOME_DIRECTORY:INTERNAL=" root "\n"))
          (should-not (gdev-debug--cmake-source-map program root))
          (with-temp-file cache (insert "CMAKE_HOME_DIRECTORY:INTERNAL=" directory "\n"))
          (should-not (gdev-debug--cmake-source-map program root)))
      (delete-directory directory t))))

