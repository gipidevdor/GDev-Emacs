(ert-deftest gdev-test-state-db-copy-dates-survive-file-copies ()
  (require 'gdev-state-db-maintenance)
  (gdev-test-db--profile
    (let ((dir (gdev-state-db--copies-directory))
          (dest (expand-file-name "ripreso" gdev-state-directory)) copies)
      (dolist (day '(1 2 3 4))
        (gdev-state-db-set "prova" "" "giorno" day)
        (let ((copy (expand-file-name (format "stato-2025-07-%02d.sqlite" day) dir)))
          (gdev-state-db-backup copy)
          ;; Un ripristino da disco esterno può invertire le date del filesystem.
          (set-file-times copy (encode-time 0 0 12 (- 10 day) 7 2025))
          (push copy copies)))
      (let ((migration (expand-file-name "prima-v2-20250702T190000-000000000.sqlite" dir))
            (replacement (expand-file-name "stato-2025-07-02-203000000000000.sqlite" dir)))
        (copy-file (caddr copies) migration)
        (copy-file (caddr copies) replacement)
        (should (equal (gdev-state-db-copies)
                       (list (car copies) (cadr copies) replacement migration (caddr copies) (cadddr copies))))
        (gdev-state-db-recover "ultima" dest)
        (let ((gdev-state-directory dest))
          (should (= 4 (cdar (gdev-state-db-entries "prova" "" "giorno")))))
        (gdev-state-db--prune-copies)
        (should (equal (gdev-state-db-copies) (list (car copies) (cadr copies) replacement migration)))))))

(ert-deftest gdev-test-db-review-owner-integrity ()
  (gdev-test-db--profile
