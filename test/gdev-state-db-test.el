(ert-deftest gdev-test-preferences-all-scope-controls ()
  (require 'gdev-preferences)
  (gdev-test-db--profile
    (gdev-test--with-layout
      (with-temp-buffer
        (setq default-directory gdev-state-directory
              buffer-file-name (expand-file-name "nota.txt" gdev-state-directory))
        (let ((document (current-buffer)) visited)
          (switch-to-buffer document)
          (gdev-layout-mark-document)
          (gdev-preferences-open-appearance)
          (let ((preferences (current-buffer)))
            (unwind-protect
              (cl-labels ((press (label)
                            (goto-char (point-min))
                            (search-forward label)
                            (button-activate (button-at (1- (point))))))
                (cl-letf (((symbol-function 'gdev-ui-set-appearance)
                           (lambda (appearance save) (setq visited (list appearance save)))))
                  (press "Chiaro")
                  (should (equal visited '(light t))))
                (press "Tipo di progetto")
                (should (eq gdev-preferences--scope 'project-type))
                (cl-letf (((symbol-function 'gdev-scoped-options-choose) (lambda (&rest _) 'fill-column))
                          ((symbol-function 'read--expression) (lambda (&rest _) 74)))
                  (press "Scegli impostazione…"))
                (should (= 74 (buffer-local-value 'fill-column document)))
                (press "Ripristina")
                (should-not (gdev-state-db-entries "preferenze_tipo_progetto" (gdev-scoped-options-project-type gdev-preferences--project)))
                (press "Personali")
                (cl-letf (((symbol-function 'gdev-scoped-options-choose) (lambda (&rest _) 'fill-column))
                          ((symbol-function 'customize-option) (lambda (symbol) (setq visited symbol))))
                  (press "Scegli impostazione…")
                  (should (eq visited 'fill-column))))
              (when (buffer-live-p preferences) (kill-buffer preferences)))))))))

