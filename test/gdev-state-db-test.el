(ert-deftest gdev-test-workspaces-historical-collision-remains-recoverable ()
  (require 'gdev-workspaces)
  (gdev-test-db--profile
    (gdev-test--with-layout
      (let* ((file (gdev-state-file "gdev-workspaces.eld"))
             (previous (gdev-workspaces--interrupted-file file))
             (gdev-workspaces--session-active nil))
        (write-region "Archivio precedente da conservare" nil previous nil 'silent)
        (with-temp-file file
          (prin1 '(:version 1 :active 0 :tabs ((:name "Storica")) :drafts nil) (current-buffer)))
        (cl-letf (((symbol-function 'gdev-workspaces--read) (lambda (&rest _) 'unreadable)))
          (gdev-workspaces--keep-unrestored file))
        (let ((files (gdev-workspaces--interrupted-files)))
          (should (= (length files) 2))
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_ choices &rest _)
                       (car (cl-find-if (lambda (choice) (not (equal previous (cdr choice)))) choices)))))
            (gdev-workspaces-restore-interrupted)))
        (should (equal (plist-get (car (plist-get (gdev-session-db-read "corrente") :tabs)) :name) "Storica"))
        (should (equal (gdev-read-file-contents previous) "Archivio precedente da conservare"))))))

