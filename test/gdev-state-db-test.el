      (should (eq (caar (last gdev-modules)) :config)))))

(ert-deftest gdev-test-state-db-custom-migration-and-late-option ()
  (require 'gdev-custom-db)
  (require 'cus-edit)
  (gdev-test-db--profile
    (let* ((custom-file (gdev-state-file "custom.el"))
           (user-init-file (gdev-state-file "init.el"))
           (gdev-custom-db--baseline nil)
           (var (intern "gdev-test-opzione-persistente"))
           (face (intern "gdev-test-faccia-persistente"))
           (gdev-scoped-options--catalog-profile nil)
           (gdev-scoped-options--pending (make-hash-table :test #'eq)))
      (unwind-protect
          (progn
            (with-temp-file custom-file
              (insert ";;; -*- lexical-binding: t -*-\n"
                      "(custom-set-variables '(gdev-test-opzione-persistente '(vecchio) t))\n"
                      "(custom-set-faces '(gdev-test-faccia-persistente ((t (:weight bold)))))\n"))
            (gdev-custom-db-load)
            (should (equal (symbol-value var) '(vecchio)))
            (custom-declare-variable var '(quote (base)) "Opzione di prova." :type '(repeat symbol))
            (customize-save-variable var '(nuovo valore))
            (should (equal (gdev-state-db-entries "variabile" "" (symbol-name var))
                           '(("gdev-test-opzione-persistente" '(nuovo valore)))))
            (should (gdev-state-db-entries "faccia" "" (symbol-name face)))
            (should (string-search "vecchio" (gdev-read-file-contents custom-file)))
            (set var nil)
            (gdev-custom-db-load)
            (should (equal (symbol-value var) '(nuovo valore)))
            (gdev-scoped-options-catalog-sync)
            (should (gdev-state-db-with (db)
                      (sqlite-select db "SELECT nome FROM catalogo_opzione WHERE nome=?" (list (symbol-name var))))))
        (unintern var obarray)
        (unintern face obarray)))))

