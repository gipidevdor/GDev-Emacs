(defmacro gdev-test-db--profile (&rest body)
  (declare (indent 0))
  `(let* ((gdev-state-directory (file-name-as-directory (make-temp-file "gdev-sql-" t)))
          (gdev-scoped-options--profile nil)
          (gdev-scoped-options--projects nil)
          (gdev-scoped-options--types nil)
          (gdev-scoped-options--session nil)
          (gdev-workspaces--generation nil))
     (unwind-protect (progn ,@body) (delete-directory gdev-state-directory t))))

(defun gdev-test-db--original ()
  "Ricrea lo schema v1 presente nei profili anteriori alle preferenze di sessione."
  (require 'gdev-state-db-maintenance)
  (let ((db (sqlite-open (gdev-state-db-file))))
    (unwind-protect
        (progn
          (dolist (sql gdev-state-db--schema)
            (cond ((string-match-p "catalogo_opzione\\|ultime_preferenze_sessione\\|indice_sessione_ambito\\|elimina_campi_sessione" sql))
                  ((equal sql (gdev-state-db--ddl "ambito")) (sqlite-execute db (car gdev-state-db--old-tables)))
                  ((equal sql (gdev-state-db--ddl "sessione")) (sqlite-execute db (cadr gdev-state-db--old-tables)))
                  (t (sqlite-execute db sql))))
          (sqlite-execute db "PRAGMA user_version=1")
          (sqlite-execute db "INSERT INTO ambito VALUES(4,'spazio',NULL)")
          (sqlite-execute db "INSERT INTO sessione VALUES(19,'corrente',0)")
          (sqlite-execute db "INSERT INTO spazio VALUES(21,19,0,'Articolo',4)")
          (sqlite-execute db "INSERT INTO documento_spazio VALUES(21,0,'bozza','Appunti')")
          (sqlite-execute db "INSERT INTO bozza VALUES(19,'bozza','Appunti','Appunti',NULL,NULL,NULL,'nil',1,0,'testo da conservare')"))
      (sqlite-close db))))

(ert-deftest gdev-test-state-db-migrates-on-article-session-read ()
  (gdev-test-db--profile
    (gdev-test-db--original)
    (let ((snapshot (gdev-session-db-read "corrente")))
      (should (= 19 (plist-get snapshot :generazione)))
      (should (equal "Articolo" (plist-get (car (plist-get snapshot :tabs)) :name)))
      (should (equal "testo da conservare" (plist-get (cdar (plist-get snapshot :drafts)) :text)))
      (should (= 1 (gdev-state-db-inspect (car (gdev-state-db-copies)) t)))
      (should (= 2 (gdev-state-db-inspect (gdev-state-db-file) t)))
      (gdev-session-db-save snapshot "corrente")
      (should (= (length (gdev-state-db-copies)) 1))
      (should (= 2 (gdev-state-db-inspect (gdev-state-db-file) t))))))

(ert-deftest gdev-test-state-db-migration-is-retryable-after-failure ()
  (gdev-test-db--profile
    (gdev-test-db--original)
    (let ((execute (symbol-function 'sqlite-execute)))
      (cl-letf (((symbol-function 'sqlite-execute)
                 (lambda (db statement &optional values)
                   (if (equal statement "DROP TABLE sessione_precedente") (error "Interruzione simulata")
                     (funcall execute db statement values)))))
        (should-error (gdev-session-db-read "corrente"))))
    (should (= 1 (gdev-state-db-inspect (gdev-state-db-file) t)))
    (should (= 19 (plist-get (gdev-session-db-read "corrente") :generazione)))))

(ert-deftest gdev-test-state-db-corruption-recovery-and-missing-primary ()
  (gdev-test-db--profile
    (gdev-state-db-set "prova" "" "impostazione" '(uno due))
    (let* ((file (gdev-state-db-file))
           (backup (gdev-state-db-backup))
           (dir (expand-file-name "recuperato" gdev-state-directory)))
      (should (equal backup (gdev-state-db-backup)))
      (should (= (length (gdev-state-db-copies)) 1))
      (delete-file file)
      (should-error (gdev-state-db-set "prova" "" "impostazione" 'tre) :type 'gdev-state-db-invalid)
      (should-not (file-exists-p file))
      (write-region "contenuto danneggiato" nil file nil 'silent)
      (should-error (gdev-state-db-entries "prova" "") :type 'gdev-state-db-invalid)
      (should-error (gdev-state-db-backup (expand-file-name "copia.sqlite" gdev-state-directory)))
      (should-error (gdev-state-db-recover file dir))
      (should-not (file-exists-p dir))
      (let ((bad (expand-file-name "stato-2099-01-01.sqlite" (gdev-state-db--copies-directory))))
        (write-region "copia danneggiata" nil bad nil 'silent)
        (set-file-times bad (time-add nil 60))
        (should (equal bad (car (gdev-state-db-copies))))
        (gdev-state-db-recover "ultima" dir))
      (should-error (gdev-state-db-recover backup dir))
      (let ((gdev-state-directory (file-name-as-directory dir)))
        (should (equal '(uno due) (cdar (gdev-state-db-entries "prova" "")))))
      (should (equal "contenuto danneggiato" (with-temp-buffer (insert-file-contents-literally file) (buffer-string)))))))

(ert-deftest gdev-test-state-db-refuses-foreign-future-and-altered-archives ()
  (gdev-test-db--profile
    (let* ((file (gdev-state-db-file))
           (db (sqlite-open file)))
      (unwind-protect (sqlite-execute db "CREATE TABLE altrui(id INTEGER)") (sqlite-close db))
      (should-error (gdev-state-db-set "prova" "" "a" 1) :type 'gdev-state-db-invalid)
      (delete-file file)
      (gdev-state-db-set "prova" "" "a" 1)
      (gdev-state-db-with (conn t) (sqlite-execute conn "PRAGMA user_version=345"))
      (should-error (gdev-state-db-entries "prova" "") :type 'gdev-state-db-invalid)
      (let ((conn (sqlite-open file)))
        (unwind-protect
            (progn (sqlite-execute conn "PRAGMA user_version=2")
                   (sqlite-execute conn "DROP INDEX indice_impostazione_nome"))
          (sqlite-close conn)))
      (should-error (gdev-state-db-set "prova" "" "a" 2) :type 'gdev-state-db-invalid))))

(ert-deftest gdev-test-state-db-busy-and-full-rollback ()
  (gdev-test-db--profile
    (gdev-state-db-set "prova" "" "a" 1)
    (let ((writer (sqlite-open (gdev-state-db-file))) (execute (symbol-function 'sqlite-execute)))
      (unwind-protect
          (progn
            (sqlite-execute writer "BEGIN IMMEDIATE")
            (cl-letf (((symbol-function 'sqlite-execute)
                       (lambda (db sql &optional params)
                         (funcall execute db (if (equal sql "PRAGMA busy_timeout=5000") "PRAGMA busy_timeout=20" sql) params))))
              (should-error (gdev-state-db-set "prova" "" "a" 2)))
            (should (= 1 (cdar (gdev-state-db-entries "prova" "")))))
        (sqlite-close writer)))
    (let ((execute (symbol-function 'sqlite-execute)))
      (cl-letf (((symbol-function 'sqlite-execute)
                 (lambda (db sql &optional params)
                   (when (string-prefix-p "INSERT INTO componente" sql)
                     (signal 'sqlite-error '("database or disk is full" 13 13)))
                   (funcall execute db sql params))))
        (should-error (gdev-state-db-set "prova" "" "a" 3))))
    (should (= 1 (cdar (gdev-state-db-entries "prova" ""))))
    (gdev-state-db-set "prova" "" "a" 4)
    (should (= 4 (cdar (gdev-state-db-entries "prova" ""))))))

(ert-deftest gdev-test-state-db-values-and-rollback ()
  (gdev-test-db--profile
    (let ((value (list [1 (a . b)] (concat "città" (string 0) "å")
                       (unibyte-string 0 255) (propertize "x" 'face 'bold))))
      (gdev-state-db-set "prova" "" "opzione" value)
      (should (equal-including-properties value (cdar (gdev-state-db-entries "prova" "" "opzione"))))
      (let ((circle (list 'giro)))
        (setcdr circle circle)
        (gdev-state-db-set "prova" "" "anello" circle)
        (let ((saved (cdar (gdev-state-db-entries "prova" "" "anello"))))
          (should (eq saved (cdr saved)))))
      (should-error (gdev-state-db-with (_db t)
                      (gdev-state-db-set "prova" "" "opzione" nil)
                      (error "Scrittura interrotta")))
      (should (equal value (cdar (gdev-state-db-entries "prova" "" "opzione"))))
      (gdev-state-db-with (db)
        (should (equal '(("ok")) (sqlite-select db "PRAGMA integrity_check")))
        (should-not (sqlite-select db "PRAGMA foreign_key_check")))
      (unless gdev-windows-p (should (= #o600 (file-modes (gdev-state-db-file)))))
      (gdev-state-db-with (db t) (sqlite-execute db "PRAGMA user_version=99"))
      (should-error (gdev-state-db-set "prova" "" "opzione" nil)))))

(ert-deftest gdev-test-workspaces-sqlite-recovers-interrupted-options-and-drafts ()
  (require 'gdev-workspaces)
  (gdev-test-db--profile
    (gdev-test--with-layout
      (let* ((name (generate-new-buffer-name "Bozza SQLite"))
             (key (list 'bozza name))
             (session (list :active 0 :tabs (list (list :name "Da riprendere" :files (list key)))
                            :drafts (list (cons key (list :name name :modified t :text "bozza")))))
             (empty '(:tabs ((:name "Vuota"))))
             (gdev-workspaces--session-active nil))
        (unwind-protect
            (progn
              (gdev-scoped-options-set 'session nil 'fill-column 91)
              (gdev-workspaces--write session)
              (let ((gdev-workspaces--session-active nil)) (gdev-workspaces--write empty))
              (gdev-scoped-options-set 'session nil 'fill-column 48)
              (should (equal (plist-get (gdev-workspaces--read) :drafts) nil))
              (gdev-workspaces-restore-interrupted)
              (should (equal (with-current-buffer (get-buffer name) (buffer-string)) "bozza"))
              (should (equal (gdev-scoped-options-session) '(("fill-column" . 91))))
              (should-not (gdev-session-db-exists-p "interrotta"))
              (should-not (file-exists-p (gdev-state-file "gdev-workspaces.eld"))))
          (when-let* ((buffer (get-buffer name)))
            (with-current-buffer buffer (set-buffer-modified-p nil))
            (kill-buffer buffer)))))))

(ert-deftest gdev-test-workspaces-sqlite-choose-older-interrupted-session ()
  (require 'gdev-workspaces)
  (gdev-test-db--profile
    (gdev-test--with-layout
      (let* ((gdev-workspaces--session-active nil)
             (first (gdev-session-db-save '(:tabs ((:name "Prima"))) "corrente"))
             (second (gdev-session-db-save '(:tabs ((:name "Seconda"))) "corrente" t))
             (third (gdev-session-db-save '(:tabs ((:name "Terza"))) "corrente" t)))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_ choices &rest _) (car (last (mapcar #'car choices))))))
          (gdev-workspaces-restore-interrupted))
        (should (equal (alist-get 'name (tab-bar--current-tab)) "Prima"))
        (should (equal (plist-get (gdev-session-db-read "corrente") :generazione) first))
        (should (equal (plist-get (gdev-session-db-read "interrotta") :generazione) second))
        (should (gdev-session-db-exists-p third))))))

(ert-deftest gdev-test-state-db-stale-writer-preserves-drafts ()
  (gdev-test-db--profile
    (let* ((draft '(:tabs ((:name "Seconda" :files ("/p")))
                    :drafts (("/p" :name "p" :text "altra istanza"))))
           (empty '(:tabs ((:name "Prima"))))
           (generation (gdev-session-db-save empty "corrente")))
      (gdev-session-db-save draft "corrente" nil generation)
      (gdev-session-db-save empty "corrente" nil generation)
      (should (equal (plist-get (cdar (plist-get (gdev-session-db-read "interrotta") :drafts)) :text)
                     "altra istanza"))
      (gdev-state-db-with (db)
        (should-not (sqlite-select db "PRAGMA foreign_key_check"))))))

(ert-deftest gdev-test-preferences-sqlite-scopes-are-live-and-resettable ()
  (gdev-test-db--profile
    (let* ((root (expand-file-name "alfa/" gdev-state-directory))
           (other (expand-file-name "beta/" gdev-state-directory))
           (a (generate-new-buffer " *progetto a*"))
           (b (generate-new-buffer " *progetto b*")))
      (unwind-protect
          (progn
            (with-current-buffer a (setq buffer-file-name (expand-file-name "a" root))
                                 (setq-local tab-width 3))
            (with-current-buffer b (setq buffer-file-name (expand-file-name "b" other)))
            (gdev-scoped-options-set 'session nil 'tab-width 5)
            (gdev-scoped-options-set 'project root 'tab-width 7)
            (should (= (buffer-local-value 'tab-width a) 7))
            (should (= (buffer-local-value 'tab-width b) 5))
            (gdev-scoped-options-set 'project root 'tab-width nil t)
            (should (= (buffer-local-value 'tab-width a) 5))
            (gdev-scoped-options-set 'session nil 'tab-width nil t)
            (should (= (buffer-local-value 'tab-width a) 3))
            (should-not (local-variable-p 'tab-width b)))
        (kill-buffer a) (kill-buffer b)))))

(ert-deftest gdev-test-preferences-sqlite-project-type-precedence ()
  (gdev-test-db--profile
    (let* ((first (expand-file-name "libro/" gdev-state-directory))
           (second (expand-file-name "dispensa/capitoli/" gdev-state-directory))
           (article (expand-file-name "articolo/" gdev-state-directory))
           (gdev-writing--project-markers '((gdev-article . ".gdev-article") (gdev-latex . ".gdev-latex"))))
      (dolist (dir (list first second article)) (make-directory dir t))
      (dolist (marker (list (expand-file-name ".gdev-latex" first)
                            (expand-file-name "../.gdev-latex" second)
                            (expand-file-name ".gdev-article" article)))
        (write-region "" nil marker nil 'silent))
      (with-temp-buffer
        (setq buffer-file-name (expand-file-name "capitolo.tex" second))
        (gdev-scoped-options-set 'session nil 'fill-column 90)
        (gdev-scoped-options-set 'project-type first 'fill-column 76)
        (should (= fill-column 76))
        (gdev-scoped-options-set 'project second 'fill-column 60)
        (should (= fill-column 60))
        (gdev-scoped-options-set 'project second 'fill-column nil t)
        (should (= fill-column 76))
        (setq buffer-file-name (expand-file-name "indice.org" article))
        (gdev-scoped-options-apply)
        (should (= fill-column 90))
        (setq buffer-file-name (expand-file-name "capitolo.tex" second))
        (gdev-scoped-options-set 'project-type first 'fill-column nil t)
        (should (= fill-column 90))))))

(ert-deftest gdev-test-state-db-simultaneous-session-preferences ()
  (gdev-test-db--profile
    (let ((gdev-scoped-options--identity "prima"))
      (gdev-scoped-options-set 'session nil 'fill-column 81)
      (let ((gdev-scoped-options--identity "seconda")
            (gdev-scoped-options--profile nil) (gdev-scoped-options--session nil))
        (should (equal (gdev-scoped-options-session) '(("fill-column" . 81))))
        (gdev-scoped-options-set 'session nil 'fill-column 73))
      (gdev-scoped-options-refresh)
      (should (equal (gdev-scoped-options-session) '(("fill-column" . 81))))
      (gdev-session-db-save '(:tabs ((:name "Prima"))) "corrente")
      (should (equal (plist-get (gdev-session-db-read "corrente") :preferenze)
                     '(("fill-column" . 81)))))))

(ert-deftest gdev-test-state-db-native-histories-round-trip ()
  (require 'recentf)
  (require 'saveplace)
  (require 'savehist)
  (require 'project)
  (gdev-test-db--profile
    (let* ((recentf-save-file (gdev-state-file "recentf"))
           (recentf-list '("/due" "/uno"))
           (save-place-file (gdev-state-file "places"))
           (save-place-alist '(("/uno" . 8)))
           (save-place-forget-unreadable-files nil)
           (save-place-loaded nil)
           (project-list-file (gdev-state-file "projects"))
           ;; Il runner Linux colloca i temporanei nella home: il
           ;; serializzatore nativo può abbreviare quei percorsi con ~.
           ;; Copri sempre anche la home, indipendentemente da TMPDIR.
           (project-roots (list gdev-state-directory (expand-file-name "~/")))
           (project--list (mapcar #'list project-roots))
           (savehist-file (gdev-state-file "history"))
           (savehist-additional-variables '(search-ring))
           (savehist-minibuffer-history-variables nil)
           (savehist-save-hook nil)
           (savehist-autosave-interval nil)
           (savehist-mode nil)
           (search-ring '("prima" "seconda")))
      (recentf-save-list)
      (setq recentf-list nil)
      (recentf-load-list)
      (should (equal recentf-list '("/due" "/uno")))
      (save-place-alist-to-file)
      (setq save-place-alist nil)
      (save-place-load-alist-from-file)
      (should (equal save-place-alist '(("/uno" . 8))))
      (project--write-project-list)
      (setq project--list nil)
      (project--read-project-list)
      (should (equal (mapcar (lambda (entry)
                              (cons (expand-file-name (car entry)) (cdr entry)))
                            project--list)
                     (mapcar #'list project-roots)))
      (savehist-save)
      (setq search-ring nil)
      (unwind-protect
          (progn (savehist-mode 1) (should (equal search-ring '("prima" "seconda"))))
        (savehist-mode -1))
      (dolist (file (list recentf-save-file save-place-file project-list-file savehist-file))
        (should-not (file-exists-p file))))))

(ert-deftest gdev-test-state-db-module-selection-follows-profile ()
  (gdev-test-db--profile
    (let ((gdev-modules nil) (load-path (copy-sequence load-path)))
      (gdev-state-db-set "moduli" "" ":lang/cc" 'disattivato)
