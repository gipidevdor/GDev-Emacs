(ert-deftest gdev-test-state-db-copy-supports-strict-sqlite-and-cleans-failures ()
  "Copie verificabili anche se SQLite rifiuta un file vuoto esistente."
  (gdev-test-db--profile
    (gdev-state-db-set "prova" "" "valore" 31)
    (let ((execute (symbol-function 'sqlite-execute))
          (copy (expand-file-name "copia è.sqlite" gdev-state-directory))
          (failed (expand-file-name "copia interrotta.sqlite" gdev-state-directory)))
      (cl-letf (((symbol-function 'sqlite-execute)
                 (lambda (db sql &optional values)
                   (when (and (equal sql "VACUUM INTO ?") (file-exists-p (car values)))
                     (signal 'sqlite-error '("output file already exists")))
                   (funcall execute db sql values))))
        (should (equal copy (gdev-state-db-backup copy))))
      (should (= 2 (gdev-state-db-inspect copy t)))
      (unless gdev-windows-p (should (= #o600 (file-modes copy))))
      (cl-letf (((symbol-function 'sqlite-execute)
                 (lambda (db sql &optional values)
                   (prog1 (funcall execute db sql values)
                     (when (equal sql "VACUUM INTO ?") (error "Copia interrotta"))))))
        (should-error (gdev-state-db-backup failed)))
      (should-not (file-exists-p failed))
      (should-not (directory-files gdev-state-directory nil "\\`\\.stato-copia-"))
      (should-error (gdev-state-db-backup copy) :type 'file-already-exists)
      (should (= 31 (cdar (gdev-state-db-entries "prova" "" "valore")))))))

