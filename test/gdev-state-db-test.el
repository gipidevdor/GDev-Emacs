(ert-deftest gdev-test-state-db-backup-directory-ownership ()
  (gdev-test-db--profile
    (gdev-state-db-set "prova" "" "valore" 27)
    (let* ((dir (directory-file-name (gdev-state-db--copies-directory)))
           (other (expand-file-name "altra-cartella" gdev-state-directory))
           (explicit (expand-file-name "copia-esplicita.sqlite" other)))
      (rename-file dir other)
      (make-symbolic-link other dir)
      (dotimes (day 4)
        (gdev-state-db-backup (expand-file-name (format "stato-2025-07-0%d.sqlite" (1+ day)) other)))
      (let ((names (directory-files other)))
        (should-error (gdev-state-db-backup) :type 'user-error)
        (should (equal names (directory-files other))))
      (should (= 2 (gdev-state-db-inspect (gdev-state-db-backup explicit) t)))
      (should (= 27 (cdar (gdev-state-db-entries "prova" ""))))
      (delete-file (gdev-state-db-file))
      (delete-directory other t)
      (let (gdev-state-db--checked)
        (should-error (gdev-state-db-set "prova" "" "valore" 28) :type 'gdev-state-db-invalid)
        (should-not (file-exists-p (gdev-state-db-file)))))))

