(ert-deftest gdev-test-db-review-recovery-publication ()
  (require 'gdev-state-db-maintenance)
  (gdev-test-db--profile
    (gdev-state-db-set "applicazione" "" "numero" 17)
    (let* ((source (gdev-state-db-backup))
           (dest (expand-file-name "ripreso" gdev-state-directory))
           (target (expand-file-name "stato.sqlite" dest))
           (rename (symbol-function 'rename-file)))
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (tmp file &optional overwrite)
                   (when (equal file dest)
                     (let ((gdev-state-directory tmp))
                       (should (= 2 (gdev-state-db-inspect (gdev-state-db-file) t)))
                       (should (= 2 (gdev-state-db-inspect (car (gdev-state-db-copies)) t))))
                     (signal 'file-error '("Pubblicazione interrotta")))
                   (funcall rename tmp file overwrite))))
        (should-error (gdev-state-db-recover source dest) :type 'file-error))
      (should-not (file-exists-p dest))
      (make-symbolic-link "inesistente" dest)
      (should-error (gdev-state-db-recover source dest) :type 'file-already-exists)
      (should (equal "inesistente" (file-symlink-p dest)))
      (delete-file dest)
      ;; Una seconda istanza ha concluso mentre la prima preparava il profilo.
      (cl-letf (((symbol-function 'rename-file)
                 (lambda (tmp file &optional overwrite)
                   (when (equal file dest)
                     (make-directory dest)
                     (write-region "preesistente" nil target nil 'silent))
                   (funcall rename tmp file overwrite))))
        (should-error (gdev-state-db-recover source dest) :type 'file-error))
      (should (equal "preesistente" (gdev-read-file-contents target)))
      (delete-directory dest t)
      (should (equal (gdev-state-db-recover source dest) target))
      (let ((gdev-state-directory dest))
        (should (= 17 (cdar (gdev-state-db-entries "applicazione" "" "numero"))))
        (should (= 2 (gdev-state-db-inspect (car (gdev-state-db-copies)) t)))))))

(ert-deftest gdev-test-db-review-shell-services ()
  (require 'em-hist)
  (require 'em-dirs)
  (require 'em-alias)
  (require 'comint)
  (gdev-test-db--profile
    (let* ((eshell-aliases-file (gdev-state-file "eshell/alias"))
           (eshell-command-aliases-list nil)
           (eshell-history-file-name (gdev-state-file "eshell/history"))
           (eshell-last-dir-ring-file-name (gdev-state-file "eshell/lastdir"))
           (eshell-last-dir-ring (make-ring 4))
           (eshell-history-ring (make-ring 4))
           (eshell-hist--new-items 1))
      (make-directory (file-name-directory eshell-history-file-name) t)
      (write-region "prima\n" nil eshell-history-file-name nil 'silent)
      (ring-insert eshell-history-ring "seconda\nriga")
      (eshell-write-history nil t)
      (eshell-read-history nil t)
      (should (equal (ring-elements eshell-history-ring) '("seconda\nriga" "prima")))
      (should (equal "prima\n" (gdev-read-file-contents eshell-history-file-name)))
      (ring-insert eshell-last-dir-ring "/prima/")
      (eshell-write-last-dir-ring)
      (setq eshell-last-dir-ring nil)
      (eshell-read-last-dir-ring)
      (should (equal (ring-elements eshell-last-dir-ring) '("/prima/")))
      (eshell/alias "prova" "echo" "uno")
      (let ((eshell-command-aliases-list nil)) (eshell/alias "altra" "echo" "due"))
      (eshell/alias "prova")
      (eshell-read-aliases-list)
      (should (equal eshell-command-aliases-list '(("altra" "echo due"))))
      (dolist (name '("ielm-history" "sly-mrepl-history"))
        (let ((comint-input-ring-file-name (gdev-state-file name))
              (comint-input-ring (make-ring 4)) (comint-input-ring-separator "\x1f"))
          (ring-insert comint-input-ring "test\nmultiriga")
          (comint-write-input-ring)
          (setq comint-input-ring nil)
          (comint-read-input-ring t)
          (should (equal (ring-elements comint-input-ring) '("test\nmultiriga")))
          (should-not (file-exists-p comint-input-ring-file-name))))
      (should-not (file-exists-p eshell-aliases-file))
      (should-not (file-exists-p eshell-last-dir-ring-file-name)))))

