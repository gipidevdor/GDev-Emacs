(require 'ert)
(require 'gdev-trace)
(require 'gdev-adoption)
(defvar native-comp-enable-subr-trampolines)

(ert-deftest gdev-test-assurance-trace-indexes-large-changed-path-sets ()
  "L'associazione di molti percorsi non ripete ricerche lineari nella lista."
  (let* ((root "/fixture/")
         (artifacts (cl-loop for number from 1 to 1024 collect
                             `((ref . ,(format "RC-%04d" number)) (path . ,(format "file-%04d" number)))))
         (paths (mapcar (lambda (row) (alist-get 'path row)) artifacts))
         (native-comp-enable-subr-trampolines nil))
    (cl-letf (((symbol-function 'gdev-trace-root) (lambda (&rest _) root))
              ((symbol-function 'gdev-trace-relative) (lambda (_ path) path))
              ((symbol-function 'gdev-trace-artifacts) (lambda (_) artifacts))
              ((symbol-function 'gdev-trace-links) (lambda (_) nil))
              ((symbol-function 'member) (lambda (&rest _) (ert-fail "Ricerca lineare nei percorsi cambiati"))))
      (let ((impact (gdev-trace-impact 'fixture root (append paths paths))))
        (should (equal (vconcat paths) (alist-get 'changed impact)))
        (should (equal (vconcat artifacts) (alist-get 'affected impact)))))))

(ert-deftest gdev-test-assurance-trace-reachability-is-stable-with-diamonds-and-duplicate-edges ()
  "Cicli, diamanti e archi ripetuti conservano insieme raggiungibile e ordine dei dati."
  (let* ((root "/fixture/")
         (artifacts (cl-loop for number from 1 to 6 collect
                             `((ref . ,(format "R%d" number)) (path . ,(format "p%d" number)))))
         (links (mapcar (lambda (pair) `((from . ,(car pair)) (to . ,(cdr pair))))
                        '(("R1" . "R2") ("R1" . "R3") ("R2" . "R4") ("R3" . "R4")
                          ("R4" . "R1") ("R1" . "R2") ("R5" . "R6")))))
    (cl-letf (((symbol-function 'gdev-trace-root) (lambda (&rest _) root))
              ((symbol-function 'gdev-trace-relative) (lambda (_ path) path))
              ((symbol-function 'gdev-trace-artifacts) (lambda (_) artifacts))
              ((symbol-function 'gdev-trace-links) (lambda (_) links)))
      (dolist (ordered (list artifacts (reverse artifacts)))
        (setq artifacts ordered)
        (let* ((impact (gdev-trace-impact 'fixture root '("p1" "p1")))
               (actual (append (alist-get 'affected impact) nil)))
          (should (equal ["p1"] (alist-get 'changed impact)))
          (should (equal actual (seq-filter (lambda (row) (member (alist-get 'ref row) '("R1" "R2" "R3" "R4")))
                                            artifacts)))
          (should (equal (vconcat links) (alist-get 'links impact))))))))

(ert-deftest gdev-test-assurance-artifact-keeps-the-full-long-path ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((path (concat (make-string 110 ?a) "/" (make-string 110 ?b) ".el"))
           (file (expand-file-name path root)) (id (gdev-test-assurance--open db)))
      (make-directory (file-name-directory file) t)
      (write-region "testo" nil file nil 'silent)
      (let* ((ref (gdev-trace-artifact db id root path 'source :actor "a" :actor-kind 'agent))
             (data (gdev-record-data (gdev-record-get db ref))))
        (should (equal path (alist-get 'path data)))
        (should (= 200 (length (alist-get 'label data))))
        (should-not (gdev-assurance-verify db))))))

(ert-deftest gdev-test-assurance-migration-five-preserves-history ()
  (gdev-test-assurance--with-root root
    (let ((old (seq-take gdev-assurance-db--migrations 4)) id events)
      (let ((gdev-assurance-db--migrations old))
        (gdev-assurance-db-with-open (db root 'write)
          (setq id (gdev-test-assurance--open db))
          (gdev-test-assurance--prove db id)
          (setq events (gdev-process-events db id))
          (should-not (gdev-assurance-verify db))))
      (gdev-assurance-db-with-open (db root 'write)
        (should (= (gdev-assurance-db-latest-version) (gdev-assurance-db-version db)))
        (should (equal events (gdev-process-events db id)))
        (should-not (gdev-assurance-verify db))))))

(ert-deftest gdev-test-assurance-records-reject-ambiguous-json-and-audit-edits ()
  (dolist (data '(nil ((x . 1) (x . 2)) ((Bad . 1)) ((x . 0.5)) ((x . (a . b)))))
    (should-error (gdev-record-json data)))
  (should (equal (gdev-record-json '((z . "caffè") (a . [t :false :null 3])))
                 "{\"a\":[true,false,null,3],\"z\":\"caffè\"}"))
  (gdev-test-assurance--with-archive (root db)
    (let* ((id (gdev-test-assurance--open db)) (file (expand-file-name "file con spazi.el" root)))
      (write-region "prima" nil file nil 'silent)
      (let ((ref (gdev-trace-artifact db id root file 'source :actor "agente" :actor-kind 'agent)))
        (should-not (gdev-assurance-verify db))
        (should (equal ref "RC-0001"))
        (should-not (gdev-record-get db "RC-9"))
        (should-not (gdev-record-get db "bad"))
        (should-error (sqlite-execute db "delete from assurance_record"))
        (should-error (sqlite-execute db "update assurance_record set actor = 'altro'"))
        (gdev-test-assurance--edit-restoring-guard
         db "assurance_record_no_update" "update assurance_record set actor = 'altro'")
        (should (seq-some (lambda (p) (string-search "attore" p)) (gdev-record-verify db)))))))

(ert-deftest gdev-test-assurance-trace-impact-follows-dependencies-and-cycles ()
  (gdev-test-assurance--with-archive (root db)
    (let ((id (gdev-test-assurance--open db)) refs)
      (dolist (path '("requisiti.org" "src.el" "prove.el"))
        (write-region path nil (expand-file-name path root) nil 'silent)
        (push (gdev-trace-artifact db id root path 'source :actor "a" :actor-kind 'agent) refs))
      (setq refs (nreverse refs))
      (gdev-trace-link db id (nth 0 refs) (nth 1 refs) 'implements "Requisito" :actor "a" :actor-kind 'agent)
      (gdev-trace-link db id (nth 1 refs) (nth 2 refs) 'verifies "Prova" :actor "a" :actor-kind 'agent)
      (gdev-trace-link db id (nth 2 refs) (nth 0 refs) 'depends-on "Ciclo" :actor "a" :actor-kind 'agent)
      (should (= 0 (length (alist-get 'changed (gdev-trace-impact db root)))))
      (write-region "cambiato" nil (expand-file-name "requisiti.org" root) nil 'silent)
      (let ((impact (gdev-trace-impact db root)))
        (should (equal ["requisiti.org"] (alist-get 'changed impact)))
        (should (= 3 (length (alist-get 'affected impact)))))
      (should (= 3 (length (alist-get 'affected (gdev-trace-impact db root '("src.el"))))))
      (delete-file (expand-file-name "src.el" root))
      (should (= 2 (length (alist-get 'changed (gdev-trace-impact db root)))))
      (should-not (gdev-assurance-verify db))
      (should-error (gdev-trace-link db id (car refs) (car refs) 'verifies "x" :actor "a" :actor-kind 'agent))
      (should-error (gdev-trace-link db id "RC-9999" (car refs) 'verifies "x" :actor "a" :actor-kind 'agent))
      (dolist (path '("../fuori" ".git/config" ".gdev/segreto" "a\nb"))
        (should-error (gdev-trace-artifact db id root path 'source :actor "a" :actor-kind 'agent))))))

(ert-deftest gdev-test-assurance-trace-does-not-read-outside-root-or-another-db ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-assurance--with-root outside
      (let ((id (gdev-test-assurance--open db)) (file (expand-file-name "segreto" outside)))
        (write-region "segreto" nil file nil 'silent)
        (make-symbolic-link file (expand-file-name "link" root))
        (cl-letf (((symbol-function 'gdev-evidence-file-sha256) (lambda (_) (error "Non leggere il bersaglio"))))
          (let* ((ref (gdev-trace-artifact db id root "link" 'source :actor "a" :actor-kind 'agent))
                 (data (gdev-record-data (gdev-record-get db ref))))
            (should (equal "symlink" (alist-get 'mode data)))
            (should (equal (gdev-evidence-sha256 file) (alist-get 'sha256 data)))
            (should (= 0 (length (alist-get 'changed (gdev-trace-impact db root)))))))
        (should-error (gdev-trace-root db outside))))))

(defun gdev-test-adoption--git (root)
  "Prepara in ROOT un repository di prova con un commit."
  (gdev-adoption-git root "init" "-q")
  (gdev-adoption-git root "config" "user.email" "prova@example.org")
  (gdev-adoption-git root "config" "user.name" "Prova")
  ;; La prova confronta anche .git: nessuna manutenzione del commit deve
  ;; proseguire in sottofondo mentre si fotografa il repository.
  (gdev-adoption-git root "config" "maintenance.auto" "false")
  (gdev-adoption-git root "config" "gc.auto" "0")
  (write-region "iniziale" nil (expand-file-name "sorgente.el" root) nil 'silent)
  (gdev-adoption-git root "add" "sorgente.el")
  (gdev-adoption-git root "commit" "-qm" "Iniziale"))

(ert-deftest gdev-test-assurance-adoption-never-certifies-the-past ()
  (gdev-test-assurance--with-root root
    (gdev-test-adoption--git root)
    (let ((before (gdev-test-assurance--snapshot root)))
      (should (= 1 (length (alist-get 'files (gdev-adoption-inventory root)))))
      (let ((after (gdev-test-assurance--snapshot root)))
        (ert-info ((format "File cambiati: %S / %S"
                           (seq-difference before after #'equal)
                           (seq-difference after before #'equal)))
          (should (equal before after)))))
    (should-error (gdev-adoption-adopt root 'core :actor "a" :actor-kind 'agent))
    (let ((id (gdev-adoption-adopt root 'core :actor "persona" :actor-kind 'human)))
      (gdev-assurance-db-with-open (db root)
        (should (eq 'PROPOSED (alist-get 'state (gdev-process-get db id))))
        (should (eq 'reconstructed (alist-get 'origin (car (gdev-evidence-list db id)))))
        (should (cl-every (lambda (r) (or (equal (alist-get 'control r) "GES-C02")
                                         (equal (alist-get 'status r) "NOT_VERIFIED")))
                          (append (alist-get 'results (gdev-assessment-run db id)) nil)))
        (should-not (gdev-assurance-verify db)))
      (should-error (gdev-adoption-adopt root 'core :actor "persona" :actor-kind 'human)))))

(ert-deftest gdev-test-assurance-recovery-preserves-damaged-original ()
  (gdev-test-assurance--with-root root
    (let ((file (gdev-assurance-db-file root)))
      (make-directory (file-name-directory file) t)
      (write-region "archivio danneggiato" nil file nil 'silent)
      (let ((digest (gdev-evidence-file-sha256 file)))
        (should-error (gdev-adoption-recover root 'core "Guasto" :actor "a" :actor-kind 'agent))
        (gdev-adoption-recover root 'core "Guasto" :actor "persona" :actor-kind 'human)
        (gdev-assurance-db-with-open (db root)
          (let* ((row (car (gdev-record-list db nil 'recovery)))
                 (data (gdev-record-data row))
                 (copy (expand-file-name "assurance.sqlite" (alist-get 'backup data))))
            (should (equal digest (gdev-evidence-file-sha256 copy)))
            (should-not (gdev-assurance-verify db))))))))

