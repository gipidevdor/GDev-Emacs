(ert-deftest gdev-test-project-resumes-after-last-step-before-finish ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let ((id (gdev-test-assurance--open db 'quality))
          (add (symbol-function 'gdev-record-add)) run)
      (catch 'interrupted
        (cl-letf (((symbol-function 'gdev-record-add)
                   (lambda (database tx kind payload &rest keys)
                     (when (and (eq kind 'run) (equal "finish" (alist-get 'event payload)))
                       (setq run (alist-get 'run_id payload)) (throw 'interrupted t))
                     (apply add database tx kind payload keys))))
          (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci)))
      (should run)
      (should (equal "SUCCEEDED" (alist-get 'status
                                             (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci :resume run))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-project-workbench-reader-is-asynchronous-and-ignores-an-old-section ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let ((id (gdev-test-assurance--open db 'quality)))
      (gdev-test-assurance-ui--view root
        (setq gdev-assurance--transaction id gdev-assurance--section 'project)
        (gdev-assurance--read-async)
        (let ((deadline (+ (float-time) 15)))
          (while (and gdev-assurance--reader-process (< (float-time) deadline)) (accept-process-output nil 0.05)))
        (should-not gdev-assurance--reader-process)
        (should-not gdev-assurance--error)
        (should (equal id (alist-get 'id (alist-get 'transaction (alist-get 'show gdev-assurance--model)))))
        (should (equal "FIXTURE" (alist-get 'id (alist-get 'project (alist-get 'detail gdev-assurance--model)))))
        (let ((reader (make-pipe-process :name "gdev-obsolete-reader-test" :buffer nil
                                         :noquery t :sentinel #'ignore))
              sentinel output)
          (unwind-protect
              (progn
                (cl-letf (((symbol-function 'set-process-sentinel) (lambda (_ callback) (setq sentinel callback)))
                          ((symbol-function 'process-status) (lambda (_) 'run))
                          ((symbol-function 'make-process)
                           (lambda (&rest args) (setq sentinel (plist-get args :sentinel) output (plist-get args :buffer)) reader)))
                  (gdev-assurance--read-async))
                (should (string-search "Aggiornamento in corso" (buffer-string)))
                (setq gdev-assurance--section 'taxonomy)
                (let ((before gdev-assurance--model))
                  (with-current-buffer output (insert "{\"wrong\":true}"))
                  (cl-letf (((symbol-function 'process-status) (lambda (_) 'exit))
                            ((symbol-function 'process-exit-status) (lambda (_) 0)))
                    (funcall sentinel reader "finished"))
                  (should (eq before gdev-assurance--model))
                  (should-not (buffer-live-p output)))
                (setq gdev-assurance--reader-process nil))
            (when (process-live-p reader) (delete-process reader))))))))

