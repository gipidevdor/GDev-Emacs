(defun gdev-test-project--write (root data)
  "Salva DATA nella fixture ROOT."
  (let ((file (expand-file-name gdev-project-manifest root)))
    (gdev-project-write-file root gdev-project-manifest (pp-to-string data)
                             (and (file-exists-p file) (gdev-evidence-file-sha256 file)))))

(defun gdev-test-project--fixture (root)
  "Prepara una definizione completa nella sola fixture ROOT."
  (gdev-project-initialize root "FIXTURE" "Fixture di progetto")
  (write-region ";; Sorgente di prova\n" nil (expand-file-name "source.el" root) nil 'silent)
  (let ((data (gdev-project-read root)))
    (dolist (field gdev-project-required-fields) (setq data (plist-put data (car field) (concat "Fixture: " (nth 1 field)))))
    (setq data (plist-put data :standards (copy-tree '((:id "nist-sp-800-218" :edition "1.1" :applicability applicable
                                            :decision accepted :scope indexed :reason "Scelta della fixture")))))
    (setq data (plist-put data :requirements
                         (copy-tree '((:id "REQ-1" :version 1 :statement "Il progetto impedisce chiusure prive di prove."
                            :origin "Contratto della fixture" :rationale "Evitare falsi successi"
                            :category process :priority must :criticality high :owner "fixture:responsabile"
                            :status accepted :applicability applicable :acceptance "I controlli devono essere eseguiti."
                            :method model-check :sources ("source.el") :tests ("project" "model" "project-report")
                            :procedure "PROC-FEATURE")))))
    (gdev-test-project--write root data) data))

(ert-deftest gdev-test-project-drafts-explain-missing-fields-and-keep-defaults-proposed ()
  (gdev-test-assurance--with-root root
    (let ((result (gdev-project-initialize root "DEMO" "Progetto dimostrativo")))
      (should (equal "INCOMPLETE" (alist-get 'status result)))
      (should (> (length (alist-get 'problems result)) 5))
      (should (eq 'proposed (plist-get (car (plist-get (gdev-project-read root) :standards)) :decision)))
      (should (equal "NOT_VERIFIED" (alist-get 'human_approval result)))
      (should-not (file-exists-p (gdev-assurance-db-file root))))
    (let ((suggestions (gdev-project-suggest "nist-sp-800-218")))
      (should (= 42 (length suggestions)))
      (seq-doseq (suggestion suggestions)
        (should (equal "proposed" (alist-get 'status suggestion)))
        (should (eq :false (alist-get 'verified suggestion)))))))

(ert-deftest gdev-test-project-schema-rejects-duplicates-and-unresolved-references ()
  (gdev-test-assurance--with-root root
    (let ((data (gdev-test-project--fixture root)))
      (should-not (gdev-project-problems root data))
      (should-error (gdev-project-validate (append data '(:version 1))))
      (let ((copy (copy-tree data)))
        (setf (plist-get (car (plist-get copy :requirements)) :depends-on) '("REQ-MISSING"))
        (should-error (gdev-project-validate copy)))
      (let ((copy (copy-tree data)))
        (setf (plist-get copy :requirements) (append (plist-get copy :requirements) (copy-tree (plist-get copy :requirements))))
        (should-error (gdev-project-validate copy))))))

(ert-deftest gdev-test-project-taxonomies-preserve-hierarchy-source-and-incompleteness ()
  (let* ((asvs (aref (alist-get 'taxonomies (gdev-taxonomy-data "owasp-asvs")) 0))
         (nist (aref (alist-get 'taxonomies (gdev-taxonomy-data "nist-ir-8397")) 0))
         (iso (aref (alist-get 'taxonomies (gdev-taxonomy-data "iso-iec-ieee-29148")) 0)))
    (should (= 345 (alist-get 'requirement_count asvs)))
    (should (equal "COMPLETE_WITHIN_SCOPE" (alist-get 'index_status asvs)))
    (should (seq-find (lambda (node) (equal "V1.1" (alist-get 'parent node))) (alist-get 'nodes asvs)))
    (should (= 35 (length (alist-get 'nodes nist))))
    (should (equal "TO_INTEGRATE" (alist-get 'requirements_status nist)))
    (should (equal "BIBLIOGRAPHIC" (alist-get 'index_status iso)))
    (should (> (length (alist-get 'missing iso)) 0))
    (seq-doseq (entry (alist-get 'sources nist)) (should (eq t (alist-get 'verified entry))))))

(ert-deftest gdev-test-project-snippet-preview-is-literal-and-conflicts-preserve-user-files ()
  (gdev-test-assurance--with-root root
    (gdev-test-project--fixture root)
    (let* ((args '(("title" . "Titolo àè日本語") ("content" . "$(touch nope) `shell` {{title}}")))
           (preview (gdev-project-snippet-preview root "SNIP-DOCUMENTATION" args))
           (path "result.md"))
      (should (string-search "$(touch nope) `shell` {{title}}" (alist-get 'content preview)))
      (should-not (file-exists-p (expand-file-name path root)))
      (gdev-project-snippet-write root "SNIP-DOCUMENTATION" args path)
      (should (equal (alist-get 'sha256 preview) (gdev-evidence-file-sha256 (expand-file-name path root))))
      (should-error (gdev-project-snippet-write root "SNIP-DOCUMENTATION" '(("title" . "Altro") ("content" . "Testo")) path))
      (should (equal (alist-get 'sha256 preview) (gdev-evidence-file-sha256 (expand-file-name path root))))
      (should-error (gdev-project-snippet-preview root "SNIP-DOCUMENTATION" '(("title" . ""))))
      (should-error (gdev-project-snippet-preview root "SNIP-DOCUMENTATION" '(("unknown" . "X"))))
      (should-error (gdev-project-snippet-write root "SNIP-DOCUMENTATION" args "../outside.md"))
      (should-not (file-exists-p (expand-file-name "nope" root))))))

(ert-deftest gdev-test-project-real-lifecycle-requires-current-runs-and-invalidates-changes ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let ((id (gdev-test-assurance--open db 'quality)))
      (gdev-project-bind db id root :actor "fixture:ci" :actor-kind 'ci)
      (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED 'IMPLEMENTING 'VERIFYING)
      (gdev-test-assurance--prove db id)
      (should-error (gdev-test-assurance--step db id 'REVIEWING) :type 'gdev-process-refused)
      (let ((result (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci)))
        (ert-info ((format "%S" result)) (should (equal "SUCCEEDED" (alist-get 'status result)))))
      (should (gdev-procedures-verified-p db id root (gdev-project-read root)))
      (gdev-test-assurance--step db id 'REVIEWING)
      (write-region ";; cambiamento\n" nil (expand-file-name "source.el" root) t 'silent)
      (should-error (gdev-test-assurance--step db id 'APPROVED) :type 'gdev-process-refused)
      (should-not (gdev-assurance-verify db))
      (delete-file (expand-file-name gdev-project-manifest root))
      (gdev-test-assurance--step db id 'CANCELLED 'human))))

