      (gdev-assurance-db-with-open (db root 'write)
        (setq id (gdev-test-assurance--open db 'quality)
              reference (gdev-project-snippet-apply db id root "SNIP-DOCUMENTATION"
                           '(("title" . "Titolo 日本語") ("content" . "Contenuto con \"virgolette\""))
                           "generated.md" :actor "fixture:ci" :actor-kind 'ci)))
      (gdev-assurance-db-with-open (db root 'read)
        (let* ((row (gdev-record-get db reference)) (effect (alist-get 'effect (gdev-record-data row)))
               (parameters (alist-get 'parameters effect)))
          (should (equal "SNIP-DOCUMENTATION" (alist-get 'snippet effect)))
          (should (equal 1 (alist-get 'version effect)))
          (should (equal "Titolo 日本語" (alist-get 'value (aref parameters 0))))
          (should (equal "Bozza" (alist-get 'value (aref parameters 2))))
          (should (equal (gdev-evidence-file-sha256 (expand-file-name "generated.md" root)) (alist-get 'sha256 effect)))
          (should (= 1 (length (alist-get 'snippets (gdev-work-data db id)))))
          (should-not (gdev-assurance-verify db))))
      (let ((existing (buffer-list)) view)
        (unwind-protect
            (gdev-test--with-layout
              (gdev-assurance-workspace-select root id)
              (gdev-assurance-show root)
              (setq view (current-buffer))
              (should (string-search "Titolo 日本語" (buffer-string)))
              (should (string-search "status: Bozza" (buffer-string))))
          (when (and (buffer-live-p view) (not (memq view existing))) (kill-buffer view)))))))

(ert-deftest gdev-test-project-manual-snippet-refusal-precedes-any-file-effect ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let ((id (gdev-test-assurance--open db 'quality)))
      (gdev-test-assurance--step db id 'CANCELLED 'human)
      (should-error (gdev-project-snippet-apply db id root "SNIP-DOCUMENTATION"
                     '(("title" . "Titolo") ("content" . "Contenuto")) "forbidden.md"
                     :actor "fixture:ci" :actor-kind 'ci))
      (should-not (file-exists-p (expand-file-name "forbidden.md" root)))
      (should-not (gdev-record-list db id 'project))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-project-manual-snippet-sql-failure-can-be-reconciled-without-overwriting ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let ((id (gdev-test-assurance--open db 'quality))
          (args '(("title" . "Titolo") ("content" . "Contenuto"))))
      (cl-letf (((symbol-function 'gdev-record-add) (lambda (&rest _) (error "SQL non disponibile"))))
        (should-error (gdev-project-snippet-apply db id root "SNIP-DOCUMENTATION" args "retry.md"
                       :actor "fixture:ci" :actor-kind 'ci)))
      (should (file-regular-p (expand-file-name "retry.md" root)))
      (should-not (gdev-record-list db id 'project))
      (let ((before (gdev-evidence-file-sha256 (expand-file-name "retry.md" root))))
        (gdev-project-snippet-apply db id root "SNIP-DOCUMENTATION" args "retry.md" :actor "fixture:ci" :actor-kind 'ci)
        (should (equal before (gdev-evidence-file-sha256 (expand-file-name "retry.md" root))))
        (should (= 1 (length (gdev-record-list db id 'project)))))
      (should-not (gdev-assurance-verify db)))))

