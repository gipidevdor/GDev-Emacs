(ert-deftest gdev-test-project-ert-procedure-records-real-cases-and-refuses-only-skips ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((data (gdev-test-project--fixture root))
           (id (gdev-test-assurance--open db 'quality))
           (procedure (car (plist-get data :procedures)))
           (step (cadr (plist-get procedure :steps))))
      (setf (plist-get step :plan) ".gdev-assurance/procedures/ert.lavorazione"
            (nth 1 (plist-get procedure :steps)) (plist-put step :inputs '("cases.el")))
      (gdev-test-project--write root data)
      (gdev-project-write-file root ".gdev-assurance/procedures/ert.lavorazione"
                               "{\"versione\":1,\"passi\":[{\"azione\":\"progetto-test-ert\",\"argomenti\":{\"file\":\"cases.el\",\"selettore\":\"fixture-case-\"}}]}")
      (write-region "(require 'ert) (ert-deftest fixture-case-ok () (should (= 2 (+ 1 1))))" nil (expand-file-name "cases.el" root) nil 'silent)
      (let ((run (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci)))
        (ert-info ((format "%S" run)) (should (equal "SUCCEEDED" (alist-get 'status run))))
        (let* ((rows (gdev-procedures--rows db id (alist-get 'run_id run)))
               (result (seq-find (lambda (row) (let ((d (gdev-record-data row))) (and (equal "step" (alist-get 'event d))
                                                                                   (equal 1 (alist-get 'step d))
                                                                                   (equal "SUCCEEDED" (alist-get 'status d))))) rows))
               (payload (gdev-record-data result)))
          (should (member "fixture-case-ok" (append (alist-get 'passed (aref (alist-get 'checks payload) 0)) nil)))
          (should (gdev-procedures-log-current-p root (alist-get 'log payload)))))
      (write-region "(require 'ert) (ert-deftest fixture-case-skip () (ert-skip \"indisponibile\"))" nil (expand-file-name "cases.el" root) nil 'silent)
      (should (equal "FAILED" (alist-get 'status (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci)))))))

(defun gdev-test-project--python-fixture (root content arguments timeout)
  "Prepara una procedura reale con un figlio Python nella fixture ROOT."
  (let* ((data (gdev-test-project--fixture root))
         (procedure (car (plist-get data :procedures)))
         (step (cadr (plist-get procedure :steps))))
    (setq step (plist-put step :inputs '("case.py")))
    (setf (plist-get step :plan) ".gdev-assurance/procedures/python.lavorazione"
          (plist-get step :timeout) timeout
          (nth 1 (plist-get procedure :steps)) step)
    (gdev-test-project--write root data)
    (gdev-project-write-file root "case.py" content)
    (gdev-project-write-file
     root ".gdev-assurance/procedures/python.lavorazione"
     (decode-coding-string
      (json-serialize `((versione . 1) (passi . [((azione . "progetto-test-python")
                                                (argomenti . ((file . "case.py")
                                                              (argomenti . ,(decode-coding-string (json-serialize arguments) 'utf-8-unix)))))])))
      'utf-8-unix))
    data))

(ert-deftest gdev-test-project-python-arguments-stay-literal-and-failures-remain-auditable ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((argument "spazio àè 日本語 $() `echo`")
           (id (gdev-test-assurance--open db 'quality)))
      (gdev-test-project--python-fixture
       root
       (format "import os, sys\nfrom pathlib import Path\nassert sys.argv[1] == %S\nassert os.environ['GDEV_STATE_DIR'] != sys.argv[2]\nassert os.environ['GDEV_USER_DIR'] != sys.argv[3]\nassert Path.cwd().samefile(sys.argv[4])\nprint(sys.argv[1])\n"
               argument)
       (vector argument (or (getenv "GDEV_STATE_DIR") "") (or (getenv "GDEV_USER_DIR") "") root) 10)
      (let* ((result (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci))
             (rows (gdev-procedures--rows db id (alist-get 'run_id result)))
             (step (seq-find (lambda (row)
                               (let ((payload (gdev-record-data row)))
                                 (and (equal "step" (alist-get 'event payload)) (equal 1 (alist-get 'step payload))
                                      (equal "SUCCEEDED" (alist-get 'status payload))))) rows))
             (payload (and step (gdev-record-data step))))
        (ert-info ((format "%S" result)) (should (equal "SUCCEEDED" (alist-get 'status result))))
        (should (equal "case.py" (alist-get 'name (aref (alist-get 'checks payload) 0))))
        (should (gdev-procedures-log-current-p root (alist-get 'log payload)))
        (with-temp-buffer
          (insert-file-contents (expand-file-name (alist-get 'path (alist-get 'log payload)) root))
          (should (string-search argument (buffer-string)))))
      (gdev-project-write-file root "case.py" "import sys\nprint('failure', flush=True)\nsys.exit(7)\n"
                               (gdev-evidence-file-sha256 (expand-file-name "case.py" root)))
      (should (equal "FAILED" (alist-get 'status (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-project-python-cancel-and-timeout-reap-their-own-child ()
