(ert-deftest gdev-test-project-runs-preserve-failures-and-resume-without-repeating-completed-effects ()
  (gdev-test-assurance--with-archive (root db)
    (let ((data (gdev-test-project--fixture root)) (count 0) (fail t))
      (gdev-procedures--engine)
      (unwind-protect
          (progn
            (gdev-lavorazione-registra
             "fixture-project-effect" "Effetto della fixture." nil
             (lambda (_context) (cl-incf count) (gdev-project-write-file root "first.txt" "effetto unico\n")))
            (gdev-lavorazione-registra "fixture-project-failure" "Guasto della fixture." nil
                                      (lambda (_context) (when fail (error "Guasto iniettato"))))
            (dolist (entry '(("first" . "fixture-project-effect") ("second" . "fixture-project-failure")))
              (gdev-project-write-file root (concat (car entry) ".lavorazione")
                                       (format "{\"versione\":1,\"passi\":[{\"azione\":%S,\"argomenti\":{}}]}" (cdr entry))))
            (setq data (plist-put data :procedures
                                 '((:id "PROC-FEATURE" :title "Fixture di ripresa" :version 1
                                    :outputs ("first.txt") :steps
                                    ((:id "first" :plan "first.lavorazione" :replay safe :required t :timeout 10 :outputs ("first.txt"))
                                     (:id "second" :plan "second.lavorazione" :replay safe :required t :timeout 10))))))
            (gdev-test-project--write root data)
            (let* ((id (gdev-test-assurance--open db))
                   (first (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci))
                   (run (alist-get 'run_id first)))
              (should (equal "FAILED" (alist-get 'status first))) (should (= 1 count))
              (setq fail nil)
              (let ((resumed (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci :resume run)))
                (should (equal "SUCCEEDED" (alist-get 'status resumed)))
                (should (equal run (alist-get 'run_id resumed))))
              (should (= 1 count))
              (should (= 2 (seq-count (lambda (row) (equal "finish" (alist-get 'event (gdev-record-data row))))
                                      (gdev-procedures--rows db id run))))
              (should-error (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci :resume run))
              (should-not (file-exists-p (expand-file-name ".gdev/assurance/procedure.lock" root)))
              (should-not (gdev-assurance-verify db))))
        (remhash "fixture-project-effect" gdev-lavorazione--azioni)
        (remhash "fixture-project-failure" gdev-lavorazione--azioni)))))

(ert-deftest gdev-test-project-cancellation-retains-a-resumable-journal ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let* ((id (gdev-test-assurance--open db)) (calls 0)
           (result (let ((gdev-procedures--cancel-function (lambda () (> (cl-incf calls) 1))))
                     (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci))))
      (should (equal "CANCELLED" (alist-get 'status result)))
      (should-not (file-exists-p (expand-file-name ".gdev/assurance/procedure.lock" root)))
      (should (equal "SUCCEEDED" (alist-get 'status
                                 (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci
                                                       :resume (alist-get 'run_id result)))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-project-resume-refuses-changed-sources-and-a-live-lock ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let* ((id (gdev-test-assurance--open db))
           (result (let ((gdev-procedures--cancel-function (lambda () t)))
                     (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci)))
           (lock (gdev-procedures--lock root)))
      (unwind-protect
          (should-error (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci))
        (gdev-procedures--unlock lock))
      (write-region ";; nuova revisione" nil (expand-file-name "source.el" root) t 'silent)
      (should-error (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci
                                        :resume (alist-get 'run_id result)))
      (should-not (file-exists-p (expand-file-name ".gdev/assurance/procedure.lock" root))))))

