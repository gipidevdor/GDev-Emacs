(ert-deftest gdev-test-project-dependency-cycles-and-unsaved-files-are-refused ()
  (gdev-test-assurance--with-root root
    (let* ((data (gdev-test-project--fixture root))
           (first (car (plist-get data :requirements)))
           (other (copy-tree first)))
      (setf (plist-get first :depends-on) '("REQ-2") (plist-get other :id) "REQ-2"
            (plist-get other :depends-on) '("REQ-1") (plist-get data :requirements) (list first other))
      (should-error (gdev-project-validate data)))
    (let* ((file (expand-file-name "source.el" root)) (buffer (find-file-noselect file))
           (hash (gdev-evidence-file-sha256 file)))
      (unwind-protect
          (progn (with-current-buffer buffer (goto-char (point-max)) (insert ";; da salvare"))
                 (should-error (gdev-project-write-file root "source.el" "replacement" hash))
                 (should (equal hash (gdev-evidence-file-sha256 file))))
        (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer)))))

(ert-deftest gdev-test-project-assessment-refuses-green-results-with-stale-project-proofs ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-project--fixture root)
    (let ((id (gdev-test-assurance--open db 'quality)))
      (gdev-project-bind db id root :actor "fixture:ci" :actor-kind 'ci)
      (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED 'IMPLEMENTING 'VERIFYING)
      (gdev-procedures-run db id root "PROC-FEATURE" :actor "fixture:ci" :actor-kind 'ci)
      (let* ((assessment (gdev-assessment-run db id))
             (result (seq-find (lambda (row) (equal "PROJECT-VERIFICATION" (alist-get 'control row))) (alist-get 'results assessment)))
             (digest (alist-get 'context_digest assessment)))
        (should (equal "SATISFIED" (alist-get 'status result)))
        (write-region ";; modified" nil (expand-file-name "source.el" root) t 'silent)
        (let ((changed (gdev-assessment-run db id)))
          (should-not (equal digest (alist-get 'context_digest changed)))
          (should (equal "NOT_VERIFIED" (alist-get 'status (seq-find (lambda (row) (equal "PROJECT-VERIFICATION" (alist-get 'control row)))
                                                                     (alist-get 'results changed))))))))))

