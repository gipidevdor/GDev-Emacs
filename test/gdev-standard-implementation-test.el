(ert-deftest gdev-test-standards-version-five-migrates-without-rewriting-the-chain ()
  (gdev-test-assurance--with-root root
    (let (id events records)
      (let ((gdev-assurance-db--migrations (seq-take gdev-assurance-db--migrations 5)))
        (gdev-assurance-db-with-open (db root 'write)
          (setq id (gdev-test-assurance--open db))
          (write-region "testo" nil (expand-file-name "file.txt" root) nil 'silent)
          (gdev-trace-artifact db id root "file.txt" 'source :actor "a" :actor-kind 'agent)
          (gdev-assessment-record db id :actor "ci" :actor-kind 'ci)
          (setq events (gdev-process-events db id) records (gdev-record-list db))
          (should-not (gdev-assurance-verify db))))
      (gdev-assurance-db-with-open (db root 'write)
        (should (= (gdev-assurance-db-latest-version) (gdev-assurance-db-version db)))
        (should (equal events (gdev-process-events db id)))
        (should (equal records (gdev-record-list db)))
        (should-not (gdev-assurance-verify db))
        (sqlite-execute db "alter table assessment drop column context_digest")
        (should (member "Colonna dello schema mancante: assessment.context_digest" (gdev-assurance-db-integrity db)))))))

(ert-deftest gdev-test-standards-a-staged-version-different-from-the-verified-artifact-cannot-be-signed ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-adoption--git root)
    (let* ((target "owasp-asvs#V1.2.1") (id (gdev-test-standard--start db root (list target))))
      (gdev-adoption-git root "add" "test.txt")
      (let ((tree (string-trim (gdev-adoption-git root "write-tree"))))
        (should-not (gdev-standard-staged-problems db id root tree))
        (write-region "nuovo" nil (expand-file-name "test.txt" root) nil 'silent)
        (gdev-trace-artifact db id root "test.txt" 'test :actor "a" :actor-kind 'agent)
        (should (equal '("test.txt") (gdev-standard-staged-problems db id root tree)))
        (gdev-test-standard--proof db root id target)
        (should-error (gdev-assurance-git-sign db id root "test/progetto" "persona" "/chiave-inesistente" :actor "p" :actor-kind 'human)))
      (gdev-adoption-git root "add" "test.txt")
      (should-not (gdev-standard-staged-problems db id root (string-trim (gdev-adoption-git root "write-tree")))))))

(ert-deftest gdev-test-standards-cli-writes-enforce-the-same-proof-and-decision-rules ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((id (gdev-test-assurance--open db)) (target "owasp-asvs#V1.2.1")
           (report (expand-file-name "rapport.txt" root)))
      (should (= 0 (car (gdev-test-assurance--cli root "standard-select" id target "Scelta motivata"))))
      (should (gdev-standard-selection db id))
      (write-region "test" nil report nil 'silent)
      (gdev-trace-artifact db id root report 'test :actor "a" :actor-kind 'agent)
      (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED 'IMPLEMENTING 'VERIFYING)
      (let ((count (length (gdev-evidence-list db id))))
        (should (= 1 (car (gdev-test-assurance--cli root "standard-proof" id target "inventato" report))))
        (should (= count (length (gdev-evidence-list db id)))))
      (should (= 0 (car (gdev-test-assurance--cli root "standard-decision" id target "waiver" "Eccezione motivata"))))
      (let ((row (aref (alist-get 'results (gdev-standard-assessment db id nil "REVIEWING")) 0)))
        (should (equal "WAIVED_WITH_AUTHORIZATION" (alist-get 'status row)))
        (should (string-search "Senza la deroga: NOT_VERIFIED" (alist-get 'reason row))))
      (should (= 0 (car (gdev-test-assurance--cli root "standard-decision" id target "revoke" "Ripristino"))))
      (should (= 0 (car (gdev-test-assurance--cli root "standard-proof" id target "pass" report))))
      (gdev-test-assurance--step db id 'REVIEWING)
      (should (= 0 (car (gdev-test-assurance--cli root "standard-assess" id))))
      (should (equal "SATISFIED" (alist-get 'status (gdev-test-standard--result db id))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-standards-document-controls-become-due-on-approval-and-baseline ()
