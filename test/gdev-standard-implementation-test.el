      (gdev-assessment-record db id :actor "ci" :actor-kind 'ci)
      (gdev-test-assurance--edit-restoring-guard db "assessment_no_update" "update assessment set context_digest = ?" (make-string 64 ?a))
      (should (gdev-assessment-store-verify db))
      (let* ((row (car (last (gdev-standard--records db id))))
             (data (gdev-record-data row)))
