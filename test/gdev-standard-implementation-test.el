(ert-deftest gdev-test-standards-a-catalog-change-invalidates-current-results-without-corrupting-history ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-assurance--with-root catalog-root
      (let ((gdev-standards-directory catalog-root) (target "owasp-asvs#V1.2.1"))
        (make-directory (expand-file-name "standard" catalog-root))
        (make-directory (expand-file-name "profili" catalog-root))
        (dolist (part '("standard" "profili"))
          (dolist (file (directory-files (expand-file-name part (expand-file-name "docs/assicurazione" gdev-config-directory)) t "\\.eld\\'"))
            (copy-file file (expand-file-name (file-name-nondirectory file) (expand-file-name part catalog-root)))))
        (let* ((id (gdev-test-standard--start db root (list target)))
               (before (gdev-assessment-run db id))
               (file (expand-file-name "standard/attuazione.eld" catalog-root)))
          (gdev-test-standard--proof db root id target)
          (with-temp-buffer
            (insert-file-contents file)
            (goto-char (point-min))
            (search-forward "\"owasp-asvs\" :scope clausola :roles (test)")
            (replace-match "\"owasp-asvs\" :scope clausola :roles (test source)" t t)
            (write-region (point-min) (point-max) file nil 'silent))
          (let ((after (gdev-assessment-run db id)))
            (should-not (equal (alist-get 'controls_digest before) (alist-get 'controls_digest after)))
            (should (equal "NOT_VERIFIED" (alist-get 'status (gdev-test-standard--result db id)))))
          (should-error (gdev-test-standard--proof db root id target))
          (should-error (gdev-test-assurance--step db id 'REVIEWING))
          (should-not (gdev-assurance-verify db)))))))

(ert-deftest gdev-test-standards-recorded-context-and-proof-inputs-are-bound-to-their-audit-events ()
