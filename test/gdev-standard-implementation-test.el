(require 'ert)
(require 'gdev-standard-assessment)

(defun gdev-test-standard--start (db root specifications &optional roles)
  "Prepara una transazione con SPECIFICATIONS e artefatti di ROLES."
  (let ((id (gdev-test-assurance--open db)))
    (gdev-standard-select db id specifications "Scelta di prova" :actor "responsabile" :actor-kind 'human)
    (dolist (role (or roles '(test)))
      (let ((file (expand-file-name (concat (symbol-name role) ".txt") root)))
        (write-region (symbol-name role) nil file nil 'silent)
        (gdev-trace-artifact db id root file role :actor "esecutore" :actor-kind 'agent)))
    (gdev-test-assurance--walk db id 'CLASSIFIED 'ANALYZED 'AUTHORIZED 'IMPLEMENTING 'VERIFYING)
    id))

(defun gdev-test-standard--proof (db root id target &optional verdict actor)
  "Registra un rapporto per TARGET di ID."
  (let ((file (expand-file-name "rapporto.txt" root)))
    (write-region "Rapporto della verifica mirata" nil file nil 'silent)
    (gdev-standard-proof-file db id target (or verdict "pass") file :actor (or actor "verificatore") :actor-kind 'human)))

(defun gdev-test-standard--result (db id &optional target)
  "Leggi l'esito di TARGET, oppure il primo controllo scelto, di ID."
  (let ((rows (alist-get 'results (alist-get 'standards (gdev-assessment-run db id)))))
    (if target (seq-find (lambda (row) (equal (concat "STD-" (replace-regexp-in-string "#" ":" target))
                                             (alist-get 'control row))) rows)
      (aref rows 0))))

(ert-deftest gdev-test-standards-catalog-distinguishes-clause-and-bibliographic-scopes ()
  (should (= 345 (length (gdev-standard-catalog-targets "owasp-asvs"))))
  (should (= 10 (length (gdev-standard-catalog-targets "ecss-e-st-40c"))))
  (should (eq 'documento (plist-get (car (gdev-standard-catalog-targets "ieee-1012")) :scope)))
  (should-not (gdev-standard-catalog-targets "iso-iec-3300x"))
  (should-not (gdev-standard-catalog-targets "nasa-hdbk-2203"))
  (should (gdev-standards-check-reference '(:standard "nasa-hdbk-2203" :edizione "B" :ambito standard)))
  (should-error (gdev-standard-catalog-resolve "iso-iec-ieee-12207#6.4.3"))
  (should-error (gdev-standard-catalog-resolve "owasp-asvs#inventata"))
  (should-not (gdev-standards-check-reference '(:standard "ieee-1012" :edizione "2024" :ambito standard)))
  (gdev-test-assurance--with-root root
    (should (= 0 (car (gdev-test-assurance--cli root "standards" "ecss-s-st-00"))))
    (should-not (file-exists-p (expand-file-name ".gdev" root)))))

(ert-deftest gdev-test-standards-specific-proof-is-required-and-ordinary-assessments-include-it ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((target "owasp-asvs#V1.2.1") (id (gdev-test-standard--start db root (list target))))
      (gdev-test-assurance--prove db id)
      (should-error (gdev-test-assurance--step db id 'REVIEWING))
      (gdev-test-standard--proof db root id target)
      (gdev-test-assurance--step db id 'REVIEWING)
      (should (equal "SATISFIED" (alist-get 'status (gdev-test-standard--result db id))))
      (should (= 4 (length (alist-get 'results (gdev-assessment-run db id)))))
      (gdev-assessment-record db id :actor "ci" :actor-kind 'ci)
      (should-not (gdev-assurance-verify db))
      (gdev-test-assurance--walk db id 'APPROVED 'BASELINED)
      (should (= 0 (car (gdev-test-assurance--cli root "standard-assess" id))))
      (should (= 4 (length (alist-get 'controls (gdev-capability-run db "core"))))))))

