      (gdev-test-assurance--step db id 'CANCELLED 'human)
      (should (equal "NOT_APPLICABLE" (alist-get 'status (gdev-test-standard--result db id))))
      (should (equal "NOT_SATISFIED"
                     (alist-get 'status (aref (alist-get 'results (gdev-standard-assessment db id '("Archive damaged"))) 0))))
      (should-not (gdev-assurance-verify db)))))

(ert-deftest gdev-test-standards-a-forged-independent-review-is-never-counted-as-satisfied ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((target "ieee-1012#@document") (id (gdev-test-standard--start db root (list target))))
      (gdev-test-standard--proof db root id target)
      (gdev-test-assurance--step db id 'REVIEWING)
      (let ((row (car (last (gdev-standard--records db id)))))
        (gdev-test-assurance--edit-restoring-guard db "assurance_record_no_update"
                                                  "update assurance_record set actor = 'revisore' where id = ?" (alist-get 'id row)))
      (should (gdev-assurance-verify db))
      (let ((row (aref (alist-get 'results (gdev-standard-assessment db id)) 0)))
        (should (equal "NOT_SATISFIED" (alist-get 'status row)))
        (should (string-search "non è indipendente" (alist-get 'reason row)))))))

(ert-deftest gdev-test-standards-symlink-proof-binds-the-descriptor-without-reading-the-target ()
  (gdev-test-assurance--with-archive (root db)
    (gdev-test-assurance--with-root outside
      (gdev-test-adoption--git root)
      (let* ((target "owasp-asvs#V1.2.1") (id (gdev-test-standard--start db root (list target)))
             (link (expand-file-name "collegamento è.txt" root))
             (external (expand-file-name "esterno.txt" outside)))
        (write-region "prima" nil external nil 'silent)
        (make-symbolic-link external link)
        (gdev-trace-artifact db id root link 'test :actor "a" :actor-kind 'agent)
        (gdev-test-standard--proof db root id target)
        (gdev-adoption-git root "add" "test.txt" "collegamento è.txt")
        (let ((tree (string-trim (gdev-adoption-git root "write-tree"))))
          (should-not (gdev-standard-staged-problems db id root tree)))
        (let ((before (gdev-standard-assessment db id nil "REVIEWING")))
          (write-region "altro contenuto fuori radice" nil external nil 'silent)
          (should (equal (alist-get 'context_digest before)
                         (alist-get 'context_digest (gdev-standard-assessment db id nil "REVIEWING")))))
        (gdev-test-assurance--step db id 'REVIEWING)
        (delete-file link)
        (write-region external nil link nil 'silent)
        (should (equal "NOT_VERIFIED" (alist-get 'status (gdev-test-standard--result db id))))
        (should-not (gdev-assurance-verify db))))))

