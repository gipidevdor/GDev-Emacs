(ert-deftest gdev-test-standards-capability-binds-file-context-without-counting-unselected-transactions ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((target "owasp-asvs#V1.2.1") (id (gdev-test-standard--start db root (list target))))
      (gdev-test-assurance--open db)
      (gdev-test-standard--proof db root id target)
      (gdev-test-assurance--step db id 'REVIEWING)
      (let* ((before (gdev-capability-run db "core"))
             (row (seq-find (lambda (row) (string-prefix-p "STD-" (alist-get 'control row))) (alist-get 'controls before))))
        (should (= 1 (alist-get 'observations row)))
        (should (= 100 (alist-get 'satisfied_percent row)))
        (delete-file (expand-file-name "test.txt" root))
        (let ((after (gdev-capability-run db "core")))
          (should (equal (alist-get 'controls_digest before) (alist-get 'controls_digest after)))
          (should-not (equal (alist-get 'input_digest before) (alist-get 'input_digest after))))))))

(ert-deftest gdev-test-standards-cancelled-transactions-are-inapplicable-but-integrity-is-still-checked ()
