(ert-deftest gdev-test-standards-changed-artifacts-change-the-input-digest-and-invalidate-the-report ()
  (gdev-test-assurance--with-archive (root db)
    (let* ((target "owasp-asvs#V1.2.1") (id (gdev-test-standard--start db root (list target))))
      (gdev-test-standard--proof db root id target)
      (gdev-test-assurance--step db id 'REVIEWING)
      (let ((before (gdev-assessment-run db id)))
        (gdev-assessment-record db id :actor "ci" :actor-kind 'ci)
        (let ((recorded (gdev-assessment-run db id)))
          (write-region "cambiato" nil (expand-file-name "test.txt" root) nil 'silent)
          (let ((after (gdev-assessment-run db id)))
            (should-not (equal (alist-get 'input_digest recorded) (alist-get 'input_digest after)))
            (should-not (equal (alist-get 'context_digest before) (alist-get 'context_digest after)))
            (should (eq t (alist-get 'context_changed (alist-get 'recorded after))))
            (should (equal "NOT_VERIFIED" (alist-get 'status (gdev-test-standard--result db id)))))))
      (should-error (gdev-test-assurance--step db id 'APPROVED))
      (should-not (gdev-assurance-verify db)))))

