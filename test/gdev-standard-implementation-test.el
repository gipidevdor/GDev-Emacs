        (gdev-test-assurance--edit-restoring-guard db "assurance_record_no_update" "update assurance_record set payload = ? where id = ?"
                                                  (gdev-record-json data) (alist-get 'id row))
        (should (seq-some (lambda (problem) (string-search "Gli ingressi" problem)) (gdev-record-verify db)))))))

(ert-deftest gdev-test-standards-mcp-proposals-preserve-agent-identity-and-cannot-choose-standards ()
