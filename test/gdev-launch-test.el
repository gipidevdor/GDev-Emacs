(ert-deftest gdev-test-launch-maps-remote-sources-in-both-directions ()
  "I sorgenti di un adattatore esterno seguono la radice del profilo."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory temporary-file-directory))
         (working-directory (expand-file-name "build/" root))
         (local (expand-file-name "src with spaces/" root))
         (source (expand-file-name "lib/main.c" local))
         (debug '(:adapter custom :port 5678 :host "127.0.0.1"
                  :options (:type "test" :request "attach")))
         (gdev-layout-mode nil)
         (gdev-debug--local-targets (make-hash-table :test #'eq))
         config)
    (dolist (bad '("/app" ("/app") ("app" ".") ("/app" "")
                   ("/ssh:container:/app" ".") ("/app" 42) ["/app" "."]))
      (should-error (gdev-launch--check-debug (append debug (list :source-map bad)) "Remoto")
                    :type 'user-error))
    (setq debug (append debug '(:source-map ("/app" "src with spaces/"))))
    (gdev-launch--check-debug debug "Remoto")
    (cl-letf (((symbol-function 'dape) (lambda (value &rest _) (setq config value)))
              ((symbol-function 'dape--config) (lambda (_) config))
              ((symbol-function 'dape--root-of) (lambda (_) 'parent)))
      (gdev-debug-launch-profile debug root working-directory nil)
      (should (equal (plist-get config :request) "attach"))
      (should (equal (dape--file-name-local 'parent "/app/lib/main.c") source))
      (should (equal (dape--file-name-remote 'parent source) "/app/lib/main.c"))
      (should (equal (dape--file-name-local 'parent "/application/other.c") "/application/other.c"))
      (should (equal (dape--file-name-local 'parent "/app/../other.c") "/app/../other.c"))
      (should (equal (dape--file-name-local 'parent "/app") (directory-file-name local)))
      (should (equal (dape--file-name-local 'parent "main.c") "main.c"))
      (should (equal (dape--file-name-local 'parent "~/main.c") "~/main.c"))
      (gdev-debug--remember-target 'child '(:systemProcessId 567 :isLocalProcess t))
      (should-not (gethash 'child gdev-debug--local-targets))
      (plist-put config 'source-directories ["/ssh:example:/work" "/app"])
      (should (equal (dape--file-name-local 'parent "/app/lib/main.c")
                     "/ssh:example:/work/lib/main.c"))
      (should (equal (dape--file-name-remote 'parent "/ssh:example:/work/lib/main.c")
                     "/app/lib/main.c"))
      (setq config (list 'command-cwd working-directory 'prefix-local local 'prefix-remote "/app/"))
      (should (equal (dape--file-name-remote 'parent source) "/app/lib/main.c"))
      (gdev-debug--remember-target 'child '(:systemProcessId 567 :isLocalProcess t))
      (should (= (gethash 'child gdev-debug--local-targets) 567)))))

(ert-deftest gdev-test-launch-restart-guard-follows-workspace-lifetime ()
  "Il riavvio può proseguire in un altro spazio, finché quello d'origine esiste."
  (gdev-test-launch--load-tools)
  (gdev-test--with-layout
    (let ((owner (gdev-workspace-state-ensure-id)) guard)
      (cl-letf (((symbol-function 'dape--root-of) (lambda (_) 'parent))
                ((symbol-function 'dape--config)
                 (lambda (connection)
                   (should (eq connection 'parent))
                   (list 'gdev-workspace owner)))
                ((symbol-function 'dape-restart)
                 (lambda (connection _ valid-p)
                   (should (eq connection 'parent))
                   (setq guard valid-p))))
        (gdev-debug-session-command 'dape-restart 'child)
        (should (funcall guard))
        (tab-bar-new-tab)
        (should (funcall guard))
        (tab-bar-close-tab 1)
        (should-not (funcall guard))))))

(ert-deftest gdev-test-launch-uses-workspace-fallback-and-distinguishes-automatic-profile ()
  "La scelta dal gruppo editor conserva anche un profilo chiamato Automatico."
  (let* ((directory (file-name-as-directory temporary-file-directory))
         (root (expand-file-name "progetto/" directory))
         (profile '("Automatico" :build ("make")))
         (gdev-launch-profiles (list (list root profile))))
    (gdev-test--with-layout
      (with-temp-buffer
        (setq default-directory directory)
        (set-window-buffer (gdev-layout-editor) (current-buffer))
        (gdev-workspace-set-roots (list root))
        (should (equal (gdev-launch-profile-root directory) root))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt candidates &rest _)
                     (should (equal candidates '("[Automatico]" "Automatico")))
                     "Automatico")))
          (should (equal (call-interactively #'gdev-launch-select-profile) profile)))
        (should (equal (gdev-launch-selected root) profile))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt candidates &rest _) (car candidates))))
          (call-interactively #'gdev-launch-select-profile))
        (should-not (gdev-launch-selected root))))))

(ert-deftest gdev-test-launch-legacy-profiles-preserve-arguments-and-interpreters ()
  "I profili posizionali continuano a distinguere programmi e interpreti."
  (let* ((root (file-name-as-directory (make-temp-file "gdev-legacy-profile-" t)))
         (file "programma con spazi")
         (absolute (expand-file-name file root))
         (args '("" "con spazi")))
    (unwind-protect
        (progn
          (with-temp-file absolute (insert "#!/bin/sh\n"))
          (set-file-modes absolute #o600)
          (should-error (gdev-launch--options '("Vecchio" "script" "non una lista") root)
                        :type 'user-error)
          (should-error (gdev-launch-program file root t) :type 'user-error)
          (should-error (gdev-launch-program "mancante" root) :type 'user-error)
          (dolist (case '((netcoredbg "dotnet") (perl "perl" "-Ilib") (debugpy "python-fittizio")))
            (pcase-let* ((`(,adapter . ,prefix) case)
                         (profile (list "Vecchio" file args '("A=B") adapter))
                         (options (gdev-launch--options profile root)))
              (should (plist-get options :legacy))
              (should (equal (plist-get options :env) '("A=B")))
              (should (equal (plist-get options :cwd) root))
              (cl-letf (((symbol-function 'gdev-python--interpreter)
                         (lambda (directory)
                           (should (equal root directory))
                           "python-fittizio")))
                (should (equal (gdev-launch--legacy-run (plist-get options :debug) root args)
                               (append prefix (list absolute) args))))))
          (cl-letf (((symbol-function 'gdev-python--interpreter) nil))
            (should-error (gdev-launch--legacy-run
                           (list :adapter 'debugpy :program file) root args)
                          :type 'user-error))
          (set-file-modes absolute #o700)
          (should (equal (gdev-launch--legacy-run (list :program file) root args)
                         (cons absolute args))))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-debug-prefix-preserves-empty-and-literal-arguments ()
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory temporary-file-directory))
         (args '("" "con spazi" "$letterale" "virgolette \" interne"))
         (debug (list :adapter 'custom :port 4321 :host "localhost"
                      :args args :options '(:type "probe" :request "launch" :stopOnEntry t)))
         (gdev-launch-profiles (list (list root (list "Prova" :debug debug))))
         (gdev-launch--standalone-selections (list (cons root "Prova")))
         (gdev-layout-mode nil)
         config)
    (with-temp-buffer
      (setq default-directory root)
      (cl-letf (((symbol-function 'read-string)
                 (lambda (_prompt initial &rest _) initial))
                ((symbol-function 'dape) (lambda (value) (setq config value))))
        (gdev-debug-dwim '(4))
        (should (equal (plist-get config :args) (vconcat args)))
        (should (equal (plist-get config 'host) "localhost"))
        (should (= (plist-get config 'port) 4321))
        (should (eq (plist-get config :stopOnEntry) t))
        (should (equal (plist-get debug :args) args))))))

(ert-deftest gdev-test-launch-run-uses-real-argv-env-cwd-and-prerequisite ()
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-launch-" t)))
         (directory (expand-file-name "sotto cartella/" root))
         (profile '("Terminale" :cwd "sotto cartella" :env ("PROBE=valore=con spazio")
                    :build ("/bin/sh" "-c" "printf pronto > preparato")
                    :build-before (run)
                    :run ("/bin/sh" "-c"
                          "printf 'GDEV:%s|%s|%s|%s\\n' \"$(cat preparato)\" \"$PROBE\" \"$1\" \"$2\""
                          "_" "uno due" "$tre")))
         (gdev-launch-profiles (list (list root profile)))
         (gdev-launch--standalone-selections (list (cons root "Terminale")))
         (gdev-layout-mode nil)
         (name (format "*Esecuzione · Terminale · %s*" (abbreviate-file-name (directory-file-name root))))
         (build (format "*%s*" (gdev-build--output-name root))))
    (unwind-protect
        (with-temp-buffer
          (make-directory directory)
          (setq default-directory directory)
          (gdev-run-dwim)
          (gdev-test-launch--wait (lambda () (get-buffer name)))
          (gdev-test-launch--wait-output name "GDEV:pronto|valore=con spazio|uno due|$tre")
          (with-current-buffer build
            (should (equal (file-truename default-directory) (file-truename directory)))
            (should (string-search "completata" (buffer-string)))))
      (dolist (name (list build name))
        (when-let* ((buffer (get-buffer name))) (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-recompile-replays-build-for-profile-and-workspace ()
  "Ricompila conserva il piano di build del profilo anche dopo la pulizia altrui."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-repeat-build-" t)))
         (profile '("Alfa" :env ("GDEV_BUILD_PROFILE=alfa")
                    :build ("/bin/sh" "-c"
                            "printf 'RISULTATO:%s:%s:%s\\n' \"$GDEV_BUILD_PROFILE\" \"$GDEV_BUILD_ENV\" \"$1\""
                            "_" "default")))
         (gdev-launch-profiles
          (list (list root profile '("Beta" :clean ("/bin/echo" "pulizia")))))
         (output (format "*%s*" (gdev-build--output-name root))))
    (unwind-protect
        (gdev-test--with-layout
          (with-temp-buffer
            (let ((source (current-buffer)))
              (setq default-directory root)
              (set-window-buffer (gdev-layout-editor) source)
              (gdev-workspace-state-set 'gdev-launch-selections (list (cons root "Alfa")))
              (let ((process-environment (cons "GDEV_BUILD_ENV=originale" process-environment)))
                (cl-letf (((symbol-function 'gdev-launch--read-arguments)
                           (lambda (args) (append (butlast args) '("modificato")))))
                  (gdev-build '(4))))
              (gdev-test-launch--wait-output output "RISULTATO:alfa:originale:modificato")
              (gdev-test-launch--wait (lambda () (not (get-buffer-process output))))
              (gdev-workspace-state-set 'gdev-launch-selections (list (cons root "Beta")))
              (gdev-build-clean)
              (gdev-test-launch--wait (lambda () (not (get-buffer-process output))))
              (tab-bar-new-tab)
              (set-window-buffer (gdev-layout-editor) source)
              (gdev-workspace-state-set 'gdev-launch-selections (list (cons root "Alfa")))
              (with-current-buffer source
                (should-not (gdev-build-last-plan root "Alfa"))
                (let ((process-environment (cons "GDEV_BUILD_ENV=nuovo" process-environment)))
                  (gdev-build-recompile)))
              (gdev-test-launch--wait-output output "RISULTATO:alfa:nuovo:default")
              (gdev-test-launch--wait (lambda () (not (get-buffer-process output))))
              (tab-bar-select-tab 1)
              (gdev-workspace-state-set 'gdev-launch-selections (list (cons root "Alfa")))
              (with-current-buffer source
                (gdev-build-recompile))
              (gdev-test-launch--wait-output output "RISULTATO:alfa:originale:modificato")
              (gdev-test-launch--wait (lambda () (not (get-buffer-process output)))))))
      (when (get-buffer output) (kill-buffer output))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-recompile-falls-back-to-automatic-build ()
  "Un profilo senza fase build usa il costruttore automatico anche fuori da Workbench."
  (gdev-test-launch--load-tools)
  (skip-unless (executable-find "make"))
  (let* ((root (file-name-as-directory (make-temp-file "gdev-build-auto-" t)))
         (gdev-layout-mode nil)
         (gdev-launch-profiles (list (list root '("Script" :run ("true")))))
         (gdev-launch--standalone-selections (list (cons root "Script")))
         (gdev-build--standalone-plans nil)
         (output (format "*%s*" (gdev-build--output-name root))))
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root)
          (with-temp-file (expand-file-name "Makefile" root)
            (insert "all:\n\t@printf 'BUILD-AUTOMATICA:%s\\n' \"$$GDEV_TEST_BUILD_AUTO\"\n"))
          (should-not (gdev-launch-dispatch 'build))
          (should-not (gdev-build-last-plan root "Script"))
          (let ((process-environment (cons "GDEV_TEST_BUILD_AUTO=originale" process-environment)))
            (gdev-build-recompile))
          (gdev-test-launch--wait-output output "BUILD-AUTOMATICA:originale")
          (gdev-test-launch--wait (lambda () (not (get-buffer-process output))))
          (should (gdev-build-last-plan root "Script"))
          (should-not (gdev-build-last-plan root nil))
          (let ((process-environment (cons "GDEV_TEST_BUILD_AUTO=modificata" process-environment)))
            (gdev-build-recompile))
          (gdev-test-launch--wait-output output "BUILD-AUTOMATICA:originale")
          (gdev-test-launch--wait (lambda () (not (get-buffer-process output))))
          (with-current-buffer output
            (should-not (string-search "BUILD-AUTOMATICA:modificata" (buffer-string)))))
      (when (get-buffer output) (kill-buffer output))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-build-reservation-releases-on-start-and-process-errors ()
  "La riserva copre l'avvio e si libera sia senza processo sia dopo l'uscita fallita."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-build-errors-" t)))
         (tree (expand-file-name "build/" root))
         (other (expand-file-name "altro-progetto/" root))
         (known (gdev-build-scope root tree))
         (unknown (gdev-build-scope root nil))
         (other-project-same-tree (gdev-build-scope other tree))
         (independent (gdev-build-scope other (expand-file-name "build/" other)))
         (gdev-build--active nil)
         (name (format "Verifica compilazione · %s" root))
         output process)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root)
          (cl-letf (((symbol-function 'gdev-compile)
                     (lambda (&rest _)
                       (should-error (gdev-build-check-scope known) :type 'user-error)
                       (should-not (gdev-build-check-scope independent))
                       (signal 'file-error '("Avvio fallito")))))
            (should-error (gdev-build-compile "true" name root unknown) :type 'file-error))
          (should-not gdev-build--active)
          (setq output (gdev-build-compile
                        "until [ -f rilascio ]; do sleep 0.05; done; exit 7"
                        name root known)
                process (get-buffer-process output))
          (should-error (gdev-build-check-scope unknown) :type 'user-error)
          (should-error (gdev-build-check-scope other-project-same-tree) :type 'user-error)
          (with-temp-file (expand-file-name "rilascio" root))
          (gdev-test-launch--wait (lambda () (not gdev-build--active)))
          (should (eq (process-status process) 'exit))
          (should (= (process-exit-status process) 7))
          (should-not (gdev-build-check-scope unknown))
          (gdev-build-compile "exit 0" name root unknown)
          (gdev-test-launch--wait (lambda () (not gdev-build--active))))
      (when (buffer-live-p output)
        (when-let* ((child (get-buffer-process output))) (delete-process child))
        (kill-buffer output))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-recompile-output-preserves-or-widens-resource-as-needed ()
  "Il tasto g rispetta la risorsa del pannello, conservando il comportamento nativo fuori da GDev."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-recompile-panel-" t)))
         (directory (expand-file-name "build separata/" root))
         (scope (gdev-build-scope root directory))
         (gdev-build--active nil)
         (command "printf '%s:%s\\n' OUTPUT originale")
         (edited "printf '%s:%s\\n' OUTPUT modificato")
         tracked plain)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root
                tracked (gdev-build-start command root scope))
          (should (string-suffix-p " · build separata*" (buffer-name tracked)))
          (gdev-test-launch--wait-output tracked "OUTPUT:originale")
          (gdev-test-launch--wait (lambda () (not (get-buffer-process tracked))))
          (with-current-buffer tracked
            (should (eq (recompile) tracked))
            (should (eq gdev-build--buffer-scope scope)))
          (gdev-test-launch--wait-output tracked "OUTPUT:originale")
          (gdev-test-launch--wait (lambda () (not (get-buffer-process tracked))))
          (with-current-buffer tracked
            (cl-letf (((symbol-function 'compilation-read-command) (lambda (_) edited)))
              (should (eq (recompile t) tracked)))
            (should-not (gdev-build-scope-resource gdev-build--buffer-scope)))
          (gdev-test-launch--wait-output tracked "OUTPUT:modificato")
          (gdev-test-launch--wait (lambda () (not (get-buffer-process tracked))))
          (setq plain (gdev-compile command (concat "Manuale " root) root))
          (gdev-test-launch--wait (lambda () (not (get-buffer-process plain))))
          (with-current-buffer plain
            (should (eq (recompile) plain))
            (should-not gdev-build--buffer-scope)
            (should-not gdev-build--active))
          (gdev-test-launch--wait-output plain "OUTPUT:originale")
          (gdev-test-launch--wait (lambda () (not (get-buffer-process plain)))))
      (dolist (buffer (list tracked plain))
        (when (buffer-live-p buffer)
          (when-let* ((process (get-buffer-process buffer))) (delete-process process))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-debug-failed-or-interrupted-build-stops-the-chain ()
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-debug-gated-" t)))
         (gdev-launch-profiles (list (list root
                                         '("Fallita" :build ("/bin/sh" "-c" "exit 7")
                                           :build-before (debug)
                                           :debug (:adapter custom :port 4100
                                                   :options (:type "probe" :request "attach")))
                                         '("Interrotta" :build ("/bin/sleep" "10")
                                           :build-before (debug)
                                           :debug (:adapter custom :port 4100
                                                   :options (:type "probe" :request "attach"))))))
         (gdev-launch--standalone-selections (list (cons root "Fallita")))
         (gdev-layout-mode nil)
         (name (format "*%s*" (gdev-build--output-name root)))
         started)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root)
          (cl-letf (((symbol-function 'gdev-debug-launch-profile)
                     (lambda (&rest _) (setq started t))))
            (gdev-debug-dwim)
            (gdev-test-launch--wait-output name "codice 7")
            (should-not started)
            (setq gdev-launch--standalone-selections (list (cons root "Interrotta")))
            (gdev-debug-dwim)
            (with-current-buffer name (interrupt-process (get-buffer-process (current-buffer))))
            (gdev-test-launch--wait (lambda () (not (get-buffer-process name))))
            (should-not started)))
      (when-let* ((buffer (get-buffer name))) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-build-before-observes-already-completed-process ()
  "Il seguito usa il codice di uscita anche quando Emacs ha già consegnato il risultato."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-launch-fast-" t)))
         (name (format "*%s*" (gdev-build--output-name root)))
         (gdev-layout-mode nil)
         (gdev-build--standalone-plans nil)
         (compilation-in-progress nil)
         (compilation-start-hook
          (cons #'gdev-test-launch--finish-in-start-hook compilation-start-hook))
         (started 0))
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root)
          (gdev-launch--build-before '("/bin/sh" "-c" "exit 0") root root nil
                                     (lambda () (cl-incf started)) "Pronto")
          (should (= started 1))
          (should-not (get-buffer-process name))
          (gdev-launch--build-before '("/bin/sh" "-c" "exit 7") root root nil
                                     (lambda () (cl-incf started)) "Pronto")
          (should-not (get-buffer-process name))
          (should (= started 1)))
      (when (get-buffer name) (kill-buffer name))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-build-before-ignores-an-auxiliary-compilation ()
  "Un processo avviato da un hook non sblocca il seguito della build richiesta."
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev-launch-nested-build-" t)))
         (marker (expand-file-name "pronto" root))
         (name (format "*%s*" (gdev-build--output-name root)))
         (aux-name (format "Compilazione ausiliaria · %s" root))
         (gdev-layout-mode nil)
         (gdev-build--standalone-plans nil)
         auxiliary auxiliary-started
         (continued 0))
    (unwind-protect
        (with-temp-buffer
          (setq default-directory root)
          (let ((compilation-start-hook
                 (cons (lambda (_process)
                         (unless auxiliary-started
                           (setq auxiliary-started t
                                 auxiliary (gdev-compile "exit 0" aux-name root))))
                       compilation-start-hook)))
            (should (eq (gdev-launch--build-before
                         '("/bin/sh" "-c" "until [ -f pronto ]; do sleep 0.05; done")
                         root root nil (lambda () (cl-incf continued)) "Prova")
                        (get-buffer name))))
          (gdev-test-launch--wait (lambda () (not (get-buffer-process auxiliary))))
          (should (process-live-p (get-buffer-process name)))
          (should (= continued 0))
          (with-temp-file marker)
          (gdev-test-launch--wait (lambda () (not (get-buffer-process name))))
          (should (= continued 1)))
      (dolist (buffer (list auxiliary (get-buffer name)))
        (when (buffer-live-p buffer)
          (when-let* ((process (get-buffer-process buffer))) (delete-process process))
          (kill-buffer buffer)))
      (delete-directory root t))))

(ert-deftest gdev-test-launch-resumes-only-in-the-workspace-that-built ()
  (gdev-test--with-layout
    (let* ((owner (gdev-workspace-state-ensure-id))
           (frame (selected-frame))
           resumed)
      (tab-bar-new-tab)
      (gdev-launch--in-workspace frame owner
                                (lambda () (setq resumed (gdev-workspace-state-id))))
      (should-not resumed)
      (tab-bar-select-tab 1)
      (should (eq owner resumed))
      (setq resumed nil)
      (tab-bar-select-tab 2)
      (tab-bar-select-tab 1)
      (should-not resumed))))

(ert-deftest gdev-test-launch-drains-the-queue-in-order-without-mutating-it ()
  "Più seguiti riprendono in ordine di completamento e una sola volta."
  (gdev-test--with-layout
    (let* ((owner (gdev-workspace-state-ensure-id))
           (frame (selected-frame))
           resumed
           (first (lambda () (push (cons 'prima (gdev-workspace-state-id)) resumed)))
           (second (lambda () (push (cons 'seconda (gdev-workspace-state-id)) resumed))))
      (tab-bar-new-tab)
      (gdev-launch--in-workspace frame owner first)
      (let* ((tab (gdev-workspace-state-find owner frame))
             (previous (gdev-workspace-state-read 'gdev-launch-pending tab)))
        (gdev-launch--in-workspace frame owner second)
        (let ((pending (gdev-workspace-state-read 'gdev-launch-pending tab)))
          (should-not resumed)
          (should-not (gdev-workspace-state-get 'gdev-launch-pending))
          (tab-bar-select-tab 1)
          (should (equal (reverse resumed) (list (cons 'prima owner) (cons 'seconda owner))))
          (should-not (gdev-workspace-state-get 'gdev-launch-pending))
          (should (equal previous (list first)))
          (should (equal pending (list second first)))
          (tab-bar-select-tab 2)
          (tab-bar-select-tab 1)
          (should (= (length resumed) 2)))))))

(ert-deftest gdev-test-launch-discards-completion-for-a-closed-workspace ()
  "Una compilazione che termina dopo la chiusura informa e scarta il seguito."
  (gdev-test--with-layout
    (let ((owner (gdev-workspace-state-ensure-id))
          started notification)
      (tab-bar-new-tab)
      (let ((remaining (gdev-workspace-state-ensure-id))
            (frame (selected-frame)))
        (tab-bar-close-tab 1)
        (should-not (gdev-workspace-state-find owner frame))
        (cl-letf (((symbol-function 'message)
                   (lambda (text &rest arguments)
                     (setq notification (apply #'format text arguments)))))
          (gdev-launch--in-workspace frame owner (lambda () (setq started t))))
        (should-not started)
        (should (eq (gdev-workspace-state-id frame) remaining))
        (should-not (gdev-workspace-state-get 'gdev-launch-pending frame))
        (should (equal notification
                       "Compilazione completata. Avvio annullato: lo spazio di origine è stato chiuso"))))))

(ert-deftest gdev-test-launch-reopening-a-workspace-cancels-its-build-continuations ()
  "Riaprire uno spazio non riprende la richiesta di avvio precedente alla chiusura."
  (gdev-test-launch--load-tools)
  (dolist (completed '(nil t))
    (let* ((root (file-name-as-directory (make-temp-file "gdev-launch-reopen-" t)))
           (build (format "*%s*" (gdev-build--output-name root)))
           (run (format "*Esecuzione · Prova · %s*" (abbreviate-file-name (directory-file-name root))))
           (marker (expand-file-name "pronto" root))
           (started (expand-file-name "avviato" root))
           (gdev-launch-profiles
            (list (list root '("Prova"
                               :build ("/bin/sh" "-c" "until [ -f pronto ]; do sleep 0.05; done")
                               :run ("/bin/sh" "-c" "printf avviato > avviato")
                               :build-before (run)))))
           (tab-bar-closed-tabs nil))
      (unwind-protect
          (gdev-test--with-layout
            (with-temp-buffer
              (setq default-directory root)
              (set-window-buffer (gdev-layout-editor) (current-buffer))
              (gdev-workspace-state-set 'gdev-launch-selections (list (cons root "Prova")))
              (gdev-run-dwim)
              (let ((owner (gdev-workspace-state-id)))
                (tab-bar-new-tab)
                (if completed
                    (progn
                      (with-temp-file marker)
                      (gdev-test-launch--wait (lambda () (not (get-buffer-process build))))
                      (should (gdev-workspace-state-read 'gdev-launch-pending
                                                         (gdev-workspace-state-find owner))))
                  (should (process-live-p (get-buffer-process build))))
                (tab-bar-close-tab 1)
                (tab-bar-undo-close-tab)
                (unless completed
                  (with-temp-file marker)
                  (gdev-test-launch--wait (lambda () (not (get-buffer-process build)))))
                (should-not (get-buffer run))
                (should-not (file-exists-p started))
                (should-not (gdev-workspace-state-get 'gdev-launch-pending)))))
        (dolist (name (list run build))
          (when-let* ((buffer (get-buffer name)))
            (when-let* ((process (get-buffer-process buffer))) (delete-process process))
            (kill-buffer buffer)))
        (delete-directory root t)))))

(ert-deftest gdev-test-launch-dape-uses-the-process-exit-status ()
  (gdev-test-launch--load-tools)
  (let* ((name " *gdev dape compilation*")
         (dape-compile-hook nil)
         (dape-compile-function (lambda (command) (gdev-compile command name default-directory)))
         (continued 0)
         (buffer-name (format "*%s*" name)))
    (unwind-protect
        (cl-letf (((symbol-function 'dape--warn) #'ignore))
          (dape--compile '(compile "exit 0") (lambda () (cl-incf continued)))
          (gdev-test-launch--wait (lambda () (= continued 1)))
          (dape--compile '(compile "exit 4") (lambda () (cl-incf continued)))
          (gdev-test-launch--wait-output buffer-name "codice 4")
          (should (= continued 1)))
      (when-let* ((buffer (get-buffer buffer-name))) (kill-buffer buffer)))))

(ert-deftest gdev-test-launch-exception-filters-are-scoped-and-acknowledged ()
  (gdev-test-launch--load-tools)
  (let* ((a (make-pipe-process :name "gdev-test-dape-one" :noquery t))
         (b (make-pipe-process :name "gdev-test-dape-two" :noquery t))
         (one (make-instance 'dape-connection :name "gdev-test-one" :process a
                             :config '(exception-filters ("catch" "unknown"))))
         (two (make-instance 'dape-connection :name "gdev-test-two" :process b :config nil))
         (caps '(:exceptionBreakpointFilters [(:filter "catch" :label "Catch")
                                              (:filter "throw" :label "Throw" :default t)]))
         (dape-update-ui-hook nil)
         requests warnings)
    (unwind-protect
        (cl-letf (((symbol-function 'dape-request)
                   (lambda (conn request data callback)
                     (push (list conn request data callback) requests)))
                  ((symbol-function 'dape--warn) (lambda (&rest args) (push args warnings))))
          (dolist (connection (list one two))
            (setf (dape--capabilities connection) caps
                  (dape--initialized-p connection) t)
            (dape--configure-exceptions connection))
          (should (equal (mapcar (lambda (request) (nth 2 request)) requests)
                         '((:filters ["throw"]) (:filters ["catch"]))))
          (dolist (request requests) (funcall (nth 3 request) nil nil))
          (should (equal (dape-enabled-exception-filters one) '("catch")))
          (should (equal (dape-enabled-exception-filters two) '("throw")))
          (should (equal (cadar warnings) "unknown"))
          (dape-set-exception-filters one nil)
          (should (equal (nth 2 (car requests)) '(:filters [])))
          (funcall (nth 3 (car requests)) nil "Adapter rejected the request")
          (should (equal (dape-enabled-exception-filters one) '("catch")))
          (dape-set-exception-filters one nil)
          (funcall (nth 3 (car requests)) nil nil)
          (should-not (dape-enabled-exception-filters one))
          (should (equal (dape-enabled-exception-filters two) '("throw"))))
      (delete-process a)
      (delete-process b))))

(ert-deftest gdev-test-launch-meson-and-ninja-use-safe-project-directories ()
  (gdev-test-launch--load-tools)
  (let* ((root (file-name-as-directory (make-temp-file "gdev build trees " t)))
         (directory (expand-file-name "build-meson/meson-info/" root))
         (gdev-meson-build-directory "build-meson")
         (gdev-build-settings nil))
    (unwind-protect
        (let ((default-directory root))
          (with-temp-file (expand-file-name "build.ninja") (insert ""))
          (should (eq (gdev-build-system root) 'ninja))
          (should (equal (gdev-build--command 'clean root) "ninja -t clean"))
          (with-temp-file (expand-file-name "meson.build") (insert ""))
          (should (eq (gdev-build-system root) 'meson))
          (should (string-search " && meson compile " (gdev-build--command 'build root)))
          (make-directory directory t)
          (let ((metadata (expand-file-name "meson-info.json" directory)))
            (with-temp-file metadata
              (insert (json-serialize (list :directories (list :source root)))))
            (should (string-prefix-p "meson setup --reconfigure" (gdev-build--command 'configure root)))
            (should (string-prefix-p "meson test" (gdev-build--command 'test root)))
            (with-temp-file metadata (insert "{\"directories\":{\"source\":\"/altro/progetto\"}}"))
            (should-error (gdev-build--command 'clean root) :type 'user-error)))
      (delete-directory root t))))

