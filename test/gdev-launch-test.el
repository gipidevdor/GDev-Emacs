(require 'ert)
(require 'gdev-compilation)
(require 'gdev-launch)

(defun gdev-test-launch--load-tools ()
  "Carica le entrate ordinarie di compilazione ed esecuzione passo passo."
  (package-activate-all)
  (load (gdev-module-file :tools 'build ".el") nil t t)
  (load (gdev-module-file :tools 'debugger ".el") nil t t)
  (require 'dape))

(defun gdev-test-launch--wait (predicate)
  "Attendi PREDICATE, dando tempo a processi e sentinelle."
  (let ((deadline (+ (float-time) 12)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.03))
    (should (funcall predicate))))

(defun gdev-test-launch--wait-output (buffer text)
  "Attendi che BUFFER riporti TEXT."
  (gdev-test-launch--wait
   (lambda () (with-current-buffer buffer (string-search text (buffer-string))))))

(defun gdev-test-launch--finish-in-start-hook (process)
  "Fai consegnare il risultato di PROCESS prima del ritorno di compilation-start."
  (let ((buffer (process-buffer process)))
    (gdev-test-launch--wait (lambda () (not (eq process (get-buffer-process buffer)))))))

(ert-deftest gdev-test-launch-selects-nearest-root-per-workspace ()
  (let* ((root (file-name-as-directory temporary-file-directory))
         (child (expand-file-name "fixture/monorepo/" root))
         (directory (expand-file-name "src/" child))
         (profile '("Lavoro" :build ("make" "-j2")))
         (gdev-launch-profiles (list (list root '("Altro" :build ("make")))
                                     (list child profile)))
         (gdev-launch-selection-change-hook nil))
    (gdev-test--with-layout
      (let ((default-directory directory))
        (should (equal child (gdev-launch-profile-root)))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Lavoro")))
          (should (equal profile (gdev-launch-select-profile))))
        (tab-bar-new-tab)
        (should-not (gdev-launch-selected child))
        (tab-bar-select-tab 1)
        (should (equal profile (gdev-launch-selected child)))
        (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil))))
          (condition-case nil (gdev-launch-select-profile child) (quit nil)))
        (should (equal profile (gdev-launch-selected child)))))))

