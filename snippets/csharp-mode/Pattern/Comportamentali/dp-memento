// Cattura i dati necessari al ripristino. Le modifiche successive devono lasciare intatta la cattura.

sealed class ${1:Editor}
{
    public string Text { get; set; } = "";
    public int Cursor { get; set; }

    public sealed record Snapshot(string Text, int Cursor);

    public Snapshot Save() => new(Text, Cursor);

    public void Restore(Snapshot state) => (Text, Cursor) = (state.Text, state.Cursor);
}
