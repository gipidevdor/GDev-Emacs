// Il consumatore avanza un elemento alla volta e può interrompere l'attraversamento in anticipo.

using System.Collections;
using System.Collections.Generic;

sealed class ${1:Countdown}(int start) : IEnumerable<int>
{
    public IEnumerator<int> GetEnumerator()
    {
        for (var next = start; next > 0; --next) yield return next;
    }

    IEnumerator IEnumerable.GetEnumerator() => GetEnumerator();
}
