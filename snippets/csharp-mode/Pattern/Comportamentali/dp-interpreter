// I nodi rappresentano la grammatica e valutano il proprio sottoalbero con il medesimo ambiente.

using System.Collections.Generic;

interface IExpression { int Evaluate(IReadOnlyDictionary<string, int> environment); }

sealed record Variable(string Name) : IExpression
{
    public int Evaluate(IReadOnlyDictionary<string, int> environment) => environment[Name];
}

sealed record ${1:Add}(IExpression Left, IExpression Right) : IExpression
{
    public int Evaluate(IReadOnlyDictionary<string, int> environment) =>
        checked(Left.Evaluate(environment) + Right.Evaluate(environment));
}
