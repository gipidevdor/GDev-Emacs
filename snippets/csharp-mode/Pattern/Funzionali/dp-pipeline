using System.Collections.Generic;
using System.Linq;

static class ${1:Records}
{
    public static IEnumerable<string> Trimmed(IEnumerable<string> items) =>
        items.Select(item => item.Trim())
             .Where(item => item.Length != 0 && !item.StartsWith('#'));
}
