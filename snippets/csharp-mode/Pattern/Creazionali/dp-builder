using System.Collections.Generic;

sealed record ${1:Report}(string Title, IReadOnlyList<string> Sections);

sealed class $1Builder(string title)
{
    private readonly List<string> sections = [];

    public $1Builder Add(string section)
    {
        sections.Add(section);
        return this;
    }

    public $1 Build() => new(title, sections.AsReadOnlyCopy());
}

static class ReportCollections
{
    public static IReadOnlyList<T> AsReadOnlyCopy<T>(this List<T> source) =>
        System.Array.AsReadOnly(source.ToArray());
}
