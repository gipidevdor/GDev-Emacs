// Fornisci la fabbrica al chiamante per mantenere coerenti i prodotti della stessa famiglia.

interface IButton { string Paint(); }
interface IDialog { string Open(); }

interface IWidgetFactory
{
    IButton Button();
    IDialog Dialog();
}

sealed class ${1:TextWidgetFactory} : IWidgetFactory
{
    public IButton Button() => new TextButton();
    public IDialog Dialog() => new TextDialog();

    private sealed class TextButton : IButton { public string Paint() => "[OK]"; }
    private sealed class TextDialog : IDialog { public string Open() => "Dialog"; }
}
