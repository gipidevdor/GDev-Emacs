// Traduci il contratto al confine e incapsula i dettagli del componente esistente.

interface ITemperature { double Celsius(); }
interface ILegacySensor { double Fahrenheit(); }

sealed class ${1:CelsiusAdapter}(ILegacySensor sensor) : ITemperature
{
    public double Celsius() => (sensor.Fahrenheit() - 32) * 5 / 9;
}
