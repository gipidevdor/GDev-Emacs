// Collega la dipendenza nel punto di composizione. Il caso d'uso può così ricevere un sostituto.

interface ISender { void Send(string message); }

sealed class ${1:Greeter}(ISender sender)
{
    public void Greet(string name) => sender.Send(\$"Hello, {name}");
}
