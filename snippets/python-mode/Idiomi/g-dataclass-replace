from dataclasses import dataclass, replace


@dataclass(frozen=True)
class ${1:Job}:
    retries: int = 0


# replace usa il costruttore e riesegue gli eventuali controlli di __post_init__.
standard = $1()
${2:retry_job} = replace(standard, retries=${3:2})
$0
