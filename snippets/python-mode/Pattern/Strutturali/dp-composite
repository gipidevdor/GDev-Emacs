# Il nodo composto delega ai figli attraverso la stessa interfaccia che espone.

from dataclasses import dataclass, field
from typing import Protocol


class SizedNode(Protocol):
    def size(self) -> int: ...


@dataclass(frozen=True)
class FileNode:
    bytes: int

    def size(self) -> int:
        return self.bytes


@dataclass
class ${1:DirectoryNode}:
    children: list[SizedNode] = field(default_factory=list)

    def size(self) -> int:
        return sum(child.size() for child in self.children)


