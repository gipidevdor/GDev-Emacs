from typing import Protocol


class Temperature(Protocol):
    def celsius(self) -> float: ...


class LegacySensor(Protocol):
    def fahrenheit(self) -> float: ...


class ${1:CelsiusAdapter}:
    def __init__(self, sensor: LegacySensor) -> None:
        self._sensor = sensor

    def celsius(self) -> float:
        return (self._sensor.fahrenheit() - 32) * 5 / 9


