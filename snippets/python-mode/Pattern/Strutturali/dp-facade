# L'ordine delle chiamate ai sottosistemi rimane in un unico punto.

from collections.abc import Callable


class ${1:OrderCheckout}:
    def __init__(
        self,
        quote: Callable[[str], int],
        place: Callable[[str, int], str],
    ) -> None:
        self._quote = quote
        self._place = place

    def checkout(self, cart_id: str) -> str:
        return self._place(cart_id, self._quote(cart_id))


