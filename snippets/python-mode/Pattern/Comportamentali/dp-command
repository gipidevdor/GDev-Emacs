# L'azione è un valore. Il chiamante può conservarla e annullarla quando il contratto lo consente.

from dataclasses import dataclass


@dataclass
class ${1:AppendText}:
    target: list[str]
    text: str

    def execute(self) -> None:
        self.target.append(self.text)

    def undo(self) -> None:
        if not self.target or self.target[-1] != self.text:
            raise RuntimeError("Undo in reverse execution order")
        self.target.pop()


