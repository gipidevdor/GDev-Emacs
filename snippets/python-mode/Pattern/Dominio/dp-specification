# Componi regole indipendenti senza inglobare l'esecuzione del caso d'uso nei predicati.

from collections.abc import Callable
from dataclasses import dataclass
from typing import Generic, TypeVar

T = TypeVar("T")


@dataclass(frozen=True)
class ${1:Specification}(Generic[T]):
    matches: Callable[[T], bool]

    def __and__(self, other: "$1[T]") -> "$1[T]":
        return $1(lambda value: self.matches(value) and other.matches(value))

    def __or__(self, other: "$1[T]") -> "$1[T]":
        return $1(lambda value: self.matches(value) or other.matches(value))


