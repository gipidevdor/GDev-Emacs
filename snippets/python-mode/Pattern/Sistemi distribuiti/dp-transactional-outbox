import json
import sqlite3
from uuid import uuid4

OUTBOX_SCHEMA = """
CREATE TABLE IF NOT EXISTS outbox (
    id TEXT PRIMARY KEY,
    payload TEXT NOT NULL
)
"""


def ${1:rename_item}(db: sqlite3.Connection, item_id: str, label: str) -> str:
    """Call with no active transaction. The item table has id and label columns."""
    event_id = str(uuid4())
    event = {"type": "ItemRenamed", "item_id": item_id, "label": label}
    with db:
        db.execute("BEGIN")
        updated = db.execute("UPDATE item SET label = ? WHERE id = ?", (label, item_id))
        if updated.rowcount != 1:
            raise LookupError(item_id)
        db.execute("INSERT INTO outbox VALUES (?, ?)", (event_id, json.dumps(event)))
    return event_id


