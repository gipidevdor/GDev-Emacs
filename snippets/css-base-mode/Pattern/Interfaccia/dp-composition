# -*- mode: snippet -*-
# name: Composizione — centro con larghezza massima e padding
# key: dp-composition
# group: Pattern.Interfaccia
# expand-env: ((yas-indent-line 'fixed))
# --
/* Incapsula i vincoli della composizione senza imporre la struttura dei figli. */

.${1:center} {
  inline-size: min(100%, ${2:70rem});
  margin-inline: auto;
  padding-inline: ${3:1rem};
  box-sizing: border-box;
  $0
}
