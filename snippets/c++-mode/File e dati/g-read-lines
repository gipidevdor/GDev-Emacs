#include <filesystem>
#include <fstream>
#include <stdexcept>
#include <string>
#include <vector>

std::vector<std::string> ${1:read_lines}(const std::filesystem::path& path) {
    std::ifstream stream{path};
    if (!stream) throw std::runtime_error("Cannot open input");
    std::vector<std::string> lines;
    for (std::string line; std::getline(stream, line);) {
        lines.push_back(line);
    }
    if (!stream.eof()) throw std::runtime_error("Read failed");
    return lines;
}

