#include <cstdio>
#include <utility>

int ${1:close_and_reset}(std::FILE*& handle) {
    // Se fclose fallisce, handle è già azzerato e non va chiuso di nuovo.
    auto* old = std::exchange(handle, nullptr);
    return old ? std::fclose(old) : 0;
}

