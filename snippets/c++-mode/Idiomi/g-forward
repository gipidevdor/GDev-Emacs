#include <memory>
#include <utility>

// std::forward distingue i riferimenti a lvalue dagli argomenti da spostare.
template <class T, class... Args>
auto ${1:make_value}(Args&&... args) {
    return std::make_unique<T>(std::forward<Args>(args)...);
}

