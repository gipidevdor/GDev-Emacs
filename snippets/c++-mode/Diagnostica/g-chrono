# -*- mode: snippet -*-
# name: Misura di durata con steady_clock
# key: g-chrono
# group: Diagnostica
# expand-env: ((yas-indent-line 'fixed))
# --
#include <chrono>
#include <functional>

double ${1:milliseconds}(const std::function<void()>& work) {
    const auto start = std::chrono::steady_clock::now();
    work();
    return std::chrono::duration<double, std::milli>(
        std::chrono::steady_clock::now() - start
    ).count();
}

$0
