#include <functional>
#include <string_view>
#include <utility>

class ${1:Greeter} {
public:
    using Send = std::function<void(std::string_view)>;

    explicit $1(Send send) : send_{std::move(send)} {}

    void greet() const { send_("${2:Hello}"); }

private:
