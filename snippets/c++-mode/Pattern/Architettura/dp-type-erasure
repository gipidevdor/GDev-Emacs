// Conserva il comportamento richiesto senza propagare il tipo concreto ai consumatori.

#include <functional>
#include <string>
#include <utility>

class ${1:AnyLabel} {
public:
    template <class T>
        requires requires(const T& item) { std::string{item.label()}; }
    explicit $1(T value)
        : label_{[item = std::move(value)] { return std::string{item.label()}; }} {}

    [[nodiscard]] std::string label() const { return label_(); }

private:
    std::function<std::string()> label_;
};

