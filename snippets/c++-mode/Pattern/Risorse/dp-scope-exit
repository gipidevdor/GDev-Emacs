// La guardia vive nello scope in cui lo stato deve essere ripristinato.

#include <functional>

void ${1:while_busy}(bool& busy, const std::function<void()>& operation) {
    const struct Restore {
        bool& target;
        bool previous;
        ~Restore() { target = previous; }
    } restore{busy, busy};
    busy = true;
    operation();
    $0
}
