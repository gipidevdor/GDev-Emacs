// Un gestore indica se ha elaborato la richiesta. Il primo che la gestisce termina la catena.

#include <functional>
#include <optional>
#include <span>
#include <string>
#include <string_view>

using Handler = std::function<std::optional<std::string>(std::string_view)>;

std::optional<std::string> ${1:dispatch}(std::string_view request,
                                       std::span<const Handler> handlers) {
    for (const auto& handle : handlers) {
        if (auto result = handle(request)) return result;
    }
    return std::nullopt;
}

