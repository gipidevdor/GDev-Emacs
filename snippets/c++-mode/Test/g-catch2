#include <catch2/catch_test_macros.hpp>

TEST_CASE("${1:an empty collection can grow}", "[${2:collection}]") {
    SECTION("initial state") {
        REQUIRE(${3:2 + 2 == 4});
    }
    SECTION("after inserting") {
        REQUIRE(${4:3 + 2 == 5});
    }
    $0
}
