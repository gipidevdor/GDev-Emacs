#include <chrono>
#include <stop_token>
#include <thread>

void ${1:run_worker}() {
    std::jthread worker{[](std::stop_token stop) {
        while (!stop.stop_requested()) {
            $0
            std::this_thread::sleep_for(std::chrono::milliseconds{25});
        }
    }};
    std::this_thread::sleep_for(std::chrono::milliseconds{${2:100}});
}
