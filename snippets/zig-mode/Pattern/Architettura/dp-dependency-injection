// Collega la dipendenza nel punto di composizione. Il caso d'uso può così ricevere un sostituto.

pub fn ${1:Greeter}(comptime Sink: type) type {
    return struct {
        sink: Sink,

        pub fn greet(self: *@This(), name: []const u8) !void {
            try self.sink.write(name);
        }
    };
}

pub const IgnoreSink = struct {
    pub fn write(_: *@This(), _: []const u8) error{}!void {}
};
