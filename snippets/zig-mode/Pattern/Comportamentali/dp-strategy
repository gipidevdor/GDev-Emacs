// Il chiamante sceglie l'algoritmo. Il contesto decide quando applicarlo.

pub fn ${1:total}(amount: u32, comptime discount: fn (u32) u32) u32 {
    return amount -| discount(amount);
}

pub fn tenPercent(amount: u32) u32 {
    return amount / 10;
}
