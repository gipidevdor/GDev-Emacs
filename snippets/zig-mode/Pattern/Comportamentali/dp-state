// Ogni stato definisce il proprio comportamento e le transizioni ammesse.

pub const ${1:Status} = enum {
    draft,
    review,
    published,

    pub fn advance(self: @This()) error{AlreadyPublished}!@This() {
        return switch (self) {
            .draft => .review,
            .review => .published,
            .published => error.AlreadyPublished,
        };
    }
};
