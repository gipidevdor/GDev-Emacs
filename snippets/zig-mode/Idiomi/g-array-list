const std = @import("std");

pub fn ${1:collect}(allocator: std.mem.Allocator, input: []const u32) ![]u32 {
    var values: std.ArrayList(u32) = .empty;
    defer values.deinit(allocator);
    for (input) |value| {
        if (value != 0) try values.append(allocator, value);
    }
    // toOwnedSlice svuota la lista. Il chiamante deve liberare il buffer.
    $0
    return values.toOwnedSlice(allocator);
}
