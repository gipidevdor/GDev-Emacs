// La stessa istanza è condivisa in questo processo. Passala esplicitamente a chi deve poterla sostituire.

package ${1:example}

import "sync"

type ${2:Settings} struct {
	TimeoutSeconds int
}

// La funzione costruisce il valore una volta. Le copie non condividono stato mutabile.
var DefaultSettings = sync.OnceValue(func() $2 {
	return $2{TimeoutSeconds: 5}
})
