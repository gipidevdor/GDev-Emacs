package ${1:example}

import "errors"

type Config struct {
	address string
	retries int
}

type Option func(*Config)

func WithRetries(retries int) Option {
	return func(config *Config) { config.retries = retries }
}

func NewConfig(address string, options ...Option) (Config, error) {
	config := Config{address: address, retries: 3}
	for _, option := range options {
		option(&config)
	}
	if config.address == "" || config.retries < 0 {
		return Config{}, errors.New("invalid address or retry count")
	}
	return config, nil
}
