// Collega la dipendenza nel punto di composizione. Il caso d'uso può così ricevere un sostituto.

package ${1:example}

import "context"

type Sender interface {
	Send(context.Context, string) error
}

type ${2:Greeter} struct{ sender Sender }

func New$2(sender Sender) $2 { return $2{sender: sender} }

func (g $2) Greet(ctx context.Context, name string) error {
	return g.sender.Send(ctx, "Hello, " + name)
}
