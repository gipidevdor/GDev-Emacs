}

func ${2:DecodeItem}(source io.Reader) (Item, error) {
	reader := json.NewDecoder(source)
	reader.DisallowUnknownFields()
	var item Item
	if err := reader.Decode(&item); err != nil {
		return Item{}, err
	}
	if err := reader.Decode(new(json.RawMessage)); err != io.EOF {
		return Item{}, errors.New("expected exactly one JSON value")
	}
	$0
