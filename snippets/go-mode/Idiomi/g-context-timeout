package ${1:example}

import (
	"context"
	"time"
)

func ${2:WithDeadline}(ctx context.Context, load func(context.Context) error) error {
	// Il figlio eredita la cancellazione e non può estendere la deadline del genitore.
	request, cancel := context.WithTimeout(ctx, ${3:5} * time.Second)
	defer cancel()
	$0
	return load(request)
}
