# -*- mode: snippet -*-
# name: Error wrapping con %w ed errors.Is
# key: g-error-wrap
# group: Idiomi
# expand-env: ((yas-indent-line 'fixed))
# --
package ${1:example}

import (
	"errors"
	"fmt"
	"io/fs"
	"os"
)

func ${2:ReadOptional}(path string) ([]byte, error) {
	data, err := os.ReadFile(path)
	// errors.Is segue la catena dei wrapper fino alla causa originale.
	if errors.Is(err, fs.ErrNotExist) {
		return nil, nil
	}
	if err != nil {
		return nil, fmt.Errorf("read %q: %w", path, err)
	}
	$0
	return data, nil
}
