{
  "\$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "${1:Item}",
  "type": "object",
  "properties": {
    "${2:id}": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" }
  },
  "required": ["$2"],
  "additionalProperties": false
}$0
