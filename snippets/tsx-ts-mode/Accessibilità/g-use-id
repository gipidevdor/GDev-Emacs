import { useId } from "react";

export function ${1:EmailField}() {
  const id = useId();
  return (
    <div>
      <label htmlFor={id}>${2:Indirizzo email}</label>
      <input id={id} name="email" type="email" autoComplete="email" required />
      $0
    </div>
  );
}
