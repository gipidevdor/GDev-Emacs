type Item = { readonly id: string; readonly label: string };

export function ${1:ItemList}({ items }: { items: readonly Item[] }) {
  if (items.length === 0) return <p>${2:Nessun elemento.}</p>;
  // La chiave appartiene al dato e mantiene l'identità quando cambia l'ordine.
  return <ul>{items.map((item) => <li key={item.id}>{item.label}</li>)}</ul>;
}
