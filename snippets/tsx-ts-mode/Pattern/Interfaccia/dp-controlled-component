// Il componente riceve il valore corrente e inoltra al proprietario le proposte di modifica.

type Props = { value: string; change(value: string): void };

export function ${1:SearchField}({ value, change }: Props) {
  return (
    <label>
      ${2:Cerca}
      <input type="search" value={value} onChange={(event) => change(event.currentTarget.value)} />
    </label>
  );
}
