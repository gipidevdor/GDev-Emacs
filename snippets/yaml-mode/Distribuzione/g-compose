# -*- mode: snippet -*-
# name: Compose — servizio locale con porta pubblicata su loopback
# key: g-compose
# group: Distribuzione
# expand-env: ((yas-indent-line 'fixed))
# --
services:
  ${1:app}:
    image: "${2:example/app:1.0}"
    ports:
      - "127.0.0.1:${3:8080}:${4:8080}"
    environment:
      LOG_LEVEL: "${5:info}"
    init: true
    $0
