# -*- mode: snippet -*-
# name: Kubernetes — Deployment con readiness probe e risorse
# key: g-kube-deployment
# group: Distribuzione
# expand-env: ((yas-indent-line 'fixed))
# --
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${1:example}
spec:
  replicas: 2
  selector:
    matchLabels:
      app: $1
  template:
    metadata:
      labels:
        app: $1
    spec:
      containers:
        - name: $1
          image: ${2:example/app:1.0}
          ports:
            - name: http
              containerPort: ${3:8080}
          readinessProbe:
            httpGet:
              path: /${4:health}
              port: http
          resources:
            requests:
              cpu: 100m
              memory: 64Mi
            limits:
              memory: 256Mi
          $0
