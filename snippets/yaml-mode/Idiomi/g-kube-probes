# -*- mode: snippet -*-
# name: Kubernetes — startup, readiness e liveness su endpoint distinti
# key: g-kube-probes
# group: Idiomi
# expand-env: ((yas-indent-line 'fixed))
# --
# La startup probe lascia tempo all'avvio prima di attivare le altre due.
startupProbe:
  httpGet: {path: /${1:live}, port: http}
  periodSeconds: 2
  failureThreshold: 30
readinessProbe:
  httpGet: {path: /${2:ready}, port: http}
  periodSeconds: 5
livenessProbe:
  httpGet: {path: /$1, port: http}
  periodSeconds: 10
  $0
