import java.util.function.IntUnaryOperator;

final class ${1:Pricing} {
    int total(int amount, IntUnaryOperator discount) {
        return amount - discount.applyAsInt(amount);
    }

    static IntUnaryOperator tenPercent() { return amount -> amount / 10; }
}
