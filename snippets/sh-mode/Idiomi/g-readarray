# -*- mode: snippet -*-
# name: Bash 4+ — carica righe in array con mapfile
# key: g-readarray
# group: Idiomi
# condition: (or (eq major-mode 'bash-ts-mode) (eq (bound-and-true-p sh-shell) 'bash))
