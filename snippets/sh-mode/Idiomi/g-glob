# -*- mode: snippet -*-
# name: Itera un glob saltando il modello quando non corrisponde
# key: g-glob
# group: Idiomi
# expand-env: ((yas-indent-line 'fixed))
# --
# Alcune shell POSIX lasciano il modello letterale quando non trovano file.
for ${1:path} in "${2:.}"/*; do
    [ -e "\$$1" ] || [ -L "\$$1" ] || continue
    $0printf '%s\\n' "\$$1"
done
