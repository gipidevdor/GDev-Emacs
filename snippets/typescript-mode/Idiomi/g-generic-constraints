// RecordType[Key] rende impossibile passare il valore di un'altra proprietà.
function ${1:setField}<RecordType, Key extends keyof RecordType>(
  record: RecordType,
  key: Key,
  value: RecordType[Key],
): void {
  record[key] = value;
}
