// Collega la dipendenza nel punto di composizione. Il caso d'uso può così ricevere un sostituto.

interface GreeterPorts {
  send(message: string): void;
}

function ${1:createGreeter}({ send }: GreeterPorts): (name: string) => void {
  return (name) => send(\`Hello, \${name}!\`);
}

