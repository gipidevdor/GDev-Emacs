// Dai a ogni livello il gestore successivo e componi partendo da quello finale.

type Handler = (request: Request) => Promise<Response>;
type Middleware = (request: Request, next: Handler) => Promise<Response>;

function ${1:compose}(layers: readonly Middleware[], endpoint: Handler): Handler {
  return layers.reduceRight<Handler>(
    (next, layer) => (request) => layer(request, next),
    endpoint,
  );
}
