// La stessa coppia stato e azione produce lo stesso risultato senza mutare l'ingresso.

type State = { readonly items: readonly string[] };
type Action = { type: "add"; item: string } | { type: "clear" };

function ${1:reducer}(state: State, action: Action): State {
  switch (action.type) {
    case "add":
      return { items: [...state.items, action.item] };
    case "clear":
      return { items: [] };
  }
}
