// Traduci il contratto al confine e incapsula i dettagli del componente esistente.

interface Temperature {
  celsius(): number;
}

interface LegacySensor {
  fahrenheit(): number;
}

function ${1:celsiusSensor}(legacy: LegacySensor): Temperature {
  return { celsius: () => (legacy.fahrenheit() - 32) * 5 / 9 };
}
