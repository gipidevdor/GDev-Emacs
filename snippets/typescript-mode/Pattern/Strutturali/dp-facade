// L'ordine delle chiamate ai sottosistemi rimane in un unico punto.

interface CheckoutServices {
  quote(cartId: string): Promise<number>;
  place(cartId: string, cents: number): Promise<string>;
}

function ${1:createCheckout}(services: CheckoutServices) {
  return {
    async checkout(cartId: string): Promise<string> {
      return services.place(cartId, await services.quote(cartId));
    },
  };
}
