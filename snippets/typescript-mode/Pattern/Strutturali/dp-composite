interface SizedNode {
  size(): number;
}

const file = (bytes: number): SizedNode => ({ size: () => bytes });

function ${1:folder}(children: readonly SizedNode[]): SizedNode {
  const entries = [...children];
  return { size: () => entries.reduce((sum, node) => sum + node.size(), 0) };
}

