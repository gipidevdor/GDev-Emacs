// Il chiamante passa per la stessa interfaccia. Il proxy controlla quando raggiungere il destinatario.

interface Report {
  render(): string;
}

function ${1:lazyReport}(load: () => Report): Report {
  let report: Report | undefined;
  return {
    render() {
      report ??= load();
      return report.render();
    },
  };
}
