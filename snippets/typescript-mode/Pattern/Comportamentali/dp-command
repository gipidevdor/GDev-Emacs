// L'azione è un valore. Il chiamante può conservarla e annullarla quando il contratto lo consente.

interface Command {
  execute(): void;
  undo(): void;
}

function ${1:appendText}(target: string[], text: string): Command {
  return {
    execute() {
      target.push(text);
    },
    undo() {
      if (target.at(-1) !== text) throw new Error("Undo in reverse execution order");
      target.pop();
    },
  };
}
