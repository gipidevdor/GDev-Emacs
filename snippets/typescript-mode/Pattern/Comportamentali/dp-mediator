// I componenti inviano cambiamenti al coordinatore, che decide quale stato propagare.

function ${1:createFormMediator}(updateSubmit: (enabled: boolean) => void) {
  let valid = false;
  let busy = false;
  const refresh = () => updateSubmit(valid && !busy);

  return {
    validityChanged(value: boolean) {
      valid = value;
      refresh();
    },
    busyChanged(value: boolean) {
      busy = value;
      refresh();
    },
  };
}
