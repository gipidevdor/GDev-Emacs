// Cattura i dati necessari al ripristino. Le modifiche successive devono lasciare intatta la cattura.

type Snapshot = Readonly<{ text: string; cursor: number }>;

class ${1:Editor} {
  text = "";
  cursor = 0;

  snapshot(): Snapshot {
    return { text: this.text, cursor: this.cursor };
  }

  restore(saved: Snapshot): void {
    this.text = saved.text;
    this.cursor = saved.cursor;
  }
}
