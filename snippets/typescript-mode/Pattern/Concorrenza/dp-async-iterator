// Ogni pagina viene richiesta quando serve. Il chiamante conserva il controllo della cancellazione.

type Page<T> = { items: readonly T[]; next: string | null };

async function* ${1:iteratePages}<T>(
  load: (cursor: string | null, signal: AbortSignal) => Promise<Page<T>>,
  signal: AbortSignal,
): AsyncGenerator<T> {
  let cursor: string | null = null;
  do {
    signal.throwIfAborted();
    const page = await load(cursor, signal);
    yield* page.items;
    cursor = page.next;
  } while (cursor !== null);
}
