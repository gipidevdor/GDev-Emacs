// Condividi il lavoro in corso per chiave. Rimuovi la voce quando termina anche se fallisce.

function ${1:singleFlight}<K, V>(load: (key: K) => Promise<V>): (key: K) => Promise<V> {
  const pending = new Map<K, Promise<V>>();
  return (key) => {
    const current = pending.get(key);
    if (current) return current;
    const result = Promise.resolve().then(() => load(key)).finally(() => {
      pending.delete(key);
    });
    pending.set(key, result);
    return result;
  };
}
