// Tieni lo stato parziale nel builder e restituisci un risultato indipendente a costruzione completata.

type Report = Readonly<{ title: string; sections: readonly string[] }>;

class ${1:ReportBuilder} {
  private readonly sections: string[] = [];

  constructor(private readonly title: string) {}

  add(section: string): this {
    this.sections.push(section);
    return this;
  }

  build(): Report {
    return { title: this.title, sections: [...this.sections] };
  }
}
