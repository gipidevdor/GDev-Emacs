// Fornisci la fabbrica al chiamante per mantenere coerenti i prodotti della stessa famiglia.

interface Sender {
  send(message: string): void;
}

interface Formatter {
  format(message: string): string;
}

interface NotificationFactory {
  sender(): Sender;
  formatter(): Formatter;
}

const ${1:textNotifications}: NotificationFactory = {
  sender: () => ({ send: console.info }),
  formatter: () => ({ format: (message) => \`[info] \${message}\` }),
};

function ${2:notify}(factory: NotificationFactory, message: string): void {
  factory.sender().send(factory.formatter().format(message));
}
