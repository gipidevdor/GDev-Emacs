// Il flusso chiamante usa il contratto del prodotto. Il punto di creazione decide l'implementazione.

interface Writer {
  write(text: string): string;
}

abstract class Exporter {
  render(text: string): string {
    return this.createWriter().write(text);
  }

  protected abstract createWriter(): Writer;
}

class ${1:MarkdownExporter} extends Exporter {
  protected override createWriter(): Writer {
    return { write: (text) => \`# \${text}\` };
  }
}
