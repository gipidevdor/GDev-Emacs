# -*- mode: snippet -*-
# name: Gruppo radio con fieldset, legend ed etichette
# key: g-radio-group
# group: Form
# expand-env: ((yas-indent-line 'fixed))
# --
<fieldset>
  <legend>${1:Frequenza}</legend>
  <label><input type="radio" name="${2:frequency}" value="daily" checked> Ogni giorno</label>
  <label><input type="radio" name="$2" value="weekly"> Ogni settimana</label>
  $0
</fieldset>
