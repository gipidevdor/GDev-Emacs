# -*- mode: snippet -*-
# name: Video con controlli, poster e traccia sottotitoli
# key: g-video
# group: Media
# expand-env: ((yas-indent-line 'fixed))
# --
<video controls preload="metadata" poster="${1:poster.jpg}">
  <source src="${2:video.mp4}" type="video/mp4">
  <track kind="captions" src="${3:captions-it.vtt}" srclang="it" label="Italiano" default>
  <a href="$2">Scarica il video</a>
</video>$0
