# -*- mode: snippet -*-
# name: Builder — costruzione a passi
# key: dp-builder
# group: Pattern.Creazionali
# expand-env: ((yas-indent-line 'fixed))
# --
// Tieni lo stato parziale nel builder e restituisci un risultato indipendente a costruzione completata.

struct ${1:Report} {
    let title: String
    let sections: [String]
}

struct $1Builder {
    let title: String
    private(set) var sections: [String] = []

    mutating func add(_ section: String) {
        sections.append(section)
    }

    func build() -> $1 {
        $1(title: title, sections: sections)
    }
}
$0
