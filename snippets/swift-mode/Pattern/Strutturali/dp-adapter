// Traduci il contratto al confine e incapsula i dettagli del componente esistente.

protocol Temperature {
    func celsius() -> Double
}

struct ${1:LegacySensor} {
    func fahrenheit() -> Double { 68 }
}

struct CelsiusAdapter: Temperature {
    let source: $1

    func celsius() -> Double {
        (source.fahrenheit() - 32) * 5 / 9
    }
}
$0
