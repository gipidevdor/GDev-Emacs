// Chi usa l'operazione conserva lo stesso contratto anche quando la avvolgi con altro comportamento.

import Foundation

func ${1:timed}<Input, Output>(
    _ operation: @escaping (Input) throws -> Output,
    report: @escaping (Duration) -> Void
) -> (Input) throws -> Output {
    { input in
        let start = ContinuousClock.now
        defer { report(start.duration(to: .now)) }
        return try operation(input)
    }
}
