use v5.36;

package ${1:CelsiusSensor} {
    sub new (\$class, \$legacy) {
        return bless { legacy => \$legacy }, \$class;
    }

    sub celsius (\$self) {
        return (\$self->{legacy}->fahrenheit - 32) * 5 / 9;
    }
}
