;; Il consumatore avanza un elemento alla volta e può interrompere l'attraversamento in anticipo.

(defun ${1:list-iterator} (items)
  (let ((remaining items))
    (lambda ()
      (if remaining
          (values (pop remaining) t)
          (values nil nil)))))
$0
