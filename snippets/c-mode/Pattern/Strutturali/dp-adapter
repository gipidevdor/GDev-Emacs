struct legacy_sensor {
    void *state;
    double (*fahrenheit)(void *state);
};

double ${1:read_celsius}(const struct legacy_sensor *sensor)
{
    return (sensor->fahrenheit(sensor->state) - 32.0) * 5.0 / 9.0;
}

