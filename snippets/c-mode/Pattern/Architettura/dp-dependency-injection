// Collega la dipendenza nel punto di composizione. Il caso d'uso può così ricevere un sostituto.

struct ${1:logger} {
    void *context;
    void (*write)(void *context, const char *message);
};

void report_ready(const struct $1 *logger)
{
    logger->write(logger->context, "${2:Ready}");
}

