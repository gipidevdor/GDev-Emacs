use std::error::Error;
use std::process::ExitCode;

fn ${1:run}() -> Result<(), Box<dyn Error>> {
    $0
    Ok(())
}

fn main() -> ExitCode {
    match $1() {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            eprintln!("{error}");
            ExitCode::FAILURE
        }
    }
}
