// Ogni fase riceve l'uscita di quella a monte. Conserva la produzione incrementale quando possibile.

pub fn ${1:records}(input: &str) -> impl Iterator<Item = &str> {
    input.lines()
        .map(str::trim)
        .filter(|line| !line.is_empty() && !line.starts_with('#'))
}
$0
