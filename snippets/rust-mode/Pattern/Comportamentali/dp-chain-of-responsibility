// Un gestore indica se ha elaborato la richiesta. Il primo che la gestisce termina la catena.

pub fn ${1:dispatch}<T, R>(request: &T, handlers: &[impl Fn(&T) -> Option<R>]) -> Option<R> {
    handlers.iter().find_map(|handle| handle(request))
}
