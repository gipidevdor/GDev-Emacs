# -*- mode: snippet -*-
# name: Gestione del dialogo nativo con invocatore e focus
# key: g-dialog
# group: DOM
# expand-env: ((yas-indent-line 'fixed))
# --
const ${1:dialog} = document.querySelector("${2:#settings}");
const trigger = document.querySelector("${3:#open-settings}");

if ($1 instanceof HTMLDialogElement && trigger instanceof HTMLElement) {
  trigger.addEventListener("click", () => $1.showModal());
  $1.addEventListener("close", () => trigger.focus());
}
$0
