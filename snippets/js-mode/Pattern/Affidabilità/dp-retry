// Ripeti operazioni idempotenti, con un limite e una decisione esplicita sugli errori ripetibili.

async function ${1:retry}(operation, { shouldRetry, signal, attempts = ${2:4} }) {
  if (!Number.isInteger(attempts) || attempts < 1) throw new RangeError("Invalid attempts");

  for (let attempt = 0; ; attempt++) {
    signal?.throwIfAborted();
    try {
      return await operation(signal);
    } catch (error) {
      if (signal?.aborted || attempt + 1 === attempts || !shouldRetry(error)) throw error;
      await new Promise((resolve, reject) => {
        signal?.throwIfAborted();
        const abort = () => {
          clearTimeout(timer);
          reject(signal.reason);
        };
        const timer = setTimeout(() => {
          signal?.removeEventListener("abort", abort);
          resolve();
        }, Math.random() * Math.min(2_000, 100 * 2 ** attempt));
        signal?.addEventListener("abort", abort, { once: true });
      });
    }
  }
}
