// L'ordine delle chiamate ai sottosistemi rimane in un unico punto.

function ${1:createCheckout}({ quote, place }) {
  return {
    async checkout(cartId) {
      const price = await quote(cartId);
      return place(cartId, price);
    },
  };
}
