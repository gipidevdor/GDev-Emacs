// Condividi solo i dati intrinseci e immutabili. Tieni lo stato di ogni uso fuori dalla cache.

const styles = new Map();

function ${1:textStyle}(font, size) {
  const key = JSON.stringify([font, size]);
  if (!styles.has(key)) {
    styles.set(key, Object.freeze({ font, size }));
  }
  return styles.get(key);
}
