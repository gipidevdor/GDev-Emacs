// Dai a ogni livello il gestore successivo e componi partendo da quello finale.

function ${1:compose}(middleware, handle) {
  return middleware.reduceRight(
    (next, layer) => (request) => layer(request, next),
    handle,
  );
}

const withTiming = async (request, next) => {
  const start = performance.now();
  try {
    return await next(request);
  } finally {
    console.debug(\`Request: \${performance.now() - start}ms\`);
  }
};
