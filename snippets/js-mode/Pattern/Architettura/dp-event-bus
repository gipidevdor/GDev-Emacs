// Disiscrivi il destinatario quando lo scope non è più attivo.

function ${1:createBus}() {
  const bus = new EventTarget();
  return {
    on(topic, listener) {
      const receive = (event) => listener(event.detail);
      bus.addEventListener(topic, receive);
      return () => bus.removeEventListener(topic, receive);
    },
    emit(topic, payload) {
      bus.dispatchEvent(new CustomEvent(topic, { detail: payload }));
    },
  };
}
