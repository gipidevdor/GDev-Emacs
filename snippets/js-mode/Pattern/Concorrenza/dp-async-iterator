// Ogni pagina viene richiesta quando serve. Il chiamante conserva il controllo della cancellazione.

async function* ${1:iteratePages}(fetchPage, signal) {
  let cursor = null;
  do {
    signal?.throwIfAborted();
    const { items, next } = await fetchPage(cursor, signal);
    yield* items;
    cursor = next;
  } while (cursor !== null);
}
