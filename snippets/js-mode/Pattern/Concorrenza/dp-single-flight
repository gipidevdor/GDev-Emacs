// Condividi il lavoro in corso per chiave. Rimuovi la voce quando termina anche se fallisce.

function ${1:singleFlight}(load) {
  const pending = new Map();
  return (key) => {
    if (!pending.has(key)) {
      const result = Promise.resolve().then(() => load(key)).finally(() => pending.delete(key));
      pending.set(key, result);
    }
    return pending.get(key);
  };
}
