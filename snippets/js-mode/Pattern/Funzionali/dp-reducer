// La stessa coppia stato e azione produce lo stesso risultato senza mutare l'ingresso.

function ${1:reducer}(state, action) {
  switch (action.type) {
    case "add":
      return { ...state, items: [...state.items, action.item] };
    case "clear":
      return { ...state, items: [] };
    default:
      throw new RangeError(\`Unknown action: \${action.type}\`);
  }
}
