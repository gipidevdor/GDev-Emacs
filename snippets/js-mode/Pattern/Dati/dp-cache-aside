// Carica soltanto alla prima lettura o alla scadenza e invalida dopo una scrittura riuscita.

function ${1:createCache}(load, ttlMs = ${2:30000}) {
  const entries = new Map();
  return {
    get(key) {
      const hit = entries.get(key);
      if (hit && hit.expiresAt > performance.now()) return hit.value;
      const value = load(key);
      entries.set(key, { value, expiresAt: performance.now() + ttlMs });
      return value;
    },
    invalidate(key) {
      entries.delete(key);
    },
  };
}
