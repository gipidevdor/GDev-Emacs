class Exporter {
  render(text) {
    return this.createWriter().write(text);
  }

  createWriter() {
    throw new TypeError("Implement createWriter in the exporter");
  }
}

class ${1:MarkdownExporter} extends Exporter {
  createWriter() {
    return { write: (text) => \`# \${text}\` };
  }
}
