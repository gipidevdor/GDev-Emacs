// Fornisci la fabbrica al chiamante per mantenere coerenti i prodotti della stessa famiglia.

const ${1:textNotifications} = {
  createFormatter: () => ({ format: (message) => \`[info] \${message}\` }),
  createSender: () => ({ send: (message) => console.info(message) }),
};

function ${2:notify}(factory, message) {
  const { format } = factory.createFormatter();
  factory.createSender().send(format(message));
}
