class ${1:ReportBuilder} {
  #title;
  #sections = [];

  constructor(title) {
    this.#title = title;
  }

  add(section) {
    this.#sections.push(section);
    return this;
  }

  build() {
    return Object.freeze({ title: this.#title, sections: Object.freeze([...this.#sections]) });
  }
}

const ${2:report} = new $1("Summary").add("Results").build();
