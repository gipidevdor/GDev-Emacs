// I componenti inviano cambiamenti al coordinatore, che decide quale stato propagare.

function ${1:createFormMediator}(updateSubmit) {
  let valid = false;
  let busy = false;
  const refresh = () => updateSubmit(valid && !busy);

  return {
    validityChanged(value) {
      valid = value;
      refresh();
    },
    busyChanged(value) {
      busy = value;
      refresh();
    },
  };
}
