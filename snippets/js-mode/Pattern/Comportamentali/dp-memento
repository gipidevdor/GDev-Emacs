// Cattura i dati necessari al ripristino. Le modifiche successive devono lasciare intatta la cattura.

class ${1:Editor} {
  text = "";
  cursor = 0;

  snapshot() {
    return Object.freeze({ text: this.text, cursor: this.cursor });
  }

  restore(snapshot) {
    this.text = snapshot.text;
    this.cursor = snapshot.cursor;
  }
}
