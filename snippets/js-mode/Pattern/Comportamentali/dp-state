// Ogni stato definisce il proprio comportamento e le transizioni ammesse.

const published = Object.freeze({
  label: "Published",
  advance() { throw new Error("Already published"); },
});
const review = Object.freeze({ label: "In review", advance: () => published });
const draft = Object.freeze({ label: "Draft", advance: () => review });

class ${1:Article} {
  #state = draft;

  get label() {
    return this.#state.label;
  }

  advance() {
    this.#state = this.#state.advance();
  }
}
