// Un gestore indica se ha elaborato la richiesta. Il primo che la gestisce termina la catena.

function ${1:dispatch}(request, handlers) {
  for (const handle of handlers) {
    const answer = handle(request);
    if (answer !== undefined) return answer;
  }
  throw new RangeError(\`No handler for \${request}\`);
}
